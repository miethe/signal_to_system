{
  "name": "signal-to-system",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:m0": "node --test tests/m0/*.test.mjs",
    "test:routes": "node scripts/route-snapshot.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "verify": "npm run build && npm run check && npm run test:m0 && npm run test:routes && npm run check:links && npm run check:palette",
    "check:prose": "node scripts/check-prose.mjs",
    "check:palette": "node scripts/check-palette-literals.mjs",
    "demo:doctor": "node demo/tools/demo-foundry.mjs doctor",
    "demo:capture": "playwright test demo/demos/**/*.spec.ts",
    "demo:review": "node demo/tools/demo-foundry.mjs review",
    "review:capture": "python3 scripts/capture-review.py",
    "assets:build": "node scripts/assets/build-assets.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.7",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@miethe/ui": "^0.2.0",
    "@nanostores/react": "^1.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.7",
    "lucide-react": "^0.577.0",
    "nanostores": "^1.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "satori": "^0.33.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "typescript": "^5.9.3"
  }
}
