def capture_atlas(browser):
    ATLAS.mkdir(parents=True, exist_ok=True)
    states=[
        ("entry", ESSAY, None), ("threadscene-incident", ESSAY, "#thread-incident"),
        ("thread-focus-route", THREAD+"incident/", None), ("evidence-focus-index", EVIDENCE, None),
        ("evidence-record", "/evidence/drift-check-2026-08-06/", None), ("figure-viewer", FIGURE+"incident/", None),
        ("conclusion", ESSAY, "#where-this-sits"),
    ]
    written=[]
    for label,path,fragment in states:
        for width,height,name in ((1440,900,"desktop"),(390,844,"mobile")):
            context=browser.new_context(viewport={"width":width,"height":height})
            for dark in (False,True):
                p=new_page(context,path+(fragment or ""),dark); filename=f"{label}__{name}__{'dark' if dark else 'light'}.jpg"; p.screenshot(path=str(ATLAS/filename), type="jpeg", quality=80); written.append(filename); p.close()
            context.close()
    for dark in (False,True):
        c=browser.new_context(viewport={"width":390,"height":844}); p=new_page(c,ESSAY,dark); p.locator("[data-mobile-contents-trigger]").click(); p.locator("[data-mobile-contents]").wait_for(state="visible"); filename=f"mobile-contents-sheet__mobile__{'dark' if dark else 'light'}.jpg"; p.screenshot(path=str(ATLAS/filename), type="jpeg", quality=80); written.append(filename); p.close(); c.close()
    # Overlay is separate from route because its dialog and parent-state behavior are a distinct reviewed surface.
    for width,height,name in ((1440,900,"desktop"),(390,844,"mobile")):
        c=browser.new_context(viewport={"width":width,"height":height})
        for dark in (False,True):
            p=new_page(c,ESSAY,dark); open_beat(p); filename=f"thread-focus-overlay__{name}__{'dark' if dark else 'light'}.jpg"; p.screenshot(path=str(ATLAS/filename), type="jpeg", quality=80); written.append(filename); p.close()
        c.close()
    index=["# Final atlas index", "", "JPEG captures use Playwright quality 80 to keep the atlas below 8 MB. They were saved but not opened or inspected in this QA leg.", ""]
    for name in written: index.append(f"- `{name}`: {name.split('__')[0].replace('-', ' ')} at the named viewport and theme.")
    (ATLAS/"INDEX.md").write_text("\n".join(index)+"\n")

def main():
    with sync_playwright() as pw:
        browser=pw.chromium.launch(headless=True)
        try:
            test_suite(browser); capture_atlas(browser)
        finally: browser.close()

if __name__ == "__main__": main()
