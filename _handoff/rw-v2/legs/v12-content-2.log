  src: string; // "/assets/posts/<slug>/<file>.png"
  alt: string;
  caption?: string;
}

export interface ThreadBeat {
  id: string; // anchor id is `thread-${id}`
  n: number;
  label: string;
  recap: string; // 1-2 sentences; the one real paragraph inline and Thread Focus both render
