--- src/components/content/ThreadScene.astro
     1	---
     2	/**
     3	 * ThreadScene — inline per-beat rendering for a post's running thread,
     4	 * placed adjacent to matching prose at each of the six canonical anchors
     5	 * (reading-experience-v2 DIRECTION.md V3/V7, ARCHITECTURE.md §4). It looks
     6	 * up its own beat from `threads.ts` by `slug` + `beatId` and renders the
     7	 * canonical figure, the one real recap paragraph, a semantic kind label,
     8	 * and an "Explore thread" link to the standalone Thread Focus route.
     9	 *
    10	 * `ThreadFocus.astro` renders the fuller composition from the exact same
    11	 * beat record — recap is written once in `threads.ts` and both surfaces
    12	 * read it, never a second hand-written explanation (V3).
    13	 *
    14	 * `composition` follows DIRECTION V6's four main-pane types. `measure`
    15	 * (default) keeps the scene inside the article's prose measure; `pane`
    16	 * breaks the whole scene out wider, for the four dense technical PNGs
    17	 * named in this essay's build brief (incident, deployment, drift,
    18	 * outcome). `split`/`inset` are accepted for forward compatibility with
    19	 * V6's full set — this essay's six scenes use only `measure`/`pane` today,
    20	 * so those two get a lighter, documented treatment rather than a full
    21	 * adjacent-content slot this component doesn't have a use for yet.
    22	 */
    23	import Figure from './Figure.astro';
    24	import { threads } from '../../data/threads';
    25	
    26	interface Props {
    27	  slug: string;
    28	  beatId: string;
    29	  composition?: 'measure' | 'pane' | 'split' | 'inset';
    30	}
    31	
    32	const { slug, beatId, composition = 'measure' } = Astro.props;
    33	const thread = threads[slug];
    34	const beat = thread?.beats.find((candidate) => candidate.id === beatId);
    35	
    36	if (!thread || !beat) {
    37	  console.warn(
    38	    `[ThreadScene] Unable to resolve beat "${beatId}" for thread "${slug}". Rendering nothing.`,
    39	  );
    40	}
    41	
    42	const kindLabel: Record<string, string> = {
    43	  historical: 'Historical account',
    44	  conceptual: 'Conceptual branch',
    45	  mechanism: 'Mechanism',
    46	  proposed: 'Proposed',
    47	};
    48	
    49	// Restrained cyan/violet split (DIRECTION V10): conceptual/mechanism beats
    50	// (the two boundary-flagged, non-historical kinds) get the cyan structural
    51	// accent on their kind label; historical/proposed keep the primary violet
    52	// accent used everywhere else in the thread.
    53	const kindUsesCyan = beat?.kind === 'conceptual' || beat?.kind === 'mechanism';
    54	---
    55	
    56	{
    57	  thread && beat && (
    58	    <section
    59	      id={`thread-${beat.id}`}
    60	      class:list={[
    61	        'thread-scene lift-hover',
    62	        composition === 'pane' && 'thread-scene--pane',
    63	        composition === 'split' && 'thread-scene--split',
    64	        composition === 'inset' && 'thread-scene--inset',
    65	      ]}
    66	      aria-labelledby={`thread-${beat.id}-label`}
    67	    >
    68	      <span class="thread-scene__corner thread-scene__corner--tl" aria-hidden="true" />
    69	      <span class="thread-scene__corner thread-scene__corner--tr" aria-hidden="true" />
    70	      <span class="thread-scene__corner thread-scene__corner--bl" aria-hidden="true" />
    71	      <span class="thread-scene__corner thread-scene__corner--br" aria-hidden="true" />
    72	
    73	      <div class="thread-scene__body">
    74	        <div class="thread-scene__head">
    75	          <p class="thread-scene__eyebrow font-mono">
    76	            <span class="thread-scene__count">
    77	              {beat.n}/{thread.beats.length}
    78	            </span>
    79	            <span aria-hidden="true" class="thread-scene__eyebrow-sep">
    80	              &middot;
    81	            </span>
    82	            <span class:list={['thread-scene__kind', kindUsesCyan && 'thread-scene__kind--cyan']}>
    83	              {kindLabel[beat.kind] ?? beat.kind}
    84	            </span>
    85	          </p>
    86	          <h3 id={`thread-${beat.id}-label`} class="thread-scene__label font-serif">
    87	            {beat.label}
    88	          </h3>
    89	        </div>
    90	
    91	        <p class="thread-scene__recap">{beat.recap}</p>
    92	
    93	        <Figure
    94	          src={beat.image.src}
    95	          alt={beat.image.alt}
    96	          caption={beat.image.caption}
    97	          number={String(beat.n).padStart(2, '0')}
    98	          longDescription={beat.longDescription}
    99	          figureId={beat.id}
   100	          slug={slug}
   101	          variant={composition === 'pane' ? 'technical' : 'inline'}
   102	        />
   103	
   104	        <a class="thread-scene__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
   105	          Explore this thread beat <span aria-hidden="true">&rarr;</span>
   106	        </a>
   107	      </div>
   108	    </section>
   109	  )
   110	}
   111	
   112	<style>
   113	  .thread-scene {
   114	    position: relative;
   115	    margin: 2.75rem 0;
   116	    padding: 1.375rem 1.5rem 1.5rem;
   117	    border: 1px solid var(--border-strong);
   118	    background: var(--bg-surface);
   119	    border-radius: var(--radius-lg);
   120	    scroll-margin-top: 6rem;
   121	  }
   122	
   123	  .thread-scene--inset {
   124	    margin: 2rem 0;
   125	    padding: 1rem 1.25rem 1.25rem;
   126	    border-style: dashed;
   127	  }
   128	
   129	  .thread-scene--split {
   130	    background: var(--bg-subtle);
   131	  }
   132	
   133	  .thread-scene__corner {
   134	    position: absolute;
   135	    width: 9px;
   136	    height: 9px;
   137	    border: 1px solid var(--border-strong);
   138	    opacity: 0.65;
   139	    pointer-events: none;
   140	  }
   141	
   142	  .thread-scene__corner--tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
   143	  .thread-scene__corner--tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
   144	  .thread-scene__corner--bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
   145	  .thread-scene__corner--br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; }
   146	
   147	  .thread-scene__body {
   148	    border-left: 2px solid var(--accent);
   149	    padding-left: 1.125rem;
   150	  }
   151	
   152	  .thread-scene__head {
   153	    display: flex;
   154	    flex-direction: column;
   155	    align-items: flex-start;
   156	    gap: 0.2rem;
   157	  }
   158	
   159	  .thread-scene__eyebrow {
   160	    display: flex;
   161	    align-items: baseline;
   162	    gap: 0.4rem;
   163	    margin: 0;
   164	    font-size: 0.6875rem;
   165	    font-weight: 700;
   166	    letter-spacing: 0.14em;
   167	    text-transform: uppercase;
   168	    color: var(--accent-text);
   169	  }
   170	
   171	  .thread-scene__eyebrow-sep {
   172	    color: var(--text-tertiary);
   173	  }
   174	
   175	  .thread-scene__kind--cyan {
   176	    color: var(--cyan-text);
   177	  }
   178	
   179	  .thread-scene__label {
   180	    margin: 0.2rem 0 0;
   181	    font-size: 1.25rem;
   182	    font-weight: 600;
   183	    line-height: 1.2;
   184	    color: var(--text-primary);
   185	  }
   186	
   187	  .thread-scene__recap {
   188	    margin: 0.85rem 0 0;
   189	    font-size: 0.9375rem;
   190	    line-height: 1.6;
   191	    color: var(--text-secondary);
   192	  }
   193	
   194	  .thread-scene__body :global(.figure-plate) {
   195	    margin: 1.25rem 0 0;
   196	  }
   197	
   198	  .thread-scene__explore {
   199	    display: inline-flex;
   200	    align-items: baseline;
   201	    gap: 0.35rem;
   202	    margin-top: 1rem;
   203	    font-family: var(--font-mono);
   204	    font-size: 0.75rem;
   205	    font-weight: 600;
   206	    letter-spacing: 0.04em;
   207	    text-transform: uppercase;
   208	    color: var(--accent);
   209	    text-decoration: none;
   210	  }
   211	
   212	  .thread-scene__explore:hover,
   213	  .thread-scene__explore:focus-visible {
   214	    color: var(--accent-hover);
   215	    text-decoration: underline;
   216	  }
   217	
   218	  .thread-scene__explore:focus-visible {
   219	    outline: 2px solid var(--accent);
   220	    outline-offset: 3px;
   221	  }
   222	
   223	  /* Pane composition (V6): the whole scene breaks out wider than the prose
   224	     measure, for the essay's four dense technical PNGs — same technique
   225	     the existing figure-plate wide/technical variants use. */
   226	  @media (min-width: 1024px) {
   227	    .prose-custom > .thread-scene.thread-scene--pane {
   228	      width: min(calc(100% + 6rem), calc(100vw - 2rem));
   229	      max-width: none;
   230	      margin-right: -3rem;
   231	      margin-left: -3rem;
   232	    }
   233	  }
   234	</style>
--- src/data/threads.ts
     1	// ---------------------------------------------------------------------------
     2	// Running Thread Registry
     3	// ---------------------------------------------------------------------------
     4	//
     5	// Declarative beat lists for essays that carry a single worked example from
     6	// beginning to outcome. One record per beat drives every rendering surface
     7	// (inline scene, ThreadDock, Thread Focus route/overlay, figure route) so
     8	// none of them writes its own second explanation (reading-experience-v2
     9	// DIRECTION.md V3). `ThreadStoryboard.astro`, `ThreadBeat.astro`'s marker
    10	// variant, and `ThreadRail.astro` currently read this same registry; P0-B
    11	// retires the first two and folds the third into `ThreadDock`.
    12	//
    13	// Beat order is the canonical six (DIRECTION.md V12): Incident, Deployment,
    14	// Use, Drift, Detection, Outcome. The essay places each `ThreadScene` beside
    15	// its movement prose in exactly this order, while this record remains the
    16	// one shared account for inline and Thread Focus readers.
    17	//
    18	// Every `recap` / `establishes` / `doesNotEstablish` / `longDescription`
    19	// below is written fresh, grounded in the manuscript's own prose and figure
    20	// captions (`src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx`)
    21	// and the six-beat filename/semantic mapping in
    22	// `registry_wave_visual_source_of_truth_2026-09-18/06_SUPPORTING_HANDOFFS/INLINE-FIGURE-IMAGE-USAGE-HANDOFF.md`.
    23	// The reading-experience-v2 handoff's `contracts/thread-manifest.json` prose
    24	// (title/caption/description/nodes) is mockup text for a different draft of
    25	// this essay and is not copied verbatim; only its beat order, `mode`
    26	// classification, and filename mapping are reused as structural facts.
    27	
    28	export type ThreadBeatKind = "historical" | "conceptual" | "mechanism" | "proposed";
    29	
    30	export interface ThreadBeatImage {
    31	  src: string; // "/assets/posts/<slug>/<file>.png"
    32	  alt: string;
    33	  caption?: string;
    34	}
    35	
    36	export interface ThreadBeat {
    37	  id: string; // anchor id is `thread-${id}`
    38	  n: number;
    39	  label: string; // display title, shared by inline and Thread Focus
    40	  recap: string; // one real paragraph; inline and Thread Focus both render it
    41	  kind: ThreadBeatKind; // historical | conceptual | mechanism | proposed (thread-manifest.json's `mode`)
    42	  establishes: string; // what this beat's evidence actually shows
    43	  doesNotEstablish: string; // the boundary readers should not read past
    44	  longDescription: string; // fuller paragraph for Thread Focus / figure long description
    45	  image: ThreadBeatImage;
    46	  secondaryImage?: ThreadBeatImage; // unused by this thread; kept for ThreadStoryboard.astro's existing prop shape
    47	  relatedEvidenceIds: string[]; // ids into `src/data/evidence.ts`; post-scoped strings, not a per-thread BeatId enum
    48	}
    49	
    50	export interface Thread {
    51	  slug: string;
    52	  title: string;
    53	  subject: string;
    54	  beats: ThreadBeat[];
    55	}
    56	
    57	export const threads: Record<string, Thread> = {
    58	  "the-registry-wave-agentic-artifact-supply-chain": {
    59	    slug: "the-registry-wave-agentic-artifact-supply-chain",
    60	    title: "The stale reviewer",
    61	    subject: "task-completion-validator",
    62	    beats: [
    63	      {
    64	        id: "incident",
    65	        n: 1,
    66	        label: "Incident",
    67	        kind: "historical",
    68	        recap:
    69	          "A reviewer skill was missing a mandatory guard. Fixing it at the source updated the registry immediately, but every project outside that source repository kept loading the pre-fix deployed copy for five days. The registry was right and the runtime's copy was wrong, and nothing compared the two to say so.",
    70	        establishes:
    71	          "The source and registry can be corrected while a deployed project copy stays on the old bytes, and nothing surfaces that mismatch by default.",
    72	        doesNotEstablish:
    73	          "This does not establish which bytes any given run actually loaded, or that a clean registry entry by itself guarantees deployment.",
    74	        longDescription:
    75	          "The reviewer skill's mandatory guard was missing in every project outside its source repository. Fixing the guard at the source updated the registry immediately, but each deployed project copy is a separate object: the registry record didn't rewrite any of them, and nothing compared the deployed bytes against the registered ones to notice they'd fallen behind. The diagram traces that handoff from a corrected source and registry into project copies that stayed on the earlier bytes.",
    76	        image: {
    77	          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-incident-resolution-flow.png",
    78	          alt: "Flow diagram showing a reviewer skill's guard corrected at its source and reflected in the registry, while separate deployed project copies remain on the earlier, uncorrected bytes.",
    79	          caption:
    80	            "The fix landed at the source and reached the registry immediately; the deployed copies had not caught up yet.",
    81	        },
    82	        relatedEvidenceIds: ["drift-check"],
    83	      },
    84	      {
    85	        id: "deployment",
    86	        n: 2,
    87	        label: "Deployment",
    88	        kind: "historical",
    89	        recap:
    90	          "A file copy is a separate object from its source. Updating the source or registering a new revision doesn't update an already-deployed copy, and a clean registration says nothing about what a given project actually has on disk.",
    91	        establishes:
    92	          "Source revision, registry record, and deployed project copy are three separate objects; closing the gap needs a recorded deployment path, not a symlink or a manual copy.",
    93	        doesNotEstablish:
    94	          "A registry entry existing does not establish that any specific project's deployed copy matches it.",
    95	        longDescription:
    96	          "The same handoff repeats through the essay: source, registry, project deployment, runtime loading, and outcome evidence are each a distinct record. A registry entry naming the correct revision says nothing about which bytes a specific project actually deployed, and a deployment record has to name that relationship explicitly rather than assume it from the registry alone. A symlink doesn't solve this either; it follows the source checkout as branches change, so it drifts with the branch instead of leaving a fixed, comparable copy.",
    97	        image: {
    98	          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-from-source-to-outcome.png",
    99	          alt: "Diagram of the handoff from source repository to registry to project deployment to runtime loading to outcome evidence, showing where an artifact's declared and deployed identity can separate.",
   100	          caption:
   101	            "The registry's corrected artifact and the deployed project copies now disagree about what the same skill name means.",
   102	        },
   103	        relatedEvidenceIds: [],
   104	      },
   105	      {
   106	        id: "use",
   107	        n: 3,
   108	        label: "Use",
   109	        kind: "conceptual",
   110	        recap:
   111	          "Even once the corrected copy is deployed, presence in the loaded file doesn't establish that the guard was actually followed during a run; that requires its own observation, not an inference from disk state.",
   112	        establishes:
   113	          "A corrected instruction's presence in a loaded artifact is not, on its own, evidence that the instruction was followed during a run; behavior requires separate verification.",
   114	        doesNotEstablish:
   115	          "This is an analytic branch, not evidence that any specific stale run in the incident did or didn't load a corrected reviewer. It does not establish observed behavior.",
   116	        longDescription:
   117	          "Even after a corrected copy is deployed, an instruction's presence in the loaded file is a different claim from evidence that the instruction was followed during a specific run. This beat is an analytic branch: it separates the two claims rather than reporting that a stale run in the incident did or didn't load a corrected reviewer. Verifying behavior needs its own observation; absent that, the loaded version and its effect on the run stay unknown.",
   118	        image: {
   119	          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-presence-vs-behavior.png",
   120	          alt: "Diagram distinguishing a corrected instruction's presence in a loaded artifact from evidence that the instruction was actually followed during a run.",
   121	          caption: "A guard's presence in a loaded file isn't evidence that the guard was actually followed.",
   122	        },
   123	        relatedEvidenceIds: [],
   124	      },
   125	      {
   126	        id: "drift",
   127	        n: 4,
   128	        label: "Drift",
   129	        kind: "historical",
   130	        recap:
   131	          "For five days, the source and registry stayed corrected while every deployed copy outside the source repository stayed on the pre-fix bytes at the same time. The manifest behind the drift gate classifies each declared path as a diffed tracked copy, a never-diffed allowed copy, or an undeclared failure.",
   132	        establishes:
   133	          "Declared state and deployed state can disagree for a measurable, bounded interval without anything surfacing the disagreement on its own.",
   134	        doesNotEstablish:
   135	          "The figure documents one five-day interval from this incident, not a claim of continuous fleet-wide monitoring or a general drift rate.",
   136	        longDescription:
   137	          "The deployment manifest classifies every declared path into one of three buckets: a tracked copy diffed against its upstream, an allowed copy with no upstream to diff against, or an undeclared copy that fails outright. For five days, that classification stayed silent while the registry and the deployed copies disagreed about the same skill name, and the exact calendar range is preserved from the incident rather than invented here.",
   138	        image: {
   139	          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-drift-across-five-days.png",
   140	          alt: "Timeline diagram spanning a five-day interval in which the registry stayed corrected while deployed copies stayed on the pre-fix bytes, without the disagreement being reported.",
   141	          caption:
   142	            "For five days, “fixed” described one location; the registry and the deployment disagreed the whole time.",
   143	        },
   144	        relatedEvidenceIds: ["drift-check", "drift-manifest-excerpt"],
   145	      },
   146	      {
   147	        id: "detection",
   148	        n: 5,
   149	        label: "Detection",
