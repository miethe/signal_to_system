     1	// ---------------------------------------------------------------------------
     2	// Evidence Record Registry
     3	// ---------------------------------------------------------------------------
     4	//
     5	// Flat, site-wide store of receipts an essay can cite from a "Receipts behind
     6	// the argument" section, an Evidence Focus route, or a thread beat's
     7	// `relatedEvidenceIds` (see `src/data/threads.ts`). The field set follows
     8	// `PublicEvidenceRecord` in the reading-experience-v2 handoff's
     9	// `contracts/types.ts`, widened per that handoff's own ARCHITECTURE.md risk
    10	// 2: `relatedSceneIds` is `string[]` here, not a per-post `BeatId[]` enum, so
    11	// a second essay's thread can reference a record without a type change.
    12	//
    13	// Every record below is re-grounded against the receipts actually published
    14	// in `src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx`
    15	// (its footnotes, its "Receipts behind the argument" section, and its two
    16	// redacted inline captures: the deployment-manifest YAML excerpt and the
    17	// September 15 drift-check shell output) and
    18	// `docs/blog-work/the-registry-wave-agentic-artifact-supply-chain/notes/`.
    19	// Nothing here invents a hash, a version, or an internal identifier the
    20	// manuscript doesn't already state. Where the manuscript itself says a date
    21	// is unresolved or gives no date, this file records `null` rather than
    22	// reusing a date an earlier handoff draft guessed (`contracts/evidence-records.json`'s
    23	// "provisioning" entry states "Aug. 4, 2026"; the manuscript's own footnote
    24	// for that receipt says "origin date unresolved", so this file follows the
    25	// manuscript and leaves both dates `null`).
    26	//
    27	// `captureType` is honest: `redacted-original` only for the two records that
    28	// correspond to the manuscript's two real redacted inline captures
    29	// (`drift-manifest-excerpt`, `drift-live-run-2026-09-15`); every other
    30	// empirical receipt is `method-summary`. `run-record` is the one deliberate
    31	// exception, set to `not-applicable` rather than `method-summary`: it is a
    32	// design proposal with no method run to summarize, and `not-applicable` is
    33	// the value `contracts/types.ts`'s `CaptureType` enum and the source
    34	// contract's own annotation ("Not applicable, proposal") both provide for
    35	// exactly this case.
    36	
    37	export type EvidenceClass = "observed" | "externally-reported" | "proposed" | "measured" | "illustrative";
    38	export type CaptureType = "original" | "redacted-original" | "method-summary" | "illustrative" | "not-applicable";
    39	
    40	export interface EvidenceRecord {
    41	  id: string;
    42	  title: string;
    43	  evidenceClass: EvidenceClass;
    44	  captureType: CaptureType;
    45	  sourceUrl: string | null;
    46	  sourceRevision: string | null;
    47	  eventDate: string | null; // ISO date; null when the manuscript doesn't state one
    48	  recordedDate: string | null; // ISO date the receipt/check/audit was recorded or committed
    49	  verifiedAt: string | null;
    50	  supports: string[];
    51	  limitations: string[];
    52	  publicability: "approved" | "pending" | "withheld";
    53	  relatedSceneIds: string[]; // ids into a thread's beats; post-scoped strings, not a per-thread BeatId enum
    54	  publicCapturePath: string | null;
    55	}
