   202	    color: var(--text-primary);
   203	  }
   204	
   205	  .thread-focus__recap {
   206	    margin: 0 0 1.5rem;
   207	    font-size: 1rem;
   208	    line-height: 1.65;
   209	    color: var(--text-secondary);
   210	  }
   211	
   212	  .thread-focus__figure-link {
   213	    display: inline-block;
   214	    margin-top: 0.75rem;
   215	    font-family: var(--font-mono);
   216	    font-size: 0.75rem;
   217	    font-weight: 600;
   218	    color: var(--accent);
   219	    text-decoration: none;
   220	  }
   221	
   222	  .thread-focus__figure-link:hover,
   223	  .thread-focus__figure-link:focus-visible {
   224	    text-decoration: underline;
   225	  }
   226	
   227	  .thread-focus__boundary {
   228	    display: grid;
   229	    gap: 1rem;
   230	    margin: 2rem 0;
   231	    padding: 1.125rem 1.25rem;
   232	    border: 1px solid var(--border-subtle);
   233	    border-radius: var(--radius-lg);
   234	    background: var(--bg-subtle);
   235	  }
   236	
   237	  @media (min-width: 640px) {
   238	    .thread-focus__boundary {
   239	      grid-template-columns: repeat(2, 1fr);
   240	    }
   241	  }
   242	
   243	  .thread-focus__boundary-label {
   244	    margin: 0 0 0.35rem;
   245	    font-size: 0.6875rem;
   246	    font-weight: 700;
   247	    letter-spacing: 0.1em;
   248	    text-transform: uppercase;
   249	    color: var(--text-tertiary);
   250	  }
   251	
   252	  .thread-focus__boundary p {
   253	    margin: 0;
   254	    font-size: 0.875rem;
   255	    line-height: 1.55;
   256	    color: var(--text-secondary);
   257	  }
   258	
   259	  .thread-focus__prevnext {
   260	    display: flex;
   261	    justify-content: space-between;
   262	    gap: 1rem;
   263	    margin-top: 2rem;
