   286	<script>
   287	  import { computeListWindow } from '../../lib/sidebar-window';
   288	
   289	  /** Nearby-outline default window size before "All sections" is toggled. */
   290	  const NEARBY_MAX_VISIBLE = 6;
   291	
   292	  const initializeReadingCompanions = () => {
   293	    document.querySelectorAll<HTMLElement>('[data-reading-companion]').forEach((root) => {
   294	      if (root.dataset.readingCompanionReady === 'true') return;
   295	      root.dataset.readingCompanionReady = 'true';
   296	
   297	      const outline = root.querySelector<HTMLElement>('[data-companion-outline]');
   298	      const allToggle = root.querySelector<HTMLButtonElement>('[data-companion-all-toggle]');
   299	      const body = root.querySelector<HTMLElement>('[data-companion-scroll]');
   300	      const rail = root.querySelector<HTMLElement>('[data-companion-fill]');
   301	      const moreAbove = root.querySelector<HTMLElement>('[data-companion-more="above"]');
   302	      const moreBelow = root.querySelector<HTMLElement>('[data-companion-more="below"]');
   303	      const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-companion-item]'));
   304	
   305	      if (!outline || !body || items.length === 0 || !('IntersectionObserver' in window)) return;
   306	
   307	      const pairs = items
   308	        .map((item) => {
   309	          const link = item.querySelector<HTMLAnchorElement>('[data-companion-link]');
   310	          const target = link ? document.getElementById(link.dataset.companionTarget ?? '') : null;
   311	          return link && target ? { item, link, target } : null;
   312	        })
   313	        .filter((pair): pair is { item: HTMLLIElement; link: HTMLAnchorElement; target: HTMLElement } => pair !== null);
   314	
   315	      if (pairs.length === 0) return;
   316	      const noteRoot = root.querySelector<HTMLElement>('[data-contextual-note]');
   317	      const dismissedNotes = new Set<string>();
   318	
   319	      const reduceMotion = () =>
   320	        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
   321	        document.documentElement.classList.contains('perf-lite');
   322	
   323	      let allExpanded = false;
   324	      let activeIndex = 0;
   325	
   326	      const resolveSection = (targetId: string): string | null => {
   327	        const pair = pairs.find((candidate) => candidate.target.id === targetId);
   328	        if (!pair) return null;
   329	        return pair.item.dataset.companionDepth === '2' ? targetId : pair.item.dataset.companionParent || null;
   330	      };
   331	
   332	      const setActiveBranch = (sectionSlug: string | null) => {
   333	        items.forEach((item) => {
   334	          if (item.dataset.companionDepth !== '3') return;
   335	          item.classList.toggle('is-active-branch', item.dataset.companionParent === sectionSlug);
   336	        });
   337	      };
   338	
   339	      const firstH2 = pairs.find((pair) => pair.item.dataset.companionDepth === '2');
   340	      setActiveBranch(firstH2?.target.id ?? null);
   341	
   342	      let lastFitSignature = '';
   343	      const fitList = () => {
   344	        const laidOut = pairs.filter(({ item }) => item.dataset.companionDepth === '2' || item.classList.contains('is-active-branch'));
   345	        if (laidOut.length === 0) return;
   346	
   347	        if (allExpanded) {
   348	          if (lastFitSignature === 'expanded') return;
   349	          lastFitSignature = 'expanded';
   350	          laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
   351	          moreAbove?.setAttribute('hidden', '');
   352	          moreBelow?.setAttribute('hidden', '');
   353	          return;
   354	        }
   355	
   356	        const panelTop = outline.getBoundingClientRect().top;
   357	        const available = window.innerHeight - panelTop - 24;
   358	        const laidOutActiveIndex = Math.max(0, laidOut.findIndex(({ target }) => pairs[activeIndex]?.target === target));
   359	        const signature = `windowed:${available.toFixed(1)}:${laidOut.length}:${laidOutActiveIndex}`;
   360	        if (signature === lastFitSignature) return;
   361	        lastFitSignature = signature;
   362	
   363	        laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
   364	        moreAbove?.setAttribute('hidden', '');
   365	        moreBelow?.setAttribute('hidden', '');
   366	
   367	        const rowHeight = laidOut[0].link.getBoundingClientRect().height || 32;
   368	        const totalRowsHeight = laidOut.reduce((sum, { link }) => sum + link.getBoundingClientRect().height, 0);
   369	        const chromeHeight = Math.max(0, body.clientHeight - totalRowsHeight);
   370	        const budgetForRows = available - chromeHeight;
   371	        const maxVisible = Math.max(1, Math.min(NEARBY_MAX_VISIBLE, Math.floor(budgetForRows / rowHeight)));
   372	
   373	        const win = computeListWindow(laidOut.length, laidOutActiveIndex, maxVisible);
   374	        laidOut.forEach(({ item }, i) => {
   375	          item.classList.toggle('is-window-hidden', i < win.start || i > win.end);
   376	        });
   377	        moreAbove?.toggleAttribute('hidden', win.above === 0);
   378	        if (moreAbove) moreAbove.textContent = `+${win.above} more above`;
   379	        moreBelow?.toggleAttribute('hidden', win.below === 0);
   380	        if (moreBelow) moreBelow.textContent = `+${win.below} more below`;
   381	      };
   382	
   383	      let fitQueued = false;
   384	      const queueFit = () => {
   385	        if (fitQueued) return;
   386	        fitQueued = true;
   387	        requestAnimationFrame(() => {
   388	          fitQueued = false;
   389	          fitList();
   390	        });
   391	      };
   392	
   393	      const setActive = (id: string) => {
   394	        activeIndex = pairs.findIndex((pair) => pair.target.id === id);
   395	        pairs.forEach(({ item, link }, index) => {
   396	          if (index === activeIndex) {
   397	            link.setAttribute('aria-current', 'location');
   398	          } else {
   399	            link.removeAttribute('aria-current');
   400	          }
--- src/components/content/SectionMarker.astro
