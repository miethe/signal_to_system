     2	/**
     3	 * SectionMarker — static editorial furniture for article-level headings.
     4	 *
     5	 * MDX supplies its headings through PostLayout's slot, so this component
     6	 * enhances those rendered h2 elements once without attaching a scroll
     7	 * observer. P1 owns the active-section state; this shell deliberately only
     8	 * establishes the stable ordinal and reserved gutter.
     9	 */
    10	---
    11	
    12	<script>
    13	  const addSectionMarkers = () => {
    14	    const headings = document.querySelectorAll<HTMLHeadingElement>(
    15	      '.prose-custom > h2:not([data-section-marker-heading])',
    16	    );
    17	
    18	    headings.forEach((heading, index) => {
    19	      const section = document.createElement('section');
    20	      const gutter = document.createElement('div');
    21	      const ordinal = document.createElement('span');
    22	      const rule = document.createElement('span');
    23	
    24	      section.className = 'section-marker';
    25	      section.dataset.sectionMarker = '';
    26	      section.dataset.sectionOrdinal = String(index + 1);
    27	      gutter.className = 'section-marker__gutter';
    28	      gutter.setAttribute('aria-hidden', 'true');
    29	      ordinal.className = 'section-marker__ordinal';
    30	      ordinal.textContent = String(index + 1).padStart(2, '0');
    31	      rule.className = 'section-marker__rule';
    32	
    33	      gutter.append(ordinal, rule);
    34	      heading.dataset.sectionMarkerHeading = '';
    35	      heading.parentNode?.insertBefore(section, heading);
    36	      section.append(gutter, heading);
    37	    });
    38	  };
    39	
    40	  const setActiveSectionMarker = (sectionId: string | null) => {
    41	    document.querySelectorAll<HTMLElement>('[data-section-marker]').forEach((marker) => {
    42	      const heading = marker.querySelector<HTMLHeadingElement>('h2');
    43	      marker.classList.toggle('is-active', Boolean(sectionId) && heading?.id === sectionId);
    44	    });
    45	  };
    46	
    47	  addSectionMarkers();
    48	  document.addEventListener('astro:page-load', addSectionMarkers);
    49	  document.addEventListener('reading-section-change', ((event: CustomEvent<{ sectionId: string | null }>) => {
    50	    setActiveSectionMarker(event.detail.sectionId);
    51	  }) as EventListener);
    52	</script>
    53	
    54	<style>
    55	  :global(.section-marker) {
    56	    display: grid;
    57	    grid-template-columns: 3rem minmax(0, 1fr);
    58	    column-gap: 0.875rem;
    59	    align-items: start;
    60	    margin-top: 2.5rem;
    61	  }
    62	
    63	  :global(.section-marker__gutter) {
    64	    position: relative;
    65	    display: flex;
    66	    flex-direction: column;
    67	    align-items: center;
    68	    gap: 0.5rem;
    69	    padding-top: 0.15rem;
    70	  }
    71	
    72	  :global(.section-marker__ordinal) {
    73	    display: grid;
    74	    width: 2.2rem;
    75	    height: 1.75rem;
    76	    place-items: center;
    77	    border: 1px solid var(--border-strong);
    78	    border-radius: 0.2rem;
    79	    color: var(--text-tertiary);
    80	    font-family: var(--font-mono);
    81	    font-size: 0.6875rem;
    82	    font-weight: 700;
    83	    letter-spacing: 0.08em;
    84	    line-height: 1;
    85	  }
    86	
    87	  :global(.section-marker__rule) {
    88	    display: block;
    89	    width: 1px;
    90	    min-height: 2.2rem;
    91	    background: var(--border-strong);
    92	    transition: background-color 0.15s ease;
    93	  }
    94	
    95	  :global(.section-marker > h2) {
    96	    margin-top: 0;
    97	  }
    98	
    99	  :global(.section-marker.is-active .section-marker__rule) { background: var(--accent); }
   100	  :global(.section-marker.is-active .section-marker__ordinal) { border-color: var(--accent); color: var(--accent-text); }
   101	
   102	  @media (prefers-reduced-motion: reduce) {
   103	    :global(.section-marker__rule) { transition: none; }
   104	  }
   105	
   106	  @media (min-width: 768px) {
   107	    :global(.section-marker) {
   108	      width: calc(100% + 3.875rem);
   109	      margin-left: -3.875rem;
   110	    }
   111	  }
   112	</style>
