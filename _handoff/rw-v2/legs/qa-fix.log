     1	---
     2	/**
     3	 * FocusTemplates — mounts the inline `<template data-focus-view="...">`
     4	 * fragments a future `FocusHost` controller will clone into its dialog
     5	 * (reading-experience-v2 ARCHITECTURE.md §3). This component owns none of
     6	 * that controller's behavior — no `showModal()`, no history, no click
     7	 * hijacking (that is P0-C's job, gated on `DIRECTION.md`'s architecture
     8	 * decision) — it only renders the same `ThreadFocus`/`EvidenceFocus`/
     9	 * `FigureViewer` components the standalone routes use, each wrapped in an
    10	 * inert `<template>` so nothing inside is rendered, laid out, or
    11	 * fetched (a browser never fetches an `<img>` inside inactive template
    12	 * content) until some future script clones it.
    13	 *
    14	 * `standalone={false}` on every nested component swaps in the "Close"
    15	 * affordance those components reserve for an overlay context — inert
    16	 * today (no listener attaches to `data-focus-close` yet), but present so
    17	 * P0-C doesn't have to touch these three components again just to add
    18	 * the button.
    19	 *
    20	 * `PostLayout` mounts this once per post that has a thread; it is a
    21	 * no-op (renders nothing) for posts without one.
    22	 */
    23	import ThreadFocus from './ThreadFocus.astro';
    24	import EvidenceFocus from './EvidenceFocus.astro';
    25	import FigureViewer from './FigureViewer.astro';
    26	import { threads } from '../../data/threads';
    27	import { evidence } from '../../data/evidence';
    28	
    29	interface Props {
    30	  slug: string;
    31	}
    32	
    33	const { slug } = Astro.props;
    34	const thread = threads[slug];
    35	const beatIds = new Set(thread?.beats.map((beat) => beat.id) ?? []);
    36	const relatedRecords = thread
    37	  ? Object.values(evidence).filter((record) => record.relatedSceneIds.some((id) => beatIds.has(id)))
    38	  : [];
    39	---
    40	
    41	{
    42	  thread && (
    43	    <div hidden data-focus-templates aria-hidden="true">
    44	      {thread.beats.map((beat) => (
    45	        <template data-focus-view={`thread:${beat.id}`}>
    46	          <ThreadFocus thread={thread} beatId={beat.id} standalone={false} />
    47	        </template>
    48	      ))}
    49	
    50	      {thread.beats.map((beat) => (
    51	        <template data-focus-view={`figure:${beat.id}`}>
    52	          <FigureViewer thread={thread} beatId={beat.id} standalone={false} />
    53	        </template>
    54	      ))}
    55	
    56	      <template data-focus-view="evidence:all">
    57	        <EvidenceFocus records={relatedRecords} essaySlug={slug} standalone={false} />
    58	      </template>
    59	
    60	      {relatedRecords.map((record) => (
    61	        <template data-focus-view={`evidence:${record.id}`}>
    62	          <EvidenceFocus records={relatedRecords} selectedId={record.id} essaySlug={slug} standalone={false} />
    63	        </template>
    64	      ))}
    65	    </div>
    66	  )
    67	}

