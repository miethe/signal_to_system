   306	
   307	  const closeAll = (afterRestore?: () => void) => {
   308	    if (!dialogEl.open) {
   309	      afterRestore?.();
   310	      return;
   311	    }
   312	    saveCurrentEntryState();
   313	    let depth = 0;
   314	    let key = currentKey;
   315	    while (key && key !== rootKey) {
   316	      depth += 1;
   317	      key = entries.get(key)?.parentKey ?? null;
   318	    }
   319	    if (historyCapable && depth > 0 && key === rootKey && isOwnHistoryState(currentKey)) {
   320	      pendingAfterRestore = afterRestore ?? null;
   321	      history.go(-depth);
   322	      return;
   323	    }
   324	    restoreRoot(afterRestore);
   325	  };
   326	
   327	  const open = (kind: FocusKind, id: string, trigger: HTMLElement | null): boolean => {
   328	    const template = templateFor(kind, id);
   329	    if (!template) return false;
   330	
   331	    closePrivateFigureLightboxes();
   332	
   333	    const wasOpen = dialogEl.open;
   334	
   335	    if (!wasOpen) {
   336	      const candidateRootKey = generateKey();
   337	      if (!writeHistory('replaceState', stateFor(candidateRootKey), window.location.href)) return false;
   338	      origin = captureOrigin(trigger);
   339	      rootKey = candidateRootKey;
   340	      entries.clear();
   341	      entries.set(rootKey, { kind: 'root', id: '', parentKey: null, scrollTop: 0, focusTargetId: null });
   342	      currentKey = rootKey;
   343	    } else {
   344	      saveCurrentEntryState();
   345	    }
   346	
   347	    const current = currentKey ? entries.get(currentKey) ?? null : null;
   348	
   349	    // Clicking a link back to this entry's own parent (e.g. FigureViewer's
   350	    // "Back to thread focus" reached via Thread → Figure) is a pop, not a
   351	    // fresh push — the destination already exists one level up.
   352	    if (current?.parentKey) {
   353	      const parent = entries.get(current.parentKey);
   354	      if (parent && parent.kind === kind && parent.id === id) {
   355	        closeOne();
   356	        return true;
   357	      }
   358	    }
   359	
   360	    const currentKind: EntryKind | undefined = current?.kind;
   361	    const isSwap = currentKind !== undefined && currentKind !== 'root' && currentKind === kind;
   362	
   363	    if (isSwap && current && currentKey) {
   364	      if (!writeHistory('replaceState', stateFor(currentKey), localHref(kind, id))) {
   365	        if (!wasOpen) restoreRoot();
   366	        return false;
   367	      }
   368	      current.kind = kind;
   369	      current.id = id;
   370	      current.scrollTop = 0;
   371	      current.focusTargetId = null;
   372	      if (!wasOpen) lockScroll();
   373	      renderEntry(current, false);
   374	      return true;
   375	    }
   376	
   377	    const key = generateKey();
   378	    const parentKey = currentKey;
   379	    if (!writeHistory('pushState', stateFor(key), localHref(kind, id))) {
   380	      if (!wasOpen) restoreRoot();
   381	      return false;
   382	    }
   383	    const entry: FocusEntry = { kind, id, parentKey, scrollTop: 0, focusTargetId: null };
   384	    entries.set(key, entry);
   385	    currentKey = key;
   386	    if (!wasOpen) lockScroll();
   387	    renderEntry(entry, false);
   388	    return true;
   389	  };
   390	
   391	  window.addEventListener('popstate', (event) => {
   392	    const state = (event.state as { rwFocus?: { doc: string; key: string } } | null)?.rwFocus;
   393	
   394	    if (!state || state.doc !== docToken) {
   395	      if (dialogEl.open) restoreRoot();
   396	      return;
   397	    }
   398	
   399	    if (state.key === rootKey || !entries.has(state.key)) {
   400	      const cb = pendingAfterRestore;
   401	      pendingAfterRestore = null;
   402	      restoreRoot(cb ?? undefined);
   403	      return;
   404	    }
   405	
   406	    currentKey = state.key;
   407	    const entry = entries.get(state.key) as FocusEntry;
   408	    if (!dialogEl.open) {
   409	      if (!origin) return; // Nothing sane to reopen into without a captured origin.
   410	      lockScroll();
   411	    }
   412	    renderEntry(entry, true);
   413	  });
   414	
   415	  dialogEl.addEventListener('cancel', (event) => {
   416	    event.preventDefault();
   417	    closeOne();
   418	  });
   419	
   420	  document.addEventListener('click', (event) => {
   421	    const targetEl = event.target as Element | null;
   422	    if (!targetEl) return;
   423	
   424	    const closeButton = targetEl.closest<HTMLButtonElement>('[data-focus-close]');
   425	    if (closeButton) {
   426	      event.preventDefault();
   427	      closeOne();
   428	      return;
   429	    }
   430	
   431	    const anchor = targetEl.closest<HTMLAnchorElement>('a[href]');
   432	    if (!anchor) return;
   433	    if (anchor.hasAttribute('data-focus-copy-link')) return;
   434	    if (anchor.target && anchor.target !== '_self') return;
   435	    if (event.defaultPrevented) return;
   436	    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
   437	
   438	    let url: URL;
   439	    try {
   440	      url = new URL(anchor.href, window.location.href);
   441	    } catch {
   442	      return;
   443	    }
   444	    if (url.origin !== window.location.origin) return;
   445	
   446	    const action = parseFocusAction(url.pathname, url.hash);
   447	    if (!action) return;
   448	
   449	    if (action.type === 'back') {
   450	      if (!dialogEl.open) return;
   451	      event.preventDefault();
   452	      closeAll();
   453	      return;
   454	    }
   455	
   456	    if (action.type === 'jump') {
   457	      if (!dialogEl.open) return;
   458	      event.preventDefault();
   459	      closeAll(() => jump(action.anchorId));
   460	      return;
   461	    }
   462	
   463	    const opened = open(action.kind, action.id, anchor);
   464	    if (opened) event.preventDefault();
   465	  });
   466	}
     1	---
     2	/**
     3	 * ThreadFocus — the shared Thread Focus renderer (reading-experience-v2
     4	 * DIRECTION.md V3/V4, ARCHITECTURE.md §4, spec §7). Backs BOTH the
     5	 * standalone `/essays/<slug>/thread/<beat>/` route and the in-place
     6	 * overlay's `<template data-focus-view="thread:<beat>">` fragment —
     7	 * `standalone` only toggles the few actions that make sense outside a
     8	 * dialog (no "Close" outside `standalone={false}`); every other prop
     9	 * comes straight from the beat record in `threads.ts`, so inline and
    10	 * focus views never diverge into two hand-written explanations (V3).
    11	 *
    12	 * P0-C is what will later clone this component's `<template>` copy into
    13	 * `FocusHost`'s dialog and wire "Back to essay" / "Read this scene in the
    14	 * essay" / prev-next to replace-in-place rather than navigate — for this
    15	 * leg every action below is a real link, so the standalone route and the
    16	 * eventual overlay share one navigable, no-JS-safe destination for each.
    17	 */
    18	import Figure from './Figure.astro';
    19	import RunningExampleCard from './RunningExampleCard.astro';
    20	import ThreadOverview from './ThreadOverview.astro';
    21	import type { Thread } from '../../data/threads';
    22	
    23	interface Props {
    24	  thread: Thread;
    25	  beatId: string;
    26	  standalone?: boolean;
    27	}
    28	
    29	const { thread, beatId, standalone = true } = Astro.props;
    30	const beat = thread.beats.find((candidate) => candidate.id === beatId);
    31	const beatIndex = beat ? thread.beats.findIndex((candidate) => candidate.id === beatId) : -1;
    32	const prevBeat = beatIndex > 0 ? thread.beats[beatIndex - 1] : null;
    33	const nextBeat = beatIndex > -1 && beatIndex < thread.beats.length - 1 ? thread.beats[beatIndex + 1] : null;
    34	
    35	const kindLabel: Record<string, string> = {
    36	  historical: 'Historical account',
    37	  conceptual: 'Conceptual branch',
    38	  mechanism: 'Mechanism',
    39	  proposed: 'Proposed',
    40	};
    41	---
    42	
    43	{
    44	  beat && (
    45	    <div class="thread-focus" data-focus-kind="thread" data-focus-key={beat.id}>
    46	      <div class="thread-focus__grid">
    47	        <div class="thread-focus__main">
    48	          <div class="thread-focus__actions">
    49	            <a class="thread-focus__action" href={`/essays/${thread.slug}/`}>
    50	              &larr; Back to essay
    51	            </a>
    52	            <span class="thread-focus__action-label font-mono">Thread focus</span>
    53	            <a
    54	              class="thread-focus__action thread-focus__action--secondary"
    55	              href={`/essays/${thread.slug}/#thread-${beat.id}`}
    56	            >
    57	              Read this scene in the essay
    58	            </a>
    59	            {!standalone && (
    60	              <button type="button" class="thread-focus__action thread-focus__action--close" data-focus-close>
    61	                Close
    62	              </button>
    63	            )}
    64	          </div>
    65	
    66	          <p class="thread-focus__eyebrow font-mono">
    67	            <span>
    68	              {beat.n}/{thread.beats.length}
    69	            </span>
    70	            <span aria-hidden="true">&middot;</span>
    71	            <span>{kindLabel[beat.kind] ?? beat.kind}</span>
    72	          </p>
    73	          <h2 class="thread-focus__title font-serif">{beat.label}</h2>
    74	          <p class="thread-focus__recap">{beat.recap}</p>
    75	
    76	          <Figure
    77	            src={beat.image.src}
    78	            alt={beat.image.alt}
    79	            caption={beat.image.caption}
    80	            number={String(beat.n).padStart(2, '0')}
    81	            longDescription={beat.longDescription}
    82	            variant="wide"
    83	            expandable={false}
    84	          />
    85	          <a class="thread-focus__figure-link" href={`/essays/${thread.slug}/figure/${beat.id}/`}>
    86	            View this figure in the Figure Viewer &rarr;
    87	          </a>
    88	
    89	          <div class="thread-focus__boundary">
    90	            <div>
    91	              <p class="thread-focus__boundary-label font-mono">What this establishes</p>
    92	              <p>{beat.establishes}</p>
    93	            </div>
    94	            <div>
    95	              <p class="thread-focus__boundary-label font-mono">What it does not establish</p>
    96	              <p>{beat.doesNotEstablish}</p>
    97	            </div>
    98	          </div>
    99	
   100	          <nav class="thread-focus__prevnext" aria-label="Adjacent thread beats">
   101	            {prevBeat ? (
   102	              <a href={`/essays/${thread.slug}/thread/${prevBeat.id}/`}>
   103	                &larr; {prevBeat.label}
   104	              </a>
   105	            ) : (
   106	              <span />
   107	            )}
   108	            {nextBeat && (
   109	              <a href={`/essays/${thread.slug}/thread/${nextBeat.id}/`}>
   110	                {nextBeat.label} &rarr;
   111	              </a>
   112	            )}
   113	          </nav>
   114	        </div>
   115	
   116	        <aside class="thread-focus__rail">
   117	          <RunningExampleCard thread={thread} />
   118	          <ThreadOverview thread={thread} currentBeatId={beat.id} />
   119	        </aside>
   120	      </div>
   121	    </div>
   122	  )
   123	}
   124	
   125	<style>
   126	  .thread-focus {
   127	    max-width: 100%;
   128	  }
   129	
   130	  .thread-focus__grid {
   131	    display: grid;
   132	    gap: 2rem;
   133	    grid-template-columns: minmax(0, 1fr);
   134	  }
   135	
   136	  @media (min-width: 960px) {
   137	    .thread-focus__grid {
   138	      grid-template-columns: minmax(0, 1fr) 18rem;
   139	    }
   140	  }
