     1	---
     2	/**
     3	 * EvidenceFocus — the shared Evidence Focus renderer (DIRECTION.md V3/V4,
     4	 * ARCHITECTURE.md §4, spec §8). Backs BOTH `/essays/<slug>/evidence/`
     5	 * (the essay-scoped index) and the flat, site-wide `/evidence/<record>/`
     6	 * route, plus the in-place overlay's `<template>` fragment — same
     7	 * component, same field set from `evidence.ts`'s `EvidenceRecord`, never
     8	 * a second hand-written summary.
     9	 *
    10	 * `records` is always the full evidence set (so the rail's `ReceiptIndex`
    11	 * can navigate anywhere); `selectedId` narrows the main pane to one
    12	 * record's full detail. Omitting it renders the full list.
    13	 */
    14	import EvidenceGuide from './EvidenceGuide.astro';
    15	import ReceiptIndex from './ReceiptIndex.astro';
    16	import ClaimBadge from './ClaimBadge.astro';
    17	import type { EvidenceRecord } from '../../data/evidence';
    18	
    19	interface Props {
    20	  records: EvidenceRecord[];
    21	  selectedId?: string;
    22	  /** Real anchor text for a "Read in essay" link, when a related essay exists. */
    23	  essaySlug?: string;
    24	  standalone?: boolean;
    25	}
    26	
    27	const { records, selectedId, essaySlug, standalone = true } = Astro.props;
    28	// The essay index is a receipt surface, not a bare directory. When no record
    29	// is named in the route, introduce the first related receipt in full and let
    30	// the rail provide the rest of the index.
    31	const selected = selectedId ? records.find((record) => record.id === selectedId) : records[0];
    32	const selectedRecordId = selected?.id;
    33	const receiptDate = selected?.recordedDate ?? selected?.eventDate ?? selected?.verifiedAt ?? null;
    34	const claimBadgeKind = selected
    35	  ? ({
    36	      observed: 'observed',
    37	      measured: 'measured',
    38	      proposed: 'proposed',
    39	      'externally-reported': 'external',
    40	      illustrative: 'hypothesis',
    41	    }[selected.evidenceClass] as 'observed' | 'measured' | 'proposed' | 'external' | 'hypothesis')
    42	  : undefined;
    43	
    44	const formatDate = (value: string | null) => value ?? 'Not stated';
    45	---
    46	
    47	<div class="evidence-focus" data-focus-kind="evidence" data-focus-key={selectedId ?? 'all'}>
    48	  <div class="evidence-focus__grid">
    49	    <div class="evidence-focus__main">
    50	      <div class="evidence-focus__actions">
    51	        {essaySlug && (
    52	          <a class="evidence-focus__action" href={`/essays/${essaySlug}/`}>
    53	            &larr; Back to essay
    54	          </a>
    55	        )}
    56	        <span class="evidence-focus__action-label font-mono">Evidence focus</span>
    57	        {essaySlug && (
    58	          <a
    59	            class="evidence-focus__action evidence-focus__action--secondary"
    60	            href={`/essays/${essaySlug}/evidence/`}
    61	            target="_blank"
    62	            rel="noopener noreferrer"
    63	          >
    64	            Open in new tab
    65	          </a>
    66	        )}
    67	        {!standalone && (
    68	          <button type="button" class="evidence-focus__action evidence-focus__action--close" data-focus-close>
    69	            Close
    70	          </button>
    71	        )}
    72	      </div>
    73	
    74	      <h1 class="evidence-focus__page-title font-serif">
    75	        {selectedId && selected ? selected.title : 'Receipts behind the argument'}
    76	      </h1>
    77	
    78	      {selected ? (
    79	        <article class="evidence-focus__record">
    80	          <p class="evidence-focus__eyebrow font-mono">
    81	            {claimBadgeKind && <ClaimBadge kind={claimBadgeKind} />}
    82	            <span>{selected.evidenceClass}</span>
    83	          </p>
    84	          {!selectedId && <h2 class="evidence-focus__title font-serif">{selected.title}</h2>}
    85	
    86	          <p class="evidence-focus__receipt-date font-mono">
    87	            Receipt date: {formatDate(receiptDate)}
    88	          </p>
    89	
    90	          <dl class="evidence-focus__facts">
    91	            <div>
    92	              <dt>Capture type</dt>
    93	              <dd>{selected.captureType}</dd>
    94	            </div>
    95	            <div>
    96	              <dt>Event date</dt>
    97	              <dd>{formatDate(selected.eventDate)}</dd>
    98	            </div>
    99	            <div>
   100	              <dt>Recorded date</dt>
   101	              <dd>{formatDate(selected.recordedDate)}</dd>
   102	            </div>
   103	            <div>
   104	              <dt>Verified at</dt>
   105	              <dd>{formatDate(selected.verifiedAt)}</dd>
   106	            </div>
   107	            <div>
   108	              <dt>Source</dt>
   109	              <dd>{selected.sourceUrl ?? 'Not stated'}</dd>
   110	            </div>
   111	            <div>
   112	              <dt>Source revision</dt>
   113	              <dd>{selected.sourceRevision ?? 'Not stated'}</dd>
   114	            </div>
   115	            <div>
   116	              <dt>Publicability</dt>
   117	              <dd>{selected.publicability}</dd>
   118	            </div>
   119	          </dl>
   120	
   121	          <div class="evidence-focus__claim-split">
   122	            <div class="evidence-focus__section">
   123	              <p class="evidence-focus__section-label font-mono">What this supports</p>
   124	              <ul>
   125	                {selected.supports.map((line) => <li>{line}</li>)}
   126	              </ul>
   127	            </div>
   128	
   129	            <div class="evidence-focus__section">
   130	              <p class="evidence-focus__section-label font-mono">Limits</p>
   131	              <ul>
   132	                {selected.limitations.map((line) => <li>{line}</li>)}
   133	              </ul>
   134	            </div>
   135	          </div>
   136	
   137	          {selected.publicCapturePath ? (
   138	            <div class="evidence-focus__section">
   139	              <p class="evidence-focus__section-label font-mono">Capture</p>
   140	              <p class="evidence-focus__capture-path">{selected.publicCapturePath}</p>
   141	            </div>
   142	          ) : (
   143	            <p class="evidence-focus__no-capture">
   144	              No standalone capture asset is published for this record; its capture type is{' '}
   145	              <strong>{selected.captureType}</strong>.
   146	            </p>
   147	          )}
   148	        </article>
   149	      ) : <p class="evidence-focus__intro">No public receipts are available for this essay.</p>}
   150	    </div>
   151	
   152	    <aside class="evidence-focus__rail">
   153	      <EvidenceGuide />
   154	      <ReceiptIndex records={records} currentId={selectedRecordId} />
   155	    </aside>
   156	  </div>
   157	</div>
