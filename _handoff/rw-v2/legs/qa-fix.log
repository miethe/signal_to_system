    43	  /** A stable fallback focus target near `trigger`, in case it's gone by the time we restore. */
    44	  headingId: string | null;
    45	  anchorId: string | null;
    46	  offsetWithinAnchor: number;
    47	}
    48	
    49	type FocusAction =
    50	  | { type: 'open'; kind: FocusKind; id: string }
    51	  | { type: 'back' }
    52	  | { type: 'jump'; anchorId: string };
    53	
    54	const THREAD_RE = /^\/essays\/([^/]+)\/thread\/([^/]+)\/?$/;
    55	const EVIDENCE_INDEX_RE = /^\/essays\/([^/]+)\/evidence\/?$/;
    56	const EVIDENCE_RECORD_RE = /^\/evidence\/([^/]+)\/?$/;
    57	const FIGURE_RE = /^\/essays\/([^/]+)\/figure\/([^/]+)\/?$/;
    58	const ESSAY_ROOT_RE = /^\/essays\/([^/]+)\/?$/;
    59	
    60	/**
    61	 * Reads the clicked link's own URL and returns what it means to FocusHost,
    62	 * or `null` if it's none of its concern (an ordinary in-page anchor, an
    63	 * external link, a route it doesn't own). Distinguishes "Back to essay"
    64	 * from "Read this scene in the essay" purely by hash: the former is the
    65	 * bare essay URL, the latter carries `#thread-<beatId>` — matching the two
    66	 * links' actual, distinct hrefs (`ThreadFocus.astro`/`EvidenceFocus.astro`
    67	 * write them differently on purpose).
    68	 */
    69	function parseFocusAction(pathname: string, hash: string): FocusAction | null {
    70	  let match = THREAD_RE.exec(pathname);
    71	  if (match) return { type: 'open', kind: 'thread', id: match[2] };
    72	
    73	  match = FIGURE_RE.exec(pathname);
    74	  if (match) return { type: 'open', kind: 'figure', id: match[2] };
    75	
    76	  match = EVIDENCE_INDEX_RE.exec(pathname);
    77	  if (match) return { type: 'open', kind: 'evidence', id: 'all' };
    78	
    79	  match = EVIDENCE_RECORD_RE.exec(pathname);
    80	  if (match) return { type: 'open', kind: 'evidence', id: match[1] };
    81	
    82	  match = ESSAY_ROOT_RE.exec(pathname);
    83	  if (match) {
    84	    const anchorId = hash.replace(/^#/, '');
    85	    if (anchorId.startsWith('thread-')) return { type: 'jump', anchorId };
    86	    if (!hash) return { type: 'back' };
    87	  }
    88	
    89	  return null;
    90	}
    91	
    92	function reduceMotion(): boolean {
    93	  return (
    94	    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    95	    document.documentElement.classList.contains('perf-lite')
    96	  );
    97	}
    98	
    99	export function initFocusHost(): void {
   100	  const dialogEl = document.querySelector<HTMLDialogElement>('[data-focus-dialog]');
   101	  if (!dialogEl || typeof dialogEl.showModal !== 'function') return;
   102	  if (dialogEl.dataset.focusHostReady === 'true') return;
   103	  dialogEl.dataset.focusHostReady = 'true';
   104	
   105	  const essaySlug = dialogEl.dataset.essaySlug ?? '';
   106	  const docToken = Math.random().toString(36).slice(2);
   107	
   108	  const entries = new Map<string, FocusEntry>();
   109	  let seq = 0;
   110	  let rootKey: string | null = null;
   111	  let currentKey: string | null = null;
   112	  let origin: RootSnapshot | null = null;
   113	  let historyCapable = true;
   114	  let pendingAfterRestore: (() => void) | null = null;
   115	  let previousBodyStyle: string | null = null;
   116	
   117	  const generateKey = (): string => {
   118	    seq += 1;
   119	    return `focus-${seq}`;
   120	  };
   121	
   122	  const stateFor = (key: string): Record<string, unknown> => ({
   123	    ...((history.state as Record<string, unknown> | null) ?? {}),
   124	    rwFocus: { doc: docToken, key },
   125	  });
   126	
   127	  const writeHistory = (method: 'pushState' | 'replaceState', state: unknown, url: string): boolean => {
   128	    try {
   129	      history[method](state, '', url);
   130	      return true;
   131	    } catch {
   132	      historyCapable = false;
   133	      return false;
   134	    }
   135	  };
   136	
   137	  const isOwnHistoryState = (key: string | null): boolean => {
   138	    const state = history.state as { rwFocus?: { doc: string; key: string } } | null;
   139	    return Boolean(key) && state?.rwFocus?.doc === docToken && state?.rwFocus?.key === key;
   140	  };
   141	
   142	  const localHref = (kind: FocusKind, id: string): string => {
   143	    switch (kind) {
   144	      case 'thread':
   145	        return `/essays/${essaySlug}/thread/${id}/`;
   146	      case 'figure':
   147	        return `/essays/${essaySlug}/figure/${id}/`;
   148	      case 'evidence':
   149	        return id === 'all' ? `/essays/${essaySlug}/evidence/` : `/evidence/${id}/`;
   150	    }
   151	  };
   152	
   153	  const templateFor = (kind: EntryKind, id: string): HTMLTemplateElement | null => {
   154	    if (kind === 'root') return null;
   155	    const safeId = id.replace(/"/g, '\\"');
   156	    return document.querySelector<HTMLTemplateElement>(
   157	      `[data-focus-templates] template[data-focus-view="${kind}:${safeId}"]`,
   158	    );
   159	  };
   160	
   161	  const closePrivateFigureLightboxes = () => {
   162	    // Hard invariant (ARCHITECTURE.md §3 risk 3): Figure.astro's own private
   163	    // lightbox and this shared dialog must never both be open at once.
   164	    document.querySelectorAll<HTMLDialogElement>('[data-figure-dialog][open]').forEach((lightbox) => {
   165	      lightbox.close();
   166	    });
   167	  };
   168	
   169	  const lockScroll = () => {
   170	    const y = window.scrollY;
   171	    previousBodyStyle = document.body.getAttribute('style');
   172	    document.body.style.position = 'fixed';
   173	    document.body.style.top = `-${y}px`;
   174	    document.body.style.left = '0';
   175	    document.body.style.right = '0';
   176	    document.body.style.width = '100%';
   177	  };
   178	
   179	  const unlockScroll = () => {
   180	    if (previousBodyStyle === null) {
   181	      document.body.removeAttribute('style');
   182	    } else {
   183	      document.body.setAttribute('style', previousBodyStyle);
   184	    }
   185	    previousBodyStyle = null;
   186	  };
   187	
   188	  const captureOrigin = (trigger: HTMLElement | null): RootSnapshot => {
   189	    const anchors = Array.from(document.querySelectorAll<HTMLElement>('.section-marker > h2, .thread-scene'));
   190	    const anchor = anchors.filter((candidate) => candidate.getBoundingClientRect().top <= 96).at(-1) ?? anchors[0] ?? null;
   191	    return { x: window.scrollX, y: window.scrollY, trigger, headingId: trigger?.closest('section')?.querySelector('h2, h3')?.id ?? null, anchorId: anchor?.id ?? null, offsetWithinAnchor: anchor ? window.scrollY - (anchor.getBoundingClientRect().top + window.scrollY) : 0 };
   192	  };
   193	
   194	  const saveCurrentEntryState = () => {
   195	    if (!currentKey) return;
   196	    const entry = entries.get(currentKey);
   197	    if (!entry) return;
   198	    entry.scrollTop = dialogEl.scrollTop;
   199	    const active = document.activeElement;
   200	    if (active instanceof HTMLElement && dialogEl.contains(active)) {
   201	      const token = active.dataset.focusToken ?? `ft-${++seq}`;
   202	      active.dataset.focusToken = token;
   203	      entry.focusTargetId = token;
   204	    } else {
   205	      entry.focusTargetId = null;
   206	    }
   207	  };
   208	
   209	  const focusEntryTitle = (entry: FocusEntry, isRestore: boolean) => {
   210	    requestAnimationFrame(() => {
   211	      // The dialog's accessible name always comes from the view's own
   212	      // title, regardless of what was focused when the entry was saved.
   213	      const title = dialogEl.querySelector<HTMLElement>('h2, h3');
   214	      if (title) {
   215	        if (!title.id) title.id = `focus-host-title-${++seq}`;
   216	        dialogEl.setAttribute('aria-labelledby', title.id);
   217	      } else {
   218	        dialogEl.removeAttribute('aria-labelledby');
   219	      }
   220	
   221	      // Initial focus target: the element that had focus when this entry
   222	      // was last left (restore), else the title itself (fresh open) — never
   223	      // a giant aria-describedby wrapper.
   224	      let target: HTMLElement | null = null;
   225	      if (isRestore && entry.focusTargetId) {
   226	        target = dialogEl.querySelector<HTMLElement>(`[data-focus-token="${entry.focusTargetId}"]`);
   227	      }
   228	      if (!target) target = title;
   229	      if (target) {
   230	        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
   231	        target.focus({ preventScroll: true });
   232	      }
   233	    });
   234	  };
   235	
   236	  const renderEntry = (entry: FocusEntry, isRestore: boolean) => {
   237	    const template = templateFor(entry.kind, entry.id);
   238	    if (!template) return;
   239	    dialogEl.replaceChildren(template.content.cloneNode(true));
   240	    if (!dialogEl.open) dialogEl.showModal();
   241	    dialogEl.scrollTop = isRestore ? entry.scrollTop : 0;
   242	    focusEntryTitle(entry, isRestore);
   243	  };
   244	
   245	  const restoreFocusToOrigin = (snapshot: RootSnapshot | null) => {
   246	    if (snapshot?.trigger?.isConnected) {
   247	      snapshot.trigger.focus({ preventScroll: true });
   248	      return;
   249	    }
   250	    const fallback =
   251	      (snapshot?.headingId ? document.getElementById(snapshot.headingId) : null) ??
   252	      document.querySelector<HTMLElement>('article h1') ??
   253	      document.querySelector<HTMLElement>('h1');
   254	    if (fallback) {
   255	      if (!fallback.hasAttribute('tabindex')) fallback.setAttribute('tabindex', '-1');
   256	      fallback.focus({ preventScroll: true });
   257	    }
   258	  };
   259	
   260	  const restoreRoot = (afterRestore?: () => void) => {
   261	    if (dialogEl.open) dialogEl.close();
   262	    unlockScroll();
   263	    const snapshot = origin;
   264	    if (snapshot) {
   265	      const anchor = snapshot.anchorId ? document.getElementById(snapshot.anchorId) : null;
   266	      const y = anchor ? anchor.getBoundingClientRect().top + window.scrollY + snapshot.offsetWithinAnchor : snapshot.y;
   267	      window.scrollTo(snapshot.x, Math.max(0, Math.min(y, document.documentElement.scrollHeight - window.innerHeight)));
   268	    }
   269	    entries.clear();
   270	    currentKey = null;
   271	    rootKey = null;
   272	    requestAnimationFrame(() => {
   273	      if (afterRestore) afterRestore();
   274	      else restoreFocusToOrigin(snapshot);
   275	    });
   276	  };
   277	
   278	  const jump = (anchorId: string) => {
   279	    const target = document.getElementById(anchorId);
   280	    if (!target) return;
   281	    writeHistory('replaceState', history.state, `#${anchorId}`);
   282	    target.scrollIntoView({ block: 'start', behavior: reduceMotion() ? 'auto' : 'smooth' });
   283	    const heading = target.querySelector<HTMLElement>('h2, h3') ?? target;
   284	    requestAnimationFrame(() => {
   285	      if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1');
   286	      heading.focus({ preventScroll: true });
   287	    });
   288	  };
   289	
   290	  const closeOne = () => {
   291	    if (!dialogEl.open) return;
   292	    saveCurrentEntryState();
   293	    if (historyCapable && isOwnHistoryState(currentKey)) {
   294	      history.back();
   295	      return;
   296	    }
   297	    const current = currentKey ? entries.get(currentKey) : null;
   298	    const parentKey = current?.parentKey ?? null;
   299	    if (parentKey && parentKey !== rootKey && entries.has(parentKey)) {
   300	      currentKey = parentKey;
   301	      renderEntry(entries.get(parentKey) as FocusEntry, true);
   302	    } else {
   303	      restoreRoot();
   304	    }
   305	  };
   306	
   307	  const closeAll = (afterRestore?: () => void) => {
   308	    if (!dialogEl.open) {
   309	      afterRestore?.();
   310	      return;
   311	    }
   312	    saveCurrentEntryState();
   313	    let depth = 0;
   314	    let key = currentKey;
   315	    while (key && key !== rootKey) {
   316	      depth += 1;
   317	      key = entries.get(key)?.parentKey ?? null;
   318	    }
   319	    if (historyCapable && depth > 0 && key === rootKey && isOwnHistoryState(currentKey)) {
   320	      pendingAfterRestore = afterRestore ?? null;
   321	      history.go(-depth);
   322	      return;
   323	    }
   324	    restoreRoot(afterRestore);
   325	  };
   326	
   327	  const open = (kind: FocusKind, id: string, trigger: HTMLElement | null): boolean => {
   328	    const template = templateFor(kind, id);
   329	    if (!template) return false;
   330	
   331	    closePrivateFigureLightboxes();
   332	
   333	    const wasOpen = dialogEl.open;
   334	
   335	    if (!wasOpen) {
   336	      const candidateRootKey = generateKey();
   337	      if (!writeHistory('replaceState', stateFor(candidateRootKey), window.location.href)) return false;
   338	      origin = captureOrigin(trigger);
   339	      rootKey = candidateRootKey;
   340	      entries.clear();
   341	      entries.set(rootKey, { kind: 'root', id: '', parentKey: null, scrollTop: 0, focusTargetId: null });
   342	      currentKey = rootKey;
   343	    } else {
   344	      saveCurrentEntryState();
   345	    }
   346	
   347	    const current = currentKey ? entries.get(currentKey) ?? null : null;
   348	
   349	    // Clicking a link back to this entry's own parent (e.g. FigureViewer's
   350	    // "Back to thread focus" reached via Thread → Figure) is a pop, not a
   351	    // fresh push — the destination already exists one level up.
   352	    if (current?.parentKey) {
   353	      const parent = entries.get(current.parentKey);
   354	      if (parent && parent.kind === kind && parent.id === id) {
   355	        closeOne();
   356	        return true;
   357	      }
   358	    }
   359	
   360	    const currentKind: EntryKind | undefined = current?.kind;
   361	    const isSwap = currentKind !== undefined && currentKind !== 'root' && currentKind === kind;
   362	
   363	    if (isSwap && current && currentKey) {
   364	      if (!writeHistory('replaceState', stateFor(currentKey), localHref(kind, id))) {
   365	        if (!wasOpen) restoreRoot();
   366	        return false;
   367	      }
   368	      current.kind = kind;
   369	      current.id = id;
   370	      current.scrollTop = 0;
   371	      current.focusTargetId = null;
   372	      if (!wasOpen) lockScroll();
   373	      renderEntry(current, false);
   374	      return true;
   375	    }
   376	
   377	    const key = generateKey();
   378	    const parentKey = currentKey;
   379	    if (!writeHistory('pushState', stateFor(key), localHref(kind, id))) {
   380	      if (!wasOpen) restoreRoot();
   381	      return false;
   382	    }
   383	    const entry: FocusEntry = { kind, id, parentKey, scrollTop: 0, focusTargetId: null };
   384	    entries.set(key, entry);
   385	    currentKey = key;
   386	    if (!wasOpen) lockScroll();
   387	    renderEntry(entry, false);
   388	    return true;
   389	  };
   390	
   391	  window.addEventListener('popstate', (event) => {
   392	    const state = (event.state as { rwFocus?: { doc: string; key: string } } | null)?.rwFocus;
   393	
   394	    if (!state || state.doc !== docToken) {
   395	      if (dialogEl.open) restoreRoot();
   396	      return;
   397	    }
   398	
   399	    if (state.key === rootKey || !entries.has(state.key)) {
   400	      const cb = pendingAfterRestore;
   401	      pendingAfterRestore = null;
   402	      restoreRoot(cb ?? undefined);
   403	      return;
   404	    }
   405	
   406	    currentKey = state.key;
   407	    const entry = entries.get(state.key) as FocusEntry;
   408	    if (!dialogEl.open) {
   409	      if (!origin) return; // Nothing sane to reopen into without a captured origin.
   410	      lockScroll();
   411	    }
   412	    renderEntry(entry, true);
   413	  });
   414	
   415	  dialogEl.addEventListener('cancel', (event) => {
   416	    event.preventDefault();
   417	    closeOne();
   418	  });
   419	
   420	  document.addEventListener('click', (event) => {
   421	    const targetEl = event.target as Element | null;
   422	    if (!targetEl) return;
   423	
   424	    const closeButton = targetEl.closest<HTMLButtonElement>('[data-focus-close]');
   425	    if (closeButton) {
   426	      event.preventDefault();
   427	      closeOne();
   428	      return;
   429	    }
   430	
   431	    const anchor = targetEl.closest<HTMLAnchorElement>('a[href]');
   432	    if (!anchor) return;
   433	    if (anchor.hasAttribute('data-focus-copy-link')) return;
   434	    if (anchor.target && anchor.target !== '_self') return;
   435	    if (event.defaultPrevented) return;
   436	    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
   437	
   438	    let url: URL;
   439	    try {
   440	      url = new URL(anchor.href, window.location.href);
   441	    } catch {
   442	      return;
   443	    }
   444	    if (url.origin !== window.location.origin) return;
   445	
   446	    const action = parseFocusAction(url.pathname, url.hash);
   447	    if (!action) return;
   448	
   449	    if (action.type === 'back') {
   450	      if (!dialogEl.open) return;
   451	      event.preventDefault();
   452	      closeAll();
   453	      return;
   454	    }
   455	
   456	    if (action.type === 'jump') {
   457	      if (!dialogEl.open) return;
   458	      event.preventDefault();
   459	      closeAll(() => jump(action.anchorId));
   460	      return;
     1	---
     2	/**
     3	 * FocusHost — the reading-experience-v2 P0-C inspection controller
     4	 * (ARCHITECTURE.md §3, DIRECTION.md V4). Mounts the one native <dialog>
     5	 * every "Explore thread" / evidence / figure trigger on the essay page
     6	 * opens into, by cloning the matching `FocusTemplates.astro` fragment.
     7	 * The behavior (open/close/history/return semantics) lives in
     8	 * `src/lib/focus-host.ts` — this component only renders the dialog shell
     9	 * and starts the controller.
    10	 *
    11	 * Mounted once by `PostLayout`, immediately after `FocusTemplates` (same
    12	 * `slug`, so `data-essay-slug` always matches the templates it clones).
    13	 * Deliberately NOT mounted on the four standalone focus routes
    14	 * (`/essays/<slug>/thread/<beat>/` etc.): those pages render no
    15	 * `<template>` fragments of their own today, so a host there would have
    16	 * nothing to clone. If a later P0-B/P1 pass adds child templates to those
    17	 * routes (ARCHITECTURE.md §3's parenthetical about "a direct arrival...
    18	 * still has a working host"), mounting this component there too is a
    19	 * one-line addition — the controller itself already degrades safely to
    20	 * an ordinary navigation whenever `templateFor()` finds nothing to clone.
    21	 *
    22	 * Owns history directly (`pushState`/`replaceState`/one `popstate`
    23	 * listener) rather than integrating with Astro ClientRouter — see
    24	 * ARCHITECTURE.md §1's correction to its own brief: ClientRouter is not
    25	 * wired anywhere in this codebase today.
    26	 */
    27	import { threads } from '../../data/threads';
    28	
    29	interface Props {
    30	  slug: string;
    31	}
    32	
    33	const { slug } = Astro.props;
    34	const thread = threads[slug];
    35	---
    36	
    37	{
    38	  thread && (
    39	    <dialog data-focus-dialog data-essay-slug={slug} class="focus-host" aria-label="Reading focus view" />
    40	  )
    41	}
    42	
    43	{
    44	  thread && (
    45	    <script>
    46	      import { initFocusHost } from '../../lib/focus-host';
    47	
    48	      initFocusHost();
    49	    </script>
    50	  )
    51	}
    52	
    53	<style>
    54	  .focus-host {
    55	    box-sizing: border-box;
    56	    width: min(94vw, 72rem);
    57	    max-width: 94vw;
    58	    max-height: 90vh;
    59	    margin: auto;
    60	    padding: 1.75rem clamp(1.25rem, 4vw, 2.5rem);
    61	    overflow-y: auto;
    62	    overscroll-behavior: contain;
    63	    color: var(--text-primary);
    64	    background: var(--bg-surface);
    65	    border: 1px solid var(--border-strong);
    66	    border-radius: var(--radius-lg);
    67	    box-shadow: var(--shadow-lg);
    68	    animation: focus-host-in 160ms ease-out;
    69	  }
    70	
    71	  .focus-host::backdrop {
    72	    background: var(--color-bg-overlay);
    73	    animation: focus-host-backdrop-in 160ms ease-out;
    74	  }
    75	
    76	  .focus-host:focus-visible {
    77	    outline: none;
    78	  }
    79	
    80	  @keyframes focus-host-in {
    81	    from {
    82	      opacity: 0;
    83	      transform: translateY(0.5rem) scale(0.99);
    84	    }
    85	    to {
    86	      opacity: 1;
    87	      transform: translateY(0) scale(1);
    88	    }
    89	  }
    90	
    91	  @keyframes focus-host-backdrop-in {
    92	    from {
    93	      opacity: 0;
    94	    }
    95	    to {
    96	      opacity: 1;
    97	    }
    98	  }
    99	
   100	  @media (prefers-reduced-motion: reduce) {
   101	    .focus-host,
   102	    .focus-host::backdrop {
   103	      animation: none;
   104	    }
   105	  }
   106	
   107	  :global(html.perf-lite) .focus-host,
   108	  :global(html.perf-lite) .focus-host::backdrop {
   109	    animation: none;
   110	  }
   111	
   112	  @media (max-width: 640px) {
   113	    .focus-host {
   114	      width: 100vw;
   115	      max-width: 100vw;
   116	      max-height: 100vh;
   117	      height: 100%;
   118	      border-radius: 0;
   119	      padding: 1.25rem 1rem 2rem;
   120	    }
   121	  }
   122	</style>
     1	---
     2	/**
     3	 * ReadingCompanion — the one sticky reading companion for an essay
     4	 * (reading-experience-v2 DIRECTION.md V5, ARCHITECTURE.md §5). Refactor of
     5	 * `PostSidebar.astro` to the three-slot contract from
     6	 * `02_EXPERIENCE_SPEC.md`§6:
     7	 *
     8	 *   1. Compact nearby-chapter outline + an "All sections" action.
     9	 *   2. `ThreadDock`, when the post has a thread.
    10	 *   3. At most one authored `ContextualNote`, selected from the post's
    11	 *      bounded note registry as the active section changes.
    12	 *
    13	 * `AuthorProfile` and `ExecutiveSignal` are no longer inside this sticky
    14	 * column at all (V5: they sit in flow at the top of the rail and scroll
    15	 * away) — `PostLayout` renders `AuthorProfile` above this component,
    16	 * outside its sticky wrapper. That removal is also what retires the old
    17	 * accordion between the author card, the takeaway pill, and the thread
    18	 * rail: with only two small, independently-sized blocks left in the
    19	 * column (the outline and the six-item `ThreadDock`), there's no
    20	 * competing-for-space problem left to solve, so this component's script
    21	 * is a straight scroll-spy + windowed-list fit, not an accordion
    22	 * coordinator.
    23	 *
    24	 * Posts without a thread get outline-only behavior (the same generic
    25	 * fallback `PostSidebar` provided) — `slug`/`thread` are both optional.
    26	 */
    27	import ThreadDock from './ThreadDock.astro';
    28	import ContextualNote from './ContextualNote.astro';
    29	import { threads } from '../../data/threads';
    30	import { contextualNotes } from '../../data/contextual-notes';
    31	
    32	interface Heading {
    33	  depth: number;
    34	  slug: string;
    35	  text: string;
    36	}
    37	
    38	interface Props {
    39	  slug?: string;
    40	  headings?: Heading[];
    41	}
    42	
    43	const { slug, headings = [] } = Astro.props;
    44	const thread = slug ? threads[slug] : undefined;
    45	const notes = slug ? contextualNotes[slug] ?? [] : [];
    46	
    47	// The footnotes section starts at the "Footnotes" heading (id
    48	// `footnote-label`, injected by the remark footnotes plugin) — exclude it
    49	// and everything after it so the outline never lists footnote content.
    50	const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
    51	const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
    52	const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
    53	const showToc = rawToc.length >= 2;
    54	
    55	// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
    56	// under, so the client script can show only the active section's
    57	// sub-headings instead of the full flat list.
    58	let h2Count = 0;
    59	let currentH2Slug: string | null = null;
    60	const toc = rawToc.map((heading) => {
    61	  if (heading.depth === 2) {
    62	    h2Count += 1;
    63	    currentH2Slug = heading.slug;
    64	    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
    65	  }
    66	  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
    67	});
    68	---
    69	
    70	<div class="reading-companion flex flex-col gap-3" data-reading-companion>
    71	  {
    72	    showToc && (
    73	      <div
    74	        class="reading-companion__block reading-companion__outline rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
    75	        data-companion-outline
    76	      >
    77	        <div class="reading-companion__header font-mono flex items-center justify-between gap-2 px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
    78	          <span>On this page</span>
    79	          <button
    80	            type="button"
    81	            class="reading-companion__all-toggle focus-ring text-[var(--text-tertiary)] hover:text-[var(--accent)]"
    82	            data-companion-all-toggle
    83	            aria-pressed="false"
    84	          >
    85	            All sections
    86	          </button>
    87	        </div>
    88	
    89	        <div class="reading-companion__body" data-companion-scroll>
    90	          <div class="reading-companion__rail" aria-hidden="true">
    91	            <div class="reading-companion__rail-fill" data-companion-fill />
    92	          </div>
    93	          <nav aria-label="Table of contents">
    94	            <p class="reading-companion__more" data-companion-more="above" hidden />
    95	            <ol class="reading-companion__list">
    96	              {toc.map((heading) => (
    97	                <li
    98	                  class:list={['reading-companion__item', heading.depth === 3 && 'reading-companion__item--sub']}
    99	                  data-companion-item
   100	                  data-companion-depth={heading.depth}
   101	                  data-companion-parent={heading.parentSlug ?? ''}
   102	                >
   103	                  <a
   104	                    href={`#${heading.slug}`}
   105	                    class="reading-companion__link"
   106	                    data-companion-link
   107	                    data-companion-target={heading.slug}
   108	                  >
   109	                    {heading.depth === 2 && (
   110	                      <span class="reading-companion__index font-mono" aria-hidden="true">
   111	                        {String(heading.sectionNumber).padStart(2, '0')}
   112	                      </span>
   113	                    )}
   114	                    <span class="reading-companion__label line-clamp-2">{heading.text}</span>
   115	                  </a>
   116	                </li>
   117	              ))}
   118	            </ol>
   119	            <p class="reading-companion__more" data-companion-more="below" hidden />
   120	          </nav>
   121	        </div>
   122	      </div>
   123	    )
   124	  }
   125	
   126	  {thread && slug && <ThreadDock slug={slug} />}
   127	  <ContextualNote notes={notes} />
   128	</div>
