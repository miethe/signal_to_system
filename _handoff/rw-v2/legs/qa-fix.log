   183	    color: var(--text-tertiary);
   184	  }
   185	
   186	  .thread-focus__eyebrow {
   187	    display: flex;
   188	    gap: 0.4rem;
   189	    margin: 0;
   190	    font-size: 0.6875rem;
   191	    font-weight: 700;
   192	    letter-spacing: 0.14em;
   193	    text-transform: uppercase;
   194	    color: var(--accent-text);
   195	  }
   196	
   197	  .thread-focus__title {
   198	    margin: 0.3rem 0 0.75rem;
   199	    font-size: 1.75rem;
   200	    font-weight: 700;
