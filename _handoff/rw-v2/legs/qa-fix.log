     1	---
     2	import { getCollection } from 'astro:content';
     3	import { GLOSSARY } from '../../data/glossary';
     4	
     5	// ---------------------------------------------------------------------------
     6	// <Term id="contract-as-spec" /> or <Term id="contract-as-spec">label</Term>
     7	//
     8	// Renders a coined term as a <dfn> with a hover/focus/tap tooltip carrying
     9	// its definition, instead of a navigating link. CSS-only — no client JS.
    10	// ---------------------------------------------------------------------------
    11	
    12	interface Props {
    13	  id: string;
    14	}
    15	
    16	const { id } = Astro.props;
    17	const entry = GLOSSARY[id];
    18	
    19	if (!entry) {
    20	  throw new Error(
    21	    `<Term id="${id}" /> does not match any entry in src/data/glossary.ts. Add the term there or fix the id.`
    22	  );
    23	}
    24	
    25	const label = await Astro.slots.render('default');
    26	const displayText = label && label.trim().length > 0 ? label : entry.term;
    27	
    28	// Resolve the defining post, if any, and only link to it when it exists, is
    29	// published, and is NOT the page the reader is already on — otherwise the
    30	// tooltip omits the "Read more" link entirely. Every term is coined in the
    31	// post that defines it, so without the self-link guard the link would send a
    32	// reader from a post straight back to that same post.
    33	const normalize = (path: string) => path.replace(/\/+$/, '');
    34	
    35	let readMoreHref: string | undefined;
    36	if (entry.definedIn) {
    37	  const posts = await getCollection('posts');
    38	  const definingPost = posts.find((p) => p.id === entry.definedIn);
    39	  if (definingPost && definingPost.data.status !== 'draft') {
    40	    const href = `/essays/${definingPost.id}/`;
    41	    if (normalize(href) !== normalize(Astro.url.pathname)) {
    42	      readMoreHref = href;
    43	    }
    44	  }
    45	}
    46	
    47	const tooltipId = `glossary-tooltip-${id}`;
    48	---
    49	
    50	<span class="glossary-term">
    51	  <dfn tabindex="0" aria-describedby={tooltipId} set:html={displayText} />
    52	  <span role="tooltip" id={tooltipId} class="glossary-tooltip">
    53	    <span class="glossary-tooltip-definition">{entry.definition}</span>
    54	    {readMoreHref && (
    55	      <a href={readMoreHref} class="glossary-tooltip-link">Read more &rarr;</a>
    56	    )}
    57	  </span>
    58	</span>

