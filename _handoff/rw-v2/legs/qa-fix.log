--- src/components/content/ReadingCompanion.astro
     1	---
     2	/**
     3	 * ReadingCompanion — the one sticky reading companion for an essay
     4	 * (reading-experience-v2 DIRECTION.md V5, ARCHITECTURE.md §5). Refactor of
     5	 * `PostSidebar.astro` to the three-slot contract from
     6	 * `02_EXPERIENCE_SPEC.md`§6:
     7	 *
     8	 *   1. Compact nearby-chapter outline + an "All sections" action.
     9	 *   2. `ThreadDock`, when the post has a thread.
    10	 *   3. At most one authored `ContextualNote`, selected from the post's
    11	 *      bounded note registry as the active section changes.
    12	 *
    13	 * `AuthorProfile` and `ExecutiveSignal` are no longer inside this sticky
    14	 * column at all (V5: they sit in flow at the top of the rail and scroll
    15	 * away) — `PostLayout` renders `AuthorProfile` above this component,
    16	 * outside its sticky wrapper. That removal is also what retires the old
    17	 * accordion between the author card, the takeaway pill, and the thread
    18	 * rail: with only two small, independently-sized blocks left in the
    19	 * column (the outline and the six-item `ThreadDock`), there's no
    20	 * competing-for-space problem left to solve, so this component's script
    21	 * is a straight scroll-spy + windowed-list fit, not an accordion
    22	 * coordinator.
    23	 *
    24	 * Posts without a thread get outline-only behavior (the same generic
    25	 * fallback `PostSidebar` provided) — `slug`/`thread` are both optional.
    26	 */
    27	import ThreadDock from './ThreadDock.astro';
    28	import ContextualNote from './ContextualNote.astro';
    29	import { threads } from '../../data/threads';
    30	import { contextualNotes } from '../../data/contextual-notes';
    31	
    32	interface Heading {
    33	  depth: number;
    34	  slug: string;
    35	  text: string;
    36	}
    37	
    38	interface Props {
    39	  slug?: string;
    40	  headings?: Heading[];
    41	}
    42	
    43	const { slug, headings = [] } = Astro.props;
    44	const thread = slug ? threads[slug] : undefined;
    45	const notes = slug ? contextualNotes[slug] ?? [] : [];
    46	
    47	// The footnotes section starts at the "Footnotes" heading (id
    48	// `footnote-label`, injected by the remark footnotes plugin) — exclude it
    49	// and everything after it so the outline never lists footnote content.
    50	const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
    51	const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
    52	const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
    53	const showToc = rawToc.length >= 2;
    54	
    55	// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
    56	// under, so the client script can show only the active section's
    57	// sub-headings instead of the full flat list.
    58	let h2Count = 0;
    59	let currentH2Slug: string | null = null;
    60	const toc = rawToc.map((heading) => {
    61	  if (heading.depth === 2) {
    62	    h2Count += 1;
    63	    currentH2Slug = heading.slug;
    64	    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
    65	  }
    66	  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
    67	});
    68	---
    69	
    70	<div class="reading-companion flex flex-col gap-3" data-reading-companion>
    71	  {
    72	    showToc && (
    73	      <div
    74	        class="reading-companion__block reading-companion__outline rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
    75	        data-companion-outline
    76	      >
    77	        <div class="reading-companion__header font-mono flex items-center justify-between gap-2 px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
    78	          <span>On this page</span>
    79	          <button
    80	            type="button"
    81	            class="reading-companion__all-toggle focus-ring text-[var(--text-tertiary)] hover:text-[var(--accent)]"
    82	            data-companion-all-toggle
    83	            aria-pressed="false"
    84	          >
    85	            All sections
    86	          </button>
    87	        </div>
    88	
    89	        <div class="reading-companion__body" data-companion-scroll>
    90	          <div class="reading-companion__rail" aria-hidden="true">
    91	            <div class="reading-companion__rail-fill" data-companion-fill />
    92	          </div>
    93	          <nav aria-label="Table of contents">
    94	            <p class="reading-companion__more" data-companion-more="above" hidden />
    95	            <ol class="reading-companion__list">
    96	              {toc.map((heading) => (
    97	                <li
    98	                  class:list={['reading-companion__item', heading.depth === 3 && 'reading-companion__item--sub']}
    99	                  data-companion-item
   100	                  data-companion-depth={heading.depth}
   101	                  data-companion-parent={heading.parentSlug ?? ''}
   102	                >
   103	                  <a
   104	                    href={`#${heading.slug}`}
   105	                    class="reading-companion__link"
   106	                    data-companion-link
   107	                    data-companion-target={heading.slug}
   108	                  >
   109	                    {heading.depth === 2 && (
