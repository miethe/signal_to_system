     1	---
     2	/**
     3	 * FigureViewer — the shared figure-viewer renderer (DIRECTION.md V7,
     4	 * ARCHITECTURE.md §4, spec §10). Backs both `/essays/<slug>/figure/<id>/`
     5	 * and the in-place overlay's `<template>` fragment: exact asset, exact
     6	 * caption, long description, and real file metadata read from disk at
     7	 * build time — never a fabricated size or dimension (V1).
     8	 *
     9	 * `sharp` is already a project dependency (Astro's own image pipeline
    10	 * uses it), so this reads genuine width/height via its metadata probe
    11	 * rather than falling back to an undocumented guess; file size comes from
    12	 * `fs.statSync`. A missing asset at build time leaves both fields `null`
    13	 * — a labeled pending slot, not a substitute value.
    14	 */
    15	import fs from 'node:fs';
    16	import path from 'node:path';
    17	import sharp from 'sharp';
    18	import type { Thread } from '../../data/threads';
    19	
    20	interface Props {
    21	  thread: Thread;
    22	  beatId: string;
    23	  standalone?: boolean;
    24	}
    25	
    26	const { thread, beatId, standalone = true } = Astro.props;
    27	const beat = thread.beats.find((candidate) => candidate.id === beatId);
    28	
    29	let fileSizeBytes: number | null = null;
    30	let width: number | null = null;
    31	let height: number | null = null;
    32	
    33	if (beat) {
    34	  const absolutePath = path.join(process.cwd(), 'public', beat.image.src);
    35	  try {
    36	    const stat = fs.statSync(absolutePath);
    37	    fileSizeBytes = stat.size;
    38	    const metadata = await sharp(absolutePath).metadata();
    39	    width = metadata.width ?? null;
    40	    height = metadata.height ?? null;
    41	  } catch {
    42	    // Asset unreadable at build time — leave metadata null (V1: a missing
    43	    // input stays a labeled pending slot, never a fabricated value).
    44	  }
    45	}
    46	
    47	const formatBytes = (bytes: number | null) => {
    48	  if (bytes === null) return 'Not available in this build';
    49	  const kb = bytes / 1024;
    50	  return kb >= 1024 ? `${(kb / 1024).toFixed(2)} MB` : `${kb.toFixed(1)} KB`;
    51	};
    52	
    53	const dimensionsLabel =
    54	  width !== null && height !== null ? `${width} × ${height}px` : 'Not available in this build';
    55	
    56	const filename = beat?.image.src.split('/').pop() ?? '';
    57	---
    58	
    59	{
    60	  beat && (
    61	    <div class="figure-viewer" data-focus-kind="figure" data-focus-key={beat.id}>
    62	      <div class="figure-viewer__actions">
    63	        <a class="figure-viewer__action" href={`/essays/${thread.slug}/`}>
    64	          &larr; Back to essay
    65	        </a>
    66	        <a class="figure-viewer__action" href={`/essays/${thread.slug}/thread/${beat.id}/`}>
    67	          &larr; Back to thread focus
    68	        </a>
    69	        <span class="figure-viewer__action-label font-mono">Figure viewer</span>
    70	        <a class="figure-viewer__action figure-viewer__action--copy" href={`/essays/${thread.slug}/figure/${beat.id}/`} data-focus-copy-link>
    71	          Copy link
    72	        </a>
    73	        {!standalone && (
    74	          <button type="button" class="figure-viewer__action figure-viewer__action--close" data-focus-close>
    75	            Close
    76	          </button>
    77	        )}
    78	      </div>
    79	
    80	      <p class="figure-viewer__eyebrow font-mono">Figure {String(beat.n).padStart(2, '0')} · {beat.label}</p>
    81	      <h2 class="figure-viewer__title font-serif">{beat.image.caption}</h2>
    82	
    83	      <figure class="figure-viewer__figure">
    84	        <img src={beat.image.src} alt={beat.image.alt} loading="lazy" decoding="async" />
    85	        <figcaption>
    86	          <p class="figure-viewer__caption">{beat.image.caption}</p>
    87	          <p class="figure-viewer__long-description">{beat.longDescription}</p>
    88	        </figcaption>
    89	      </figure>
    90	
    91	      <dl class="figure-viewer__metadata">
    92	        <div>
    93	          <dt>Filename</dt>
    94	          <dd class="font-mono">{filename}</dd>
    95	        </div>
    96	        <div>
    97	          <dt>File size</dt>
    98	          <dd>{formatBytes(fileSizeBytes)}</dd>
    99	        </div>
   100	        <div>
   101	          <dt>Dimensions</dt>
   102	          <dd>{dimensionsLabel}</dd>
   103	        </div>
   104	      </dl>
   105	    </div>
   106	  )
   107	}
   108	
   109	<style>
   110	  .figure-viewer__actions {
   111	    display: flex;
   112	    flex-wrap: wrap;
   113	    align-items: center;
   114	    gap: 0.75rem 1.25rem;
   115	    margin-bottom: 1.5rem;
   116	    padding-bottom: 1rem;
   117	    border-bottom: 1px solid var(--border-subtle);
   118	  }
   119	
   120	  .figure-viewer__action {
   121	    font-family: var(--font-mono);
   122	    font-size: 0.75rem;
   123	    font-weight: 600;
   124	    color: var(--accent);
   125	    text-decoration: none;
   126	    background: none;
   127	    border: 0;
   128	    cursor: pointer;
   129	  }
   130	
   131	  .figure-viewer__action:hover,
   132	  .figure-viewer__action:focus-visible {
   133	    text-decoration: underline;
   134	  }
   135	
   136	  .figure-viewer__action-label {
   137	    margin-left: auto;
   138	    font-size: 0.6875rem;
   139	    font-weight: 700;
   140	    letter-spacing: 0.14em;
   141	    text-transform: uppercase;
   142	    color: var(--text-tertiary);
   143	  }
   144	
   145	  .figure-viewer__action--close {
   146	    color: var(--text-tertiary);
   147	  }
   148	
   149	  .figure-viewer__figure {
   150	    margin: 0 0 1.5rem;
   151	    padding: 1.25rem;
   152	    background: #f6f8fb;
   153	    border: 1px solid var(--border-subtle);
   154	    border-radius: var(--radius-lg);
   155	  }
   156	
   157	  .figure-viewer__figure img {
   158	    display: block;
   159	    width: 100%;
   160	    height: auto;
   161	    margin: 0 0 0.875rem;
