  }

  .evidence-focus__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .evidence-focus__action:hover,
  .evidence-focus__action:focus-visible {
    text-decoration: underline;
  }

  .evidence-focus__action-label {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .evidence-focus__action--secondary {
    color: var(--text-secondary);
  }

  .evidence-focus__eyebrow {
    margin: 0;
