pre code {
  background: none;
  border: none;
  padding: 0;
  font-size: inherit;
  color: inherit;
  border-radius: 0;
}

/* --- Focus states (accessibility) --- */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 0.25rem;
}

:focus:not(:focus-visible) {
  outline: none;
}

/* ============================================================
   PROSE — .prose-custom
   Used for article/essay body content
   ============================================================ */

/* PostLayout owns this one reading measure. Keeping the layout and prose on
   the same variable prevents a wider grid from leaving a narrow text column. */
.post-layout {
  --measure: 72ch;
}

@media (min-width: 1024px) {
  .post-layout {
    --measure: 84ch;
  }
}

.prose-custom {
  max-width: var(--measure, 72ch);
  font-size: 1.0625rem;
  line-height: 1.75;
  color: var(--text-secondary);
}

/* --- Headings --- */
.prose-custom h1,
.prose-custom h2,
.prose-custom h3,
.prose-custom h4,
.prose-custom h5,
.prose-custom h6 {
  color: var(--text-primary);
  font-weight: 700;
  letter-spacing: -0.02em;
  scroll-margin-top: 5rem;
}

.prose-custom h1 {
  font-size: 2rem;
  line-height: 1.2;
  margin-top: 0;
  margin-bottom: 1rem;
}

.prose-custom h2 {
  font-size: 1.5rem;

.prose-custom summary {
  cursor: pointer;
  color: var(--accent);
  font-size: 0.9375rem;
  font-weight: 600;
  line-height: 1.5;
  text-underline-offset: 0.18em;
}

.prose-custom summary::marker {
  color: var(--accent);
}

.prose-custom summary:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

.prose-custom details[open] > summary {
  margin-bottom: 0.75rem;
}

@media (prefers-reduced-motion: no-preference) {
  .prose-custom details {
    transition: border-color 150ms ease;
  }
}

/* --- Horizontal rules --- */
.prose-custom hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 2.5rem 0;
}

/* --- Images in prose --- */
.prose-custom img {
  border-radius: 0.5rem;
  border: 1px solid var(--border-subtle);
  margin: 2rem auto;
  box-shadow: var(--shadow-md);
}

.prose-custom figure {
  margin: 2rem 0;
}

.prose-custom figcaption {
  text-align: center;
  font-size: 0.875rem;
  color: var(--text-tertiary);
  margin-top: 0.75rem;
  font-style: italic;
}

/* Supporting visual material can borrow a little of the surrounding grid at
   laptop widths, while prose keeps its deliberate reading measure. */
@media (min-width: 1024px) {
  .prose-custom > .figure-plate,
  .prose-custom > table {
    width: calc(100% + 3rem);
    max-width: none;
    margin-right: -1.5rem;
    margin-left: -1.5rem;
  }
}

/* ============================================================
   FIGURE PLATE
   Editorial "engineering plate" treatment for schematic figures.
   Artwork stays light in its own frame; in dark mode the surrounding plate
   becomes a restrained navy panel so it belongs to the page.
   Used via <Figure /> component, and by PostLayout for heroImage.
   ============================================================ */
.figure-plate {
  position: relative;
  margin: 2.75rem 0;
  padding: 1.375rem 1.375rem 1.125rem;
  background: #f6f8fb;
  border: 1px solid #e2e8f0;
  border-radius: 0.625rem;
  box-shadow:
    0 1px 2px rgba(15, 23, 42, 0.04),
    0 8px 24px -8px rgba(15, 23, 42, 0.1);
}

.dark .figure-plate {
  background: #111a2c;
  border-color: rgba(99, 102, 241, 0.22);
  box-shadow:
    0 0 0 1px rgba(99, 102, 241, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.35),
    0 22px 56px -14px rgba(79, 70, 229, 0.4);
}

/* Hero variant — frontispiece on the post */
.figure-plate--hero {
  margin: 0 0 3.5rem;
  padding: 1.5rem 1.5rem 1.25rem;
}

/* Inline variant — stays within the prose measure, cancelling the grid
   breakout the default plate gets at lg (see the `.prose-custom >
   .figure-plate` rule below). For small supporting figures. */
@media (min-width: 1024px) {
  .prose-custom > .figure-plate.figure-plate--inline {
    width: 100%;
    max-width: 100%;
    margin-right: 0;
    margin-left: 0;
  }
}

/* Wide / technical variants — break out further than the default plate for
   diagrams that need more than the 72ch reading measure. */
@media (min-width: 1024px) {
  .prose-custom > .figure-plate.figure-plate--wide,
  .prose-custom > .figure-plate.figure-plate--technical {
    width: min(calc(100% + 6rem), calc(100vw - 2rem));
    max-width: none;
    margin-right: -3rem;
    margin-left: -3rem;
  }
}

/* Technical variant — a thinner, dashed "schematic" plate treatment,
   distinct from the warm editorial plate used for photos/illustrations. */
.figure-plate--technical {
  border-width: 1px;
  border-style: dashed;
  border-color: #94a3b8;
}

.dark .figure-plate--technical {
  border-color: rgba(45, 212, 191, 0.35);
}

.figure-plate--technical .figure-plate__label {
  color: #0f766e;
}

/* Corner tick marks — four 10px L-brackets echoing drafting sheets */
.figure-plate__corner {
  position: absolute;
  width: 10px;
  height: 10px;
  pointer-events: none;
  opacity: 0.5;
  border: 1.5px solid #5b6b7a;
}
.figure-plate__corner--tl { top: 7px; left: 7px;  border-right: 0; border-bottom: 0; }
.figure-plate__corner--tr { top: 7px; right: 7px; border-left: 0;  border-bottom: 0; }
.figure-plate__corner--bl { bottom: 7px; left: 7px;  border-right: 0; border-top: 0; }
.figure-plate__corner--br { bottom: 7px; right: 7px; border-left: 0;  border-top: 0; }

/* Image frame inside the plate — reset any inherited prose-custom img styling */
.figure-plate__frame {
  position: relative;
  border-radius: 0.375rem;
  overflow: hidden;
  background: #ffffff;
}

.figure-plate__header {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: .45rem .65rem;
  color: #334155;
  background: rgb(246 248 251 / .92);
  border-bottom: 1px solid #cbd5e1;
  font: 700 .625rem var(--font-mono);
  letter-spacing: .07em;
  text-transform: uppercase;
  pointer-events: none;
}

.figure-plate__enlarge {
  position: relative;
  display: block;
  color: var(--text-primary);
  cursor: zoom-in;
}

.figure-plate__enlarge:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 3px;
}

.figure-plate__enlarge-affordance {
  position: absolute;
  top: 0.625rem;
  right: 0.625rem;
  display: grid;
  width: 2rem;
  height: 2rem;
  place-items: center;
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  opacity: 0;
  transition: opacity 150ms ease;
}

.figure-plate__enlarge:hover .figure-plate__enlarge-affordance,
.figure-plate__enlarge:focus-visible .figure-plate__enlarge-affordance {
  opacity: 0.9;
}

.figure-plate__frame img,
.prose-custom .figure-plate__frame img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0;
  border: 0;
  border-radius: 0.375rem;
  box-shadow: none;
}

/* Caption: mono label in accent + serif-friendly text in paper-readable slate.
   Caption lives INSIDE the light plate, so colors are fixed (not theme-var) —
   we are in "paper space" here, not page space. */
.figure-plate__caption,
.prose-custom .figure-plate__caption {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.35rem;
  margin-top: 0.625rem;
  padding: 0 0.125rem;
  font-size: 0.75rem;
  line-height: 1.45;
  font-style: normal;
  text-align: left;
  color: #475569;
}

.figure-plate__caption-main {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
}

.figure-plate__label {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #4f46e5;
  padding-top: 0.0625rem;
  white-space: nowrap;
}

.figure-plate__text {
  font-family: var(--font-sans);
  color: #475569;
  font-weight: 400;
}

.figure-plate__credit {
  color: #64748b;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  line-height: 1.4;
}

.figure-plate__credit a {
  color: inherit;
  text-underline-offset: 0.18em;
}

.figure-plate__credit a:hover {
  color: #334155;
}

.figure-lightbox {
  width: min(96vw, 100rem);
  max-width: 96vw;
  max-height: 92vh;
  margin: auto;
  padding: 0;
  overflow: visible;
  color: var(--text-primary);
  background: transparent;
  border: 0;
  animation: figure-lightbox-in 160ms ease-out;
}

.figure-lightbox::backdrop {
  background: var(--color-bg-overlay);
  animation: figure-lightbox-backdrop-in 160ms ease-out;
}

.figure-lightbox__panel {
  position: relative;
  display: flex;
  max-height: 92vh;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.figure-lightbox__panel img,
.prose-custom .figure-lightbox__panel img {
  display: block;
  width: auto;
  max-width: calc(96vw - 2rem);
  height: auto;
  max-height: calc(92vh - 5rem);
  margin: auto;
  border: 0;
  border-radius: var(--radius-md);
  box-shadow: none;
  object-fit: contain;
}

.figure-lightbox__close {
  position: absolute;
  z-index: 1;
  top: 1.5rem;
  right: 1.5rem;
  display: grid;
  width: 2.25rem;
  height: 2.25rem;
  place-items: center;
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
}

.figure-lightbox__close:hover {
  color: var(--accent-hover);
}

.figure-lightbox__close:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}

.figure-lightbox__caption {
  margin: 0;
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 0.875rem;
  line-height: 1.5;
  text-align: center;
}

@keyframes figure-lightbox-in {
  from { opacity: 0; transform: scale(0.985); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes figure-lightbox-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (hover: none) {
  .figure-plate__enlarge-affordance {
    opacity: 0.8;
  }
}

@media (prefers-reduced-motion: reduce) {
  .figure-plate__enlarge-affordance {
    transition: none;
  }

  .figure-lightbox,
  .figure-lightbox::backdrop {
    animation: none;
  }
}

@media (max-width: 640px) {
  .figure-plate {
    margin: 2rem 0;
    padding: 1rem 1rem 0.875rem;
  }
  .figure-plate--hero {
    margin: 0 0 2.5rem;
    padding: 1.125rem 1.125rem 1rem;
  }
  .figure-plate__caption {
    gap: 0.3rem;
  }
  .figure-plate__caption-main {
    flex-direction: column;
    gap: 0.25rem;
  }
}

/* --- Strong & em --- */
.prose-custom strong {
  font-weight: 700;
  color: var(--text-primary);
}

.prose-custom em {
  color: var(--text-primary);
}

/* --- Keyboard / mark --- */
.prose-custom kbd {
  font-family: var(--font-mono);
  font-size: 0.8125em;
  background-color: var(--bg-muted);
}

.callout-info {
  background-color: rgb(14 165 233 / 0.05);
  border-color: rgb(14 165 233 / 0.3);
  color: #7dd3fc;
}

.callout-success {
  background-color: rgb(16 185 129 / 0.05);
  border-color: rgb(16 185 129 / 0.3);
  color: #6ee7b7;
}

.callout-danger {
  background-color: rgb(239 68 68 / 0.05);
  border-color: rgb(239 68 68 / 0.3);
  color: #fca5a5;
}

/* ============================================================
   HOVER LIFT — shared treatment for boxed in-body content
   Add `lift-hover` to the ROOT element of a boxed MDX/body
   component (callouts, figures, thread beats, the leader-takeaway
   card). Never on sidebar cards, and never on inline markers
   (Evidence, Term) — a baseline-aligned pill must not move.

   The lift is a transform, so it never reflows its neighbours.
   Surfaces that already carry a resting shadow re-declare
   --lift-shadow so the hover state is a superset of it rather
   than a replacement (see .figure-plate below).
   ============================================================ */

.lift-hover {
  transition:
    transform var(--lift-duration) var(--lift-ease),
    box-shadow var(--lift-duration) ease-out;
}

/* Pointer devices only: a `:hover` that sticks after a tap is worse than no
   hover at all. */
@media (hover: hover) and (pointer: fine) {
  .lift-hover:hover {
    transform: translateY(var(--lift-y));
    box-shadow: var(--lift-shadow);
  }

  /* A transformed ancestor can become the containing block for fixed
     descendants; don't lift a figure whose lightbox is open. */
  .lift-hover:hover:has(dialog[open]) {
    transform: none;
  }
}

/* Reduced motion / lite mode: keep the shadow (it isn't motion), drop the
   lift and the transition. The global rules below only clamp transition
   DURATION, so the transform itself has to be cancelled explicitly. */
@media (prefers-reduced-motion: reduce) {
  .lift-hover,
  .lift-hover:hover {
    transform: none;
    transition: box-shadow var(--lift-duration) ease-out;
  }
}

.perf-lite .lift-hover,
.perf-lite .lift-hover:hover {
  transform: none;
  transition: none;
}

/* Figure plates keep their engineering-plate resting shadow underneath. */
.figure-plate.lift-hover {
  --lift-shadow:
    0 1px 2px rgba(15, 23, 42, 0.04),
    0 16px 38px -12px rgba(15, 23, 42, 0.22);
}

.dark .figure-plate.lift-hover {
  --lift-shadow:
    0 0 0 1px rgba(99, 102, 241, 0.22),
    0 2px 6px rgba(0, 0, 0, 0.35),
    0 28px 64px -14px rgba(79, 70, 229, 0.52);
}

/* Same reasoning for the leader-takeaway card's resting elevation. */
.leader-takeaway.lift-hover {
  --lift-shadow:
    0 1px 2px rgba(15, 23, 42, 0.04),
    0 16px 34px -14px rgba(15, 23, 42, 0.24);
}

.dark .leader-takeaway.lift-hover {
  --lift-shadow:
    0 0 0 1px rgba(192, 193, 255, 0.16),
    0 18px 38px -16px rgba(111, 0, 190, 0.55);
}

/* ============================================================
   SERIES WAYFINDING
   The one-line "where does this sit?" element between a post's
   dek and its tag row (components/content/SeriesWayfinding.astro).
   Two chip kinds, deliberately different in weight: an Arc is a
   narrative throughline across series (accent-forward), a Series
   is a mini-series (quiet outline).
   ============================================================ */

.series-wayfinding {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}

.wayfind {
  display: inline-flex;
  .animate-on-scroll {
    opacity: 1;
    transform: none;
  }
}

.perf-lite .animate-on-scroll {
  opacity: 1;
  transform: none;
  animation: none !important;
}

/* ============================================================
   @miethe/ui — shadcn semantic tokens
   The library uses classes like bg-primary, text-muted-foreground,
   border-border. Map them to HSL tokens defined on :root / .dark so
   @miethe/ui components render correctly in the showcase and
   anywhere they're embedded.
   ============================================================ */

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--shadcn-accent));
  --color-accent-foreground: hsl(var(--shadcn-accent-foreground));
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));
  --color-border: hsl(var(--border-hsl));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
}

:root {
  /* shadcn defaults, light. `--accent`/`--accent-foreground` are namespaced
     to `--shadcn-*` (FIX-LIST A2) — the bare names collided at equal
     specificity with the real editorial `--accent` set above (:116), and as
     an invalid HSL-triple color they clobbered it silently instead of
     erroring. @miethe/ui components still resolve the same values through
     the `@theme inline` mapping above; only the shared variable name moved. */
  --background: 0 0% 100%;
  --foreground: 222.2 47.4% 11.2%;
  --card: 0 0% 100%;
  --card-foreground: 222.2 47.4% 11.2%;
  --popover: 0 0% 100%;
  --popover-foreground: 222.2 47.4% 11.2%;
  --primary: 222.2 47.4% 11.2%;
  --primary-foreground: 210 40% 98%;
  --secondary: 210 40% 96.1%;
  --secondary-foreground: 222.2 47.4% 11.2%;
  --muted: 210 40% 96.1%;
  --muted-foreground: 215.4 16.3% 46.9%;
  --shadcn-accent: 210 40% 96.1%;
  --shadcn-accent-foreground: 222.2 47.4% 11.2%;
  --destructive: 0 84.2% 60.2%;
  --destructive-foreground: 210 40% 98%;
  --border-hsl: 214.3 31.8% 91.4%;
  --input: 214.3 31.8% 91.4%;
  --ring: 222.2 84% 4.9%;
}

.dark {
  --background: 222.2 47.4% 11.2%;
  --foreground: 210 40% 98%;
  --card: 222.2 47.4% 11.2%;
  --card-foreground: 210 40% 98%;
  --popover: 222.2 47.4% 11.2%;
  --popover-foreground: 210 40% 98%;
  --primary: 210 40% 98%;
  --primary-foreground: 222.2 47.4% 11.2%;
  --secondary: 217.2 32.6% 17.5%;
  --secondary-foreground: 210 40% 98%;
  --muted: 217.2 32.6% 17.5%;
  --muted-foreground: 215 20.2% 65.1%;
  --shadcn-accent: 217.2 32.6% 17.5%;
  --shadcn-accent-foreground: 210 40% 98%;
  --destructive: 0 62.8% 30.6%;
  --destructive-foreground: 210 40% 98%;
  --border-hsl: 217.2 32.6% 17.5%;
  --input: 217.2 32.6% 17.5%;
  --ring: 212.7 26.8% 83.9%;
}
  <script>
    // Reading progress bar
    const progressBar = document.getElementById('reading-progress');
    const articleEl = document.querySelector('article');
    const scrollToTopBtn = document.getElementById('scroll-to-top');
    const isLite = document.documentElement.classList.contains('perf-lite');

    if (progressBar && articleEl && !isLite) {
      const updateProgress = () => {
        const rect = articleEl.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = rect.height;
        const scrolled = window.scrollY - articleTop;
        const progress = Math.min(Math.max(scrolled / (articleHeight - window.innerHeight), 0), 1);
        progressBar.style.width = `${progress * 100}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    } else if (progressBar && isLite) {
      progressBar.style.display = 'none';
    }

    // Scroll to top button
    if (scrollToTopBtn) {
      const toggleButton = () => {
        const show = window.scrollY > window.innerHeight * 0.5;
        scrollToTopBtn.classList.toggle('opacity-0', !show);
        scrollToTopBtn.classList.toggle('translate-y-4', !show);
        scrollToTopBtn.classList.toggle('pointer-events-none', !show);
        scrollToTopBtn.classList.toggle('opacity-100', show);
        scrollToTopBtn.classList.toggle('translate-y-0', show);
        scrollToTopBtn.classList.toggle('pointer-events-auto', show);
      };

      window.addEventListener('scroll', toggleButton, { passive: true });
      toggleButton();

      scrollToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</BaseLayout>

