---
/**
 * EvidenceFocus — the shared Evidence Focus renderer (DIRECTION.md V3/V4,
 * ARCHITECTURE.md §4, spec §8). Backs BOTH `/essays/<slug>/evidence/`
 * (the essay-scoped index) and the flat, site-wide `/evidence/<record>/`
 * route, plus the in-place overlay's `<template>` fragment — same
 * component, same field set from `evidence.ts`'s `EvidenceRecord`, never
 * a second hand-written summary.
 *
 * `records` is always the full evidence set (so the rail's `ReceiptIndex`
 * can navigate anywhere); `selectedId` narrows the main pane to one
 * record's full detail. Omitting it renders the full list.
 */
import EvidenceGuide from './EvidenceGuide.astro';
import ReceiptIndex from './ReceiptIndex.astro';
import ClaimBadge from './ClaimBadge.astro';
import type { EvidenceRecord } from '../../data/evidence';

interface Props {
  records: EvidenceRecord[];
  selectedId?: string;
  /** Real anchor text for a "Read in essay" link, when a related essay exists. */
  essaySlug?: string;
  standalone?: boolean;
}

const { records, selectedId, essaySlug, standalone = true } = Astro.props;
// The essay index is a receipt surface, not a bare directory. When no record
// is named in the route, introduce the first related receipt in full and let
// the rail provide the rest of the index.
const selected = selectedId ? records.find((record) => record.id === selectedId) : records[0];
const selectedRecordId = selected?.id;
const receiptDate = selected?.recordedDate ?? selected?.eventDate ?? selected?.verifiedAt ?? null;
const claimBadgeKind = selected
  ? ({
      observed: 'observed',
      measured: 'measured',
      proposed: 'proposed',
      'externally-reported': 'external',
      illustrative: 'hypothesis',
    }[selected.evidenceClass] as 'observed' | 'measured' | 'proposed' | 'external' | 'hypothesis')
  : undefined;

const formatDate = (value: string | null) => value ?? 'Not stated';
---

<div class="evidence-focus" data-focus-kind="evidence" data-focus-key={selectedId ?? 'all'}>
  <div class="evidence-focus__grid">
    <div class="evidence-focus__main">
      <div class="evidence-focus__actions">
        {essaySlug && (
          <a class="evidence-focus__action" href={`/essays/${essaySlug}/`}>
            &larr; Back to essay
          </a>
        )}
        <span class="evidence-focus__action-label font-mono">Evidence focus</span>
        {essaySlug && (
          <a
            class="evidence-focus__action evidence-focus__action--secondary"
            href={`/essays/${essaySlug}/evidence/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in new tab
          </a>
        )}
        {!standalone && (
          <button type="button" class="evidence-focus__action evidence-focus__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      <h1 class="evidence-focus__page-title font-serif">
        {selectedId && selected ? selected.title : 'Receipts behind the argument'}
      </h1>

      {selected ? (
        <article class="evidence-focus__record">
          <p class="evidence-focus__eyebrow font-mono">
            {claimBadgeKind && <ClaimBadge kind={claimBadgeKind} />}
            <span>{selected.evidenceClass}</span>
          </p>
          {!selectedId && <h2 class="evidence-focus__title font-serif">{selected.title}</h2>}

          <p class="evidence-focus__receipt-date font-mono">
            Receipt date: {formatDate(receiptDate)}
          </p>

          <dl class="evidence-focus__facts">
            <div>
              <dt>Capture type</dt>
              <dd>{selected.captureType}</dd>
            </div>
            <div>
              <dt>Event date</dt>
              <dd>{formatDate(selected.eventDate)}</dd>
            </div>
            <div>
              <dt>Recorded date</dt>
              <dd>{formatDate(selected.recordedDate)}</dd>
            </div>
            <div>
              <dt>Verified at</dt>
              <dd>{formatDate(selected.verifiedAt)}</dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>{selected.sourceUrl ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Source revision</dt>
              <dd>{selected.sourceRevision ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Publicability</dt>
              <dd>{selected.publicability}</dd>
            </div>
          </dl>

          <div class="evidence-focus__claim-split">
            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">What this supports</p>
              <ul>
                {selected.supports.map((line) => <li>{line}</li>)}
              </ul>
            </div>

            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">Limits</p>
              <ul>
                {selected.limitations.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </div>

          {selected.publicCapturePath ? (
            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">Capture</p>
              <p class="evidence-focus__capture-path">{selected.publicCapturePath}</p>
            </div>
          ) : (
            <p class="evidence-focus__no-capture">
              No standalone capture asset is published for this record; its capture type is{' '}
              <strong>{selected.captureType}</strong>.
            </p>
          )}

          {essaySlug && selected.relatedSceneIds.length > 0 && (
            <nav class="evidence-focus__figure-links" aria-label="Related figures">
              <p class="evidence-focus__section-label font-mono">Related figures</p>
              <ul>
                {selected.relatedSceneIds.map((sceneId) => (
                  <li><a href={`/essays/${essaySlug}/figure/${sceneId}/`}>View {sceneId} figure &rarr;</a></li>
                ))}
              </ul>
            </nav>
          )}
        </article>
      ) : <p class="evidence-focus__intro">No public receipts are available for this essay.</p>}
    </div>

    <aside class="evidence-focus__rail">
      <EvidenceGuide />
      <ReceiptIndex records={records} currentId={selectedRecordId} />
    </aside>
  </div>
</div>

<style>
  .evidence-focus__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .evidence-focus__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .evidence-focus__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
