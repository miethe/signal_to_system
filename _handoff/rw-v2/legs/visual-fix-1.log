---
/**
 * Figure — editorial "engineering plate" treatment for illustrations.
 *
 * Renders a warm-paper plate with corner tick marks, suitable for
 * schematic / blueprint-style figures. The plate stays light in both
 * themes on purpose: in dark mode it reads as a luminous drawing card
 * floating on the navy page.
 *
 * Variants:
 *   - default:   inline article figure with mono "Fig · NN" label + caption
 *                (unchanged from the original component)
 *   - hero:      frontispiece plate (no caption, larger padding; unchanged)
 *   - inline:    like default, but never breaks out of the `.prose-custom`
 *                reading measure — for small supporting figures
 *   - wide:      breaks out further than default/inline — for diagrams that
 *                need more than the 72ch measure
 *   - technical: like wide, with a distinct "schematic" plate treatment
 *                (dashed border, teal label) instead of the editorial one
 *
 * `expandable` gates the existing lightbox/dialog: on by default for every
 * variant except `hero`, which stays non-expandable unless a `caption` is
 * also supplied (matching its current no-caption, frontispiece-only use).
 * `mobileSrc` swaps in a `<picture>` element with a narrow-viewport source.
 * `longDescription` is exposed to screen readers only, via `aria-describedby`
 * on the figure, for dense technical figures that need more than `alt` text.
 *
 * `figureId` (paired with `slug`) is the opt-in reading-experience-v2 path
 * (ARCHITECTURE.md §5, V7): when both are supplied, the enlarge trigger
 * becomes a real link to `/essays/<slug>/figure/<figureId>/` (data-kind
 * "figure", data-key `figureId`) instead of opening this component's own
 * private `<dialog>` — no-JS/direct-link both work because the route is a
 * real static page, and this component never renders its private dialog
 * for a figureId figure (risk 3: never two dialog mechanisms open on one
 * figure). `FocusHost` (P0-C) hijacks that link's click later; until then
 * it behaves as an ordinary link to the standalone figure route. Every
 * other figure on the site keeps using the private lightbox, untouched.
 *
 * Every prop from the original component (`src`, `alt`, `caption`, `number`,
 * `credit`, `creditHref`, `variant: 'default' | 'hero'`) keeps working
 * unchanged — this file is an additive extension, not a rewrite.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  number?: string;
  credit?: string;
  creditHref?: string;
  variant?: 'default' | 'hero' | 'inline' | 'wide' | 'technical';
  expandable?: boolean;
  width?: number;
  height?: number;
  mobileSrc?: string;
  longDescription?: string;
  figureId?: string;
  slug?: string;
}

const {
  src,
  alt,
  caption,
  number,
  credit,
  creditHref,
  variant = 'default',
  expandable,
  width,
  height,
  mobileSrc,
  longDescription,
  figureId,
  slug,
} = Astro.props;

const isHero = variant === 'hero';
const showCaption = !isHero && (number || caption || credit);

// Every variant is expandable by default; the hero frontispiece is the one
// exception (no caption today, so no lightbox unless one is supplied).
const canExpand = expandable ?? (isHero ? Boolean(caption) : true);

// Opt-in FocusHost path — see the header comment. Both props are required
// together; a figureId without a slug (or vice versa) falls back to the
// ordinary private lightbox rather than building a broken href.
const focusHref = figureId && slug ? `/essays/${slug}/figure/${figureId}/` : undefined;

// Only allocated when needed — most figures carry no long description.
const descId = longDescription
  ? `figure-desc-${crypto.randomUUID().slice(0, 8)}`
  : undefined;
---

<figure
  class:list={[
    'figure-plate',
    'lift-hover',
    isHero && 'figure-plate--hero',
    variant === 'inline' && 'figure-plate--inline',
    variant === 'wide' && 'figure-plate--wide',
    variant === 'technical' && 'figure-plate--technical',
  ]}
  data-enlargeable-figure={canExpand ? 'true' : undefined}
  aria-describedby={descId}
>
  <span class="figure-plate__corner figure-plate__corner--tl" aria-hidden="true"></span>
  <span class="figure-plate__corner figure-plate__corner--tr" aria-hidden="true"></span>
  <span class="figure-plate__corner figure-plate__corner--bl" aria-hidden="true"></span>
  <span class="figure-plate__corner figure-plate__corner--br" aria-hidden="true"></span>

  <div class="figure-plate__frame">
    {canExpand && <span class="figure-plate__header" aria-hidden="true"><span>{number ? `Figure ${number}` : 'Figure'}</span><span>Enlarge figure ↗</span></span>}
    {
      canExpand ? (
        <a
          class="figure-plate__enlarge"
          href={focusHref ?? src}
          aria-label={`Enlarge: ${alt}`}
          aria-haspopup="dialog"
          data-figure-trigger={focusHref ? undefined : true}
          data-kind={focusHref ? 'figure' : undefined}
          data-key={focusHref ? figureId : undefined}
        >
          {mobileSrc ? (
            <picture>
              <source media="(max-width: 640px)" srcset={mobileSrc} />
              <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
            </picture>
          ) : (
            <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          )}
          <span class="figure-plate__enlarge-affordance" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h6v6" />
              <path d="m21 3-7 7" />
              <path d="M9 21H3v-6" />
              <path d="m3 21 7-7" />
            </svg>
          </span>
        </a>
      ) : mobileSrc ? (
        <picture>
          <source media="(max-width: 640px)" srcset={mobileSrc} />
          <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
        </picture>
      ) : (
        <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      )
    }
  </div>

  {showCaption && (
    <figcaption class="figure-plate__caption">
      {(number || caption) && (
        <span class="figure-plate__caption-main">
          {number && <span class="figure-plate__label">Fig · {number}</span>}
          {caption && <span class="figure-plate__text">{caption}</span>}
        </span>
      )}
      {credit && (
        <span class="figure-plate__credit">
          {creditHref ? <a href={creditHref}>{credit}</a> : credit}
        </span>
      )}
    </figcaption>
  )}

  {longDescription && (
    <p id={descId} class="sr-only">{longDescription}</p>
  )}

  {canExpand && !focusHref && (
    <dialog
      class="figure-lightbox"
      aria-label={`Enlarged figure: ${alt}`}
      data-figure-dialog
    >
      <div class="figure-lightbox__panel">
        <button class="figure-lightbox__close" type="button" aria-label="Close enlarged figure" data-figure-close>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
        <img src={src} alt={alt} loading="lazy" decoding="async" />
        <p class="figure-lightbox__caption">
          {caption ?? alt}
        </p>
      </div>
    </dialog>
  )}
</figure>

<script>
  const initializeFigureLightboxes = () => {
    document.querySelectorAll<HTMLElement>('[data-enlargeable-figure]').forEach((figure) => {
      if (figure.dataset.figureLightboxReady === 'true') return;

      const trigger = figure.querySelector<HTMLAnchorElement>('[data-figure-trigger]');
      const dialog = figure.querySelector<HTMLDialogElement>('[data-figure-dialog]');
      const closeButton = figure.querySelector<HTMLButtonElement>('[data-figure-close]');
      if (!trigger || !dialog || !closeButton || typeof dialog.showModal !== 'function') return;

      figure.dataset.figureLightboxReady = 'true';
      let previousBodyOverflow = '';

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
        closeButton.focus();
      });

      closeButton.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = previousBodyOverflow;
        trigger.focus();
      });
    });
  };

  initializeFigureLightboxes();
  document.addEventListener('astro:page-load', initializeFigureLightboxes);
</script>
