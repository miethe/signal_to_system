---
import { site } from '../../data/site';

interface Props {
  variant?: 'featured' | 'sidebar' | 'compact';
  headingLevel?: 'h2' | 'h3';
  showSocials?: boolean;
}

const { variant = 'compact', headingLevel: Heading = 'h2', showSocials } = Astro.props;
const isFeatured = variant === 'featured';
const isSidebar = variant === 'sidebar';
const shouldShowSocials = showSocials ?? isFeatured;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const profileLinks = site.author.profileLinks.filter((link) => normalizePath(link.href) !== currentPath);
const socialLinks = [
  { label: 'GitHub', href: site.author.social.github },
  { label: 'LinkedIn', href: site.author.social.linkedin },
  { label: 'Twitter / X', href: site.author.social.twitter },
];
---

<aside
  aria-label={`About the author, ${site.author.name}`}
  class:list={[
    'author-profile relative overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-ambient',
    isFeatured && 'rounded-2xl p-6 sm:p-7',
    isSidebar && 'rounded-xl p-5',
    variant === 'compact' && 'rounded-xl p-5 sm:p-6',
  ]}
>
  {isFeatured && (
    <div
      class="pointer-events-none absolute -right-10 -top-14 h-36 w-36 rounded-full bg-[var(--accent-subtle)] opacity-60 blur-2xl"
      aria-hidden="true"
    />
  )}

  <div class:list={['relative', variant === 'compact' && 'sm:flex sm:items-center sm:gap-5']}>
    <div class:list={['flex items-center gap-4', variant === 'compact' && 'sm:min-w-64']}>
      <img
        src={site.author.avatar.src}
        alt=""
        width={site.author.avatar.width}
        height={site.author.avatar.height}
        loading={isFeatured ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'shrink-0 rounded-full border border-[var(--border)] bg-[var(--bg-muted)] object-cover object-top ring-2 ring-[var(--bg-surface)]',
          isFeatured ? '!m-0 !h-20 !w-20 !rounded-full' : '!m-0 !h-14 !w-14 !rounded-full',
        ]}
      />
      <div class="min-w-0">
        <p class="font-mono mb-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
          {isSidebar ? 'Written by' : 'The author'}
        </p>
        <Heading class:list={['font-serif font-bold text-[var(--text-primary)]', isFeatured ? 'text-2xl' : 'text-lg']}>
          {site.author.name}
        </Heading>
        <p class="author-profile__role mt-1 text-xs leading-relaxed text-[var(--text-tertiary)]">{site.author.role}</p>
      </div>
    </div>

    <div class:list={['author-profile__extra border-[var(--border-subtle)]', variant === 'compact' ? 'mt-5 border-t pt-5 sm:mt-0 sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0' : 'mt-5 border-t pt-5']}>
      <div class="author-profile__extra-inner">
      <p class:list={['leading-relaxed text-[var(--text-secondary)]', isSidebar ? 'text-sm' : 'text-sm sm:text-[15px]']}>
        {isFeatured ? site.author.bioLong : site.author.bioShort}
      </p>

      {profileLinks.length > 0 && (
      <nav aria-label="Author links" class="mt-4 flex flex-wrap items-center gap-1">
        {profileLinks.map((link, index) => (
          <a
            href={link.href}
            class:list={[
              'focus-ring inline-flex min-h-11 items-center gap-1.5 rounded-md px-2 text-sm font-medium underline-offset-4 hover:underline',
              index === 0 ? 'text-[var(--accent)] hover:text-[var(--accent-hover)]' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
            ]}
          >
            {link.label}
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        ))}
      </nav>
      )}

      {shouldShowSocials && (
        <nav aria-label="Author social profiles" class:list={['flex flex-wrap items-center gap-1', profileLinks.length > 0 ? 'border-t border-[var(--border-subtle)] pt-1' : 'mt-4']}>
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="focus-ring inline-flex min-h-11 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-[var(--text-tertiary)] underline-offset-4 hover:text-[var(--text-primary)] hover:underline"
            >
              {link.label}
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7" /><path d="M7 7h10v10" />
              </svg>
            </a>
          ))}
        </nav>
      )}
      </div>
    </div>
  </div>
</aside>

<style>
  /* Keep the card's compact rhythm when embedded inside `.prose-custom`. */
  .author-profile {
    margin: 0;
    border-color: var(--border-subtle);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-style: normal;
  }

  .author-profile :global(h2),
  .author-profile :global(h3),
  .author-profile :global(p) {
    margin: 0;
    border: 0;
  }

  /*
   * Collapse hooks: the `.is-collapsed` class is toggled externally (by
   * PostSidebar, only on the "sidebar" variant instance used in the post
   * rail) via an IntersectionObserver on the article header — never set by
   * this component itself, so `featured`/`compact` usages are unaffected.
   */
  .author-profile__role {
    max-height: 1.5rem;
    overflow: hidden;
    opacity: 1;
    transition: max-height 0.25s ease, opacity 0.2s ease, margin-top 0.25s ease;
  }

  .author-profile__extra {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
    transition:
      grid-template-rows 0.25s ease,
      opacity 0.2s ease,
      margin-top 0.25s ease,
      padding-top 0.25s ease,
      border-top-width 0.25s ease;
  }

  .author-profile__extra-inner {
    overflow: hidden;
    min-height: 0;
  }

  .author-profile.is-collapsed {
    padding: 0.625rem 0.875rem;
    transition: padding 0.25s ease;
  }

  .author-profile.is-collapsed .author-profile__role {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
  }

  /*
   * The grid-rows trick above only collapses the CONTENT height to 0 — the
   * block's own margin-top/border-top/padding-top (mt-5 border-t pt-5 from
   * the markup) are box properties of this element itself, not its grid
   * track, so they keep reserving space even at grid-template-rows: 0fr.
   * Zero them explicitly so no dead space survives the collapse. `!important`
   * is safe here: `.is-collapsed` never applies to the featured/compact
   * variants that rely on the un-collapsed mt-5/border-t/pt-5 (or compact's
   * sm:border-l) utility values.
   */
  .author-profile.is-collapsed .author-profile__extra {
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: 0 !important;
    padding-top: 0 !important;
    border-top-width: 0 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .author-profile,
    .author-profile__role,
    .author-profile__extra {
      transition: none;
    }
  }

  /* perf-lite drops the animation, never the collapse itself — the class
     toggle in PostSidebar's script always runs regardless of this mode. */
  :global(html.perf-lite) .author-profile,
  :global(html.perf-lite) .author-profile__role,
  :global(html.perf-lite) .author-profile__extra {
    transition: none;
  }
</style>
FILE src/components/content/ReadingCompanion.astro
---
/**
 * ReadingCompanion — the one sticky reading companion for an essay
 * (reading-experience-v2 DIRECTION.md V5, ARCHITECTURE.md §5). Refactor of
 * `PostSidebar.astro` to the three-slot contract from
 * `02_EXPERIENCE_SPEC.md`§6:
 *
 *   1. Compact nearby-chapter outline + an "All sections" action.
 *   2. `ThreadDock`, when the post has a thread.
 *   3. At most one authored `ContextualNote`, selected from the post's
 *      bounded note registry as the active section changes.
 *
 * `AuthorProfile` and `ExecutiveSignal` are no longer inside this sticky
 * column at all (V5: they sit in flow at the top of the rail and scroll
 * away) — `PostLayout` renders `AuthorProfile` above this component,
 * outside its sticky wrapper. That removal is also what retires the old
 * accordion between the author card, the takeaway pill, and the thread
 * rail: with only two small, independently-sized blocks left in the
 * column (the outline and the six-item `ThreadDock`), there's no
 * competing-for-space problem left to solve, so this component's script
 * is a straight scroll-spy + windowed-list fit, not an accordion
 * coordinator.
 *
 * Posts without a thread get outline-only behavior (the same generic
 * fallback `PostSidebar` provided) — `slug`/`thread` are both optional.
 */
import ThreadDock from './ThreadDock.astro';
import ContextualNote from './ContextualNote.astro';
import { threads } from '../../data/threads';
import { contextualNotes } from '../../data/contextual-notes';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug?: string;
  headings?: Heading[];
}

const { slug, headings = [] } = Astro.props;
const thread = slug ? threads[slug] : undefined;
const notes = slug ? contextualNotes[slug] ?? [] : [];

// The footnotes section starts at the "Footnotes" heading (id
// `footnote-label`, injected by the remark footnotes plugin) — exclude it
// and everything after it so the outline never lists footnote content.
const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = rawToc.length >= 2;

// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
// under, so the client script can show only the active section's
// sub-headings instead of the full flat list.
let h2Count = 0;
let currentH2Slug: string | null = null;
const toc = rawToc.map((heading) => {
  if (heading.depth === 2) {
    h2Count += 1;
    currentH2Slug = heading.slug;
    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
  }
  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
});
---

<div class="reading-companion flex flex-col gap-3" data-reading-companion>
  {
    showToc && (
      <div
        class="reading-companion__block reading-companion__outline rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
        data-companion-outline
      >
        <div class="reading-companion__header font-mono flex items-center justify-between gap-2 px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
          <span>On this page</span>
          <button
            type="button"
            class="reading-companion__all-toggle focus-ring text-[var(--text-tertiary)] hover:text-[var(--accent)]"
            data-companion-all-toggle
            aria-pressed="false"
          >
            All sections
          </button>
        </div>

        <div class="reading-companion__body" data-companion-scroll>
          <div class="reading-companion__rail" aria-hidden="true">
            <div class="reading-companion__rail-fill" data-companion-fill />
          </div>
          <nav aria-label="Table of contents">
            <p class="reading-companion__more" data-companion-more="above" hidden />
            <ol class="reading-companion__list">
              {toc.map((heading) => (
                <li
                  class:list={['reading-companion__item', heading.depth === 3 && 'reading-companion__item--sub']}
                  data-companion-item
                  data-companion-depth={heading.depth}
                  data-companion-parent={heading.parentSlug ?? ''}
                >
                  <a
                    href={`#${heading.slug}`}
                    class="reading-companion__link"
                    data-companion-link
                    data-companion-target={heading.slug}
                  >
                    {heading.depth === 2 && (
                      <span class="reading-companion__index font-mono" aria-hidden="true">
                        {String(heading.sectionNumber).padStart(2, '0')}
                      </span>
                    )}
                    <span class="reading-companion__label line-clamp-2">{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="reading-companion__more" data-companion-more="below" hidden />
          </nav>
        </div>
      </div>
    )
  }

  {thread && slug && <ThreadDock slug={slug} />}
  <ContextualNote notes={notes} />
</div>

<style>
  .reading-companion__header {
    border-bottom: 1px solid var(--border-subtle);
  }

  .reading-companion__all-toggle {
    font-family: var(--font-mono);
