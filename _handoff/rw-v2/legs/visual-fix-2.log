  title={title}
  description={pageDescription}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 z-[60] h-[3px] bg-[var(--accent)] transition-none"
    style="width: 0%;"
    aria-hidden="true"
  ></div>

  <article
    class:list={[
      'post-layout mx-auto grid w-full max-w-[var(--measure)] items-start px-4 py-12 sm:px-6 lg:px-8 xl:max-w-7xl xl:grid-cols-[minmax(0,var(--measure))_minmax(14rem,18rem)] xl:justify-center xl:gap-x-12',
      isRegistryWave && 'post-layout--registry-wave',
    ]}
  >
    <!-- This lives inside .post-layout so the shared --measure token is
         resolvable. It remains ahead of the title/dek/meta at every size. -->
    {
      isFrontispiece && heroImage && (
        <div class:list={['w-full pt-0', isRegistryWave ? 'xl:col-start-1 xl:row-start-1' : 'xl:col-span-2 xl:row-start-1']}>
          <Figure src={heroImage} alt={resolvedHeroAlt} variant="hero" />
        </div>
      )
    }

    <!-- Article header -->
    <header
      id="post-header"
      class:list={[
        'mb-16 min-w-0 space-y-6 pb-4 xl:col-start-1',
        isRegistryWave ? 'xl:row-start-2' : isFrontispiece ? 'xl:row-start-2' : 'xl:row-start-1',
      ]}
    >
      {
        category && (
          <div>
            <span class="font-mono inline-block rounded-full bg-[var(--accent-subtle)] px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[var(--accent-text)] ring-1 ring-inset ring-[var(--border-subtle)]">
              {category}
            </span>
          </div>
        )
      }

      <h1 class="font-serif text-4xl font-bold leading-[1.1] tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-7xl">
        {title}
      </h1>

      {
        excerpt && (
          <p class="text-lg leading-relaxed text-[var(--text-tertiary)]">{excerpt}</p>
        )
      }

      <!-- Series wayfinding: arc position and/or mini-series part. Grouped
           with the dek (it answers "where does this sit?", which is editorial
           context) and kept away from the grey tag chips below, so the two
           chip rows never read as one muddled row. -->
      {
        slug && (
          <SeriesWayfinding
            slug={slug}
            collection="posts"
            series={series}
            seriesPart={seriesPart}
          />
        )
      }

      <!-- Meta row -->
      <div class="font-mono flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--text-disabled)]">
        <time datetime={publishedISO} class="text-[var(--text-tertiary)]">
          {formatDate(date)}
        </time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated{' '}
                <time datetime={updatedISO}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
        {
          readTime && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{readTime} min read</span>
            </>
          )
        }
      </div>

      <!-- Tags -->
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-1">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="rounded-full bg-[var(--bg-muted)] px-3 py-0.5 text-xs font-medium text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-surface)] hover:text-[var(--text-secondary)]"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <!-- Desktop rail follows the header in source order and spans the
         article column. Reading-experience-v2 DIRECTION.md V5: the author
         card sits in flow here and scrolls away with the page; only
         ReadingCompanion (outline + ThreadDock + optional ContextualNote)
         is the sticky surface at depth. -->
    <div
      class:list={[
        isRegistryWave
          ? 'hidden xl:col-start-2 xl:row-span-3 xl:block xl:self-stretch'
          : 'hidden xl:col-start-2 xl:row-span-2 xl:block xl:self-stretch',
        isRegistryWave ? 'xl:row-start-1' : isFrontispiece ? 'xl:row-start-2' : 'xl:row-start-1',
      ]}
    >
      <div class="mb-4">
        <AuthorProfile variant="sidebar" headingLevel="h2" />
      </div>
      {
        whyItMatters && (
          <div class="mb-4">
            <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
          </div>
        )
      }
      <div class="xl:sticky xl:top-24 xl:pr-1">
        <ReadingCompanion slug={slug} headings={headings} />
}

body {
  background-color: var(--bg-base);
  color: var(--text-primary);
  min-height: 100dvh;
  transition:
    background-color 200ms ease,
    color 200ms ease;
}

.dark body {
  background: radial-gradient(circle at 25% 0%, rgb(20 53 91 / 18%), transparent 42%), var(--bg-base);
}

/* Registry Wave v2 is deliberately scoped to its reading surface. The
   values match the accepted two-pane composition without changing legacy
   essays, project pages, or Dev Stories. */
.post-layout--registry-wave {
  --measure: 46rem;
}

.post-layout--registry-wave .prose-custom > .executive-signal {
  display: none;
}

@media (min-width: 1280px) {
  .post-layout--registry-wave {
    grid-template-columns: minmax(0, 756px) 266px;
    column-gap: 22px;
    max-width: 1118px;
    padding-top: 1.5rem;
  }

  .post-layout--registry-wave #post-header {
    margin: 18px 0 24px;
    padding: 0;
    row-gap: 10px;
  }

  .post-layout--registry-wave #post-header h1 {
    max-width: 760px;
    margin: 2px 0 4px;
    font-size: 43px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .post-layout--registry-wave #post-header > p {
    font-size: 1rem;
    line-height: 1.48;
  }

  .post-layout--registry-wave .prose-custom {
    max-width: 100%;
  }

}

@media (max-width: 1279px) {
  .post-layout--registry-wave {
    max-width: 430px;
    padding-top: 8px;
    padding-inline: 20px;
  }

  .post-layout--registry-wave #post-header {
    margin-bottom: 1.25rem;
    row-gap: 8px;
  }

  .post-layout--registry-wave #post-header h1 {
    font-size: 26px;
    line-height: 1.08;
  }
}

/* Smooth color transitions for interactive elements */
a,
button,
input,
textarea,
select,
[role="button"] {
  transition:
    color 150ms ease,
    background-color 150ms ease,
    border-color 150ms ease,
    box-shadow 150ms ease,
    opacity 150ms ease;
}

/* --- Scrollbar (dark mode) --- */
@media (prefers-color-scheme: dark) {
  :root:not(.light) {
    scrollbar-color: #334155 #0f172a;
    scrollbar-width: thin;
  }
}

.dark {
  scrollbar-color: #334155 #0f172a;
  scrollbar-width: thin;
}

.dark ::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}


.prose-custom summary:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

.prose-custom details[open] > summary {
  margin-bottom: 0.75rem;
}

@media (prefers-reduced-motion: no-preference) {
  .prose-custom details {
    transition: border-color 150ms ease;
  }
}

/* --- Horizontal rules --- */
.prose-custom hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 2.5rem 0;
}

/* --- Images in prose --- */
.prose-custom img {
  border-radius: 0.5rem;
  border: 1px solid var(--border-subtle);
  margin: 2rem auto;
  box-shadow: var(--shadow-md);
}

.prose-custom figure {
  margin: 2rem 0;
}

.prose-custom figcaption {
  text-align: center;
  font-size: 0.875rem;
  color: var(--text-tertiary);
  margin-top: 0.75rem;
  font-style: italic;
}

/* Supporting visual material can borrow a little of the surrounding grid at
   laptop widths, while prose keeps its deliberate reading measure. */
@media (min-width: 1024px) {
  .prose-custom > .figure-plate,
  .prose-custom > table {
    width: calc(100% + 3rem);
    max-width: none;
    margin-right: -1.5rem;
    margin-left: -1.5rem;
  }
}

/* ============================================================
   FIGURE PLATE
   Editorial "engineering plate" treatment for schematic figures.
   Artwork stays light in its own frame; in dark mode the surrounding plate
   becomes a restrained navy panel so it belongs to the page.
   Used via <Figure /> component, and by PostLayout for heroImage.
   ============================================================ */
.figure-plate {
  position: relative;
  margin: 2.75rem 0;
  padding: 1.375rem 1.375rem 1.125rem;
  background: #f6f8fb;
  border: 1px solid #e2e8f0;
  border-radius: 0.625rem;
  box-shadow:
    0 1px 2px rgba(15, 23, 42, 0.04),
    0 8px 24px -8px rgba(15, 23, 42, 0.1);
}

.dark .figure-plate {
  background: linear-gradient(180deg, #081d34 0%, #06172b 100%);
  border-color: #234b72;
  box-shadow:
    0 0 0 1px rgba(99, 102, 241, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.35),
    0 22px 56px -14px rgba(79, 70, 229, 0.4);
}

.dark .figure-plate__frame { background: #07182d; }
.dark .figure-plate__header { height: 34px; padding: 0 16px; align-items: center; color: #b8c5d9; background: rgb(8 29 52 / 95%); border-color: #214563; letter-spacing: .18em; }
.dark .figure-plate__caption,
.dark .prose-custom .figure-plate__caption { margin-top: 14px; padding: 10px 0 0; border-top: 1px solid #294b69; color: #aebcd0; }
.dark .figure-plate__text,
.dark .figure-plate__credit { color: #aebcd0; }
.dark .figure-plate__label { color: #6fd8ff; }

/* Hero variant — frontispiece on the post */
.figure-plate--hero {
  margin: 0 0 3.5rem;
  padding: 1.5rem 1.5rem 1.25rem;
}

.post-layout--registry-wave .figure-plate--hero {
  width: 100%;
  height: 220px;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 10px 30px rgb(0 0 0 / 22%);
}

.post-layout--registry-wave .figure-plate--hero .figure-plate__corner,
.post-layout--registry-wave .figure-plate--hero .figure-plate__header {
  display: none;
}

.post-layout--registry-wave .figure-plate--hero .figure-plate__frame,
.post-layout--registry-wave .figure-plate--hero img {
  width: 100%;
  height: 100%;
  border-radius: 0;
  object-fit: cover;
}

@media (max-width: 1279px) {
  .post-layout--registry-wave .figure-plate--hero {
    height: auto;
    aspect-ratio: 2.25 / 1;
    margin-bottom: 12px;
    border-radius: 6px;
  }
}

/* Inline variant — stays within the prose measure, cancelling the grid
   breakout the default plate gets at lg (see the `.prose-custom >
   .figure-plate` rule below). For small supporting figures. */
@media (min-width: 1024px) {
  .prose-custom > .figure-plate.figure-plate--inline {
    width: 100%;
    max-width: 100%;
    margin-right: 0;
    margin-left: 0;
  }
}

/* Wide / technical variants — break out further than the default plate for
   diagrams that need more than the 72ch reading measure. */
@media (min-width: 1024px) {
  .prose-custom > .figure-plate.figure-plate--wide,
  .prose-custom > .figure-plate.figure-plate--technical {
    width: min(calc(100% + 6rem), calc(100vw - 2rem));
    max-width: none;
    margin-right: -3rem;
    margin-left: -3rem;
  }
}

/* Technical variant — a thinner, dashed "schematic" plate treatment,
   distinct from the warm editorial plate used for photos/illustrations. */
.figure-plate--technical {
  border-width: 1px;
  border-style: dashed;
  border-color: #94a3b8;
}

.dark .figure-plate--technical {
  border-color: rgba(45, 212, 191, 0.35);
}

.figure-plate--technical .figure-plate__label {
  color: #0f766e;
}

/* Corner tick marks — four 10px L-brackets echoing drafting sheets */
.figure-plate__label {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #4f46e5;
  padding-top: 0.0625rem;
  white-space: nowrap;
}

.figure-plate__text {
  font-family: var(--font-sans);
  color: #475569;
  font-weight: 400;
}

.figure-plate__credit {
  color: #64748b;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  line-height: 1.4;
}

.figure-plate__credit a {
  color: inherit;
  text-underline-offset: 0.18em;
}

.figure-plate__credit a:hover {
  color: #334155;
}

.figure-lightbox {
  width: min(96vw, 100rem);
  max-width: 96vw;
  max-height: 92vh;
  margin: auto;
  padding: 0;
  overflow: visible;
  color: var(--text-primary);
  background: transparent;
  border: 0;
  animation: figure-lightbox-in 160ms ease-out;
}

.figure-lightbox::backdrop {
  background: var(--color-bg-overlay);
  animation: figure-lightbox-backdrop-in 160ms ease-out;
}

.figure-lightbox__panel {
  position: relative;
  display: flex;
  max-height: 92vh;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.figure-lightbox__panel img,
.prose-custom .figure-lightbox__panel img {
  display: block;
  width: auto;
  max-width: calc(96vw - 2rem);
  height: auto;
  max-height: calc(92vh - 5rem);
  margin: auto;
  border: 0;
  border-radius: var(--radius-md);
  box-shadow: none;
  object-fit: contain;
}

.figure-lightbox__close {
  position: absolute;
  z-index: 1;
  top: 1.5rem;
  right: 1.5rem;
  display: grid;
  width: 2.25rem;
  height: 2.25rem;
  place-items: center;
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
}

.figure-lightbox__close:hover {
  color: var(--accent-hover);
}

.figure-lightbox__close:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}

.figure-lightbox__caption {
  margin: 0;
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 0.875rem;
  line-height: 1.5;
  text-align: center;
}

@keyframes figure-lightbox-in {
  from { opacity: 0; transform: scale(0.985); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes figure-lightbox-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (hover: none) {
  .figure-plate__enlarge-affordance {
    opacity: 0.8;
  }
}

@media (prefers-reduced-motion: reduce) {
  .figure-plate__enlarge-affordance {
    transition: none;
  }

  .figure-lightbox,
  .figure-lightbox::backdrop {
    animation: none;
  }
}

@media (max-width: 640px) {
  .figure-plate {
    margin: 2rem 0;
    padding: 1rem 1rem 0.875rem;
  }
  .figure-plate--hero {
    margin: 0 0 2.5rem;
    padding: 1.125rem 1.125rem 1rem;
  }
  .figure-plate__caption {
    gap: 0.3rem;
  }
  .figure-plate__caption-main {
    flex-direction: column;
    gap: 0.25rem;
  }
}

@media (max-width: 640px) {
  .post-layout--registry-wave .prose-custom { font-size: 15px; line-height: 1.48; }
  .post-layout--registry-wave .prose-custom > p:first-child { font-size: 15px; line-height: 1.45; }
  .post-layout--registry-wave .figure-plate { margin: 18px 0; padding: 8px; border-radius: 7px; }
  .post-layout--registry-wave .thread-scene { margin: 22px 0; padding: 12px; }
}

/* --- Strong & em --- */
.prose-custom strong {
  font-weight: 700;
  color: var(--text-primary);
}

.prose-custom em {
  color: var(--text-primary);
}

/* --- Keyboard / mark --- */
.prose-custom kbd {
