---
/**
 * RevisionNote — a thin, one-line revision marker (date plus a
 * `<details>` disclosure), for posts that want a quieter signal than a
 * full callout box. Replaces `EditionBanner` for this post only;
 * `EditionBanner.astro` itself is untouched and stays available where the
 * boxed treatment is still wanted.
 *
 * The line stays one line by keeping the summary text collapsed by
 * default — only "Revised {date}" and the disclosure trigger are visible
 * at rest; expanding reveals the revision note and, if given, the
 * changelog link.
 */
interface Props {
  note: string;
  revisedDate: string;
  changelogHref?: string;
}

const { note, revisedDate, changelogHref } = Astro.props;
---

<p class="revision-note">
  <span class="revision-note__date">Revised {revisedDate}</span>
  <details class="revision-note__details">
    <summary>What&rsquo;s changed?</summary>
    <span class="revision-note__note">
      {note}
      {
        changelogHref && (
          <>
            {' '}
            <a href={changelogHref}>View full changelog</a>
          </>
        )
      }
    </span>
  </details>
</p>

<style>
  .revision-note {
    margin: 0 0 1.5rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .revision-note__date {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .revision-note__details {
    display: inline;
    margin-left: 0.5rem;
  }

  .revision-note__details summary {
    display: inline;
    list-style: none;
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
  }

  .revision-note__details summary::-webkit-details-marker {
    display: none;
  }

  .revision-note__details summary::before {
    content: '· ';
    color: var(--text-tertiary);
  }

  .revision-note__details summary:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .revision-note__note {
    display: block;
    margin-top: 0.4rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: normal;
    line-height: 1.6;
  }

  .revision-note__note a {
    color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .revision-note__note a:hover {
    color: var(--accent-hover);
  }

  :global(.post-layout--registry-wave .revision-note) { display: flex; align-items: center; min-height: 38px; margin: 0 0 18px; padding: 0 4px; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); font-size: 11px; line-height: 1; }
  :global(.post-layout--registry-wave .revision-note__details) { margin-left: 8px; }
  :global(.post-layout--registry-wave .revision-note__note) { line-height: 1.45; }
</style>
---
/**
 * ExecutiveSignal — the post-level executive read: "why this matters" and,
 * when the post has one, "what to carry forward". Replaces the ad-hoc
 * `whyItMatters` aside plus the in-body `LeaderTakeaway` render that used to
 * sit at the top of the body.
 *
 * Reading-experience-v2 DIRECTION.md V5: the takeaway now always renders
 * in flow here, at every breakpoint — there is no more rail-only takeaway
 * card to avoid duplicating (the old `takeawayPlacement`/`showRailTakeaway`
 * split retired with `PostSidebar`). Two columns at `sm:` and up when a
 * takeaway is present; stacks otherwise.
 */
interface Props {
  whyItMatters: string;
  takeaway?: string;
}

const { whyItMatters, takeaway } = Astro.props;
const hasTakeaway = Boolean(takeaway);
---

<aside
  class:list={['executive-signal', 'lift-hover', { 'executive-signal--split': hasTakeaway }]}
  role="note"
  aria-label="Executive signal"
>
  <div class="executive-signal__col">
    <p class="executive-signal__eyebrow">Why this matters</p>
    <p class="executive-signal__body">{whyItMatters}</p>
  </div>
  {
    hasTakeaway && (
      <div class="executive-signal__col executive-signal__col--takeaway">
        <p class="executive-signal__eyebrow">Carry this forward</p>
        <p class="executive-signal__body">{takeaway}</p>
      </div>
    )
  }
</aside>

<style>
  .executive-signal {
    position: relative;
    margin: 0 0 1.75rem;
    padding: 1.125rem 1.25rem 1.1875rem 1.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    box-shadow: var(--shadow-sm);
  }

  .executive-signal::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    border-radius: var(--radius-xl) 0 0 var(--radius-xl);
    background: var(--accent);
  }

  .executive-signal--split {
    display: grid;
    gap: 1.1rem;
  }

  @media (min-width: 640px) {
    .executive-signal--split {
      grid-template-columns: 1fr 1fr;
      gap: 1.1rem 1.75rem;
    }

    .executive-signal__col--takeaway {
      padding-left: 1.5rem;
      border-left: 1px solid var(--border-subtle);
    }
  }

  .executive-signal__eyebrow {
    margin: 0 0 0.4rem;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .executive-signal__body {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  :global(.dark) .executive-signal {
    min-height: 164px;
    margin: 0;
    padding: 17px 15px;
    border-color: #5548a8;
    border-radius: 9px;
    background: linear-gradient(145deg, #191a48 0%, #15143b 58%, #101d3b 100%);
    box-shadow: inset 0 0 28px rgb(108 74 255 / 12%), 0 8px 22px rgb(0 0 0 / 20%);
  }

  :global(.dark) .executive-signal::before { display: none; }
  :global(.dark) .executive-signal--split { display: block; }
  :global(.dark) .executive-signal__col--takeaway { margin-top: .8rem; padding: .8rem 0 0; border-top: 1px solid rgb(185 172 255 / 20%); border-left: 0; }
  :global(.dark) .executive-signal__eyebrow { color: #c5baff; }
  :global(.dark) .executive-signal__body { color: #c8d1e2; font-size: .75rem; line-height: 1.4; }
</style>
---
/**
 * ReadingCompanion — the one sticky reading companion for an essay
 * (reading-experience-v2 DIRECTION.md V5, ARCHITECTURE.md §5). Refactor of
 * `PostSidebar.astro` to the three-slot contract from
 * `02_EXPERIENCE_SPEC.md`§6:
 *
 *   1. Compact nearby-chapter outline + an "All sections" action.
 *   2. `ThreadDock`, when the post has a thread.
 *   3. At most one authored `ContextualNote`, selected from the post's
 *      bounded note registry as the active section changes.
 *
 * `AuthorProfile` and `ExecutiveSignal` are no longer inside this sticky
 * column at all (V5: they sit in flow at the top of the rail and scroll
 * away) — `PostLayout` renders `AuthorProfile` above this component,
 * outside its sticky wrapper. That removal is also what retires the old
 * accordion between the author card, the takeaway pill, and the thread
 * rail: with only two small, independently-sized blocks left in the
 * column (the outline and the six-item `ThreadDock`), there's no
 * competing-for-space problem left to solve, so this component's script
 * is a straight scroll-spy + windowed-list fit, not an accordion
 * coordinator.
 *
 * Posts without a thread get outline-only behavior (the same generic
 * fallback `PostSidebar` provided) — `slug`/`thread` are both optional.
 */
import ThreadDock from './ThreadDock.astro';
import ContextualNote from './ContextualNote.astro';
import { threads } from '../../data/threads';
import { contextualNotes } from '../../data/contextual-notes';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug?: string;
  headings?: Heading[];
}

const { slug, headings = [] } = Astro.props;
const thread = slug ? threads[slug] : undefined;
const notes = slug ? contextualNotes[slug] ?? [] : [];

// The footnotes section starts at the "Footnotes" heading (id
// `footnote-label`, injected by the remark footnotes plugin) — exclude it
// and everything after it so the outline never lists footnote content.
const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = rawToc.length >= 2;

// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
// under, so the client script can show only the active section's
// sub-headings instead of the full flat list.
let h2Count = 0;
let currentH2Slug: string | null = null;
const toc = rawToc.map((heading) => {
  if (heading.depth === 2) {
    h2Count += 1;
    currentH2Slug = heading.slug;
    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
  }
  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
});
---

<div class="reading-companion flex flex-col gap-3" data-reading-companion>
  {
    showToc && (
      <div
        class="reading-companion__block reading-companion__outline rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
        data-companion-outline
      >
        <div class="reading-companion__header font-mono flex items-center justify-between gap-2 px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
          <span>On this page</span>
          <button
            type="button"
            class="reading-companion__all-toggle focus-ring text-[var(--text-tertiary)] hover:text-[var(--accent)]"
            data-companion-all-toggle
            aria-pressed="false"
          >
            All sections
          </button>
        </div>

        <div class="reading-companion__body" data-companion-scroll>
          <div class="reading-companion__rail" aria-hidden="true">
            <div class="reading-companion__rail-fill" data-companion-fill />
          </div>
          <nav aria-label="Table of contents">
            <p class="reading-companion__more" data-companion-more="above" hidden />
            <ol class="reading-companion__list">
              {toc.map((heading) => (
                <li
                  class:list={['reading-companion__item', heading.depth === 3 && 'reading-companion__item--sub']}
                  data-companion-item
                  data-companion-depth={heading.depth}
                  data-companion-parent={heading.parentSlug ?? ''}
                >
                  <a
                    href={`#${heading.slug}`}
                    class="reading-companion__link"
                    data-companion-link
                    data-companion-target={heading.slug}
                  >
                    {heading.depth === 2 && (
                      <span class="reading-companion__index font-mono" aria-hidden="true">
                        {String(heading.sectionNumber).padStart(2, '0')}
                      </span>
                    )}
                    <span class="reading-companion__label line-clamp-2">{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="reading-companion__more" data-companion-more="below" hidden />
          </nav>
        </div>
      </div>
    )
  }

  {thread && slug && <ThreadDock slug={slug} />}
  <ContextualNote notes={notes} />
</div>

<style>
