---
/**
 * ThreadScene — inline per-beat rendering for a post's running thread,
 * placed adjacent to matching prose at each of the six canonical anchors
 * (reading-experience-v2 DIRECTION.md V3/V7, ARCHITECTURE.md §4). It looks
 * up its own beat from `threads.ts` by `slug` + `beatId` and renders the
 * canonical figure, the one real recap paragraph, a semantic kind label,
 * and an "Explore thread" link to the standalone Thread Focus route.
 *
 * `ThreadFocus.astro` renders the fuller composition from the exact same
 * beat record — recap is written once in `threads.ts` and both surfaces
 * read it, never a second hand-written explanation (V3).
 *
 * `composition` follows DIRECTION V6's four main-pane types. `measure`
 * (default) keeps the scene inside the article's prose measure; `pane`
 * breaks the whole scene out wider, for the four dense technical PNGs
 * named in this essay's build brief (incident, deployment, drift,
 * outcome). `split`/`inset` are accepted for forward compatibility with
 * V6's full set — this essay's six scenes use only `measure`/`pane` today,
 * so those two get a lighter, documented treatment rather than a full
 * adjacent-content slot this component doesn't have a use for yet.
 */
import Figure from './Figure.astro';
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  beatId: string;
  composition?: 'measure' | 'pane' | 'split' | 'inset';
}

const { slug, beatId, composition = 'measure' } = Astro.props;
const thread = threads[slug];
const beat = thread?.beats.find((candidate) => candidate.id === beatId);

if (!thread || !beat) {
  console.warn(
    `[ThreadScene] Unable to resolve beat "${beatId}" for thread "${slug}". Rendering nothing.`,
  );
}

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};

// Restrained cyan/violet split (DIRECTION V10): conceptual/mechanism beats
// (the two boundary-flagged, non-historical kinds) get the cyan structural
// accent on their kind label; historical/proposed keep the primary violet
// accent used everywhere else in the thread.
const kindUsesCyan = beat?.kind === 'conceptual' || beat?.kind === 'mechanism';
---

{
  thread && beat && (
    <section
      id={`thread-${beat.id}`}
      class:list={[
        'thread-scene lift-hover',
        composition === 'pane' && 'thread-scene--pane',
        composition === 'split' && 'thread-scene--split',
        composition === 'inset' && 'thread-scene--inset',
      ]}
      aria-labelledby={`thread-${beat.id}-label`}
    >
      <span class="thread-scene__corner thread-scene__corner--tl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--tr" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--bl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--br" aria-hidden="true" />

      <div class="thread-scene__body">
        <div class="thread-scene__head">
          <p class="thread-scene__eyebrow font-mono">
            <span class="thread-scene__count">
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true" class="thread-scene__eyebrow-sep">
              &middot;
            </span>
            <span class:list={['thread-scene__kind', kindUsesCyan && 'thread-scene__kind--cyan']}>
              {kindLabel[beat.kind] ?? beat.kind}
            </span>
          </p>
          <h3 id={`thread-${beat.id}-label`} class="thread-scene__label font-serif">
            {beat.label}
          </h3>
        </div>

        <p class="thread-scene__recap">{beat.recap}</p>

        <Figure
          src={beat.image.src}
          alt={beat.image.alt}
          caption={beat.image.caption}
          number={String(beat.n).padStart(2, '0')}
          longDescription={beat.longDescription}
          figureId={beat.id}
          slug={slug}
          variant={composition === 'pane' ? 'technical' : 'inline'}
        />

        <a class="thread-scene__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
          Explore this thread beat <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )
}

