/bin/zsh -lc "sed -n '250,310p' src/layouts/PostLayout.astro; sed -n '1,260p' src/components/content/Figure.astro; sed -n '1,180p' src/components/content/ThreadFocus.astro; sed -n '180,420p' src/components/content/ThreadFocus.astro; sed -n '400,460p' src/components/content/EvidenceFocus.astro" in /Users/miethe/dev/homelab/development/signal_to_system/.wt/rw-v2-essay
 succeeded in 0ms:

    <!-- Compact author context remains in the reading flow below desktop. -->
    <div class="mb-10 xl:hidden">
      <AuthorProfile variant="compact" headingLevel="h2" />
    </div>

    <!-- Hero illustration (engineering plate) — the frontispiece position
         (above the header) is rendered earlier and skips this slot. -->
    {
      !isFrontispiece && heroImage && (
        <Figure
          src={heroImage}
          alt={resolvedHeroAlt}
          variant="hero"
        />
      )
    }

    <!-- The narrow layout has no rail, so it keeps the signal in flow here.
         Desktop places the same single signal under the author card above. -->
    {
      whyItMatters && (
        <div class="xl:hidden">
          <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
        </div>
      )
    }

    <!-- Article body -->
    <div class="prose-custom">
      <slot />
      <SectionMarker />
    </div>

    <!-- Article footer: series nav + tags recap -->
    <footer class="mt-12 space-y-8 border-t border-[var(--border-subtle)] pt-8">
      <!-- Series navigation -->
      {
        (prevPost || nextPost) && (
          <nav aria-label="Series navigation" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {prevPost ? (
              <a
                href={prevPost.href ?? `/essays/${prevPost.slug}/`}
                class="group flex flex-col gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
                  &larr; Previous
                </span>
                <span class="text-sm font-medium text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
                  {prevPost.title}
                </span>
              </a>
            ) : (
              <div />
            )}
            {nextPost && (
              <a
                href={nextPost.href ?? `/essays/${nextPost.slug}/`}
                class="group flex flex-col items-end gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
---
/**
 * Figure — editorial "engineering plate" treatment for illustrations.
 *
 * Renders a warm-paper plate with corner tick marks, suitable for
 * schematic / blueprint-style figures. The plate stays light in both
 * themes on purpose: in dark mode it reads as a luminous drawing card
 * floating on the navy page.
 *
 * Variants:
 *   - default:   inline article figure with mono "Fig · NN" label + caption
 *                (unchanged from the original component)
 *   - hero:      frontispiece plate (no caption, larger padding; unchanged)
 *   - inline:    like default, but never breaks out of the `.prose-custom`
 *                reading measure — for small supporting figures
 *   - wide:      breaks out further than default/inline — for diagrams that
 *                need more than the 72ch measure
 *   - technical: like wide, with a distinct "schematic" plate treatment
 *                (dashed border, teal label) instead of the editorial one
 *
 * `expandable` gates the existing lightbox/dialog: on by default for every
 * variant except `hero`, which stays non-expandable unless a `caption` is
 * also supplied (matching its current no-caption, frontispiece-only use).
 * `mobileSrc` swaps in a `<picture>` element with a narrow-viewport source.
 * `longDescription` is exposed to screen readers only, via `aria-describedby`
 * on the figure, for dense technical figures that need more than `alt` text.
 *
 * `figureId` (paired with `slug`) is the opt-in reading-experience-v2 path
 * (ARCHITECTURE.md §5, V7): when both are supplied, the enlarge trigger
 * becomes a real link to `/essays/<slug>/figure/<figureId>/` (data-kind
 * "figure", data-key `figureId`) instead of opening this component's own
 * private `<dialog>` — no-JS/direct-link both work because the route is a
 * real static page, and this component never renders its private dialog
 * for a figureId figure (risk 3: never two dialog mechanisms open on one
 * figure). `FocusHost` (P0-C) hijacks that link's click later; until then
 * it behaves as an ordinary link to the standalone figure route. Every
 * other figure on the site keeps using the private lightbox, untouched.
 *
 * Every prop from the original component (`src`, `alt`, `caption`, `number`,
 * `credit`, `creditHref`, `variant: 'default' | 'hero'`) keeps working
 * unchanged — this file is an additive extension, not a rewrite.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  number?: string;
  credit?: string;
  creditHref?: string;
  variant?: 'default' | 'hero' | 'inline' | 'wide' | 'technical';
  expandable?: boolean;
  width?: number;
  height?: number;
  mobileSrc?: string;
  longDescription?: string;
  figureId?: string;
  slug?: string;
}

const {
  src,
  alt,
  caption,
  number,
  credit,
  creditHref,
  variant = 'default',
  expandable,
  width,
  height,
  mobileSrc,
  longDescription,
  figureId,
  slug,
} = Astro.props;

const isHero = variant === 'hero';
const showCaption = !isHero && (number || caption || credit);

// Every variant is expandable by default; the hero frontispiece is the one
// exception (no caption today, so no lightbox unless one is supplied).
const canExpand = expandable ?? (isHero ? Boolean(caption) : true);

// Opt-in FocusHost path — see the header comment. Both props are required
// together; a figureId without a slug (or vice versa) falls back to the
// ordinary private lightbox rather than building a broken href.
const focusHref = figureId && slug ? `/essays/${slug}/figure/${figureId}/` : undefined;

// Only allocated when needed — most figures carry no long description.
const descId = longDescription
  ? `figure-desc-${crypto.randomUUID().slice(0, 8)}`
  : undefined;
---

<figure
  class:list={[
    'figure-plate',
    'lift-hover',
    isHero && 'figure-plate--hero',
    variant === 'inline' && 'figure-plate--inline',
    variant === 'wide' && 'figure-plate--wide',
    variant === 'technical' && 'figure-plate--technical',
  ]}
  data-enlargeable-figure={canExpand ? 'true' : undefined}
  aria-describedby={descId}
>
  <span class="figure-plate__corner figure-plate__corner--tl" aria-hidden="true"></span>
  <span class="figure-plate__corner figure-plate__corner--tr" aria-hidden="true"></span>
  <span class="figure-plate__corner figure-plate__corner--bl" aria-hidden="true"></span>
  <span class="figure-plate__corner figure-plate__corner--br" aria-hidden="true"></span>

  <div class="figure-plate__frame">
    {canExpand && <span class="figure-plate__header" aria-hidden="true"><span>{number ? `Figure ${number}` : 'Figure'}</span><span>Enlarge figure ↗</span></span>}
    {
      canExpand ? (
        <a
          class="figure-plate__enlarge"
          href={focusHref ?? src}
          aria-label={`Enlarge: ${alt}`}
          aria-haspopup="dialog"
          data-figure-trigger={focusHref ? undefined : true}
          data-kind={focusHref ? 'figure' : undefined}
          data-key={focusHref ? figureId : undefined}
        >
          {mobileSrc ? (
            <picture>
              <source media="(max-width: 640px)" srcset={mobileSrc} />
              <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
            </picture>
          ) : (
            <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          )}
          <span class="figure-plate__enlarge-affordance" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h6v6" />
              <path d="m21 3-7 7" />
              <path d="M9 21H3v-6" />
              <path d="m3 21 7-7" />
            </svg>
          </span>
        </a>
      ) : mobileSrc ? (
        <picture>
          <source media="(max-width: 640px)" srcset={mobileSrc} />
          <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
        </picture>
      ) : (
        <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      )
    }
  </div>

  {showCaption && (
    <figcaption class="figure-plate__caption">
      {(number || caption) && (
        <span class="figure-plate__caption-main">
          {number && <span class="figure-plate__label">Fig · {number}</span>}
          {caption && <span class="figure-plate__text">{caption}</span>}
        </span>
      )}
      {credit && (
        <span class="figure-plate__credit">
          {creditHref ? <a href={creditHref}>{credit}</a> : credit}
        </span>
      )}
    </figcaption>
  )}

  {longDescription && (
    <p id={descId} class="sr-only">{longDescription}</p>
  )}

  {canExpand && !focusHref && (
    <dialog
      class="figure-lightbox"
      aria-label={`Enlarged figure: ${alt}`}
      data-figure-dialog
    >
      <div class="figure-lightbox__panel">
        <button class="figure-lightbox__close" type="button" aria-label="Close enlarged figure" data-figure-close>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
        <img src={src} alt={alt} loading="lazy" decoding="async" />
        <p class="figure-lightbox__caption">
          {caption ?? alt}
        </p>
      </div>
    </dialog>
  )}
</figure>

<script>
  const initializeFigureLightboxes = () => {
    document.querySelectorAll<HTMLElement>('[data-enlargeable-figure]').forEach((figure) => {
      if (figure.dataset.figureLightboxReady === 'true') return;

      const trigger = figure.querySelector<HTMLAnchorElement>('[data-figure-trigger]');
      const dialog = figure.querySelector<HTMLDialogElement>('[data-figure-dialog]');
      const closeButton = figure.querySelector<HTMLButtonElement>('[data-figure-close]');
      if (!trigger || !dialog || !closeButton || typeof dialog.showModal !== 'function') return;

      figure.dataset.figureLightboxReady = 'true';
      let previousBodyOverflow = '';

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
        closeButton.focus();
      });

      closeButton.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = previousBodyOverflow;
        trigger.focus();
      });
    });
  };

  initializeFigureLightboxes();
  document.addEventListener('astro:page-load', initializeFigureLightboxes);
</script>
---
/**
 * ThreadFocus — the shared Thread Focus renderer (reading-experience-v2
 * DIRECTION.md V3/V4, ARCHITECTURE.md §4, spec §7). Backs BOTH the
 * standalone `/essays/<slug>/thread/<beat>/` route and the in-place
 * overlay's `<template data-focus-view="thread:<beat>">` fragment —
 * `standalone` only toggles the few actions that make sense outside a
 * dialog (no "Close" outside `standalone={false}`); every other prop
 * comes straight from the beat record in `threads.ts`, so inline and
 * focus views never diverge into two hand-written explanations (V3).
 *
 * P0-C is what will later clone this component's `<template>` copy into
 * `FocusHost`'s dialog and wire "Back to essay" / "Read this scene in the
 * essay" / prev-next to replace-in-place rather than navigate — for this
 * leg every action below is a real link, so the standalone route and the
 * eventual overlay share one navigable, no-JS-safe destination for each.
 */
import Figure from './Figure.astro';
import RunningExampleCard from './RunningExampleCard.astro';
import ThreadOverview from './ThreadOverview.astro';
import { evidence } from '../../data/evidence';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);
const beatIndex = beat ? thread.beats.findIndex((candidate) => candidate.id === beatId) : -1;
const prevBeat = beatIndex > 0 ? thread.beats[beatIndex - 1] : null;
const nextBeat = beatIndex > -1 && beatIndex < thread.beats.length - 1 ? thread.beats[beatIndex + 1] : null;
const relatedEvidence = beat ? beat.relatedEvidenceIds.map((id) => evidence[id]).filter(Boolean) : [];

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};
---

{
  beat && (
    <div class="thread-focus" data-focus-kind="thread" data-focus-key={beat.id}>
      <div class="thread-focus__grid">
        <div class="thread-focus__main">
          <div class="thread-focus__actions">
            <a class="thread-focus__action" href={`/essays/${thread.slug}/`}>
              &larr; Back to essay
            </a>
            <span class="thread-focus__action-label font-mono">Thread focus</span>
            <a
              class="thread-focus__action thread-focus__action--secondary"
              href={`/essays/${thread.slug}/#thread-${beat.id}`}
            >
              Read this scene in the essay
            </a>
            {!standalone && (
              <button type="button" class="thread-focus__action thread-focus__action--close" data-focus-close>
                Close
              </button>
            )}
          </div>

          <p class="thread-focus__eyebrow font-mono">
            <span>
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true">&middot;</span>
            <span>{kindLabel[beat.kind] ?? beat.kind}</span>
          </p>
          <h2 class="thread-focus__title font-serif">{beat.label}</h2>
          <p class="thread-focus__recap">{beat.recap}</p>

          <Figure
            src={beat.image.src}
            alt={beat.image.alt}
            caption={beat.image.caption}
            number={String(beat.n).padStart(2, '0')}
            longDescription={beat.longDescription}
            variant="wide"
            expandable={false}
          />
          <a class="thread-focus__figure-link" href={`/essays/${thread.slug}/figure/${beat.id}/`}>
            View this figure in the Figure Viewer &rarr;
          </a>

          {relatedEvidence.length > 0 && (
            <nav class="thread-focus__evidence-links" aria-label="Related evidence">
              <p class="thread-focus__boundary-label font-mono">Related evidence</p>
              <ul>
                {relatedEvidence.map((record) => (
                  <li><a href={`/evidence/${record.id}/`}>{record.title} &rarr;</a></li>
                ))}
              </ul>
            </nav>
          )}

          <div class="thread-focus__boundary">
            <div>
              <p class="thread-focus__boundary-label font-mono">What this establishes</p>
              <p>{beat.establishes}</p>
            </div>
            <div>
              <p class="thread-focus__boundary-label font-mono">What it does not establish</p>
              <p>{beat.doesNotEstablish}</p>
            </div>
          </div>

          <nav class="thread-focus__prevnext" aria-label="Adjacent thread beats">
            {prevBeat ? (
              <a href={`/essays/${thread.slug}/thread/${prevBeat.id}/`}>
                &larr; {prevBeat.label}
              </a>
            ) : (
              <span />
            )}
            {nextBeat && (
              <a href={`/essays/${thread.slug}/thread/${nextBeat.id}/`}>
                {nextBeat.label} &rarr;
              </a>
            )}
          </nav>
        </div>

        <aside class="thread-focus__rail">
          <RunningExampleCard thread={thread} />
          <ThreadOverview thread={thread} currentBeatId={beat.id} />
        </aside>
      </div>
    </div>
  )
}

<style>
  .thread-focus {
    max-width: 100%;
  }

  .thread-focus__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .thread-focus__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .thread-focus__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .thread-focus__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .thread-focus__action:hover,
  .thread-focus__action:focus-visible {
    text-decoration: underline;
  }
  }

  .thread-focus__action-label {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .thread-focus__action--secondary {
    color: var(--text-secondary);
  }

  .thread-focus__action--close {
    color: var(--text-tertiary);
  }

  .thread-focus__eyebrow {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .thread-focus__title {
    margin: 0.3rem 0 0.75rem;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .thread-focus__recap {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .thread-focus__figure-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .thread-focus__figure-link:hover,
  .thread-focus__figure-link:focus-visible {
    text-decoration: underline;
  }

  .thread-focus__evidence-links {
    margin: 1.25rem 0 0;
  }

  .thread-focus__evidence-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread-focus__evidence-links a {
    color: var(--accent);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .thread-focus__evidence-links a:hover,
  .thread-focus__evidence-links a:focus-visible {
    text-decoration: underline;
  }

  .thread-focus__boundary {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  @media (min-width: 640px) {
    .thread-focus__boundary {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .thread-focus__boundary-label {
    margin: 0 0 0.35rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .thread-focus__boundary p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .thread-focus__prevnext {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .thread-focus__prevnext a {
    color: var(--accent);
    text-decoration: none;
  }

  .thread-focus__prevnext a:hover,
  .thread-focus__prevnext a:focus-visible {
    text-decoration: underline;
  }

  .thread-focus__rail {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.dark) .thread-focus__grid { gap: 28px; }
  @media (min-width: 960px) { :global(.dark) .thread-focus__grid { grid-template-columns: minmax(0, 720px) 287px; } }
  :global(.dark) .thread-focus__title { margin: 8px 0 18px; color: #f5f1ea; font-size: 36px; line-height: 1.08; }
  :global(.dark) .thread-focus__recap { color: #bbc7d8; font-size: 16px; line-height: 1.58; }
  :global(.dark) .thread-focus__boundary { padding: 9px 16px; border-color: #efbc68; border-width: 0 0 0 3px; border-radius: 0; background: linear-gradient(90deg, rgb(240 185 93 / 9%), transparent); }
  :global(.dark) .thread-focus__boundary-label { color: #efbc68; }
  :global(.dark) .thread-focus__rail > * { border-color: #294b6d; border-radius: 8px; background: linear-gradient(145deg, rgb(10 29 51 / 94%), rgb(6 21 39 / 90%)); box-shadow: 0 12px 32px rgb(0 0 0 / 18%); }
</style>
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .evidence-focus__rail {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.dark) .evidence-focus__grid { gap: 20px; }
  @media (min-width: 960px) { :global(.dark) .evidence-focus__grid { grid-template-columns: minmax(0, 818px) 299px; } }
  :global(.dark) .evidence-focus__page-title { color: #f2f1f4; font-size: 40px; line-height: 1.02; }
  :global(.dark) .evidence-focus__record { padding: 18px; border: 1px solid #29496d; border-radius: 12px; background: linear-gradient(145deg, #0b1b33 0%, #08162a 100%); box-shadow: 0 12px 32px rgb(0 0 0 / 22%), inset 0 1px 0 rgb(120 180 255 / 5%); }
  :global(.dark) .evidence-focus__facts { border-color: #29496d; background: #09172a; }
  :global(.dark) .evidence-focus__claim-split { gap: 0; }
  @media (min-width: 700px) { :global(.dark) .evidence-focus__claim-split > :last-child { padding-left: 36px; border-left: 1px solid #24415f; } :global(.dark) .evidence-focus__claim-split > :first-child { padding-right: 36px; } }
  :global(.dark) .evidence-focus__rail > * { padding: 18px 20px; border-color: #29496d; border-radius: 11px; background: linear-gradient(155deg, #0d1d35 0%, #09172a 100%); }
</style>

