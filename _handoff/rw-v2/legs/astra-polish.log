---
/**
 * ThreadScene — inline per-beat rendering for a post's running thread,
 * placed adjacent to matching prose at each of the six canonical anchors
 * (reading-experience-v2 DIRECTION.md V3/V7, ARCHITECTURE.md §4). It looks
 * up its own beat from `threads.ts` by `slug` + `beatId` and renders the
 * canonical figure, the one real recap paragraph, a semantic kind label,
 * and an "Explore thread" link to the standalone Thread Focus route.
 *
 * `ThreadFocus.astro` renders the fuller composition from the exact same
 * beat record — recap is written once in `threads.ts` and both surfaces
 * read it, never a second hand-written explanation (V3).
 *
 * `composition` follows DIRECTION V6's four main-pane types. `measure`
 * (default) keeps the scene inside the article's prose measure; `pane`
 * breaks the whole scene out wider, for the four dense technical PNGs
 * named in this essay's build brief (incident, deployment, drift,
 * outcome). `split`/`inset` are accepted for forward compatibility with
 * V6's full set — this essay's six scenes use only `measure`/`pane` today,
 * so those two get a lighter, documented treatment rather than a full
 * adjacent-content slot this component doesn't have a use for yet.
 */
import Figure from './Figure.astro';
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  beatId: string;
  composition?: 'measure' | 'pane' | 'split' | 'inset';
}

const { slug, beatId, composition = 'measure' } = Astro.props;
const thread = threads[slug];
const beat = thread?.beats.find((candidate) => candidate.id === beatId);

if (!thread || !beat) {
  console.warn(
    `[ThreadScene] Unable to resolve beat "${beatId}" for thread "${slug}". Rendering nothing.`,
  );
}

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};

// Restrained cyan/violet split (DIRECTION V10): conceptual/mechanism beats
// (the two boundary-flagged, non-historical kinds) get the cyan structural
// accent on their kind label; historical/proposed keep the primary violet
// accent used everywhere else in the thread.
const kindUsesCyan = beat?.kind === 'conceptual' || beat?.kind === 'mechanism';
---

{
  thread && beat && (
    <section
      id={`thread-${beat.id}`}
      class:list={[
        'thread-scene lift-hover',
        composition === 'pane' && 'thread-scene--pane',
        composition === 'split' && 'thread-scene--split',
        composition === 'inset' && 'thread-scene--inset',
      ]}
      aria-labelledby={`thread-${beat.id}-label`}
    >
      <span class="thread-scene__corner thread-scene__corner--tl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--tr" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--bl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--br" aria-hidden="true" />

      <div class="thread-scene__body">
        <div class="thread-scene__head">
          <p class="thread-scene__eyebrow font-mono">
            <span class="thread-scene__count">
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true" class="thread-scene__eyebrow-sep">
              &middot;
            </span>
            <span class:list={['thread-scene__kind', kindUsesCyan && 'thread-scene__kind--cyan']}>
              {kindLabel[beat.kind] ?? beat.kind}
            </span>
          </p>
          <h3 id={`thread-${beat.id}-label`} class="thread-scene__label font-serif">
            {beat.label}
          </h3>
        </div>

        <p class="thread-scene__recap">{beat.recap}</p>

        <Figure
          src={beat.image.src}
          alt={beat.image.alt}
          caption={beat.image.caption}
          number={String(beat.n).padStart(2, '0')}
          longDescription={beat.longDescription}
          figureId={beat.id}
          slug={slug}
          variant={composition === 'pane' ? 'technical' : 'inline'}
        />

        <a class="thread-scene__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
          Explore this thread beat <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .thread-scene {
    position: relative;
    margin: 2.75rem 0;
    padding: 1.375rem 1.5rem 1.5rem;
    border: 1px solid var(--border-strong);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    scroll-margin-top: 6rem;
  }

  .thread-scene--inset {
    margin: 2rem 0;
    padding: 1rem 1.25rem 1.25rem;
    border-style: dashed;
  }

  .thread-scene--split {
    background: var(--bg-subtle);
  }

  .thread-scene__corner {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--border-strong);
    opacity: 0.65;
    pointer-events: none;
  }

  .thread-scene__corner--tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .thread-scene__corner--tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
  .thread-scene__corner--bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
  .thread-scene__corner--br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; }

  .thread-scene__body {
    border-left: 2px solid var(--accent);
    padding-left: 1.125rem;
  }
---
/**
 * WhereThisSits (cross-series "reading path" locator for MDX essays).
 *
 * Looks up the current essay by slug in src/data/reading-paths.json and
 * renders prior -> this -> next within that guided path, plus a link to
 * the path's own page. Distinct from ReadingPathNav (which navigates
 * within a single content-collection `series`): a reading path spans
 * several parallel series on purpose.
 *
 * Usage in MDX:
 *   <WhereThisSits slug="agentic-operations-flow" />
 */
import pathsData from '../../data/reading-paths.json';

interface Step {
  slug: string | null;
  title: string;
  whatItAnswers: string;
  state: 'published' | 'next';
}

interface ReadingPath {
  id: string;
  pageSlug: string;
  title: string;
  umbrellaTerm: string;
  rationale: string;
  steps: Step[];
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const paths = (pathsData as { paths: ReadingPath[] }).paths;
const path = paths.find((p) => p.steps.some((s) => s.slug === slug));

if (!path) {
  throw new Error(
    `<WhereThisSits slug="${slug}" /> does not match any step in src/data/reading-paths.json. Add this essay's slug to a path's steps, or fix the slug.`
  );
}

const index = path.steps.findIndex((s) => s.slug === slug);
const prev = index > 0 ? path.steps[index - 1] : null;
const current = path.steps[index];
const next = index < path.steps.length - 1 ? path.steps[index + 1] : null;

const hrefFor = (step: Step) => (step.slug ? `/essays/${step.slug}/` : undefined);
---

<aside class="where-this-sits lift-hover my-10 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-5">
  <p class="where-this-sits__intro mb-3 text-xs font-medium uppercase tracking-wider text-[var(--text-tertiary)]">
    Part of the <span class="text-[var(--text-primary)]">{path.umbrellaTerm}</span> reading path
    (<a href={`/series/${path.pageSlug}/`} class="text-violet-600 hover:underline dark:text-violet-400">see the full path</a>)
  </p>
  <div class="where-this-sits__steps flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-2">
    <span class="where-this-sits__step text-sm text-[var(--text-tertiary)]">
      {prev ? (
        <a href={hrefFor(prev)} class="hover:text-violet-600 hover:underline dark:hover:text-violet-400">{prev.title}</a>
      ) : (
        'Start of the path'
      )}
    </span>
    <span class="hidden text-[var(--text-disabled)] sm:inline" aria-hidden="true">&rarr;</span>
    <span class="where-this-sits__step where-this-sits__step--current font-medium text-[var(--text-primary)]">{current.title} (you are here)</span>
    <span class="hidden text-[var(--text-disabled)] sm:inline" aria-hidden="true">&rarr;</span>
    <span class="where-this-sits__step text-sm text-[var(--text-tertiary)]">
      {next ? (
        next.state === 'published' ? (
          <a href={hrefFor(next)} class="hover:text-violet-600 hover:underline dark:hover:text-violet-400">{next.title}</a>
        ) : (
          <span>{next.title} <span class="italic text-[var(--text-disabled)]">(next, in progress)</span></span>
        )
      ) : (
        'End of the path'
      )}
    </span>
  </div>
</aside>

<style>
  :global(.post-layout--registry-wave) .where-this-sits { padding: 14px; border-color: var(--border-strong); border-radius: 8px; background: var(--bg-subtle); }
  :global(.post-layout--registry-wave) .where-this-sits__intro { margin: 0; font-size: 10px; line-height: 1.4; }
  :global(.post-layout--registry-wave) .where-this-sits__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 10px; padding: 12px 16px 14px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--bg-surface); }
  :global(.post-layout--registry-wave) .where-this-sits__step { min-width: 0; padding-top: 10px; border-top: 1px solid var(--border-subtle); font-family: var(--font-serif); font-size: 14px; line-height: 1.2; }
  :global(.post-layout--registry-wave) .where-this-sits__steps > [aria-hidden] { display: none; }
  :global(.dark) .where-this-sits { padding: 14px; border-color: #294563; border-radius: 8px; background: linear-gradient(135deg, #0b1c31 0%, #0a172a 70%, #11153a 100%); }
  :global(.dark) .where-this-sits__intro { margin: 0; color: #b8c3d4; font-size: 10px; line-height: 1.4; }
  :global(.dark) .where-this-sits__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 10px; padding: 12px 16px 14px; border: 1px solid #6550b8; border-radius: 8px; }
  :global(.dark) .where-this-sits__step { min-width: 0; padding-top: 10px; border-top: 1px solid #40506a; font-family: var(--font-serif); font-size: 14px; line-height: 1.2; }
  :global(.dark) .where-this-sits__step--current { color: #f1eff0; }
  :global(.dark) .where-this-sits__steps > [aria-hidden] { display: none; }
  @media (max-width: 640px) { :global(.dark) .where-this-sits__steps { grid-template-columns: 1fr; } }
</style>

