.prose-custom ul {
  list-style-type: disc;
}

.prose-custom ol {
  list-style-type: decimal;
}

.prose-custom li {
  margin-bottom: 0.375rem;
  padding-left: 0.25rem;
}

.prose-custom li::marker {
  color: var(--accent);
}

.prose-custom li > ul,
.prose-custom li > ol {
  margin-top: 0.375rem;
  margin-bottom: 0.375rem;
}

/* --- Blockquotes --- */
.prose-custom blockquote {
  margin: 1.75rem 0;
  padding: 1rem 1.5rem;
  border-left: 3px solid var(--accent);
  background-color: var(--accent-subtle);
  border-radius: 0 0.375rem 0.375rem 0;
  font-style: italic;
  color: var(--text-primary);
}

.prose-custom blockquote p {
  margin-bottom: 0;
  color: inherit;
}

.prose-custom blockquote cite {
  display: block;
  margin-top: 0.75rem;
  font-size: 0.875rem;
  font-style: normal;
  color: var(--text-tertiary);
}

/* --- Inline code --- */
.prose-custom :not(pre) > code {
  font-family: var(--font-mono);
@media (prefers-reduced-motion: no-preference) {
  .prose-custom details {
    transition: border-color 150ms ease;
  }
}

/* --- Horizontal rules --- */
.prose-custom hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 2.5rem 0;
}

/* --- Images in prose --- */
.prose-custom img {
  border-radius: 0.5rem;
  border: 1px solid var(--border-subtle);
  margin: 2rem auto;
  box-shadow: var(--shadow-md);
}

.prose-custom figure {
  margin: 2rem 0;
}

.prose-custom figcaption {
  text-align: center;
  font-size: 0.875rem;
  color: var(--text-tertiary);
  margin-top: 0.75rem;
  font-style: italic;
}

/* Supporting visual material can borrow a little of the surrounding grid at
   laptop widths, while prose keeps its deliberate reading measure. */
@media (min-width: 1024px) {
  .prose-custom > .figure-plate,
  .prose-custom > table {
    width: calc(100% + 3rem);
    max-width: none;
    margin-right: -1.5rem;
    margin-left: -1.5rem;
  }
}

/* ============================================================
   FIGURE PLATE
   Editorial "engineering plate" treatment for schematic figures.
   Artwork stays light in its own frame; in dark mode the surrounding plate
   becomes a restrained navy panel so it belongs to the page.
   Used via <Figure /> component, and by PostLayout for heroImage.
   ============================================================ */
.figure-plate {
  position: relative;
  margin: 2.75rem 0;
  padding: 1.375rem 1.375rem 1.125rem;
  background: #f6f8fb;
  border: 1px solid #e2e8f0;
  border-radius: 0.625rem;
  box-shadow:
    0 1px 2px rgba(15, 23, 42, 0.04),
    0 8px 24px -8px rgba(15, 23, 42, 0.1);
}

.dark .figure-plate {
  background: linear-gradient(180deg, #081d34 0%, #06172b 100%);
  border-color: #234b72;
  box-shadow:
    0 0 0 1px rgba(99, 102, 241, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.35),
    0 22px 56px -14px rgba(79, 70, 229, 0.4);
}

.dark .figure-plate__frame { background: #07182d; }
.dark .figure-plate__header { height: 34px; padding: 0 16px; align-items: center; color: #b8c5d9; background: rgb(8 29 52 / 95%); border-color: #214563; letter-spacing: .18em; }
.dark .figure-plate__caption,
.dark .prose-custom .figure-plate__caption { margin-top: 14px; padding: 10px 0 0; border-top: 1px solid #294b69; color: #aebcd0; }
.dark .figure-plate__text,
.dark .figure-plate__credit { color: #aebcd0; }
.dark .figure-plate__label { color: #6fd8ff; }

/* Hero variant — frontispiece on the post */
.figure-plate--hero {
  }

  @media (prefers-reduced-motion: reduce) {
    .author-profile,
    .author-profile__role,
    .author-profile__extra {
      transition: none;
    }
  }

  /* perf-lite drops the animation, never the collapse itself — the class
     toggle in PostSidebar's script always runs regardless of this mode. */
  :global(html.perf-lite) .author-profile,
  :global(html.perf-lite) .author-profile__role,
  :global(html.perf-lite) .author-profile__extra {
    transition: none;
  }

  :global(.dark) .author-profile {
    padding: 16px;
    border-color: #29476b;
    border-radius: 9px;
    background: linear-gradient(145deg, rgb(13 29 51 / 96%), rgb(10 23 42 / 92%));
    box-shadow: 0 10px 28px rgb(0 0 0 / 20%);
  }

  :global(.dark) .author-profile img { width: 38px !important; height: 38px !important; }
  :global(.dark) .author-profile :global(h2), :global(.dark) .author-profile :global(h3) { font-size: 18px; line-height: 1.15; }
  :global(.dark) .author-profile__extra { margin-top: 12px !important; padding-top: 12px !important; }
  :global(.dark) .author-profile__extra p { font-size: 12px; line-height: 1.45; }

  /* The Registry Wave rail is intentionally compact in both themes. */
  :global(.post-layout--registry-wave .registry-wave-rail .author-profile) {
