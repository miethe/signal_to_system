        railFrame = 0;
        if (!entryRail) return;
        entryRail.classList.toggle('is-companion-active', root.getBoundingClientRect().top <= 112);
      };
      const queueEntryRail = () => {
        if (!railFrame) railFrame = requestAnimationFrame(syncEntryRail);
