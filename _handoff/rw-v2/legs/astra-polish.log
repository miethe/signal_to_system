from pathlib import Path
import sys
from playwright.sync_api import sync_playwright
import run_qa as q
OUT=q.ROOT/'docs/blog-work/the-registry-wave-agentic-artifact-supply-chain/reading-experience-v2/atlas/astra'
OUT.mkdir(parents=True,exist_ok=True)
def align(p,selector,top=110):
 p.locator(selector).first.evaluate('(el, top) => scrollTo({top: scrollY + el.getBoundingClientRect().top - top, behavior: "instant"})',top)
 p.wait_for_timeout(550)
def capture(group='all'):
 with sync_playwright() as pw:
  b=pw.chromium.launch()
  states=[('01-entry',q.ESSAY,None),('02-first-scroll',q.ESSAY,'.section-marker'),('02-pullquote',q.ESSAY,'.pull-quote--quote:has-text("Copy and paste")'),('03-artifact',q.ESSAY,'#what-counts-as-an-artifact'),('04-thread',q.THREAD+'use/',None),('05-evidence',q.EVIDENCE,None),('06-figure',q.ESSAY,'overlay'),('07-variation',q.ESSAY,'.section-marker:has(h2#the-harder-problem-not-every-difference-should-disappear)'),('08-conclusion',q.ESSAY,'.where-this-sits')]
  if group=='entry': states=states[:1]
  elif group=='narrative': states=[s for s in states if s[0][:2] in ('02','03','07','08')]
  elif group=='focus': states=[s for s in states if s[0][:2] in ('04','05','06')]
  for label,path,selector in states:
   for dark in (True,False):
    c=q.capture_context(b,1440,1000,dark);p=q.new_page(c,path,dark);q.preload(p);p.evaluate("scrollTo({top:0,behavior:'instant'})");p.evaluate("document.fonts.ready");p.wait_for_timeout(250)
    if selector=='overlay':
     p.locator("a[href*='/figure/']").first.click();p.locator('[data-focus-dialog]').wait_for(state='visible');p.wait_for_timeout(550);q.wait_for_images(p)
    elif selector: align(p,selector,140 if label=='07-variation' else 110)
    p.screenshot(path=str(OUT/f'{label}--{"dark" if dark else "light"}.jpg'),type='jpeg',quality=78)
    if label=='01-entry':
     print(p.locator('#post-header h1').bounding_box());print(p.locator('.registry-wave-rail').bounding_box())
    p.close();c.close()
  if group in ('mobile','all','entry'):
   for dark in (True,False):
    for label,path in [('entry',q.ESSAY),('contents',q.ESSAY),('thread',q.THREAD+'use/'),('evidence',q.EVIDENCE)]:
     if group=='entry' and label!='entry':continue
     c=q.capture_context(b,390,844,dark);p=q.new_page(c,path,dark);q.preload(p);p.evaluate("scrollTo({top:0,behavior:'instant'})");p.evaluate("document.fonts.ready");p.wait_for_timeout(250)
     if label=='contents': p.locator('[data-mobile-contents-trigger]').click();p.locator('[data-mobile-contents]').wait_for(state='visible');p.wait_for_timeout(550)
     p.screenshot(path=str(OUT/f'09-mobile-{label}--{"dark" if dark else "light"}.jpg'),type='jpeg',quality=78);p.close();c.close()
  b.close()
if __name__=='__main__':capture(sys.argv[1] if len(sys.argv)>1 else 'all')
/* Registry Wave visual system. All furniture is bounded to this essay. */
:is(html .post-layout.post-layout--registry-wave, .registry-wave-focus) {
  --rw-cyan: #146987;
  --rw-violet: #7154b5;
  --rw-panel: linear-gradient(145deg, #fff, #f1f4fa);
  --rw-edge: #c6d2e3;
  --rw-shadow: 0 8px 24px rgb(25 43 74 / 5%), inset 0 1px 0 rgb(255 255 255 / 65%);
  --text-disabled: #617088;
  --text-tertiary: #53627a;
}
html .post-layout.post-layout--registry-wave { width: calc(100% - 80px); max-width: 1280px; padding: 28px 0 64px; }
.dark :is(html .post-layout.post-layout--registry-wave, .registry-wave-focus) {
  --rw-cyan: #7cd9f5;
  --rw-violet: #b49af7;
  --rw-panel: linear-gradient(145deg, #0e2039, #09172a 75%);
  --rw-edge: #2e486b;
  --rw-shadow: 0 12px 30px rgb(0 0 0 / 14%), inset 0 1px 0 rgb(157 187 244 / 7%);
  --text-primary: #f3f0ed;
  --text-secondary: #c7d2e3;
  --text-tertiary: #acbbd0;
  --text-disabled: #91a3bc;
}
@media (min-width: 1280px) {
  html .post-layout.post-layout--registry-wave { grid-template-columns: minmax(0, 1fr) 320px; column-gap: 44px; }
  html .post-layout.post-layout--registry-wave > .registry-wave-rail { padding-left: 24px; }
}
html .post-layout.post-layout--registry-wave .post-frontispiece { position: relative; min-width: 0; }
html .post-layout.post-layout--registry-wave .figure-plate--hero { height: auto; aspect-ratio: 3.4; border-radius: 8px; box-shadow: 0 6px 28px rgb(0 0 0 / 12%); }
html .post-layout.post-layout--registry-wave .post-frontispiece__caption { position: absolute; bottom: 1px; left: 1px; padding: 6px 12px; border-radius: 0 6px 0 7px; background: rgb(5 18 35 / 88%); color: #dce7f6; font: 11px/1.4 var(--font-sans); }
html .post-layout.post-layout--registry-wave #post-header { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 14px; margin: 24px 0 22px; padding: 0; }
html .post-layout.post-layout--registry-wave #post-header > * { margin: 0; }
html .post-layout.post-layout--registry-wave .post-category { order: 0; }
html .post-layout.post-layout--registry-wave .post-category > span { background: transparent; border: 1px solid var(--rw-edge); padding: 4px 10px; font: 600 11px/1.4 var(--font-sans); letter-spacing: .03em; color: var(--text-primary); }
html .post-layout.post-layout--registry-wave .post-meta { order: 1; gap: 6px 10px; font: 12px/1.5 var(--font-sans); color: var(--text-tertiary); }
html .post-layout.post-layout--registry-wave #post-header h1 { order: 2; flex-basis: 100%; max-width: none; font-size: clamp(38px, 3.3vw, 49px); line-height: 1.09; letter-spacing: -.028em; }
html .post-layout.post-layout--registry-wave #post-header > p { order: 3; font-family: var(--font-serif); font-size: 22px; line-height: 1.5; color: var(--text-secondary); }
html .post-layout.post-layout--registry-wave .post-tags { order: 4; gap: 9px; padding: 0; }
html .post-layout.post-layout--registry-wave .post-tags a { padding: 5px 11px; border: 1px solid var(--rw-edge); background: transparent; color: var(--text-secondary); font-size: 11px; }
html .post-layout.post-layout--registry-wave #post-header > :not(h1, p, .post-meta, .post-tags, .post-category) { order: 5; flex-basis: 100%; }
html .post-layout.post-layout--registry-wave .author-profile { padding: 20px 18px 12px; border: 1px solid var(--rw-edge); border-radius: 10px; background: var(--rw-panel); box-shadow: var(--rw-shadow); }
html .post-layout.post-layout--registry-wave .author-profile h2 { font-size: 23px; line-height: 1.15; }
html .post-layout.post-layout--registry-wave .author-profile__role { max-height: none; font-size: 11px; line-height: 1.5; margin-top: 5px; }
html .post-layout.post-layout--registry-wave .author-profile__extra { margin-top: 16px; padding-top: 0; border: 0; }
html .post-layout.post-layout--registry-wave .author-profile__extra p { font: 13px/1.6 var(--font-sans); }
html .post-layout.post-layout--registry-wave .author-profile nav { margin-top: 10px; gap: 12px; }
html .post-layout.post-layout--registry-wave .author-profile nav a { min-height: 36px; padding: 0; color: var(--rw-cyan); font-size: 12px; }
html .post-layout.post-layout--registry-wave .executive-signal { display: flex; flex-direction: column; gap: 13px; min-height: 0; padding: 20px 18px; border: 1px solid #a794d5; border-radius: 10px; background: linear-gradient(140deg, #f0eafb, #f7f8ff 70%); box-shadow: var(--rw-shadow); }
html.dark .post-layout.post-layout--registry-wave .executive-signal { border-color: #574881; background: radial-gradient(ellipse at 95% 0%, rgb(92 62 163 / 28%), transparent 70%), linear-gradient(140deg, #191e40, #101a30); }
html .post-layout.post-layout--registry-wave .executive-signal::before { display: none; }
html .post-layout.post-layout--registry-wave .executive-signal__col--takeaway { order: -1; margin: 0; padding: 0; border: 0; }

