_handoff/rw-v2/legs/taste-fix-codex.log:32805:+++ b/src/components/content/SectionMarker.astro
_handoff/rw-v2/legs/taste-fix-codex.log:32806:@@ -0,0 +1,94 @@
_handoff/rw-v2/legs/taste-fix-codex.log:32807:+---
_handoff/rw-v2/legs/taste-fix-codex.log:32808:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:32809:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:32810:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:32811:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:32812:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:32813:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:32814:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:32815:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:32816:+---
_handoff/rw-v2/legs/taste-fix-codex.log:32817:+
_handoff/rw-v2/legs/taste-fix-codex.log:32818:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:32819:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:32820:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:32821:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:32822:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:32823:+
_handoff/rw-v2/legs/taste-fix-codex.log:32824:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:32825:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:32826:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:32827:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:32828:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:32829:+
_handoff/rw-v2/legs/taste-fix-codex.log:32830:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:32831:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:32832:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:32833:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:32834:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:32835:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:32836:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:32837:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:32838:+
_handoff/rw-v2/legs/taste-fix-codex.log:32839:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:32840:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:32841:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:32842:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:32843:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:32844:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:32845:+
_handoff/rw-v2/legs/taste-fix-codex.log:32846:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:32847:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:32848:+</script>
_handoff/rw-v2/legs/taste-fix-codex.log:32849:+
_handoff/rw-v2/legs/taste-fix-codex.log:32850:+<style>
_handoff/rw-v2/legs/taste-fix-codex.log:32851:+  :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:32852:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:32853:+    grid-template-columns: 3rem minmax(0, 1fr);
_handoff/rw-v2/legs/taste-fix-codex.log:32854:+    column-gap: 0.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32855:+    align-items: start;
_handoff/rw-v2/legs/taste-fix-codex.log:32856:+    margin-top: 2.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32857:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:32858:+
_handoff/rw-v2/legs/taste-fix-codex.log:32859:+  :global(.section-marker__gutter) {
_handoff/rw-v2/legs/taste-fix-codex.log:32860:+    position: relative;
_handoff/rw-v2/legs/taste-fix-codex.log:32861:+    display: flex;
_handoff/rw-v2/legs/taste-fix-codex.log:32862:+    flex-direction: column;
_handoff/rw-v2/legs/taste-fix-codex.log:32863:+    align-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:32864:+    gap: 0.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32865:+    padding-top: 0.15rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32866:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:32867:+
_handoff/rw-v2/legs/taste-fix-codex.log:32868:+  :global(.section-marker__ordinal) {
_handoff/rw-v2/legs/taste-fix-codex.log:32869:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:32870:+    width: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32871:+    height: 1.75rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32872:+    place-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:32873:+    border: 1px solid var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:32874:+    border-radius: 0.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32875:+    color: var(--text-tertiary);
_handoff/rw-v2/legs/taste-fix-codex.log:32876:+    font-family: var(--font-mono);
_handoff/rw-v2/legs/taste-fix-codex.log:32877:+    font-size: 0.6875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32878:+    font-weight: 700;
_handoff/rw-v2/legs/taste-fix-codex.log:32879:+    letter-spacing: 0.08em;
_handoff/rw-v2/legs/taste-fix-codex.log:32880:+    line-height: 1;
_handoff/rw-v2/legs/taste-fix-codex.log:32881:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:32882:+
_handoff/rw-v2/legs/taste-fix-codex.log:32883:+  :global(.section-marker__rule) {
_handoff/rw-v2/legs/taste-fix-codex.log:32884:+    display: block;
_handoff/rw-v2/legs/taste-fix-codex.log:32885:+    width: 1px;
_handoff/rw-v2/legs/taste-fix-codex.log:32886:+    min-height: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32887:+    background: var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:32888:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:32889:+
_handoff/rw-v2/legs/taste-fix-codex.log:32890:+  :global(.section-marker > h2) {
_handoff/rw-v2/legs/taste-fix-codex.log:32891:+    margin-top: 0;
_handoff/rw-v2/legs/taste-fix-codex.log:32892:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:32893:+
_handoff/rw-v2/legs/taste-fix-codex.log:32894:+  @media (min-width: 768px) {
_handoff/rw-v2/legs/taste-fix-codex.log:32895:+    :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:32896:+      width: calc(100% + 3.875rem);
_handoff/rw-v2/legs/taste-fix-codex.log:32897:+      margin-left: -3.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32898:+    }
_handoff/rw-v2/legs/taste-fix-codex.log:32899:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:32900:+</style>
_handoff/rw-v2/legs/taste-fix-codex.log:32901:diff --git a/src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx b/src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx
_handoff/rw-v2/legs/taste-fix-codex.log:32902:index b3595dfaac091847f1f69958c21b5f1e38f193d4..fad5438bc4fdee0d2612874dccc391c2dfa2d740
_handoff/rw-v2/legs/taste-fix-codex.log:32903:--- a/src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx
_handoff/rw-v2/legs/taste-fix-codex.log:32904:+++ b/src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx
_handoff/rw-v2/legs/taste-fix-codex.log:32905:@@ -15,6 +15,7 @@
_handoff/rw-v2/legs/taste-fix-codex.log:32906: status: published
_handoff/rw-v2/legs/taste-fix-codex.log:32907: heroImage: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/hero-governed-cube.png"
_handoff/rw-v2/legs/taste-fix-codex.log:32908: heroAlt: "A shared capability pattern connects several project workbenches, each retaining a distinct adaptation."
_handoff/rw-v2/legs/taste-fix-codex.log:32909:+heroPlacement: frontispiece
_handoff/rw-v2/legs/taste-fix-codex.log:32910: whyItMatters: "Approval attaches to an artifact. Its use happens in a context that approval never saw. A current registry can coexist with stale deployed instructions and unacceptable outcomes."
_handoff/rw-v2/legs/taste-fix-codex.log:32911: leaderTakeaway: "Require four separate assurances: pinned artifact identity, authorized conditions of use, evidence of actual execution, and an accepted outcome. Connect the systems responsible for each."
_handoff/rw-v2/legs/taste-fix-codex.log:32912: relatedSlugs:
_handoff/rw-v2/legs/taste-fix-codex.log:32913:@@ -378,6 +379,8 @@
_handoff/rw-v2/legs/taste-fix-codex.log:32914: 
_handoff/rw-v2/legs/taste-fix-codex.log:32915: These are dated implementation records, summarized as methods. The August commits establish when checks entered the repository; the September audit establishes what that later inspection found. Neither date silently becomes the incident date or an attestation of today's runtime state.
_handoff/rw-v2/legs/taste-fix-codex.log:32916: 
_handoff/rw-v2/legs/taste-fix-codex.log:32917:+[Read the full receipt set in Evidence Focus.](/essays/the-registry-wave-agentic-artifact-supply-chain/evidence/)
_handoff/rw-v2/legs/taste-fix-codex.log:32918:+
_handoff/rw-v2/legs/taste-fix-codex.log:32919: <Evidence kind="observed" /> **The reviewer copy.** The drift-check source records a deployed reviewer missing its mandatory establish-the-diff step while the upstream copy contained it. The incident was filed August 5; the check was committed August 6. Its five-day interval describes the stale deployment. Comparing deployed bytes with the source makes that discrepancy visible, but doesn't recover a per-session loading history or count incorrect reviews.[^drift]
_handoff/rw-v2/legs/taste-fix-codex.log:32920: 
_handoff/rw-v2/legs/taste-fix-codex.log:32921: <Evidence kind="observed" /> **Sibling instructions.** One harness-specific instruction file carried superseded doctrine for six weeks after its canonical sibling changed. The parity gate committed August 5 checks a declared relationship between those files. It doesn't require every document to be identical. The separate live-document staleness check catches a named obsolete assertion outside that pair; it leaves dated historical records alone.[^parity][^staleness]
