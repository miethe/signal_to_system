_handoff/rw-v2/legs/p0d-p1.log:2941:  @media (min-width: 768px) {
_handoff/rw-v2/legs/p0d-p1.log:2942:    :global(.section-marker) {
_handoff/rw-v2/legs/p0d-p1.log:2943:      width: calc(100% + 3.875rem);
