_handoff/rw-v2/legs/taste-fix-codex.log:35046:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:35047:+
_handoff/rw-v2/legs/taste-fix-codex.log:35048:+  :global(.section-marker__ordinal) {
_handoff/rw-v2/legs/taste-fix-codex.log:35049:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:35050:+    width: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:35051:+    height: 1.75rem;
_handoff/rw-v2/legs/taste-fix-codex.log:35052:+    place-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:35053:+    border: 1px solid var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:35054:+    border-radius: 0.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:35055:+    color: var(--text-tertiary);
_handoff/rw-v2/legs/taste-fix-codex.log:35056:+    font-family: var(--font-mono);
_handoff/rw-v2/legs/taste-fix-codex.log:35057:+    font-size: 0.6875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:35058:+    font-weight: 700;
_handoff/rw-v2/legs/taste-fix-codex.log:35059:+    letter-spacing: 0.08em;
_handoff/rw-v2/legs/taste-fix-codex.log:35060:+    line-height: 1;
_handoff/rw-v2/legs/taste-fix-codex.log:35061:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:35062:+
_handoff/rw-v2/legs/taste-fix-codex.log:35063:+  :global(.section-marker__rule) {
_handoff/rw-v2/legs/taste-fix-codex.log:35064:+    display: block;
