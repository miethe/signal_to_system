_handoff/rw-v2/legs/taste-fix-codex.log:32362:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:32363:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:32364:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:32365:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:32366:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:32367:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:32368:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:32369:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:32370:+---
_handoff/rw-v2/legs/taste-fix-codex.log:32371:+
_handoff/rw-v2/legs/taste-fix-codex.log:32372:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:32373:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:32374:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:32375:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:32376:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:32377:+
_handoff/rw-v2/legs/taste-fix-codex.log:32378:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:32379:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:32380:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:32381:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:32382:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:32383:+
_handoff/rw-v2/legs/taste-fix-codex.log:32384:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:32385:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:32386:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:32387:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:32388:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:32389:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:32390:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:32391:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:32392:+
_handoff/rw-v2/legs/taste-fix-codex.log:32393:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:32394:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:32395:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:32396:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:32397:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:32398:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:32399:+
_handoff/rw-v2/legs/taste-fix-codex.log:32400:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:32401:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:32402:+</script>
_handoff/rw-v2/legs/taste-fix-codex.log:32403:+
_handoff/rw-v2/legs/taste-fix-codex.log:32404:+<style>
_handoff/rw-v2/legs/taste-fix-codex.log:32405:+  :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:32406:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:32407:+    grid-template-columns: 3rem minmax(0, 1fr);
