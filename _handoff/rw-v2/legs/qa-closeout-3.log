_handoff/rw-v2/legs/p0d-p1.log:2855:/**
_handoff/rw-v2/legs/p0d-p1.log:2856: * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/p0d-p1.log:2857: *
_handoff/rw-v2/legs/p0d-p1.log:2858: * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/p0d-p1.log:2859: * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/p0d-p1.log:2860: * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/p0d-p1.log:2861: * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/p0d-p1.log:2862: */
_handoff/rw-v2/legs/p0d-p1.log:2863:---
_handoff/rw-v2/legs/p0d-p1.log:2864:
_handoff/rw-v2/legs/p0d-p1.log:2865:<script>
_handoff/rw-v2/legs/p0d-p1.log:2866:  const addSectionMarkers = () => {
_handoff/rw-v2/legs/p0d-p1.log:2867:    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/p0d-p1.log:2868:      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/p0d-p1.log:2869:    );
_handoff/rw-v2/legs/p0d-p1.log:2870:
_handoff/rw-v2/legs/p0d-p1.log:2871:    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/p0d-p1.log:2872:      const section = document.createElement('section');
_handoff/rw-v2/legs/p0d-p1.log:2873:      const gutter = document.createElement('div');
_handoff/rw-v2/legs/p0d-p1.log:2874:      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/p0d-p1.log:2875:      const rule = document.createElement('span');
_handoff/rw-v2/legs/p0d-p1.log:2876:
_handoff/rw-v2/legs/p0d-p1.log:2877:      section.className = 'section-marker';
_handoff/rw-v2/legs/p0d-p1.log:2878:      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/p0d-p1.log:2879:      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/p0d-p1.log:2880:      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/p0d-p1.log:2881:      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/p0d-p1.log:2882:      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/p0d-p1.log:2883:      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/p0d-p1.log:2884:      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/p0d-p1.log:2885:
_handoff/rw-v2/legs/p0d-p1.log:2886:      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/p0d-p1.log:2887:      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/p0d-p1.log:2888:      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/p0d-p1.log:2889:      section.append(gutter, heading);
_handoff/rw-v2/legs/p0d-p1.log:2890:    });
_handoff/rw-v2/legs/p0d-p1.log:2891:  };
_handoff/rw-v2/legs/p0d-p1.log:2892:
_handoff/rw-v2/legs/p0d-p1.log:2893:  addSectionMarkers();
_handoff/rw-v2/legs/p0d-p1.log:2894:  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/p0d-p1.log:2895:</script>
_handoff/rw-v2/legs/p0d-p1.log:2896:
_handoff/rw-v2/legs/p0d-p1.log:2897:<style>
