_handoff/rw-v2/legs/p0d-p1.log:2073:    type="button"
_handoff/rw-v2/legs/p0d-p1.log:2074:    aria-label="Scroll to top"
_handoff/rw-v2/legs/p0d-p1.log:2075:    class="fixed bottom-8 right-8 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-tertiary)] shadow-md opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-[var(--accent-subtle)] hover:text-[var(--accent)] hover:border-[var(--accent)]/50 focus-ring"
_handoff/rw-v2/legs/p0d-p1.log:2076:  >
_handoff/rw-v2/legs/p0d-p1.log:2077:    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
_handoff/rw-v2/legs/p0d-p1.log:2078:      <path d="m18 15-6-6-6 6"/>
