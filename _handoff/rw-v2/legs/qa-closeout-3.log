_handoff/rw-v2/legs/p0d-p1.log:4027:  --shadow-md:  0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
_handoff/rw-v2/legs/p0d-p1.log:4028:  --shadow-lg:  0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
_handoff/rw-v2/legs/p0d-p1.log:4029:  --shadow-ambient: 0px 32px 64px -12px rgba(11, 19, 38, 0.06);
_handoff/rw-v2/legs/p0d-p1.log:4030:
_handoff/rw-v2/legs/p0d-p1.log:4031:  /* Hover lift (see the HOVER LIFT section). Back-out curve overshoots
_handoff/rw-v2/legs/p0d-p1.log:4032:     slightly then settles — the "bounce". */
_handoff/rw-v2/legs/p0d-p1.log:4033:  --lift-y: -2px;
_handoff/rw-v2/legs/p0d-p1.log:4034:  --lift-duration: 200ms;
_handoff/rw-v2/legs/p0d-p1.log:4035:  --lift-ease: cubic-bezier(0.34, 1.4, 0.64, 1);
_handoff/rw-v2/legs/p0d-p1.log:4036:  --lift-shadow:
_handoff/rw-v2/legs/p0d-p1.log:4037:    0 2px 4px rgba(15, 23, 42, 0.05),
_handoff/rw-v2/legs/p0d-p1.log:4038:    0 14px 30px -12px rgba(15, 23, 42, 0.22);
_handoff/rw-v2/legs/p0d-p1.log:4039:}
