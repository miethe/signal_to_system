_handoff/rw-v2/legs/p0d-p1.log:2126:}
_handoff/rw-v2/legs/p0d-p1.log:2127:
_handoff/rw-v2/legs/p0d-p1.log:2128:const { slug, headings = [] } = Astro.props;
_handoff/rw-v2/legs/p0d-p1.log:2129:const thread = slug ? threads[slug] : undefined;
_handoff/rw-v2/legs/p0d-p1.log:2130:
_handoff/rw-v2/legs/p0d-p1.log:2131:// The footnotes section starts at the "Footnotes" heading (id
_handoff/rw-v2/legs/p0d-p1.log:2132:// `footnote-label`, injected by the remark footnotes plugin) — exclude it
_handoff/rw-v2/legs/p0d-p1.log:2133:// and everything after it so the outline never lists footnote content.
_handoff/rw-v2/legs/p0d-p1.log:2134:const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
_handoff/rw-v2/legs/p0d-p1.log:2135:const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
_handoff/rw-v2/legs/p0d-p1.log:2136:const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
_handoff/rw-v2/legs/p0d-p1.log:2137:const showToc = rawToc.length >= 2;
_handoff/rw-v2/legs/p0d-p1.log:2138:
_handoff/rw-v2/legs/p0d-p1.log:2139:// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
_handoff/rw-v2/legs/p0d-p1.log:2140:// under, so the client script can show only the active section's
_handoff/rw-v2/legs/p0d-p1.log:2141:// sub-headings instead of the full flat list.
_handoff/rw-v2/legs/p0d-p1.log:2142:let h2Count = 0;
_handoff/rw-v2/legs/p0d-p1.log:2143:let currentH2Slug: string | null = null;
_handoff/rw-v2/legs/p0d-p1.log:2144:const toc = rawToc.map((heading) => {
_handoff/rw-v2/legs/p0d-p1.log:2145:  if (heading.depth === 2) {
_handoff/rw-v2/legs/p0d-p1.log:2146:    h2Count += 1;
_handoff/rw-v2/legs/p0d-p1.log:2147:    currentH2Slug = heading.slug;
_handoff/rw-v2/legs/p0d-p1.log:2148:    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
_handoff/rw-v2/legs/p0d-p1.log:2149:  }
_handoff/rw-v2/legs/p0d-p1.log:2150:  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
_handoff/rw-v2/legs/p0d-p1.log:2151:});
