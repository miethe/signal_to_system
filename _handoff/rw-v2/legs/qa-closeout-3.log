_handoff/rw-v2/legs/p0d-p1.log:2371:<script>
_handoff/rw-v2/legs/p0d-p1.log:2372:  import { computeListWindow } from '../../lib/sidebar-window';
_handoff/rw-v2/legs/p0d-p1.log:2373:
_handoff/rw-v2/legs/p0d-p1.log:2374:  /** Nearby-outline default window size before "All sections" is toggled. */
_handoff/rw-v2/legs/p0d-p1.log:2375:  const NEARBY_MAX_VISIBLE = 6;
_handoff/rw-v2/legs/p0d-p1.log:2376:
_handoff/rw-v2/legs/p0d-p1.log:2377:  const initializeReadingCompanions = () => {
_handoff/rw-v2/legs/p0d-p1.log:2378:    document.querySelectorAll<HTMLElement>('[data-reading-companion]').forEach((root) => {
_handoff/rw-v2/legs/p0d-p1.log:2379:      if (root.dataset.readingCompanionReady === 'true') return;
_handoff/rw-v2/legs/p0d-p1.log:2380:      root.dataset.readingCompanionReady = 'true';
_handoff/rw-v2/legs/p0d-p1.log:2381:
_handoff/rw-v2/legs/p0d-p1.log:2382:      const outline = root.querySelector<HTMLElement>('[data-companion-outline]');
_handoff/rw-v2/legs/p0d-p1.log:2383:      const allToggle = root.querySelector<HTMLButtonElement>('[data-companion-all-toggle]');
_handoff/rw-v2/legs/p0d-p1.log:2384:      const body = root.querySelector<HTMLElement>('[data-companion-scroll]');
_handoff/rw-v2/legs/p0d-p1.log:2385:      const rail = root.querySelector<HTMLElement>('[data-companion-fill]');
_handoff/rw-v2/legs/p0d-p1.log:2386:      const moreAbove = root.querySelector<HTMLElement>('[data-companion-more="above"]');
_handoff/rw-v2/legs/p0d-p1.log:2387:      const moreBelow = root.querySelector<HTMLElement>('[data-companion-more="below"]');
_handoff/rw-v2/legs/p0d-p1.log:2388:      const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-companion-item]'));
_handoff/rw-v2/legs/p0d-p1.log:2389:
_handoff/rw-v2/legs/p0d-p1.log:2390:      if (!outline || !body || items.length === 0 || !('IntersectionObserver' in window)) return;
_handoff/rw-v2/legs/p0d-p1.log:2391:
_handoff/rw-v2/legs/p0d-p1.log:2392:      const pairs = items
_handoff/rw-v2/legs/p0d-p1.log:2393:        .map((item) => {
_handoff/rw-v2/legs/p0d-p1.log:2394:          const link = item.querySelector<HTMLAnchorElement>('[data-companion-link]');
_handoff/rw-v2/legs/p0d-p1.log:2395:          const target = link ? document.getElementById(link.dataset.companionTarget ?? '') : null;
_handoff/rw-v2/legs/p0d-p1.log:2396:          return link && target ? { item, link, target } : null;
_handoff/rw-v2/legs/p0d-p1.log:2397:        })
_handoff/rw-v2/legs/p0d-p1.log:2398:        .filter((pair): pair is { item: HTMLLIElement; link: HTMLAnchorElement; target: HTMLElement } => pair !== null);
_handoff/rw-v2/legs/p0d-p1.log:2399:
_handoff/rw-v2/legs/p0d-p1.log:2400:      if (pairs.length === 0) return;
_handoff/rw-v2/legs/p0d-p1.log:2401:
_handoff/rw-v2/legs/p0d-p1.log:2402:      const reduceMotion = () =>
_handoff/rw-v2/legs/p0d-p1.log:2403:        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
_handoff/rw-v2/legs/p0d-p1.log:2404:        document.documentElement.classList.contains('perf-lite');
_handoff/rw-v2/legs/p0d-p1.log:2405:
_handoff/rw-v2/legs/p0d-p1.log:2406:      let allExpanded = false;
_handoff/rw-v2/legs/p0d-p1.log:2407:      let activeIndex = 0;
_handoff/rw-v2/legs/p0d-p1.log:2408:
_handoff/rw-v2/legs/p0d-p1.log:2409:      const resolveSection = (targetId: string): string | null => {
_handoff/rw-v2/legs/p0d-p1.log:2410:        const pair = pairs.find((candidate) => candidate.target.id === targetId);
_handoff/rw-v2/legs/p0d-p1.log:2411:        if (!pair) return null;
_handoff/rw-v2/legs/p0d-p1.log:2412:        return pair.item.dataset.companionDepth === '2' ? targetId : pair.item.dataset.companionParent || null;
_handoff/rw-v2/legs/p0d-p1.log:2413:      };
_handoff/rw-v2/legs/p0d-p1.log:2414:
_handoff/rw-v2/legs/p0d-p1.log:2415:      const setActiveBranch = (sectionSlug: string | null) => {
_handoff/rw-v2/legs/p0d-p1.log:2416:        items.forEach((item) => {
_handoff/rw-v2/legs/p0d-p1.log:2417:          if (item.dataset.companionDepth !== '3') return;
_handoff/rw-v2/legs/p0d-p1.log:2418:          item.classList.toggle('is-active-branch', item.dataset.companionParent === sectionSlug);
_handoff/rw-v2/legs/p0d-p1.log:2419:        });
_handoff/rw-v2/legs/p0d-p1.log:2420:      };
_handoff/rw-v2/legs/p0d-p1.log:2421:
_handoff/rw-v2/legs/p0d-p1.log:2422:      const firstH2 = pairs.find((pair) => pair.item.dataset.companionDepth === '2');
_handoff/rw-v2/legs/p0d-p1.log:2423:      setActiveBranch(firstH2?.target.id ?? null);
_handoff/rw-v2/legs/p0d-p1.log:2424:
_handoff/rw-v2/legs/p0d-p1.log:2425:      let lastFitSignature = '';
_handoff/rw-v2/legs/p0d-p1.log:2426:      const fitList = () => {
_handoff/rw-v2/legs/p0d-p1.log:2427:        const laidOut = pairs.filter(({ item }) => item.dataset.companionDepth === '2' || item.classList.contains('is-active-branch'));
_handoff/rw-v2/legs/p0d-p1.log:2428:        if (laidOut.length === 0) return;
_handoff/rw-v2/legs/p0d-p1.log:2429:
_handoff/rw-v2/legs/p0d-p1.log:2430:        if (allExpanded) {
_handoff/rw-v2/legs/p0d-p1.log:2431:          if (lastFitSignature === 'expanded') return;
_handoff/rw-v2/legs/p0d-p1.log:2432:          lastFitSignature = 'expanded';
_handoff/rw-v2/legs/p0d-p1.log:2433:          laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
_handoff/rw-v2/legs/p0d-p1.log:2434:          moreAbove?.setAttribute('hidden', '');
_handoff/rw-v2/legs/p0d-p1.log:2435:          moreBelow?.setAttribute('hidden', '');
_handoff/rw-v2/legs/p0d-p1.log:2436:          return;
_handoff/rw-v2/legs/p0d-p1.log:2437:        }
_handoff/rw-v2/legs/p0d-p1.log:2438:
_handoff/rw-v2/legs/p0d-p1.log:2439:        const panelTop = outline.getBoundingClientRect().top;
_handoff/rw-v2/legs/p0d-p1.log:2440:        const available = window.innerHeight - panelTop - 24;
_handoff/rw-v2/legs/p0d-p1.log:2441:        const laidOutActiveIndex = Math.max(0, laidOut.findIndex(({ target }) => pairs[activeIndex]?.target === target));
_handoff/rw-v2/legs/p0d-p1.log:2442:        const signature = `windowed:${available.toFixed(1)}:${laidOut.length}:${laidOutActiveIndex}`;
_handoff/rw-v2/legs/p0d-p1.log:2443:        if (signature === lastFitSignature) return;
_handoff/rw-v2/legs/p0d-p1.log:2444:        lastFitSignature = signature;
_handoff/rw-v2/legs/p0d-p1.log:2445:
_handoff/rw-v2/legs/p0d-p1.log:2446:        laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
