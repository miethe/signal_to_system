_handoff/rw-v2/legs/taste-fix-codex.log:35949:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:35950:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:35951:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:35952:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:35953:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:35954:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:35955:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:35956:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:35957:+---
_handoff/rw-v2/legs/taste-fix-codex.log:35958:+
_handoff/rw-v2/legs/taste-fix-codex.log:35959:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:35960:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:35961:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:35962:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:35963:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:35964:+
_handoff/rw-v2/legs/taste-fix-codex.log:35965:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:35966:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:35967:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:35968:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:35969:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:35970:+
_handoff/rw-v2/legs/taste-fix-codex.log:35971:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:35972:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:35973:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:35974:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:35975:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:35976:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:35977:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:35978:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:35979:+
_handoff/rw-v2/legs/taste-fix-codex.log:35980:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:35981:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:35982:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:35983:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:35984:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:35985:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:35986:+
_handoff/rw-v2/legs/taste-fix-codex.log:35987:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:35988:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:35989:+</script>
_handoff/rw-v2/legs/taste-fix-codex.log:35990:+
_handoff/rw-v2/legs/taste-fix-codex.log:35991:+<style>
_handoff/rw-v2/legs/taste-fix-codex.log:35992:+  :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:35993:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:35994:+    grid-template-columns: 3rem minmax(0, 1fr);
