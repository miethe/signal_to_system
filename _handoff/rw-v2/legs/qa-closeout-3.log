_handoff/rw-v2/legs/p0d-p1.log:3311:--- src/components/content/FigureViewer.astro ---
_handoff/rw-v2/legs/p0d-p1.log:3312:---
_handoff/rw-v2/legs/p0d-p1.log:3313:/**
_handoff/rw-v2/legs/p0d-p1.log:3314: * FigureViewer — the shared figure-viewer renderer (DIRECTION.md V7,
_handoff/rw-v2/legs/p0d-p1.log:3315: * ARCHITECTURE.md §4, spec §10). Backs both `/essays/<slug>/figure/<id>/`
_handoff/rw-v2/legs/p0d-p1.log:3316: * and the in-place overlay's `<template>` fragment: exact asset, exact
_handoff/rw-v2/legs/p0d-p1.log:3317: * caption, long description, and real file metadata read from disk at
_handoff/rw-v2/legs/p0d-p1.log:3318: * build time — never a fabricated size or dimension (V1).
_handoff/rw-v2/legs/p0d-p1.log:3319: *
_handoff/rw-v2/legs/p0d-p1.log:3320: * `sharp` is already a project dependency (Astro's own image pipeline
_handoff/rw-v2/legs/p0d-p1.log:3321: * uses it), so this reads genuine width/height via its metadata probe
_handoff/rw-v2/legs/p0d-p1.log:3322: * rather than falling back to an undocumented guess; file size comes from
_handoff/rw-v2/legs/p0d-p1.log:3323: * `fs.statSync`. A missing asset at build time leaves both fields `null`
_handoff/rw-v2/legs/p0d-p1.log:3324: * — a labeled pending slot, not a substitute value.
_handoff/rw-v2/legs/p0d-p1.log:3325: */
_handoff/rw-v2/legs/p0d-p1.log:3326:import fs from 'node:fs';
_handoff/rw-v2/legs/p0d-p1.log:3327:import path from 'node:path';
_handoff/rw-v2/legs/p0d-p1.log:3328:import sharp from 'sharp';
_handoff/rw-v2/legs/p0d-p1.log:3329:import type { Thread } from '../../data/threads';
_handoff/rw-v2/legs/p0d-p1.log:3330:
_handoff/rw-v2/legs/p0d-p1.log:3331:interface Props {
_handoff/rw-v2/legs/p0d-p1.log:3332:  thread: Thread;
_handoff/rw-v2/legs/p0d-p1.log:3333:  beatId: string;
_handoff/rw-v2/legs/p0d-p1.log:3334:  standalone?: boolean;
_handoff/rw-v2/legs/p0d-p1.log:3335:}
_handoff/rw-v2/legs/p0d-p1.log:3336:
_handoff/rw-v2/legs/p0d-p1.log:3337:const { thread, beatId, standalone = true } = Astro.props;
_handoff/rw-v2/legs/p0d-p1.log:3338:const beat = thread.beats.find((candidate) => candidate.id === beatId);
_handoff/rw-v2/legs/p0d-p1.log:3339:
_handoff/rw-v2/legs/p0d-p1.log:3340:let fileSizeBytes: number | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3341:let width: number | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3342:let height: number | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3343:
_handoff/rw-v2/legs/p0d-p1.log:3344:if (beat) {
_handoff/rw-v2/legs/p0d-p1.log:3345:  const absolutePath = path.join(process.cwd(), 'public', beat.image.src);
_handoff/rw-v2/legs/p0d-p1.log:3346:  try {
_handoff/rw-v2/legs/p0d-p1.log:3347:    const stat = fs.statSync(absolutePath);
_handoff/rw-v2/legs/p0d-p1.log:3348:    fileSizeBytes = stat.size;
_handoff/rw-v2/legs/p0d-p1.log:3349:    const metadata = await sharp(absolutePath).metadata();
_handoff/rw-v2/legs/p0d-p1.log:3350:    width = metadata.width ?? null;
_handoff/rw-v2/legs/p0d-p1.log:3351:    height = metadata.height ?? null;
_handoff/rw-v2/legs/p0d-p1.log:3352:  } catch {
_handoff/rw-v2/legs/p0d-p1.log:3353:    // Asset unreadable at build time — leave metadata null (V1: a missing
_handoff/rw-v2/legs/p0d-p1.log:3354:    // input stays a labeled pending slot, never a fabricated value).
_handoff/rw-v2/legs/p0d-p1.log:3355:  }
_handoff/rw-v2/legs/p0d-p1.log:3356:}
_handoff/rw-v2/legs/p0d-p1.log:3357:
_handoff/rw-v2/legs/p0d-p1.log:3358:const formatBytes = (bytes: number | null) => {
_handoff/rw-v2/legs/p0d-p1.log:3359:  if (bytes === null) return 'Not available in this build';
_handoff/rw-v2/legs/p0d-p1.log:3360:  const kb = bytes / 1024;
_handoff/rw-v2/legs/p0d-p1.log:3361:  return kb >= 1024 ? `${(kb / 1024).toFixed(2)} MB` : `${kb.toFixed(1)} KB`;
_handoff/rw-v2/legs/p0d-p1.log:3362:};
_handoff/rw-v2/legs/p0d-p1.log:3363:
_handoff/rw-v2/legs/p0d-p1.log:3364:const dimensionsLabel =
_handoff/rw-v2/legs/p0d-p1.log:3365:  width !== null && height !== null ? `${width} × ${height}px` : 'Not available in this build';
_handoff/rw-v2/legs/p0d-p1.log:3366:
_handoff/rw-v2/legs/p0d-p1.log:3367:const filename = beat?.image.src.split('/').pop() ?? '';
_handoff/rw-v2/legs/p0d-p1.log:3368:---
_handoff/rw-v2/legs/p0d-p1.log:3369:
_handoff/rw-v2/legs/p0d-p1.log:3370:{
_handoff/rw-v2/legs/p0d-p1.log:3371:  beat && (
_handoff/rw-v2/legs/p0d-p1.log:3372:    <div class="figure-viewer" data-focus-kind="figure" data-focus-key={beat.id}>
_handoff/rw-v2/legs/p0d-p1.log:3373:      <div class="figure-viewer__actions">
_handoff/rw-v2/legs/p0d-p1.log:3374:        <a class="figure-viewer__action" href={`/essays/${thread.slug}/`}>
_handoff/rw-v2/legs/p0d-p1.log:3375:          &larr; Back to essay
_handoff/rw-v2/legs/p0d-p1.log:3376:        </a>
_handoff/rw-v2/legs/p0d-p1.log:3377:        <a class="figure-viewer__action" href={`/essays/${thread.slug}/thread/${beat.id}/`}>
