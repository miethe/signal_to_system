_handoff/rw-v2/legs/taste-fix-codex.log:32432:+    font-weight: 700;
_handoff/rw-v2/legs/taste-fix-codex.log:32433:+    letter-spacing: 0.08em;
_handoff/rw-v2/legs/taste-fix-codex.log:32434:+    line-height: 1;
_handoff/rw-v2/legs/taste-fix-codex.log:32435:+  }
