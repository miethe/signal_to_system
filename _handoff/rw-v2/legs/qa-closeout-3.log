_handoff/rw-v2/legs/taste-fix-codex.log:34560:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:34561:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:34562:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:34563:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:34564:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:34565:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:34566:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:34567:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:34568:+---
_handoff/rw-v2/legs/taste-fix-codex.log:34569:+
_handoff/rw-v2/legs/taste-fix-codex.log:34570:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:34571:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:34572:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:34573:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:34574:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:34575:+
_handoff/rw-v2/legs/taste-fix-codex.log:34576:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:34577:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:34578:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:34579:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:34580:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:34581:+
_handoff/rw-v2/legs/taste-fix-codex.log:34582:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:34583:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:34584:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:34585:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:34586:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:34587:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:34588:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:34589:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:34590:+
_handoff/rw-v2/legs/taste-fix-codex.log:34591:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:34592:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:34593:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:34594:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:34595:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:34596:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:34597:+
_handoff/rw-v2/legs/taste-fix-codex.log:34598:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:34599:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:34600:+</script>
