_handoff/rw-v2/legs/taste-fix-codex.log:33649:+---
_handoff/rw-v2/legs/taste-fix-codex.log:33650:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:33651:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:33652:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:33653:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:33654:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:33655:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:33656:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:33657:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:33658:+---
_handoff/rw-v2/legs/taste-fix-codex.log:33659:+
_handoff/rw-v2/legs/taste-fix-codex.log:33660:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:33661:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:33662:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:33663:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:33664:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:33665:+
_handoff/rw-v2/legs/taste-fix-codex.log:33666:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:33667:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:33668:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:33669:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:33670:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:33671:+
_handoff/rw-v2/legs/taste-fix-codex.log:33672:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:33673:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:33674:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:33675:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:33676:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:33677:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:33678:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:33679:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:33680:+
_handoff/rw-v2/legs/taste-fix-codex.log:33681:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:33682:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:33683:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:33684:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:33685:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:33686:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:33687:+
_handoff/rw-v2/legs/taste-fix-codex.log:33688:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:33689:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:33690:+</script>
_handoff/rw-v2/legs/taste-fix-codex.log:33691:+
_handoff/rw-v2/legs/taste-fix-codex.log:33692:+<style>
_handoff/rw-v2/legs/taste-fix-codex.log:33693:+  :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:33694:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:33695:+    grid-template-columns: 3rem minmax(0, 1fr);
_handoff/rw-v2/legs/taste-fix-codex.log:33696:+    column-gap: 0.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33697:+    align-items: start;
_handoff/rw-v2/legs/taste-fix-codex.log:33698:+    margin-top: 2.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33699:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33700:+
_handoff/rw-v2/legs/taste-fix-codex.log:33701:+  :global(.section-marker__gutter) {
_handoff/rw-v2/legs/taste-fix-codex.log:33702:+    position: relative;
_handoff/rw-v2/legs/taste-fix-codex.log:33703:+    display: flex;
_handoff/rw-v2/legs/taste-fix-codex.log:33704:+    flex-direction: column;
_handoff/rw-v2/legs/taste-fix-codex.log:33705:+    align-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:33706:+    gap: 0.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33707:+    padding-top: 0.15rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33708:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33709:+
_handoff/rw-v2/legs/taste-fix-codex.log:33710:+  :global(.section-marker__ordinal) {
_handoff/rw-v2/legs/taste-fix-codex.log:33711:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:33712:+    width: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33713:+    height: 1.75rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33714:+    place-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:33715:+    border: 1px solid var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:33716:+    border-radius: 0.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33717:+    color: var(--text-tertiary);
_handoff/rw-v2/legs/taste-fix-codex.log:33718:+    font-family: var(--font-mono);
_handoff/rw-v2/legs/taste-fix-codex.log:33719:+    font-size: 0.6875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33720:+    font-weight: 700;
_handoff/rw-v2/legs/taste-fix-codex.log:33721:+    letter-spacing: 0.08em;
_handoff/rw-v2/legs/taste-fix-codex.log:33722:+    line-height: 1;
_handoff/rw-v2/legs/taste-fix-codex.log:33723:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33724:+
_handoff/rw-v2/legs/taste-fix-codex.log:33725:+  :global(.section-marker__rule) {
_handoff/rw-v2/legs/taste-fix-codex.log:33726:+    display: block;
_handoff/rw-v2/legs/taste-fix-codex.log:33727:+    width: 1px;
_handoff/rw-v2/legs/taste-fix-codex.log:33728:+    min-height: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33729:+    background: var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:33730:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33731:+
_handoff/rw-v2/legs/taste-fix-codex.log:33732:+  :global(.section-marker > h2) {
_handoff/rw-v2/legs/taste-fix-codex.log:33733:+    margin-top: 0;
_handoff/rw-v2/legs/taste-fix-codex.log:33734:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33735:+
_handoff/rw-v2/legs/taste-fix-codex.log:33736:+  @media (min-width: 768px) {
_handoff/rw-v2/legs/taste-fix-codex.log:33737:+    :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:33738:+      width: calc(100% + 3.875rem);
_handoff/rw-v2/legs/taste-fix-codex.log:33739:+      margin-left: -3.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33740:+    }
_handoff/rw-v2/legs/taste-fix-codex.log:33741:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33742:+</style>
