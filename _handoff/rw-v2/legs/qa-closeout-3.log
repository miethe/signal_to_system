/**
 * ThreadScene — inline per-beat rendering for a post's running thread,
 * placed adjacent to matching prose at each of the six canonical anchors
 * (reading-experience-v2 DIRECTION.md V3/V7, ARCHITECTURE.md §4). It looks
 * up its own beat from `threads.ts` by `slug` + `beatId` and renders the
 * canonical figure, the one real recap paragraph, a semantic kind label,
 * and an "Explore thread" link to the standalone Thread Focus route.
 *
 * `ThreadFocus.astro` renders the fuller composition from the exact same
 * beat record — recap is written once in `threads.ts` and both surfaces
 * read it, never a second hand-written explanation (V3).
 *
 * `composition` follows DIRECTION V6's four main-pane types. `measure`
 * (default) keeps the scene inside the article's prose measure; `pane`
 * breaks the whole scene out wider, for the four dense technical PNGs
 * named in this essay's build brief (incident, deployment, drift,
 * outcome). `split`/`inset` are accepted for forward compatibility with
 * V6's full set — this essay's six scenes use only `measure`/`pane` today,
 * so those two get a lighter, documented treatment rather than a full
 * adjacent-content slot this component doesn't have a use for yet.
 */
import Figure from './Figure.astro';
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  beatId: string;
  composition?: 'measure' | 'pane' | 'split' | 'inset';
}

const { slug, beatId, composition = 'measure' } = Astro.props;
const thread = threads[slug];
const beat = thread?.beats.find((candidate) => candidate.id === beatId);

if (!thread || !beat) {
  console.warn(
    `[ThreadScene] Unable to resolve beat "${beatId}" for thread "${slug}". Rendering nothing.`,
  );
}

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};

// Restrained cyan/violet split (DIRECTION V10): conceptual/mechanism beats
// (the two boundary-flagged, non-historical kinds) get the cyan structural
// accent on their kind label; historical/proposed keep the primary violet
// accent used everywhere else in the thread.
const kindUsesCyan = beat?.kind === 'conceptual' || beat?.kind === 'mechanism';
---

{
  thread && beat && (
    <section
      id={`thread-${beat.id}`}
      class:list={[
        'thread-scene lift-hover',
        composition === 'pane' && 'thread-scene--pane',
        composition === 'split' && 'thread-scene--split',
        composition === 'inset' && 'thread-scene--inset',
      ]}
      aria-labelledby={`thread-${beat.id}-label`}
    >
      <span class="thread-scene__corner thread-scene__corner--tl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--tr" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--bl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--br" aria-hidden="true" />

      <div class="thread-scene__body">
        <div class="thread-scene__head">
          <p class="thread-scene__eyebrow font-mono">
            <span class="thread-scene__count">
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true" class="thread-scene__eyebrow-sep">
              &middot;
            </span>
            <span class:list={['thread-scene__kind', kindUsesCyan && 'thread-scene__kind--cyan']}>
              {kindLabel[beat.kind] ?? beat.kind}
            </span>
          </p>
          <h3 id={`thread-${beat.id}-label`} class="thread-scene__label font-serif">
            {beat.label}
          </h3>
        </div>

        <p class="thread-scene__recap">{beat.recap}</p>

        <Figure
          src={beat.image.src}
          alt={beat.image.alt}
          caption={beat.image.caption}
          number={String(beat.n).padStart(2, '0')}
          longDescription={beat.longDescription}
          figureId={beat.id}
          slug={slug}
          variant={composition === 'pane' ? 'technical' : 'inline'}
        />

        <a class="thread-scene__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
          Explore this thread beat <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .thread-scene {
    position: relative;
    margin: 2.75rem 0;
    padding: 1.375rem 1.5rem 1.5rem;
    border: 1px solid var(--border-strong);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    scroll-margin-top: 6rem;
  }

  .thread-scene--inset {
    margin: 2rem 0;
    padding: 1rem 1.25rem 1.25rem;
    border-style: dashed;
  }

  .thread-scene--split {
    background: var(--bg-subtle);
  }

  .thread-scene__corner {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--border-strong);
    opacity: 0.65;
    pointer-events: none;
  }

  .thread-scene__corner--tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .thread-scene__corner--tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
  .thread-scene__corner--bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
  .thread-scene__corner--br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; }

  .thread-scene__body {
    border-left: 2px solid var(--accent);
    padding-left: 1.125rem;
  }

  .thread-scene__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }

  .thread-scene__eyebrow {
    display: flex;
---
/**
 * ThreadFocus — the shared Thread Focus renderer (reading-experience-v2
 * DIRECTION.md V3/V4, ARCHITECTURE.md §4, spec §7). Backs BOTH the
 * standalone `/essays/<slug>/thread/<beat>/` route and the in-place
 * overlay's `<template data-focus-view="thread:<beat>">` fragment —
 * `standalone` only toggles the few actions that make sense outside a
 * dialog (no "Close" outside `standalone={false}`); every other prop
 * comes straight from the beat record in `threads.ts`, so inline and
 * focus views never diverge into two hand-written explanations (V3).
 *
 * P0-C is what will later clone this component's `<template>` copy into
 * `FocusHost`'s dialog and wire "Back to essay" / "Read this scene in the
 * essay" / prev-next to replace-in-place rather than navigate — for this
 * leg every action below is a real link, so the standalone route and the
 * eventual overlay share one navigable, no-JS-safe destination for each.
 */
import Figure from './Figure.astro';
import RunningExampleCard from './RunningExampleCard.astro';
import ThreadOverview from './ThreadOverview.astro';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);
const beatIndex = beat ? thread.beats.findIndex((candidate) => candidate.id === beatId) : -1;
const prevBeat = beatIndex > 0 ? thread.beats[beatIndex - 1] : null;
const nextBeat = beatIndex > -1 && beatIndex < thread.beats.length - 1 ? thread.beats[beatIndex + 1] : null;

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};
---

{
  beat && (
    <div class="thread-focus" data-focus-kind="thread" data-focus-key={beat.id}>
      <div class="thread-focus__grid">
        <div class="thread-focus__main">
          <div class="thread-focus__actions">
            <a class="thread-focus__action" href={`/essays/${thread.slug}/`}>
              &larr; Back to essay
            </a>
            <span class="thread-focus__action-label font-mono">Thread focus</span>
            <a
              class="thread-focus__action thread-focus__action--secondary"
              href={`/essays/${thread.slug}/#thread-${beat.id}`}
            >
              Read this scene in the essay
            </a>
            {!standalone && (
              <button type="button" class="thread-focus__action thread-focus__action--close" data-focus-close>
                Close
              </button>
            )}
          </div>

          <p class="thread-focus__eyebrow font-mono">
            <span>
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true">&middot;</span>
            <span>{kindLabel[beat.kind] ?? beat.kind}</span>
          </p>
          <h2 class="thread-focus__title font-serif">{beat.label}</h2>
          <p class="thread-focus__recap">{beat.recap}</p>

          <Figure
            src={beat.image.src}
            alt={beat.image.alt}
            caption={beat.image.caption}
            number={String(beat.n).padStart(2, '0')}
            longDescription={beat.longDescription}
            variant="wide"
            expandable={false}
          />
          <a class="thread-focus__figure-link" href={`/essays/${thread.slug}/figure/${beat.id}/`}>
            View this figure in the Figure Viewer &rarr;
          </a>

          <div class="thread-focus__boundary">
            <div>
              <p class="thread-focus__boundary-label font-mono">What this establishes</p>
              <p>{beat.establishes}</p>
            </div>
            <div>
              <p class="thread-focus__boundary-label font-mono">What it does not establish</p>
              <p>{beat.doesNotEstablish}</p>
            </div>
          </div>

          <nav class="thread-focus__prevnext" aria-label="Adjacent thread beats">
            {prevBeat ? (
              <a href={`/essays/${thread.slug}/thread/${prevBeat.id}/`}>
                &larr; {prevBeat.label}
              </a>
            ) : (
              <span />
            )}
            {nextBeat && (
              <a href={`/essays/${thread.slug}/thread/${nextBeat.id}/`}>
                {nextBeat.label} &rarr;
              </a>
            )}
          </nav>
        </div>

        <aside class="thread-focus__rail">
          <RunningExampleCard thread={thread} />
          <ThreadOverview thread={thread} currentBeatId={beat.id} />
        </aside>
      </div>
    </div>
  )
}

<style>
  .thread-focus {
    max-width: 100%;
  }

  .thread-focus__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .thread-focus__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .thread-focus__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .thread-focus__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
---
/**
 * EvidenceFocus — the shared Evidence Focus renderer (DIRECTION.md V3/V4,
 * ARCHITECTURE.md §4, spec §8). Backs BOTH `/essays/<slug>/evidence/`
 * (the essay-scoped index) and the flat, site-wide `/evidence/<record>/`
 * route, plus the in-place overlay's `<template>` fragment — same
 * component, same field set from `evidence.ts`'s `EvidenceRecord`, never
 * a second hand-written summary.
 *
 * `records` is always the full evidence set (so the rail's `ReceiptIndex`
 * can navigate anywhere); `selectedId` narrows the main pane to one
 * record's full detail. Omitting it renders the full list.
 */
import EvidenceGuide from './EvidenceGuide.astro';
import ReceiptIndex from './ReceiptIndex.astro';
import ClaimBadge from './ClaimBadge.astro';
import type { EvidenceRecord } from '../../data/evidence';

interface Props {
  records: EvidenceRecord[];
  selectedId?: string;
  /** Real anchor text for a "Read in essay" link, when a related essay exists. */
  essaySlug?: string;
  standalone?: boolean;
}

const { records, selectedId, essaySlug, standalone = true } = Astro.props;
// The essay index is a receipt surface, not a bare directory. When no record
// is named in the route, introduce the first related receipt in full and let
// the rail provide the rest of the index.
const selected = selectedId ? records.find((record) => record.id === selectedId) : records[0];
const selectedRecordId = selected?.id;
const receiptDate = selected?.recordedDate ?? selected?.eventDate ?? selected?.verifiedAt ?? null;
const claimBadgeKind = selected
  ? ({
      observed: 'observed',
      measured: 'measured',
      proposed: 'proposed',
      'externally-reported': 'external',
      illustrative: 'hypothesis',
    }[selected.evidenceClass] as 'observed' | 'measured' | 'proposed' | 'external' | 'hypothesis')
  : undefined;

const formatDate = (value: string | null) => value ?? 'Not stated';
---

<div class="evidence-focus" data-focus-kind="evidence" data-focus-key={selectedId ?? 'all'}>
  <div class="evidence-focus__grid">
    <div class="evidence-focus__main">
      <div class="evidence-focus__actions">
        {essaySlug && (
          <a class="evidence-focus__action" href={`/essays/${essaySlug}/`}>
            &larr; Back to essay
          </a>
        )}
        <span class="evidence-focus__action-label font-mono">Evidence focus</span>
        {essaySlug && (
          <a
            class="evidence-focus__action evidence-focus__action--secondary"
            href={`/essays/${essaySlug}/evidence/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in new tab
          </a>
        )}
        {!standalone && (
          <button type="button" class="evidence-focus__action evidence-focus__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      <h1 class="evidence-focus__page-title font-serif">
        {selectedId && selected ? selected.title : 'Receipts behind the argument'}
      </h1>

      {selected ? (
        <article class="evidence-focus__record">
          <p class="evidence-focus__eyebrow font-mono">
            {claimBadgeKind && <ClaimBadge kind={claimBadgeKind} />}
            <span>{selected.evidenceClass}</span>
          </p>
          {!selectedId && <h2 class="evidence-focus__title font-serif">{selected.title}</h2>}

          <p class="evidence-focus__receipt-date font-mono">
            Receipt date: {formatDate(receiptDate)}
          </p>

          <dl class="evidence-focus__facts">
            <div>
              <dt>Capture type</dt>
              <dd>{selected.captureType}</dd>
            </div>
            <div>
              <dt>Event date</dt>
              <dd>{formatDate(selected.eventDate)}</dd>
            </div>
            <div>
              <dt>Recorded date</dt>
              <dd>{formatDate(selected.recordedDate)}</dd>
            </div>
            <div>
              <dt>Verified at</dt>
              <dd>{formatDate(selected.verifiedAt)}</dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>{selected.sourceUrl ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Source revision</dt>
              <dd>{selected.sourceRevision ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Publicability</dt>
              <dd>{selected.publicability}</dd>
            </div>
          </dl>

          <div class="evidence-focus__claim-split">
            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">What this supports</p>
              <ul>
                {selected.supports.map((line) => <li>{line}</li>)}
              </ul>
            </div>

            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">Limits</p>
              <ul>
                {selected.limitations.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </div>

          {selected.publicCapturePath ? (
            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">Capture</p>
              <p class="evidence-focus__capture-path">{selected.publicCapturePath}</p>
---
/**
 * FigureViewer — the shared figure-viewer renderer (DIRECTION.md V7,
 * ARCHITECTURE.md §4, spec §10). Backs both `/essays/<slug>/figure/<id>/`
 * and the in-place overlay's `<template>` fragment: exact asset, exact
 * caption, long description, and real file metadata read from disk at
 * build time — never a fabricated size or dimension (V1).
 *
 * `sharp` is already a project dependency (Astro's own image pipeline
 * uses it), so this reads genuine width/height via its metadata probe
 * rather than falling back to an undocumented guess; file size comes from
 * `fs.statSync`. A missing asset at build time leaves both fields `null`
 * — a labeled pending slot, not a substitute value.
 */
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);

let fileSizeBytes: number | null = null;
let width: number | null = null;
let height: number | null = null;

if (beat) {
  const absolutePath = path.join(process.cwd(), 'public', beat.image.src);
  try {
    const stat = fs.statSync(absolutePath);
    fileSizeBytes = stat.size;
    const metadata = await sharp(absolutePath).metadata();
    width = metadata.width ?? null;
    height = metadata.height ?? null;
  } catch {
    // Asset unreadable at build time — leave metadata null (V1: a missing
    // input stays a labeled pending slot, never a fabricated value).
  }
}

const formatBytes = (bytes: number | null) => {
  if (bytes === null) return 'Not available in this build';
  const kb = bytes / 1024;
  return kb >= 1024 ? `${(kb / 1024).toFixed(2)} MB` : `${kb.toFixed(1)} KB`;
};

const dimensionsLabel =
  width !== null && height !== null ? `${width} × ${height}px` : 'Not available in this build';

const filename = beat?.image.src.split('/').pop() ?? '';
---

{
  beat && (
    <div class="figure-viewer" data-focus-kind="figure" data-focus-key={beat.id}>
      <div class="figure-viewer__actions">
        <a class="figure-viewer__action" href={`/essays/${thread.slug}/`}>
          &larr; Back to essay
        </a>
        <a class="figure-viewer__action" href={`/essays/${thread.slug}/thread/${beat.id}/`}>
          &larr; Back to thread focus
        </a>
        <span class="figure-viewer__action-label font-mono">Figure viewer</span>
        <a class="figure-viewer__action figure-viewer__action--copy" href={`/essays/${thread.slug}/figure/${beat.id}/`} data-focus-copy-link>
          Copy link
        </a>
        {!standalone && (
          <button type="button" class="figure-viewer__action figure-viewer__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      <p class="figure-viewer__eyebrow font-mono">Figure {String(beat.n).padStart(2, '0')} · {beat.label}</p>
      <h2 class="figure-viewer__title font-serif">{beat.image.caption}</h2>

      <figure class="figure-viewer__figure">
        <img src={beat.image.src} alt={beat.image.alt} loading="lazy" decoding="async" />
        <figcaption>
          <p class="figure-viewer__caption">{beat.image.caption}</p>
          <p class="figure-viewer__long-description">{beat.longDescription}</p>
        </figcaption>
      </figure>

      <dl class="figure-viewer__metadata">
        <div>
          <dt>Filename</dt>
          <dd class="font-mono">{filename}</dd>
        </div>
        <div>
          <dt>File size</dt>
          <dd>{formatBytes(fileSizeBytes)}</dd>
        </div>
        <div>
          <dt>Dimensions</dt>
          <dd>{dimensionsLabel}</dd>
        </div>
      </dl>
    </div>
  )
}

<style>
  .figure-viewer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .figure-viewer__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
---
/**
 * ThreadDock — the compact beat list inside `ReadingCompanion`, replacing
 * `ThreadRail`'s role there (ARCHITECTURE.md §5, DIRECTION.md V3/V5).
 *
 * P0-B ships this as static, server-rendered markup: every beat links to
 * its inline anchor in the essay, plus a per-beat "Explore" link straight
 * to that beat's Thread Focus route — both real links, so the dock works
 * fully without JavaScript. Follow/hold-preview behavior (V6's
 * "held preview" vs "reading" split) and any live active-beat styling
 * driven by a scroll/section observer are P1 (component-ownership table:
 * ThreadDock is P1) — this component accepts an optional `activeBeatId`
 * so a later P1/P0-C pass can set `aria-current="step"` on the matching
 * row without touching this file's markup, but nothing here computes that
 * value today.
 */
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  activeBeatId?: string;
}

const { slug, activeBeatId } = Astro.props;
const thread = threads[slug];
---

{
  thread && (
    <nav class="thread-dock" aria-label={`Running example: ${thread.title}`} data-thread-dock>
      <div class="thread-dock__header">
        <div><p class="thread-dock__eyebrow font-mono">Running example</p><p class="thread-dock__title font-serif">{thread.title}</p></div>
        <button type="button" class="thread-dock__toggle focus-ring" data-thread-dock-toggle aria-expanded="true">Collapse</button>
      </div>

      <div data-thread-dock-content>
      <p class="thread-dock__state" data-thread-dock-state>Following reading</p>
      <ol class="thread-dock__list">
        {
          thread.beats.map((beat) => (
            <li class="thread-dock__item">
              <a
                href={`#thread-${beat.id}`}
                class="thread-dock__link"
                data-thread-dock-link
                data-beat-id={beat.id}
                aria-current={beat.id === activeBeatId ? 'step' : undefined}
              >
                <span class="thread-dock__number font-mono" aria-hidden="true">
                  {beat.n}
                </span>
                <span class="thread-dock__label">{beat.label}</span>
              </a>
              <button type="button" class="thread-dock__hold focus-ring" data-thread-dock-hold data-beat-id={beat.id}>Hold</button>
              <a class="thread-dock__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
                Explore
              </a>
            </li>
          ))
        }
      </ol>
      </div>
    </nav>
  )
}

<style>
  .thread-dock {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    padding: 0.875rem 0.875rem 0.75rem;
  }
  .thread-dock__header { display: flex; align-items: start; justify-content: space-between; gap: .5rem; }
  .thread-dock__toggle, .thread-dock__hold { border: 0; background: transparent; color: var(--text-tertiary); cursor: pointer; font: 600 .625rem var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  .thread-dock__state { margin: 0 0 .35rem; color: var(--text-tertiary); font: 600 .625rem/1.4 var(--font-mono); letter-spacing: .04em; }

  .thread-dock__eyebrow {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .thread-dock__title {
    margin: 0.2rem 0 0.6rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .thread-dock__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread-dock__item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .thread-dock__link {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: baseline;
    gap: 0.5rem;
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.4rem;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .thread-dock__link:hover,
  .thread-dock__link:focus-visible {
    background: var(--accent-subtle);
    color: var(--text-primary);
    outline: none;
  }

  .thread-dock__link:focus-visible {

