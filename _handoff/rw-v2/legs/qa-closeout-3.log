_handoff/rw-v2/legs/taste-fix-codex.log:34069:+---
_handoff/rw-v2/legs/taste-fix-codex.log:34070:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:34071:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:34072:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:34073:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:34074:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:34075:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:34076:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:34077:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:34078:+---
_handoff/rw-v2/legs/taste-fix-codex.log:34079:+
_handoff/rw-v2/legs/taste-fix-codex.log:34080:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:34081:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:34082:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:34083:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:34084:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:34085:+
_handoff/rw-v2/legs/taste-fix-codex.log:34086:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:34087:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:34088:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:34089:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:34090:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:34091:+
_handoff/rw-v2/legs/taste-fix-codex.log:34092:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:34093:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:34094:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:34095:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:34096:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:34097:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:34098:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:34099:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:34100:+
_handoff/rw-v2/legs/taste-fix-codex.log:34101:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:34102:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:34103:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:34104:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:34105:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:34106:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:34107:+
_handoff/rw-v2/legs/taste-fix-codex.log:34108:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:34109:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:34110:+</script>
_handoff/rw-v2/legs/taste-fix-codex.log:34111:+
_handoff/rw-v2/legs/taste-fix-codex.log:34112:+<style>
_handoff/rw-v2/legs/taste-fix-codex.log:34113:+  :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:34114:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:34115:+    grid-template-columns: 3rem minmax(0, 1fr);
_handoff/rw-v2/legs/taste-fix-codex.log:34116:+    column-gap: 0.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34117:+    align-items: start;
_handoff/rw-v2/legs/taste-fix-codex.log:34118:+    margin-top: 2.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34119:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:34120:+
_handoff/rw-v2/legs/taste-fix-codex.log:34121:+  :global(.section-marker__gutter) {
_handoff/rw-v2/legs/taste-fix-codex.log:34122:+    position: relative;
_handoff/rw-v2/legs/taste-fix-codex.log:34123:+    display: flex;
_handoff/rw-v2/legs/taste-fix-codex.log:34124:+    flex-direction: column;
_handoff/rw-v2/legs/taste-fix-codex.log:34125:+    align-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:34126:+    gap: 0.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34127:+    padding-top: 0.15rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34128:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:34129:+
_handoff/rw-v2/legs/taste-fix-codex.log:34130:+  :global(.section-marker__ordinal) {
_handoff/rw-v2/legs/taste-fix-codex.log:34131:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:34132:+    width: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34133:+    height: 1.75rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34134:+    place-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:34135:+    border: 1px solid var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:34136:+    border-radius: 0.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34137:+    color: var(--text-tertiary);
_handoff/rw-v2/legs/taste-fix-codex.log:34138:+    font-family: var(--font-mono);
_handoff/rw-v2/legs/taste-fix-codex.log:34139:+    font-size: 0.6875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34140:+    font-weight: 700;
_handoff/rw-v2/legs/taste-fix-codex.log:34141:+    letter-spacing: 0.08em;
_handoff/rw-v2/legs/taste-fix-codex.log:34142:+    line-height: 1;
_handoff/rw-v2/legs/taste-fix-codex.log:34143:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:34144:+
_handoff/rw-v2/legs/taste-fix-codex.log:34145:+  :global(.section-marker__rule) {
_handoff/rw-v2/legs/taste-fix-codex.log:34146:+    display: block;
_handoff/rw-v2/legs/taste-fix-codex.log:34147:+    width: 1px;
_handoff/rw-v2/legs/taste-fix-codex.log:34148:+    min-height: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34149:+    background: var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:34150:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:34151:+
_handoff/rw-v2/legs/taste-fix-codex.log:34152:+  :global(.section-marker > h2) {
_handoff/rw-v2/legs/taste-fix-codex.log:34153:+    margin-top: 0;
_handoff/rw-v2/legs/taste-fix-codex.log:34154:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:34155:+
_handoff/rw-v2/legs/taste-fix-codex.log:34156:+  @media (min-width: 768px) {
_handoff/rw-v2/legs/taste-fix-codex.log:34157:+    :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:34158:+      width: calc(100% + 3.875rem);
_handoff/rw-v2/legs/taste-fix-codex.log:34159:+      margin-left: -3.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:34160:+    }
_handoff/rw-v2/legs/taste-fix-codex.log:34161:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:34162:+</style>
