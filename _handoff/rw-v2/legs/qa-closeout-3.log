_handoff/rw-v2/legs/p0d-p1.log:2591:    min-width: 0;
_handoff/rw-v2/legs/p0d-p1.log:2592:  }
_handoff/rw-v2/legs/p0d-p1.log:2593:
_handoff/rw-v2/legs/p0d-p1.log:2594:  .thread-dock__explore {
_handoff/rw-v2/legs/p0d-p1.log:2595:    flex-shrink: 0;
_handoff/rw-v2/legs/p0d-p1.log:2596:    font-family: var(--font-mono);
_handoff/rw-v2/legs/p0d-p1.log:2597:    font-size: 0.625rem;
_handoff/rw-v2/legs/p0d-p1.log:2598:    font-weight: 600;
