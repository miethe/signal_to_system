_handoff/rw-v2/legs/p0d-p1.log:3520:--- src/lib/focus-host.ts ---
_handoff/rw-v2/legs/p0d-p1.log:3521:/**
_handoff/rw-v2/legs/p0d-p1.log:3522: * FocusHost controller — reading-experience-v2 P0-C
_handoff/rw-v2/legs/p0d-p1.log:3523: * (docs/blog-work/the-registry-wave-agentic-artifact-supply-chain/reading-experience-v2/ARCHITECTURE.md §3).
_handoff/rw-v2/legs/p0d-p1.log:3524: *
_handoff/rw-v2/legs/p0d-p1.log:3525: * Owns one native <dialog> (mounted by `FocusHost.astro`) that every
_handoff/rw-v2/legs/p0d-p1.log:3526: * "Explore thread" / evidence / figure trigger on an essay page can open
_handoff/rw-v2/legs/p0d-p1.log:3527: * in place, by cloning the matching `<template data-focus-view="kind:id">`
_handoff/rw-v2/legs/p0d-p1.log:3528: * fragment `FocusTemplates.astro` already rendered on the page — never a
_handoff/rw-v2/legs/p0d-p1.log:3529: * client fetch, never a second hand-written explanation of a beat/record.
_handoff/rw-v2/legs/p0d-p1.log:3530: *
_handoff/rw-v2/legs/p0d-p1.log:3531: * Every trigger is first and always a real `<a href>` to the standalone
_handoff/rw-v2/legs/p0d-p1.log:3532: * route P0-B built (`/essays/<slug>/thread/<beat>/`, `/essays/<slug>/evidence/`,
_handoff/rw-v2/legs/p0d-p1.log:3533: * `/evidence/<record>/`, `/essays/<slug>/figure/<id>/`). This module only
_handoff/rw-v2/legs/p0d-p1.log:3534: * decides, on an unmodified primary click, whether to intercept that link
_handoff/rw-v2/legs/p0d-p1.log:3535: * and render the matching template in the dialog instead of navigating —
_handoff/rw-v2/legs/p0d-p1.log:3536: * derived from the clicked link's own `href` (a static route shape), never
_handoff/rw-v2/legs/p0d-p1.log:3537: * from author-added `data-kind`/`data-key` markup. That keeps every
_handoff/rw-v2/legs/p0d-p1.log:3538: * existing "Explore thread" / rail / prev-next / figure link correct by
_handoff/rw-v2/legs/p0d-p1.log:3539: * construction: the standalone route and the overlay agree because they
_handoff/rw-v2/legs/p0d-p1.log:3540: * are reading the same URL.
_handoff/rw-v2/legs/p0d-p1.log:3541: *
_handoff/rw-v2/legs/p0d-p1.log:3542: * History is owned directly (`pushState`/`replaceState`/one `popstate`
_handoff/rw-v2/legs/p0d-p1.log:3543: * listener) rather than integrated with Astro ClientRouter, because
_handoff/rw-v2/legs/p0d-p1.log:3544: * ClientRouter is not wired anywhere in this codebase today — see
_handoff/rw-v2/legs/p0d-p1.log:3545: * ARCHITECTURE.md §1's correction to its own brief before changing this.
_handoff/rw-v2/legs/p0d-p1.log:3546: */
_handoff/rw-v2/legs/p0d-p1.log:3547:
_handoff/rw-v2/legs/p0d-p1.log:3548:type FocusKind = 'thread' | 'evidence' | 'figure';
_handoff/rw-v2/legs/p0d-p1.log:3549:type EntryKind = FocusKind | 'root';
_handoff/rw-v2/legs/p0d-p1.log:3550:
_handoff/rw-v2/legs/p0d-p1.log:3551:interface FocusEntry {
_handoff/rw-v2/legs/p0d-p1.log:3552:  kind: EntryKind;
_handoff/rw-v2/legs/p0d-p1.log:3553:  id: string;
_handoff/rw-v2/legs/p0d-p1.log:3554:  parentKey: string | null;
_handoff/rw-v2/legs/p0d-p1.log:3555:  scrollTop: number;
_handoff/rw-v2/legs/p0d-p1.log:3556:  focusTargetId: string | null;
_handoff/rw-v2/legs/p0d-p1.log:3557:}
_handoff/rw-v2/legs/p0d-p1.log:3558:
_handoff/rw-v2/legs/p0d-p1.log:3559:interface RootSnapshot {
_handoff/rw-v2/legs/p0d-p1.log:3560:  x: number;
_handoff/rw-v2/legs/p0d-p1.log:3561:  y: number;
_handoff/rw-v2/legs/p0d-p1.log:3562:  trigger: HTMLElement | null;
_handoff/rw-v2/legs/p0d-p1.log:3563:  /** A stable fallback focus target near `trigger`, in case it's gone by the time we restore. */
_handoff/rw-v2/legs/p0d-p1.log:3564:  headingId: string | null;
_handoff/rw-v2/legs/p0d-p1.log:3565:}
_handoff/rw-v2/legs/p0d-p1.log:3566:
_handoff/rw-v2/legs/p0d-p1.log:3567:type FocusAction =
_handoff/rw-v2/legs/p0d-p1.log:3568:  | { type: 'open'; kind: FocusKind; id: string }
_handoff/rw-v2/legs/p0d-p1.log:3569:  | { type: 'back' }
_handoff/rw-v2/legs/p0d-p1.log:3570:  | { type: 'jump'; anchorId: string };
_handoff/rw-v2/legs/p0d-p1.log:3571:
_handoff/rw-v2/legs/p0d-p1.log:3572:const THREAD_RE = /^\/essays\/([^/]+)\/thread\/([^/]+)\/?$/;
_handoff/rw-v2/legs/p0d-p1.log:3573:const EVIDENCE_INDEX_RE = /^\/essays\/([^/]+)\/evidence\/?$/;
_handoff/rw-v2/legs/p0d-p1.log:3574:const EVIDENCE_RECORD_RE = /^\/evidence\/([^/]+)\/?$/;
_handoff/rw-v2/legs/p0d-p1.log:3575:const FIGURE_RE = /^\/essays\/([^/]+)\/figure\/([^/]+)\/?$/;
_handoff/rw-v2/legs/p0d-p1.log:3576:const ESSAY_ROOT_RE = /^\/essays\/([^/]+)\/?$/;
_handoff/rw-v2/legs/p0d-p1.log:3577:
_handoff/rw-v2/legs/p0d-p1.log:3578:/**
_handoff/rw-v2/legs/p0d-p1.log:3579: * Reads the clicked link's own URL and returns what it means to FocusHost,
_handoff/rw-v2/legs/p0d-p1.log:3580: * or `null` if it's none of its concern (an ordinary in-page anchor, an
_handoff/rw-v2/legs/p0d-p1.log:3581: * external link, a route it doesn't own). Distinguishes "Back to essay"
_handoff/rw-v2/legs/p0d-p1.log:3582: * from "Read this scene in the essay" purely by hash: the former is the
_handoff/rw-v2/legs/p0d-p1.log:3583: * bare essay URL, the latter carries `#thread-<beatId>` — matching the two
_handoff/rw-v2/legs/p0d-p1.log:3584: * links' actual, distinct hrefs (`ThreadFocus.astro`/`EvidenceFocus.astro`
_handoff/rw-v2/legs/p0d-p1.log:3585: * write them differently on purpose).
_handoff/rw-v2/legs/p0d-p1.log:3586: */
_handoff/rw-v2/legs/p0d-p1.log:3587:function parseFocusAction(pathname: string, hash: string): FocusAction | null {
_handoff/rw-v2/legs/p0d-p1.log:3588:  let match = THREAD_RE.exec(pathname);
_handoff/rw-v2/legs/p0d-p1.log:3589:  if (match) return { type: 'open', kind: 'thread', id: match[2] };
_handoff/rw-v2/legs/p0d-p1.log:3590:
_handoff/rw-v2/legs/p0d-p1.log:3591:  match = FIGURE_RE.exec(pathname);
_handoff/rw-v2/legs/p0d-p1.log:3592:  if (match) return { type: 'open', kind: 'figure', id: match[2] };
_handoff/rw-v2/legs/p0d-p1.log:3593:
_handoff/rw-v2/legs/p0d-p1.log:3594:  match = EVIDENCE_INDEX_RE.exec(pathname);
_handoff/rw-v2/legs/p0d-p1.log:3595:  if (match) return { type: 'open', kind: 'evidence', id: 'all' };
_handoff/rw-v2/legs/p0d-p1.log:3596:
_handoff/rw-v2/legs/p0d-p1.log:3597:  match = EVIDENCE_RECORD_RE.exec(pathname);
_handoff/rw-v2/legs/p0d-p1.log:3598:  if (match) return { type: 'open', kind: 'evidence', id: match[1] };
_handoff/rw-v2/legs/p0d-p1.log:3599:
_handoff/rw-v2/legs/p0d-p1.log:3600:  match = ESSAY_ROOT_RE.exec(pathname);
_handoff/rw-v2/legs/p0d-p1.log:3601:  if (match) {
_handoff/rw-v2/legs/p0d-p1.log:3602:    const anchorId = hash.replace(/^#/, '');
_handoff/rw-v2/legs/p0d-p1.log:3603:    if (anchorId.startsWith('thread-')) return { type: 'jump', anchorId };
_handoff/rw-v2/legs/p0d-p1.log:3604:    if (!hash) return { type: 'back' };
_handoff/rw-v2/legs/p0d-p1.log:3605:  }
_handoff/rw-v2/legs/p0d-p1.log:3606:
_handoff/rw-v2/legs/p0d-p1.log:3607:  return null;
_handoff/rw-v2/legs/p0d-p1.log:3608:}
_handoff/rw-v2/legs/p0d-p1.log:3609:
_handoff/rw-v2/legs/p0d-p1.log:3610:function reduceMotion(): boolean {
_handoff/rw-v2/legs/p0d-p1.log:3611:  return (
_handoff/rw-v2/legs/p0d-p1.log:3612:    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
_handoff/rw-v2/legs/p0d-p1.log:3613:    document.documentElement.classList.contains('perf-lite')
_handoff/rw-v2/legs/p0d-p1.log:3614:  );
_handoff/rw-v2/legs/p0d-p1.log:3615:}
_handoff/rw-v2/legs/p0d-p1.log:3616:
_handoff/rw-v2/legs/p0d-p1.log:3617:export function initFocusHost(): void {
_handoff/rw-v2/legs/p0d-p1.log:3618:  const dialogEl = document.querySelector<HTMLDialogElement>('[data-focus-dialog]');
_handoff/rw-v2/legs/p0d-p1.log:3619:  if (!dialogEl || typeof dialogEl.showModal !== 'function') return;
_handoff/rw-v2/legs/p0d-p1.log:3620:  if (dialogEl.dataset.focusHostReady === 'true') return;
_handoff/rw-v2/legs/p0d-p1.log:3621:  dialogEl.dataset.focusHostReady = 'true';
_handoff/rw-v2/legs/p0d-p1.log:3622:
_handoff/rw-v2/legs/p0d-p1.log:3623:  const essaySlug = dialogEl.dataset.essaySlug ?? '';
_handoff/rw-v2/legs/p0d-p1.log:3624:  const docToken = Math.random().toString(36).slice(2);
_handoff/rw-v2/legs/p0d-p1.log:3625:
_handoff/rw-v2/legs/p0d-p1.log:3626:  const entries = new Map<string, FocusEntry>();
_handoff/rw-v2/legs/p0d-p1.log:3627:  let seq = 0;
_handoff/rw-v2/legs/p0d-p1.log:3628:  let rootKey: string | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3629:  let currentKey: string | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3630:  let origin: RootSnapshot | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3631:  let historyCapable = true;
_handoff/rw-v2/legs/p0d-p1.log:3632:  let pendingAfterRestore: (() => void) | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3633:  let previousBodyStyle: string | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3634:
_handoff/rw-v2/legs/p0d-p1.log:3635:  const generateKey = (): string => {
_handoff/rw-v2/legs/p0d-p1.log:3636:    seq += 1;
_handoff/rw-v2/legs/p0d-p1.log:3637:    return `focus-${seq}`;
_handoff/rw-v2/legs/p0d-p1.log:3638:  };
_handoff/rw-v2/legs/p0d-p1.log:3639:
_handoff/rw-v2/legs/p0d-p1.log:3640:  const stateFor = (key: string): Record<string, unknown> => ({
_handoff/rw-v2/legs/p0d-p1.log:3641:    ...((history.state as Record<string, unknown> | null) ?? {}),
_handoff/rw-v2/legs/p0d-p1.log:3642:    rwFocus: { doc: docToken, key },
_handoff/rw-v2/legs/p0d-p1.log:3643:  });
_handoff/rw-v2/legs/p0d-p1.log:3644:
_handoff/rw-v2/legs/p0d-p1.log:3645:  const writeHistory = (method: 'pushState' | 'replaceState', state: unknown, url: string): boolean => {
_handoff/rw-v2/legs/p0d-p1.log:3646:    try {
_handoff/rw-v2/legs/p0d-p1.log:3647:      history[method](state, '', url);
_handoff/rw-v2/legs/p0d-p1.log:3648:      return true;
_handoff/rw-v2/legs/p0d-p1.log:3649:    } catch {
_handoff/rw-v2/legs/p0d-p1.log:3650:      historyCapable = false;
_handoff/rw-v2/legs/p0d-p1.log:3651:      return false;
_handoff/rw-v2/legs/p0d-p1.log:3652:    }
_handoff/rw-v2/legs/p0d-p1.log:3653:  };
_handoff/rw-v2/legs/p0d-p1.log:3654:
_handoff/rw-v2/legs/p0d-p1.log:3655:  const isOwnHistoryState = (key: string | null): boolean => {
_handoff/rw-v2/legs/p0d-p1.log:3656:    const state = history.state as { rwFocus?: { doc: string; key: string } } | null;
_handoff/rw-v2/legs/p0d-p1.log:3657:    return Boolean(key) && state?.rwFocus?.doc === docToken && state?.rwFocus?.key === key;
_handoff/rw-v2/legs/p0d-p1.log:3658:  };
_handoff/rw-v2/legs/p0d-p1.log:3659:
_handoff/rw-v2/legs/p0d-p1.log:3660:  const localHref = (kind: FocusKind, id: string): string => {
_handoff/rw-v2/legs/p0d-p1.log:3661:    switch (kind) {
_handoff/rw-v2/legs/p0d-p1.log:3662:      case 'thread':
_handoff/rw-v2/legs/p0d-p1.log:3663:        return `/essays/${essaySlug}/thread/${id}/`;
_handoff/rw-v2/legs/p0d-p1.log:3664:      case 'figure':
_handoff/rw-v2/legs/p0d-p1.log:3665:        return `/essays/${essaySlug}/figure/${id}/`;
_handoff/rw-v2/legs/p0d-p1.log:3666:      case 'evidence':
_handoff/rw-v2/legs/p0d-p1.log:3667:        return id === 'all' ? `/essays/${essaySlug}/evidence/` : `/evidence/${id}/`;
_handoff/rw-v2/legs/p0d-p1.log:3668:    }
_handoff/rw-v2/legs/p0d-p1.log:3669:  };
_handoff/rw-v2/legs/p0d-p1.log:3670:
_handoff/rw-v2/legs/p0d-p1.log:3671:  const templateFor = (kind: EntryKind, id: string): HTMLTemplateElement | null => {
_handoff/rw-v2/legs/p0d-p1.log:3672:    if (kind === 'root') return null;
_handoff/rw-v2/legs/p0d-p1.log:3673:    const safeId = id.replace(/"/g, '\\"');
_handoff/rw-v2/legs/p0d-p1.log:3674:    return document.querySelector<HTMLTemplateElement>(
_handoff/rw-v2/legs/p0d-p1.log:3675:      `[data-focus-templates] template[data-focus-view="${kind}:${safeId}"]`,
_handoff/rw-v2/legs/p0d-p1.log:3676:    );
_handoff/rw-v2/legs/p0d-p1.log:3677:  };
_handoff/rw-v2/legs/p0d-p1.log:3678:
_handoff/rw-v2/legs/p0d-p1.log:3679:  const closePrivateFigureLightboxes = () => {
_handoff/rw-v2/legs/p0d-p1.log:3680:    // Hard invariant (ARCHITECTURE.md §3 risk 3): Figure.astro's own private
_handoff/rw-v2/legs/p0d-p1.log:3681:    // lightbox and this shared dialog must never both be open at once.
_handoff/rw-v2/legs/p0d-p1.log:3682:    document.querySelectorAll<HTMLDialogElement>('[data-figure-dialog][open]').forEach((lightbox) => {
_handoff/rw-v2/legs/p0d-p1.log:3683:      lightbox.close();
_handoff/rw-v2/legs/p0d-p1.log:3684:    });
_handoff/rw-v2/legs/p0d-p1.log:3685:  };
_handoff/rw-v2/legs/p0d-p1.log:3686:
_handoff/rw-v2/legs/p0d-p1.log:3687:  const lockScroll = () => {
_handoff/rw-v2/legs/p0d-p1.log:3688:    const y = window.scrollY;
_handoff/rw-v2/legs/p0d-p1.log:3689:    previousBodyStyle = document.body.getAttribute('style');
_handoff/rw-v2/legs/p0d-p1.log:3690:    document.body.style.position = 'fixed';
_handoff/rw-v2/legs/p0d-p1.log:3691:    document.body.style.top = `-${y}px`;
_handoff/rw-v2/legs/p0d-p1.log:3692:    document.body.style.left = '0';
_handoff/rw-v2/legs/p0d-p1.log:3693:    document.body.style.right = '0';
_handoff/rw-v2/legs/p0d-p1.log:3694:    document.body.style.width = '100%';
_handoff/rw-v2/legs/p0d-p1.log:3695:  };
_handoff/rw-v2/legs/p0d-p1.log:3696:
_handoff/rw-v2/legs/p0d-p1.log:3697:  const unlockScroll = () => {
_handoff/rw-v2/legs/p0d-p1.log:3698:    if (previousBodyStyle === null) {
_handoff/rw-v2/legs/p0d-p1.log:3699:      document.body.removeAttribute('style');
_handoff/rw-v2/legs/p0d-p1.log:3700:    } else {
_handoff/rw-v2/legs/p0d-p1.log:3701:      document.body.setAttribute('style', previousBodyStyle);
_handoff/rw-v2/legs/p0d-p1.log:3702:    }
_handoff/rw-v2/legs/p0d-p1.log:3703:    previousBodyStyle = null;
_handoff/rw-v2/legs/p0d-p1.log:3704:  };
_handoff/rw-v2/legs/p0d-p1.log:3705:
_handoff/rw-v2/legs/p0d-p1.log:3706:  const captureOrigin = (trigger: HTMLElement | null): RootSnapshot => ({
_handoff/rw-v2/legs/p0d-p1.log:3707:    x: window.scrollX,
_handoff/rw-v2/legs/p0d-p1.log:3708:    y: window.scrollY,
_handoff/rw-v2/legs/p0d-p1.log:3709:    trigger,
_handoff/rw-v2/legs/p0d-p1.log:3710:    headingId: trigger?.closest('section')?.querySelector('h2, h3')?.id ?? null,
_handoff/rw-v2/legs/p0d-p1.log:3711:  });
_handoff/rw-v2/legs/p0d-p1.log:3712:
_handoff/rw-v2/legs/p0d-p1.log:3713:  const saveCurrentEntryState = () => {
_handoff/rw-v2/legs/p0d-p1.log:3714:    if (!currentKey) return;
_handoff/rw-v2/legs/p0d-p1.log:3715:    const entry = entries.get(currentKey);
_handoff/rw-v2/legs/p0d-p1.log:3716:    if (!entry) return;
_handoff/rw-v2/legs/p0d-p1.log:3717:    entry.scrollTop = dialogEl.scrollTop;
_handoff/rw-v2/legs/p0d-p1.log:3718:    const active = document.activeElement;
_handoff/rw-v2/legs/p0d-p1.log:3719:    if (active instanceof HTMLElement && dialogEl.contains(active)) {
_handoff/rw-v2/legs/p0d-p1.log:3720:      const token = active.dataset.focusToken ?? `ft-${++seq}`;
_handoff/rw-v2/legs/p0d-p1.log:3721:      active.dataset.focusToken = token;
_handoff/rw-v2/legs/p0d-p1.log:3722:      entry.focusTargetId = token;
_handoff/rw-v2/legs/p0d-p1.log:3723:    } else {
_handoff/rw-v2/legs/p0d-p1.log:3724:      entry.focusTargetId = null;
_handoff/rw-v2/legs/p0d-p1.log:3725:    }
_handoff/rw-v2/legs/p0d-p1.log:3726:  };
_handoff/rw-v2/legs/p0d-p1.log:3727:
_handoff/rw-v2/legs/p0d-p1.log:3728:  const focusEntryTitle = (entry: FocusEntry, isRestore: boolean) => {
_handoff/rw-v2/legs/p0d-p1.log:3729:    requestAnimationFrame(() => {
_handoff/rw-v2/legs/p0d-p1.log:3730:      // The dialog's accessible name always comes from the view's own
_handoff/rw-v2/legs/p0d-p1.log:3731:      // title, regardless of what was focused when the entry was saved.
_handoff/rw-v2/legs/p0d-p1.log:3732:      const title = dialogEl.querySelector<HTMLElement>('h2, h3');
_handoff/rw-v2/legs/p0d-p1.log:3733:      if (title) {
_handoff/rw-v2/legs/p0d-p1.log:3734:        if (!title.id) title.id = `focus-host-title-${++seq}`;
_handoff/rw-v2/legs/p0d-p1.log:3735:        dialogEl.setAttribute('aria-labelledby', title.id);
_handoff/rw-v2/legs/p0d-p1.log:3736:      } else {
_handoff/rw-v2/legs/p0d-p1.log:3737:        dialogEl.removeAttribute('aria-labelledby');
_handoff/rw-v2/legs/p0d-p1.log:3738:      }
_handoff/rw-v2/legs/p0d-p1.log:3739:
_handoff/rw-v2/legs/p0d-p1.log:3740:      // Initial focus target: the element that had focus when this entry
_handoff/rw-v2/legs/p0d-p1.log:3741:      // was last left (restore), else the title itself (fresh open) — never
_handoff/rw-v2/legs/p0d-p1.log:3742:      // a giant aria-describedby wrapper.
_handoff/rw-v2/legs/p0d-p1.log:3743:      let target: HTMLElement | null = null;
_handoff/rw-v2/legs/p0d-p1.log:3744:      if (isRestore && entry.focusTargetId) {
_handoff/rw-v2/legs/p0d-p1.log:3745:        target = dialogEl.querySelector<HTMLElement>(`[data-focus-token="${entry.focusTargetId}"]`);
_handoff/rw-v2/legs/p0d-p1.log:3746:      }
