_handoff/rw-v2/legs/p0d-p1.log:2611:</style>
_handoff/rw-v2/legs/p0d-p1.log:2612:
_handoff/rw-v2/legs/p0d-p1.log:2613:--- src/components/content/ThreadScene.astro ---
_handoff/rw-v2/legs/p0d-p1.log:2614:---
_handoff/rw-v2/legs/p0d-p1.log:2615:/**
_handoff/rw-v2/legs/p0d-p1.log:2616: * ThreadScene — inline per-beat rendering for a post's running thread,
_handoff/rw-v2/legs/p0d-p1.log:2617: * placed adjacent to matching prose at each of the six canonical anchors
_handoff/rw-v2/legs/p0d-p1.log:2618: * (reading-experience-v2 DIRECTION.md V3/V7, ARCHITECTURE.md §4). It looks
_handoff/rw-v2/legs/p0d-p1.log:2619: * up its own beat from `threads.ts` by `slug` + `beatId` and renders the
_handoff/rw-v2/legs/p0d-p1.log:2620: * canonical figure, the one real recap paragraph, a semantic kind label,
_handoff/rw-v2/legs/p0d-p1.log:2621: * and an "Explore thread" link to the standalone Thread Focus route.
_handoff/rw-v2/legs/p0d-p1.log:2622: *
_handoff/rw-v2/legs/p0d-p1.log:2623: * `ThreadFocus.astro` renders the fuller composition from the exact same
_handoff/rw-v2/legs/p0d-p1.log:2624: * beat record — recap is written once in `threads.ts` and both surfaces
_handoff/rw-v2/legs/p0d-p1.log:2625: * read it, never a second hand-written explanation (V3).
_handoff/rw-v2/legs/p0d-p1.log:2626: *
_handoff/rw-v2/legs/p0d-p1.log:2627: * `composition` follows DIRECTION V6's four main-pane types. `measure`
_handoff/rw-v2/legs/p0d-p1.log:2628: * (default) keeps the scene inside the article's prose measure; `pane`
_handoff/rw-v2/legs/p0d-p1.log:2629: * breaks the whole scene out wider, for the four dense technical PNGs
_handoff/rw-v2/legs/p0d-p1.log:2630: * named in this essay's build brief (incident, deployment, drift,
_handoff/rw-v2/legs/p0d-p1.log:2631: * outcome). `split`/`inset` are accepted for forward compatibility with
_handoff/rw-v2/legs/p0d-p1.log:2632: * V6's full set — this essay's six scenes use only `measure`/`pane` today,
_handoff/rw-v2/legs/p0d-p1.log:2633: * so those two get a lighter, documented treatment rather than a full
_handoff/rw-v2/legs/p0d-p1.log:2634: * adjacent-content slot this component doesn't have a use for yet.
_handoff/rw-v2/legs/p0d-p1.log:2635: */
_handoff/rw-v2/legs/p0d-p1.log:2636:import Figure from './Figure.astro';
_handoff/rw-v2/legs/p0d-p1.log:2637:import { threads } from '../../data/threads';
_handoff/rw-v2/legs/p0d-p1.log:2638:
_handoff/rw-v2/legs/p0d-p1.log:2639:interface Props {
_handoff/rw-v2/legs/p0d-p1.log:2640:  slug: string;
_handoff/rw-v2/legs/p0d-p1.log:2641:  beatId: string;
_handoff/rw-v2/legs/p0d-p1.log:2642:  composition?: 'measure' | 'pane' | 'split' | 'inset';
_handoff/rw-v2/legs/p0d-p1.log:2643:}
_handoff/rw-v2/legs/p0d-p1.log:2644:
_handoff/rw-v2/legs/p0d-p1.log:2645:const { slug, beatId, composition = 'measure' } = Astro.props;
_handoff/rw-v2/legs/p0d-p1.log:2646:const thread = threads[slug];
_handoff/rw-v2/legs/p0d-p1.log:2647:const beat = thread?.beats.find((candidate) => candidate.id === beatId);
_handoff/rw-v2/legs/p0d-p1.log:2648:
_handoff/rw-v2/legs/p0d-p1.log:2649:if (!thread || !beat) {
_handoff/rw-v2/legs/p0d-p1.log:2650:  console.warn(
_handoff/rw-v2/legs/p0d-p1.log:2651:    `[ThreadScene] Unable to resolve beat "${beatId}" for thread "${slug}". Rendering nothing.`,
_handoff/rw-v2/legs/p0d-p1.log:2652:  );
_handoff/rw-v2/legs/p0d-p1.log:2653:}
_handoff/rw-v2/legs/p0d-p1.log:2654:
_handoff/rw-v2/legs/p0d-p1.log:2655:const kindLabel: Record<string, string> = {
_handoff/rw-v2/legs/p0d-p1.log:2656:  historical: 'Historical account',
_handoff/rw-v2/legs/p0d-p1.log:2657:  conceptual: 'Conceptual branch',
_handoff/rw-v2/legs/p0d-p1.log:2658:  mechanism: 'Mechanism',
_handoff/rw-v2/legs/p0d-p1.log:2659:  proposed: 'Proposed',
_handoff/rw-v2/legs/p0d-p1.log:2660:};
_handoff/rw-v2/legs/p0d-p1.log:2661:
_handoff/rw-v2/legs/p0d-p1.log:2662:// Restrained cyan/violet split (DIRECTION V10): conceptual/mechanism beats
_handoff/rw-v2/legs/p0d-p1.log:2663:// (the two boundary-flagged, non-historical kinds) get the cyan structural
_handoff/rw-v2/legs/p0d-p1.log:2664:// accent on their kind label; historical/proposed keep the primary violet
_handoff/rw-v2/legs/p0d-p1.log:2665:// accent used everywhere else in the thread.
_handoff/rw-v2/legs/p0d-p1.log:2666:const kindUsesCyan = beat?.kind === 'conceptual' || beat?.kind === 'mechanism';
_handoff/rw-v2/legs/p0d-p1.log:2667:---
_handoff/rw-v2/legs/p0d-p1.log:2668:
_handoff/rw-v2/legs/p0d-p1.log:2669:{
_handoff/rw-v2/legs/p0d-p1.log:2670:  thread && beat && (
_handoff/rw-v2/legs/p0d-p1.log:2671:    <section
_handoff/rw-v2/legs/p0d-p1.log:2672:      id={`thread-${beat.id}`}
_handoff/rw-v2/legs/p0d-p1.log:2673:      class:list={[
_handoff/rw-v2/legs/p0d-p1.log:2674:        'thread-scene lift-hover',
_handoff/rw-v2/legs/p0d-p1.log:2675:        composition === 'pane' && 'thread-scene--pane',
_handoff/rw-v2/legs/p0d-p1.log:2676:        composition === 'split' && 'thread-scene--split',
_handoff/rw-v2/legs/p0d-p1.log:2677:        composition === 'inset' && 'thread-scene--inset',
_handoff/rw-v2/legs/p0d-p1.log:2678:      ]}
_handoff/rw-v2/legs/p0d-p1.log:2679:      aria-labelledby={`thread-${beat.id}-label`}
_handoff/rw-v2/legs/p0d-p1.log:2680:    >
_handoff/rw-v2/legs/p0d-p1.log:2681:      <span class="thread-scene__corner thread-scene__corner--tl" aria-hidden="true" />
_handoff/rw-v2/legs/p0d-p1.log:2682:      <span class="thread-scene__corner thread-scene__corner--tr" aria-hidden="true" />
_handoff/rw-v2/legs/p0d-p1.log:2683:      <span class="thread-scene__corner thread-scene__corner--bl" aria-hidden="true" />
_handoff/rw-v2/legs/p0d-p1.log:2684:      <span class="thread-scene__corner thread-scene__corner--br" aria-hidden="true" />
_handoff/rw-v2/legs/p0d-p1.log:2685:
_handoff/rw-v2/legs/p0d-p1.log:2686:      <div class="thread-scene__body">
_handoff/rw-v2/legs/p0d-p1.log:2687:        <div class="thread-scene__head">
_handoff/rw-v2/legs/p0d-p1.log:2688:          <p class="thread-scene__eyebrow font-mono">
_handoff/rw-v2/legs/p0d-p1.log:2689:            <span class="thread-scene__count">
_handoff/rw-v2/legs/p0d-p1.log:2690:              {beat.n}/{thread.beats.length}
_handoff/rw-v2/legs/p0d-p1.log:2691:            </span>
_handoff/rw-v2/legs/p0d-p1.log:2692:            <span aria-hidden="true" class="thread-scene__eyebrow-sep">
_handoff/rw-v2/legs/p0d-p1.log:2693:              &middot;
_handoff/rw-v2/legs/p0d-p1.log:2694:            </span>
_handoff/rw-v2/legs/p0d-p1.log:2695:            <span class:list={['thread-scene__kind', kindUsesCyan && 'thread-scene__kind--cyan']}>
_handoff/rw-v2/legs/p0d-p1.log:2696:              {kindLabel[beat.kind] ?? beat.kind}
_handoff/rw-v2/legs/p0d-p1.log:2697:            </span>
_handoff/rw-v2/legs/p0d-p1.log:2698:          </p>
_handoff/rw-v2/legs/p0d-p1.log:2699:          <h3 id={`thread-${beat.id}-label`} class="thread-scene__label font-serif">
_handoff/rw-v2/legs/p0d-p1.log:2700:            {beat.label}
_handoff/rw-v2/legs/p0d-p1.log:2701:          </h3>
_handoff/rw-v2/legs/p0d-p1.log:2702:        </div>
_handoff/rw-v2/legs/p0d-p1.log:2703:
_handoff/rw-v2/legs/p0d-p1.log:2704:        <p class="thread-scene__recap">{beat.recap}</p>
_handoff/rw-v2/legs/p0d-p1.log:2705:
_handoff/rw-v2/legs/p0d-p1.log:2706:        <Figure
_handoff/rw-v2/legs/p0d-p1.log:2707:          src={beat.image.src}
_handoff/rw-v2/legs/p0d-p1.log:2708:          alt={beat.image.alt}
_handoff/rw-v2/legs/p0d-p1.log:2709:          caption={beat.image.caption}
_handoff/rw-v2/legs/p0d-p1.log:2710:          number={String(beat.n).padStart(2, '0')}
_handoff/rw-v2/legs/p0d-p1.log:2711:          longDescription={beat.longDescription}
_handoff/rw-v2/legs/p0d-p1.log:2712:          figureId={beat.id}
_handoff/rw-v2/legs/p0d-p1.log:2713:          slug={slug}
_handoff/rw-v2/legs/p0d-p1.log:2714:          variant={composition === 'pane' ? 'technical' : 'inline'}
_handoff/rw-v2/legs/p0d-p1.log:2715:        />
_handoff/rw-v2/legs/p0d-p1.log:2716:
_handoff/rw-v2/legs/p0d-p1.log:2717:        <a class="thread-scene__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
_handoff/rw-v2/legs/p0d-p1.log:2718:          Explore this thread beat <span aria-hidden="true">&rarr;</span>
_handoff/rw-v2/legs/p0d-p1.log:2719:        </a>
_handoff/rw-v2/legs/p0d-p1.log:2720:      </div>
_handoff/rw-v2/legs/p0d-p1.log:2721:    </section>
_handoff/rw-v2/legs/p0d-p1.log:2722:  )
_handoff/rw-v2/legs/p0d-p1.log:2723:}
_handoff/rw-v2/legs/p0d-p1.log:2724:
_handoff/rw-v2/legs/p0d-p1.log:2725:<style>
