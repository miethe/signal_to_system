_handoff/rw-v2/legs/taste-fix-codex.log:31522:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:31523:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:31524:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:31525:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:31526:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:31527:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:31528:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:31529:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:31530:+---
_handoff/rw-v2/legs/taste-fix-codex.log:31531:+
_handoff/rw-v2/legs/taste-fix-codex.log:31532:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:31533:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:31534:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:31535:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:31536:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:31537:+
_handoff/rw-v2/legs/taste-fix-codex.log:31538:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:31539:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:31540:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:31541:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:31542:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:31543:+
_handoff/rw-v2/legs/taste-fix-codex.log:31544:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:31545:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:31546:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:31547:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:31548:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:31549:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:31550:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:31551:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:31552:+
_handoff/rw-v2/legs/taste-fix-codex.log:31553:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:31554:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:31555:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:31556:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:31557:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:31558:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:31559:+
_handoff/rw-v2/legs/taste-fix-codex.log:31560:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:31561:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:31562:+</script>
