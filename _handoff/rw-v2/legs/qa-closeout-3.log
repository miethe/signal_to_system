_handoff/rw-v2/legs/taste-fix-codex.log:31952:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:31953:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:31954:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:31955:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:31956:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:31957:+
_handoff/rw-v2/legs/taste-fix-codex.log:31958:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:31959:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:31960:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:31961:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:31962:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:31963:+
_handoff/rw-v2/legs/taste-fix-codex.log:31964:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:31965:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:31966:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:31967:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:31968:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:31969:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:31970:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:31971:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:31972:+
_handoff/rw-v2/legs/taste-fix-codex.log:31973:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:31974:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:31975:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:31976:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:31977:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:31978:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:31979:+
_handoff/rw-v2/legs/taste-fix-codex.log:31980:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:31981:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:31982:+</script>
