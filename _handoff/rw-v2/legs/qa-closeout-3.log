_handoff/rw-v2/legs/taste-fix-codex.log:35475:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:35476:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:35477:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:35478:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:35479:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:35480:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:35481:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:35482:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:35483:+---
_handoff/rw-v2/legs/taste-fix-codex.log:35484:+
_handoff/rw-v2/legs/taste-fix-codex.log:35485:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:35486:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:35487:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:35488:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:35489:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:35490:+
_handoff/rw-v2/legs/taste-fix-codex.log:35491:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:35492:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:35493:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:35494:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:35495:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:35496:+
_handoff/rw-v2/legs/taste-fix-codex.log:35497:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:35498:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:35499:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:35500:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:35501:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:35502:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:35503:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:35504:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:35505:+
_handoff/rw-v2/legs/taste-fix-codex.log:35506:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:35507:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:35508:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:35509:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:35510:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:35511:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:35512:+
_handoff/rw-v2/legs/taste-fix-codex.log:35513:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:35514:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:35515:+</script>
