_handoff/rw-v2/legs/taste-fix-codex.log:34988:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:34989:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:34990:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:34991:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:34992:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:34993:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:34994:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:34995:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:34996:+---
_handoff/rw-v2/legs/taste-fix-codex.log:34997:+
_handoff/rw-v2/legs/taste-fix-codex.log:34998:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:34999:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:35000:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:35001:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:35002:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:35003:+
_handoff/rw-v2/legs/taste-fix-codex.log:35004:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:35005:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:35006:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:35007:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:35008:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:35009:+
_handoff/rw-v2/legs/taste-fix-codex.log:35010:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:35011:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:35012:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:35013:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:35014:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:35015:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:35016:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:35017:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:35018:+
_handoff/rw-v2/legs/taste-fix-codex.log:35019:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:35020:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:35021:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:35022:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:35023:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:35024:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:35025:+
_handoff/rw-v2/legs/taste-fix-codex.log:35026:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:35027:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:35028:+</script>
_handoff/rw-v2/legs/taste-fix-codex.log:35029:+
_handoff/rw-v2/legs/taste-fix-codex.log:35030:+<style>
_handoff/rw-v2/legs/taste-fix-codex.log:35031:+  :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:35032:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:35033:+    grid-template-columns: 3rem minmax(0, 1fr);
