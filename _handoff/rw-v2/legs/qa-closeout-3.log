_handoff/rw-v2/legs/taste-fix-codex.log:32422:+  :global(.section-marker__ordinal) {
_handoff/rw-v2/legs/taste-fix-codex.log:32423:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:32424:+    width: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32425:+    height: 1.75rem;
_handoff/rw-v2/legs/taste-fix-codex.log:32426:+    place-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:32427:+    border: 1px solid var(--border-strong);
