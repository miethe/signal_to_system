_handoff/rw-v2/legs/p0d-p1.log:2448:--- src/components/content/ThreadDock.astro ---
_handoff/rw-v2/legs/p0d-p1.log:2449:---
_handoff/rw-v2/legs/p0d-p1.log:2450:/**
_handoff/rw-v2/legs/p0d-p1.log:2451: * ThreadDock — the compact beat list inside `ReadingCompanion`, replacing
_handoff/rw-v2/legs/p0d-p1.log:2452: * `ThreadRail`'s role there (ARCHITECTURE.md §5, DIRECTION.md V3/V5).
_handoff/rw-v2/legs/p0d-p1.log:2453: *
_handoff/rw-v2/legs/p0d-p1.log:2454: * P0-B ships this as static, server-rendered markup: every beat links to
_handoff/rw-v2/legs/p0d-p1.log:2455: * its inline anchor in the essay, plus a per-beat "Explore" link straight
_handoff/rw-v2/legs/p0d-p1.log:2456: * to that beat's Thread Focus route — both real links, so the dock works
_handoff/rw-v2/legs/p0d-p1.log:2457: * fully without JavaScript. Follow/hold-preview behavior (V6's
_handoff/rw-v2/legs/p0d-p1.log:2458: * "held preview" vs "reading" split) and any live active-beat styling
_handoff/rw-v2/legs/p0d-p1.log:2459: * driven by a scroll/section observer are P1 (component-ownership table:
_handoff/rw-v2/legs/p0d-p1.log:2460: * ThreadDock is P1) — this component accepts an optional `activeBeatId`
_handoff/rw-v2/legs/p0d-p1.log:2461: * so a later P1/P0-C pass can set `aria-current="step"` on the matching
_handoff/rw-v2/legs/p0d-p1.log:2462: * row without touching this file's markup, but nothing here computes that
_handoff/rw-v2/legs/p0d-p1.log:2463: * value today.
_handoff/rw-v2/legs/p0d-p1.log:2464: */
_handoff/rw-v2/legs/p0d-p1.log:2465:import { threads } from '../../data/threads';
_handoff/rw-v2/legs/p0d-p1.log:2466:
_handoff/rw-v2/legs/p0d-p1.log:2467:interface Props {
_handoff/rw-v2/legs/p0d-p1.log:2468:  slug: string;
_handoff/rw-v2/legs/p0d-p1.log:2469:  activeBeatId?: string;
_handoff/rw-v2/legs/p0d-p1.log:2470:}
_handoff/rw-v2/legs/p0d-p1.log:2471:
_handoff/rw-v2/legs/p0d-p1.log:2472:const { slug, activeBeatId } = Astro.props;
_handoff/rw-v2/legs/p0d-p1.log:2473:const thread = threads[slug];
_handoff/rw-v2/legs/p0d-p1.log:2474:---
_handoff/rw-v2/legs/p0d-p1.log:2475:
_handoff/rw-v2/legs/p0d-p1.log:2476:{
_handoff/rw-v2/legs/p0d-p1.log:2477:  thread && (
_handoff/rw-v2/legs/p0d-p1.log:2478:    <nav class="thread-dock" aria-label={`Running example: ${thread.title}`} data-thread-dock>
_handoff/rw-v2/legs/p0d-p1.log:2479:      <p class="thread-dock__eyebrow font-mono">Running example</p>
_handoff/rw-v2/legs/p0d-p1.log:2480:      <p class="thread-dock__title font-serif">{thread.title}</p>
_handoff/rw-v2/legs/p0d-p1.log:2481:
_handoff/rw-v2/legs/p0d-p1.log:2482:      <ol class="thread-dock__list">
_handoff/rw-v2/legs/p0d-p1.log:2483:        {
_handoff/rw-v2/legs/p0d-p1.log:2484:          thread.beats.map((beat) => (
_handoff/rw-v2/legs/p0d-p1.log:2485:            <li class="thread-dock__item">
_handoff/rw-v2/legs/p0d-p1.log:2486:              <a
_handoff/rw-v2/legs/p0d-p1.log:2487:                href={`#thread-${beat.id}`}
_handoff/rw-v2/legs/p0d-p1.log:2488:                class="thread-dock__link"
_handoff/rw-v2/legs/p0d-p1.log:2489:                data-thread-dock-link
_handoff/rw-v2/legs/p0d-p1.log:2490:                data-beat-id={beat.id}
_handoff/rw-v2/legs/p0d-p1.log:2491:                aria-current={beat.id === activeBeatId ? 'step' : undefined}
_handoff/rw-v2/legs/p0d-p1.log:2492:              >
_handoff/rw-v2/legs/p0d-p1.log:2493:                <span class="thread-dock__number font-mono" aria-hidden="true">
_handoff/rw-v2/legs/p0d-p1.log:2494:                  {beat.n}
_handoff/rw-v2/legs/p0d-p1.log:2495:                </span>
_handoff/rw-v2/legs/p0d-p1.log:2496:                <span class="thread-dock__label">{beat.label}</span>
_handoff/rw-v2/legs/p0d-p1.log:2497:              </a>
_handoff/rw-v2/legs/p0d-p1.log:2498:              <a class="thread-dock__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
_handoff/rw-v2/legs/p0d-p1.log:2499:                Explore
_handoff/rw-v2/legs/p0d-p1.log:2500:              </a>
_handoff/rw-v2/legs/p0d-p1.log:2501:            </li>
_handoff/rw-v2/legs/p0d-p1.log:2502:          ))
_handoff/rw-v2/legs/p0d-p1.log:2503:        }
_handoff/rw-v2/legs/p0d-p1.log:2504:      </ol>
_handoff/rw-v2/legs/p0d-p1.log:2505:    </nav>
_handoff/rw-v2/legs/p0d-p1.log:2506:  )
_handoff/rw-v2/legs/p0d-p1.log:2507:}
_handoff/rw-v2/legs/p0d-p1.log:2508:
_handoff/rw-v2/legs/p0d-p1.log:2509:<style>
