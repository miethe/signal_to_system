_handoff/rw-v2/legs/taste-fix-codex.log:33227:+---
_handoff/rw-v2/legs/taste-fix-codex.log:33228:+/**
_handoff/rw-v2/legs/taste-fix-codex.log:33229:+ * SectionMarker — static editorial furniture for article-level headings.
_handoff/rw-v2/legs/taste-fix-codex.log:33230:+ *
_handoff/rw-v2/legs/taste-fix-codex.log:33231:+ * MDX supplies its headings through PostLayout's slot, so this component
_handoff/rw-v2/legs/taste-fix-codex.log:33232:+ * enhances those rendered h2 elements once without attaching a scroll
_handoff/rw-v2/legs/taste-fix-codex.log:33233:+ * observer. P1 owns the active-section state; this shell deliberately only
_handoff/rw-v2/legs/taste-fix-codex.log:33234:+ * establishes the stable ordinal and reserved gutter.
_handoff/rw-v2/legs/taste-fix-codex.log:33235:+ */
_handoff/rw-v2/legs/taste-fix-codex.log:33236:+---
_handoff/rw-v2/legs/taste-fix-codex.log:33237:+
_handoff/rw-v2/legs/taste-fix-codex.log:33238:+<script>
_handoff/rw-v2/legs/taste-fix-codex.log:33239:+  const addSectionMarkers = () => {
_handoff/rw-v2/legs/taste-fix-codex.log:33240:+    const headings = document.querySelectorAll<HTMLHeadingElement>(
_handoff/rw-v2/legs/taste-fix-codex.log:33241:+      '.prose-custom > h2:not([data-section-marker-heading])',
_handoff/rw-v2/legs/taste-fix-codex.log:33242:+    );
_handoff/rw-v2/legs/taste-fix-codex.log:33243:+
_handoff/rw-v2/legs/taste-fix-codex.log:33244:+    headings.forEach((heading, index) => {
_handoff/rw-v2/legs/taste-fix-codex.log:33245:+      const section = document.createElement('section');
_handoff/rw-v2/legs/taste-fix-codex.log:33246:+      const gutter = document.createElement('div');
_handoff/rw-v2/legs/taste-fix-codex.log:33247:+      const ordinal = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:33248:+      const rule = document.createElement('span');
_handoff/rw-v2/legs/taste-fix-codex.log:33249:+
_handoff/rw-v2/legs/taste-fix-codex.log:33250:+      section.className = 'section-marker';
_handoff/rw-v2/legs/taste-fix-codex.log:33251:+      section.dataset.sectionMarker = '';
_handoff/rw-v2/legs/taste-fix-codex.log:33252:+      section.dataset.sectionOrdinal = String(index + 1);
_handoff/rw-v2/legs/taste-fix-codex.log:33253:+      gutter.className = 'section-marker__gutter';
_handoff/rw-v2/legs/taste-fix-codex.log:33254:+      gutter.setAttribute('aria-hidden', 'true');
_handoff/rw-v2/legs/taste-fix-codex.log:33255:+      ordinal.className = 'section-marker__ordinal';
_handoff/rw-v2/legs/taste-fix-codex.log:33256:+      ordinal.textContent = String(index + 1).padStart(2, '0');
_handoff/rw-v2/legs/taste-fix-codex.log:33257:+      rule.className = 'section-marker__rule';
_handoff/rw-v2/legs/taste-fix-codex.log:33258:+
_handoff/rw-v2/legs/taste-fix-codex.log:33259:+      gutter.append(ordinal, rule);
_handoff/rw-v2/legs/taste-fix-codex.log:33260:+      heading.dataset.sectionMarkerHeading = '';
_handoff/rw-v2/legs/taste-fix-codex.log:33261:+      heading.parentNode?.insertBefore(section, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:33262:+      section.append(gutter, heading);
_handoff/rw-v2/legs/taste-fix-codex.log:33263:+    });
_handoff/rw-v2/legs/taste-fix-codex.log:33264:+  };
_handoff/rw-v2/legs/taste-fix-codex.log:33265:+
_handoff/rw-v2/legs/taste-fix-codex.log:33266:+  addSectionMarkers();
_handoff/rw-v2/legs/taste-fix-codex.log:33267:+  document.addEventListener('astro:page-load', addSectionMarkers);
_handoff/rw-v2/legs/taste-fix-codex.log:33268:+</script>
_handoff/rw-v2/legs/taste-fix-codex.log:33269:+
_handoff/rw-v2/legs/taste-fix-codex.log:33270:+<style>
_handoff/rw-v2/legs/taste-fix-codex.log:33271:+  :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:33272:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:33273:+    grid-template-columns: 3rem minmax(0, 1fr);
_handoff/rw-v2/legs/taste-fix-codex.log:33274:+    column-gap: 0.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33275:+    align-items: start;
_handoff/rw-v2/legs/taste-fix-codex.log:33276:+    margin-top: 2.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33277:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33278:+
_handoff/rw-v2/legs/taste-fix-codex.log:33279:+  :global(.section-marker__gutter) {
_handoff/rw-v2/legs/taste-fix-codex.log:33280:+    position: relative;
_handoff/rw-v2/legs/taste-fix-codex.log:33281:+    display: flex;
_handoff/rw-v2/legs/taste-fix-codex.log:33282:+    flex-direction: column;
_handoff/rw-v2/legs/taste-fix-codex.log:33283:+    align-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:33284:+    gap: 0.5rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33285:+    padding-top: 0.15rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33286:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33287:+
_handoff/rw-v2/legs/taste-fix-codex.log:33288:+  :global(.section-marker__ordinal) {
_handoff/rw-v2/legs/taste-fix-codex.log:33289:+    display: grid;
_handoff/rw-v2/legs/taste-fix-codex.log:33290:+    width: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33291:+    height: 1.75rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33292:+    place-items: center;
_handoff/rw-v2/legs/taste-fix-codex.log:33293:+    border: 1px solid var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:33294:+    border-radius: 0.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33295:+    color: var(--text-tertiary);
_handoff/rw-v2/legs/taste-fix-codex.log:33296:+    font-family: var(--font-mono);
_handoff/rw-v2/legs/taste-fix-codex.log:33297:+    font-size: 0.6875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33298:+    font-weight: 700;
_handoff/rw-v2/legs/taste-fix-codex.log:33299:+    letter-spacing: 0.08em;
_handoff/rw-v2/legs/taste-fix-codex.log:33300:+    line-height: 1;
_handoff/rw-v2/legs/taste-fix-codex.log:33301:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33302:+
_handoff/rw-v2/legs/taste-fix-codex.log:33303:+  :global(.section-marker__rule) {
_handoff/rw-v2/legs/taste-fix-codex.log:33304:+    display: block;
_handoff/rw-v2/legs/taste-fix-codex.log:33305:+    width: 1px;
_handoff/rw-v2/legs/taste-fix-codex.log:33306:+    min-height: 2.2rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33307:+    background: var(--border-strong);
_handoff/rw-v2/legs/taste-fix-codex.log:33308:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33309:+
_handoff/rw-v2/legs/taste-fix-codex.log:33310:+  :global(.section-marker > h2) {
_handoff/rw-v2/legs/taste-fix-codex.log:33311:+    margin-top: 0;
_handoff/rw-v2/legs/taste-fix-codex.log:33312:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33313:+
_handoff/rw-v2/legs/taste-fix-codex.log:33314:+  @media (min-width: 768px) {
_handoff/rw-v2/legs/taste-fix-codex.log:33315:+    :global(.section-marker) {
_handoff/rw-v2/legs/taste-fix-codex.log:33316:+      width: calc(100% + 3.875rem);
_handoff/rw-v2/legs/taste-fix-codex.log:33317:+      margin-left: -3.875rem;
_handoff/rw-v2/legs/taste-fix-codex.log:33318:+    }
_handoff/rw-v2/legs/taste-fix-codex.log:33319:+  }
_handoff/rw-v2/legs/taste-fix-codex.log:33320:+</style>
_handoff/rw-v2/legs/taste-fix-codex.log:33321:diff --git a/src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx b/src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx
_handoff/rw-v2/legs/taste-fix-codex.log:33322:index b3595dfaac091847f1f69958c21b5f1e38f193d4..fad5438bc4fdee0d2612874dccc391c2dfa2d740
