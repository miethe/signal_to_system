_handoff/rw-v2/legs/p0d-p1.log:4244:--- src/data/threads.ts ---
_handoff/rw-v2/legs/p0d-p1.log:4245:// ---------------------------------------------------------------------------
_handoff/rw-v2/legs/p0d-p1.log:4246:// Running Thread Registry
_handoff/rw-v2/legs/p0d-p1.log:4247:// ---------------------------------------------------------------------------
_handoff/rw-v2/legs/p0d-p1.log:4248://
_handoff/rw-v2/legs/p0d-p1.log:4249:// Declarative beat lists for essays that carry a single worked example from
_handoff/rw-v2/legs/p0d-p1.log:4250:// beginning to outcome. One record per beat drives every rendering surface
_handoff/rw-v2/legs/p0d-p1.log:4251:// (inline scene, ThreadDock, Thread Focus route/overlay, figure route) so
_handoff/rw-v2/legs/p0d-p1.log:4252:// none of them writes its own second explanation (reading-experience-v2
_handoff/rw-v2/legs/p0d-p1.log:4253:// DIRECTION.md V3). `ThreadStoryboard.astro`, `ThreadBeat.astro`'s marker
_handoff/rw-v2/legs/p0d-p1.log:4254:// variant, and `ThreadRail.astro` currently read this same registry; P0-B
_handoff/rw-v2/legs/p0d-p1.log:4255:// retires the first two and folds the third into `ThreadDock`.
_handoff/rw-v2/legs/p0d-p1.log:4256://
_handoff/rw-v2/legs/p0d-p1.log:4257:// Beat order is the canonical six (DIRECTION.md V12): Incident, Deployment,
_handoff/rw-v2/legs/p0d-p1.log:4258:// Use, Drift, Detection, Outcome. The essay places each `ThreadScene` beside
_handoff/rw-v2/legs/p0d-p1.log:4259:// its movement prose in exactly this order, while this record remains the
_handoff/rw-v2/legs/p0d-p1.log:4260:// one shared account for inline and Thread Focus readers.
_handoff/rw-v2/legs/p0d-p1.log:4261://
_handoff/rw-v2/legs/p0d-p1.log:4262:// Every `recap` / `establishes` / `doesNotEstablish` / `longDescription`
_handoff/rw-v2/legs/p0d-p1.log:4263:// below is written fresh, grounded in the manuscript's own prose and figure
_handoff/rw-v2/legs/p0d-p1.log:4264:// captions (`src/content/posts/the-registry-wave-agentic-artifact-supply-chain.mdx`)
_handoff/rw-v2/legs/p0d-p1.log:4265:// and the six-beat filename/semantic mapping in
_handoff/rw-v2/legs/p0d-p1.log:4266:// `registry_wave_visual_source_of_truth_2026-09-18/06_SUPPORTING_HANDOFFS/INLINE-FIGURE-IMAGE-USAGE-HANDOFF.md`.
_handoff/rw-v2/legs/p0d-p1.log:4267:// The reading-experience-v2 handoff's `contracts/thread-manifest.json` prose
_handoff/rw-v2/legs/p0d-p1.log:4268:// (title/caption/description/nodes) is mockup text for a different draft of
_handoff/rw-v2/legs/p0d-p1.log:4269:// this essay and is not copied verbatim; only its beat order, `mode`
_handoff/rw-v2/legs/p0d-p1.log:4270:// classification, and filename mapping are reused as structural facts.
_handoff/rw-v2/legs/p0d-p1.log:4271:
_handoff/rw-v2/legs/p0d-p1.log:4272:export type ThreadBeatKind = "historical" | "conceptual" | "mechanism" | "proposed";
_handoff/rw-v2/legs/p0d-p1.log:4273:
_handoff/rw-v2/legs/p0d-p1.log:4274:export interface ThreadBeatImage {
_handoff/rw-v2/legs/p0d-p1.log:4275:  src: string; // "/assets/posts/<slug>/<file>.png"
_handoff/rw-v2/legs/p0d-p1.log:4276:  alt: string;
_handoff/rw-v2/legs/p0d-p1.log:4277:  caption?: string;
_handoff/rw-v2/legs/p0d-p1.log:4278:}
_handoff/rw-v2/legs/p0d-p1.log:4279:
_handoff/rw-v2/legs/p0d-p1.log:4280:export interface ThreadBeat {
_handoff/rw-v2/legs/p0d-p1.log:4281:  id: string; // anchor id is `thread-${id}`
_handoff/rw-v2/legs/p0d-p1.log:4282:  n: number;
_handoff/rw-v2/legs/p0d-p1.log:4283:  label: string; // display title, shared by inline and Thread Focus
_handoff/rw-v2/legs/p0d-p1.log:4284:  recap: string; // one real paragraph; inline and Thread Focus both render it
_handoff/rw-v2/legs/p0d-p1.log:4285:  kind: ThreadBeatKind; // historical | conceptual | mechanism | proposed (thread-manifest.json's `mode`)
_handoff/rw-v2/legs/p0d-p1.log:4286:  establishes: string; // what this beat's evidence actually shows
_handoff/rw-v2/legs/p0d-p1.log:4287:  doesNotEstablish: string; // the boundary readers should not read past
_handoff/rw-v2/legs/p0d-p1.log:4288:  longDescription: string; // fuller paragraph for Thread Focus / figure long description
_handoff/rw-v2/legs/p0d-p1.log:4289:  image: ThreadBeatImage;
_handoff/rw-v2/legs/p0d-p1.log:4290:  secondaryImage?: ThreadBeatImage; // unused by this thread; kept for ThreadStoryboard.astro's existing prop shape
_handoff/rw-v2/legs/p0d-p1.log:4291:  relatedEvidenceIds: string[]; // ids into `src/data/evidence.ts`; post-scoped strings, not a per-thread BeatId enum
_handoff/rw-v2/legs/p0d-p1.log:4292:}
_handoff/rw-v2/legs/p0d-p1.log:4293:
_handoff/rw-v2/legs/p0d-p1.log:4294:export interface Thread {
_handoff/rw-v2/legs/p0d-p1.log:4295:  slug: string;
_handoff/rw-v2/legs/p0d-p1.log:4296:  title: string;
_handoff/rw-v2/legs/p0d-p1.log:4297:  subject: string;
_handoff/rw-v2/legs/p0d-p1.log:4298:  beats: ThreadBeat[];
_handoff/rw-v2/legs/p0d-p1.log:4299:}
_handoff/rw-v2/legs/p0d-p1.log:4300:
_handoff/rw-v2/legs/p0d-p1.log:4301:export const threads: Record<string, Thread> = {
_handoff/rw-v2/legs/p0d-p1.log:4302:  "the-registry-wave-agentic-artifact-supply-chain": {
_handoff/rw-v2/legs/p0d-p1.log:4303:    slug: "the-registry-wave-agentic-artifact-supply-chain",
_handoff/rw-v2/legs/p0d-p1.log:4304:    title: "The stale reviewer",
_handoff/rw-v2/legs/p0d-p1.log:4305:    subject: "task-completion-validator",
_handoff/rw-v2/legs/p0d-p1.log:4306:    beats: [
_handoff/rw-v2/legs/p0d-p1.log:4307:      {
_handoff/rw-v2/legs/p0d-p1.log:4308:        id: "incident",
_handoff/rw-v2/legs/p0d-p1.log:4309:        n: 1,
_handoff/rw-v2/legs/p0d-p1.log:4310:        label: "Incident",
_handoff/rw-v2/legs/p0d-p1.log:4311:        kind: "historical",
_handoff/rw-v2/legs/p0d-p1.log:4312:        recap:
_handoff/rw-v2/legs/p0d-p1.log:4313:          "A reviewer skill was missing a mandatory guard. Fixing it at the source updated the registry immediately, but every project outside that source repository kept loading the pre-fix deployed copy for five days. The registry was right and the runtime's copy was wrong, and nothing compared the two to say so.",
_handoff/rw-v2/legs/p0d-p1.log:4314:        establishes:
_handoff/rw-v2/legs/p0d-p1.log:4315:          "The source and registry can be corrected while a deployed project copy stays on the old bytes, and nothing surfaces that mismatch by default.",
_handoff/rw-v2/legs/p0d-p1.log:4316:        doesNotEstablish:
_handoff/rw-v2/legs/p0d-p1.log:4317:          "This does not establish which bytes any given run actually loaded, or that a clean registry entry by itself guarantees deployment.",
_handoff/rw-v2/legs/p0d-p1.log:4318:        longDescription:
_handoff/rw-v2/legs/p0d-p1.log:4319:          "The reviewer skill's mandatory guard was missing in every project outside its source repository. Fixing the guard at the source updated the registry immediately, but each deployed project copy is a separate object: the registry record didn't rewrite any of them, and nothing compared the deployed bytes against the registered ones to notice they'd fallen behind. The diagram traces that handoff from a corrected source and registry into project copies that stayed on the earlier bytes.",
_handoff/rw-v2/legs/p0d-p1.log:4320:        image: {
_handoff/rw-v2/legs/p0d-p1.log:4321:          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-incident-resolution-flow.png",
_handoff/rw-v2/legs/p0d-p1.log:4322:          alt: "Flow diagram showing a reviewer skill's guard corrected at its source and reflected in the registry, while separate deployed project copies remain on the earlier, uncorrected bytes.",
_handoff/rw-v2/legs/p0d-p1.log:4323:          caption:
_handoff/rw-v2/legs/p0d-p1.log:4324:            "The fix landed at the source and reached the registry immediately; the deployed copies had not caught up yet.",
_handoff/rw-v2/legs/p0d-p1.log:4325:        },
_handoff/rw-v2/legs/p0d-p1.log:4326:        relatedEvidenceIds: ["drift-check"],
_handoff/rw-v2/legs/p0d-p1.log:4327:      },
_handoff/rw-v2/legs/p0d-p1.log:4328:      {
_handoff/rw-v2/legs/p0d-p1.log:4329:        id: "deployment",
_handoff/rw-v2/legs/p0d-p1.log:4330:        n: 2,
_handoff/rw-v2/legs/p0d-p1.log:4331:        label: "Deployment",
_handoff/rw-v2/legs/p0d-p1.log:4332:        kind: "historical",
_handoff/rw-v2/legs/p0d-p1.log:4333:        recap:
_handoff/rw-v2/legs/p0d-p1.log:4334:          "A file copy is a separate object from its source. Updating the source or registering a new revision doesn't update an already-deployed copy, and a clean registration says nothing about what a given project actually has on disk.",
_handoff/rw-v2/legs/p0d-p1.log:4335:        establishes:
_handoff/rw-v2/legs/p0d-p1.log:4336:          "Source revision, registry record, and deployed project copy are three separate objects; closing the gap needs a recorded deployment path, not a symlink or a manual copy.",
_handoff/rw-v2/legs/p0d-p1.log:4337:        doesNotEstablish:
_handoff/rw-v2/legs/p0d-p1.log:4338:          "A registry entry existing does not establish that any specific project's deployed copy matches it.",
_handoff/rw-v2/legs/p0d-p1.log:4339:        longDescription:
_handoff/rw-v2/legs/p0d-p1.log:4340:          "The same handoff repeats through the essay: source, registry, project deployment, runtime loading, and outcome evidence are each a distinct record. A registry entry naming the correct revision says nothing about which bytes a specific project actually deployed, and a deployment record has to name that relationship explicitly rather than assume it from the registry alone. A symlink doesn't solve this either; it follows the source checkout as branches change, so it drifts with the branch instead of leaving a fixed, comparable copy.",
_handoff/rw-v2/legs/p0d-p1.log:4341:        image: {
_handoff/rw-v2/legs/p0d-p1.log:4342:          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-from-source-to-outcome.png",
_handoff/rw-v2/legs/p0d-p1.log:4343:          alt: "Diagram of the handoff from source repository to registry to project deployment to runtime loading to outcome evidence, showing where an artifact's declared and deployed identity can separate.",
_handoff/rw-v2/legs/p0d-p1.log:4344:          caption:
_handoff/rw-v2/legs/p0d-p1.log:4345:            "The registry's corrected artifact and the deployed project copies now disagree about what the same skill name means.",
_handoff/rw-v2/legs/p0d-p1.log:4346:        },
_handoff/rw-v2/legs/p0d-p1.log:4347:        relatedEvidenceIds: [],
_handoff/rw-v2/legs/p0d-p1.log:4348:      },
_handoff/rw-v2/legs/p0d-p1.log:4349:      {
_handoff/rw-v2/legs/p0d-p1.log:4350:        id: "use",
_handoff/rw-v2/legs/p0d-p1.log:4351:        n: 3,
_handoff/rw-v2/legs/p0d-p1.log:4352:        label: "Use",
_handoff/rw-v2/legs/p0d-p1.log:4353:        kind: "conceptual",
_handoff/rw-v2/legs/p0d-p1.log:4354:        recap:
_handoff/rw-v2/legs/p0d-p1.log:4355:          "Even once the corrected copy is deployed, presence in the loaded file doesn't establish that the guard was actually followed during a run; that requires its own observation, not an inference from disk state.",
_handoff/rw-v2/legs/p0d-p1.log:4356:        establishes:
_handoff/rw-v2/legs/p0d-p1.log:4357:          "A corrected instruction's presence in a loaded artifact is not, on its own, evidence that the instruction was followed during a run; behavior requires separate verification.",
_handoff/rw-v2/legs/p0d-p1.log:4358:        doesNotEstablish:
_handoff/rw-v2/legs/p0d-p1.log:4359:          "This is an analytic branch, not evidence that any specific stale run in the incident did or didn't load a corrected reviewer. It does not establish observed behavior.",
_handoff/rw-v2/legs/p0d-p1.log:4360:        longDescription:
_handoff/rw-v2/legs/p0d-p1.log:4361:          "Even after a corrected copy is deployed, an instruction's presence in the loaded file is a different claim from evidence that the instruction was followed during a specific run. This beat is an analytic branch: it separates the two claims rather than reporting that a stale run in the incident did or didn't load a corrected reviewer. Verifying behavior needs its own observation; absent that, the loaded version and its effect on the run stay unknown.",
_handoff/rw-v2/legs/p0d-p1.log:4362:        image: {
_handoff/rw-v2/legs/p0d-p1.log:4363:          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-presence-vs-behavior.png",
_handoff/rw-v2/legs/p0d-p1.log:4364:          alt: "Diagram distinguishing a corrected instruction's presence in a loaded artifact from evidence that the instruction was actually followed during a run.",
_handoff/rw-v2/legs/p0d-p1.log:4365:          caption: "A guard's presence in a loaded file isn't evidence that the guard was actually followed.",
_handoff/rw-v2/legs/p0d-p1.log:4366:        },
_handoff/rw-v2/legs/p0d-p1.log:4367:        relatedEvidenceIds: [],
_handoff/rw-v2/legs/p0d-p1.log:4368:      },
_handoff/rw-v2/legs/p0d-p1.log:4369:      {
_handoff/rw-v2/legs/p0d-p1.log:4370:        id: "drift",
_handoff/rw-v2/legs/p0d-p1.log:4371:        n: 4,
_handoff/rw-v2/legs/p0d-p1.log:4372:        label: "Drift",
_handoff/rw-v2/legs/p0d-p1.log:4373:        kind: "historical",
_handoff/rw-v2/legs/p0d-p1.log:4374:        recap:
_handoff/rw-v2/legs/p0d-p1.log:4375:          "For five days, the source and registry stayed corrected while every deployed copy outside the source repository stayed on the pre-fix bytes at the same time. The manifest behind the drift gate classifies each declared path as a diffed tracked copy, a never-diffed allowed copy, or an undeclared failure.",
_handoff/rw-v2/legs/p0d-p1.log:4376:        establishes:
_handoff/rw-v2/legs/p0d-p1.log:4377:          "Declared state and deployed state can disagree for a measurable, bounded interval without anything surfacing the disagreement on its own.",
_handoff/rw-v2/legs/p0d-p1.log:4378:        doesNotEstablish:
_handoff/rw-v2/legs/p0d-p1.log:4379:          "The figure documents one five-day interval from this incident, not a claim of continuous fleet-wide monitoring or a general drift rate.",
_handoff/rw-v2/legs/p0d-p1.log:4380:        longDescription:
_handoff/rw-v2/legs/p0d-p1.log:4381:          "The deployment manifest classifies every declared path into one of three buckets: a tracked copy diffed against its upstream, an allowed copy with no upstream to diff against, or an undeclared copy that fails outright. For five days, that classification stayed silent while the registry and the deployed copies disagreed about the same skill name, and the exact calendar range is preserved from the incident rather than invented here.",
_handoff/rw-v2/legs/p0d-p1.log:4382:        image: {
_handoff/rw-v2/legs/p0d-p1.log:4383:          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-drift-across-five-days.png",
_handoff/rw-v2/legs/p0d-p1.log:4384:          alt: "Timeline diagram spanning a five-day interval in which the registry stayed corrected while deployed copies stayed on the pre-fix bytes, without the disagreement being reported.",
_handoff/rw-v2/legs/p0d-p1.log:4385:          caption:
_handoff/rw-v2/legs/p0d-p1.log:4386:            "For five days, “fixed” described one location; the registry and the deployment disagreed the whole time.",
_handoff/rw-v2/legs/p0d-p1.log:4387:        },
_handoff/rw-v2/legs/p0d-p1.log:4388:        relatedEvidenceIds: ["drift-check", "drift-manifest-excerpt"],
_handoff/rw-v2/legs/p0d-p1.log:4389:      },
_handoff/rw-v2/legs/p0d-p1.log:4390:      {
_handoff/rw-v2/legs/p0d-p1.log:4391:        id: "detection",
_handoff/rw-v2/legs/p0d-p1.log:4392:        n: 5,
_handoff/rw-v2/legs/p0d-p1.log:4393:        label: "Detection",
_handoff/rw-v2/legs/p0d-p1.log:4394:        kind: "mechanism",
_handoff/rw-v2/legs/p0d-p1.log:4395:        recap:
_handoff/rw-v2/legs/p0d-p1.log:4396:          "An August 6 byte-comparison gate compares deployed state against its declared source, classifying each entry as a tracked copy, a justified (allowed) copy, or drift, and flags symlinks separately. A justified copy needs an explicit stated reason; drift fails the check outright.",
_handoff/rw-v2/legs/p0d-p1.log:4397:        establishes:
_handoff/rw-v2/legs/p0d-p1.log:4398:          "A byte comparison against the declared source is what actually surfaced the five-day gap; nothing upstream of that comparison had noticed it.",
_handoff/rw-v2/legs/p0d-p1.log:4399:        doesNotEstablish:
_handoff/rw-v2/legs/p0d-p1.log:4400:          "A nonzero exit from the check does not by itself identify which specific finding fired, and the check does not recover a per-session loading history.",
_handoff/rw-v2/legs/p0d-p1.log:4401:        longDescription:
_handoff/rw-v2/legs/p0d-p1.log:4402:          "An August 6 byte-comparison gate compares each deployed copy against its declared source, classifying tracked copies, justified (allowed) copies, and drift, and separately flags any symlink. A justified copy needs an explicit stated reason to differ; anything else that fails the comparison is drift. The comparison itself, not the registry and not the source, is what surfaced the five-day gap.",
_handoff/rw-v2/legs/p0d-p1.log:4403:        image: {
_handoff/rw-v2/legs/p0d-p1.log:4404:          src: "/assets/posts/the-registry-wave-agentic-artifact-supply-chain/registry-wave-detecting-silent-drift.png",
