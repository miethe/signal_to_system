_handoff/rw-v2/legs/p0d-p1.log:2949:--- src/components/content/EvidenceFocus.astro ---
_handoff/rw-v2/legs/p0d-p1.log:2950:---
_handoff/rw-v2/legs/p0d-p1.log:2951:/**
_handoff/rw-v2/legs/p0d-p1.log:2952: * EvidenceFocus — the shared Evidence Focus renderer (DIRECTION.md V3/V4,
_handoff/rw-v2/legs/p0d-p1.log:2953: * ARCHITECTURE.md §4, spec §8). Backs BOTH `/essays/<slug>/evidence/`
_handoff/rw-v2/legs/p0d-p1.log:2954: * (the essay-scoped index) and the flat, site-wide `/evidence/<record>/`
_handoff/rw-v2/legs/p0d-p1.log:2955: * route, plus the in-place overlay's `<template>` fragment — same
_handoff/rw-v2/legs/p0d-p1.log:2956: * component, same field set from `evidence.ts`'s `EvidenceRecord`, never
_handoff/rw-v2/legs/p0d-p1.log:2957: * a second hand-written summary.
_handoff/rw-v2/legs/p0d-p1.log:2958: *
_handoff/rw-v2/legs/p0d-p1.log:2959: * `records` is always the full evidence set (so the rail's `ReceiptIndex`
_handoff/rw-v2/legs/p0d-p1.log:2960: * can navigate anywhere); `selectedId` narrows the main pane to one
_handoff/rw-v2/legs/p0d-p1.log:2961: * record's full detail. Omitting it renders the full list.
_handoff/rw-v2/legs/p0d-p1.log:2962: */
_handoff/rw-v2/legs/p0d-p1.log:2963:import EvidenceGuide from './EvidenceGuide.astro';
_handoff/rw-v2/legs/p0d-p1.log:2964:import ReceiptIndex from './ReceiptIndex.astro';
_handoff/rw-v2/legs/p0d-p1.log:2965:import ClaimBadge from './ClaimBadge.astro';
_handoff/rw-v2/legs/p0d-p1.log:2966:import type { EvidenceRecord } from '../../data/evidence';
_handoff/rw-v2/legs/p0d-p1.log:2967:
_handoff/rw-v2/legs/p0d-p1.log:2968:interface Props {
_handoff/rw-v2/legs/p0d-p1.log:2969:  records: EvidenceRecord[];
_handoff/rw-v2/legs/p0d-p1.log:2970:  selectedId?: string;
_handoff/rw-v2/legs/p0d-p1.log:2971:  /** Real anchor text for a "Read in essay" link, when a related essay exists. */
_handoff/rw-v2/legs/p0d-p1.log:2972:  essaySlug?: string;
_handoff/rw-v2/legs/p0d-p1.log:2973:  standalone?: boolean;
_handoff/rw-v2/legs/p0d-p1.log:2974:}
_handoff/rw-v2/legs/p0d-p1.log:2975:
_handoff/rw-v2/legs/p0d-p1.log:2976:const { records, selectedId, essaySlug, standalone = true } = Astro.props;
_handoff/rw-v2/legs/p0d-p1.log:2977:// The essay index is a receipt surface, not a bare directory. When no record
_handoff/rw-v2/legs/p0d-p1.log:2978:// is named in the route, introduce the first related receipt in full and let
_handoff/rw-v2/legs/p0d-p1.log:2979:// the rail provide the rest of the index.
_handoff/rw-v2/legs/p0d-p1.log:2980:const selected = selectedId ? records.find((record) => record.id === selectedId) : records[0];
_handoff/rw-v2/legs/p0d-p1.log:2981:const selectedRecordId = selected?.id;
_handoff/rw-v2/legs/p0d-p1.log:2982:const receiptDate = selected?.recordedDate ?? selected?.eventDate ?? selected?.verifiedAt ?? null;
_handoff/rw-v2/legs/p0d-p1.log:2983:const claimBadgeKind = selected
_handoff/rw-v2/legs/p0d-p1.log:2984:  ? ({
_handoff/rw-v2/legs/p0d-p1.log:2985:      observed: 'observed',
_handoff/rw-v2/legs/p0d-p1.log:2986:      measured: 'measured',
_handoff/rw-v2/legs/p0d-p1.log:2987:      proposed: 'proposed',
_handoff/rw-v2/legs/p0d-p1.log:2988:      'externally-reported': 'external',
_handoff/rw-v2/legs/p0d-p1.log:2989:      illustrative: 'hypothesis',
_handoff/rw-v2/legs/p0d-p1.log:2990:    }[selected.evidenceClass] as 'observed' | 'measured' | 'proposed' | 'external' | 'hypothesis')
_handoff/rw-v2/legs/p0d-p1.log:2991:  : undefined;
_handoff/rw-v2/legs/p0d-p1.log:2992:
_handoff/rw-v2/legs/p0d-p1.log:2993:const formatDate = (value: string | null) => value ?? 'Not stated';
_handoff/rw-v2/legs/p0d-p1.log:2994:---
_handoff/rw-v2/legs/p0d-p1.log:2995:
_handoff/rw-v2/legs/p0d-p1.log:2996:<div class="evidence-focus" data-focus-kind="evidence" data-focus-key={selectedId ?? 'all'}>
_handoff/rw-v2/legs/p0d-p1.log:2997:  <div class="evidence-focus__grid">
_handoff/rw-v2/legs/p0d-p1.log:2998:    <div class="evidence-focus__main">
_handoff/rw-v2/legs/p0d-p1.log:2999:      <div class="evidence-focus__actions">
_handoff/rw-v2/legs/p0d-p1.log:3000:        {essaySlug && (
_handoff/rw-v2/legs/p0d-p1.log:3001:          <a class="evidence-focus__action" href={`/essays/${essaySlug}/`}>
_handoff/rw-v2/legs/p0d-p1.log:3002:            &larr; Back to essay
_handoff/rw-v2/legs/p0d-p1.log:3003:          </a>
_handoff/rw-v2/legs/p0d-p1.log:3004:        )}
_handoff/rw-v2/legs/p0d-p1.log:3005:        <span class="evidence-focus__action-label font-mono">Evidence focus</span>
_handoff/rw-v2/legs/p0d-p1.log:3006:        {essaySlug && (
_handoff/rw-v2/legs/p0d-p1.log:3007:          <a
_handoff/rw-v2/legs/p0d-p1.log:3008:            class="evidence-focus__action evidence-focus__action--secondary"
_handoff/rw-v2/legs/p0d-p1.log:3009:            href={`/essays/${essaySlug}/evidence/`}
_handoff/rw-v2/legs/p0d-p1.log:3010:            target="_blank"
_handoff/rw-v2/legs/p0d-p1.log:3011:            rel="noopener noreferrer"
_handoff/rw-v2/legs/p0d-p1.log:3012:          >
_handoff/rw-v2/legs/p0d-p1.log:3013:            Open in new tab
_handoff/rw-v2/legs/p0d-p1.log:3014:          </a>
_handoff/rw-v2/legs/p0d-p1.log:3015:        )}
_handoff/rw-v2/legs/p0d-p1.log:3016:        {!standalone && (
_handoff/rw-v2/legs/p0d-p1.log:3017:          <button type="button" class="evidence-focus__action evidence-focus__action--close" data-focus-close>
_handoff/rw-v2/legs/p0d-p1.log:3018:            Close
_handoff/rw-v2/legs/p0d-p1.log:3019:          </button>
_handoff/rw-v2/legs/p0d-p1.log:3020:        )}
_handoff/rw-v2/legs/p0d-p1.log:3021:      </div>
_handoff/rw-v2/legs/p0d-p1.log:3022:
_handoff/rw-v2/legs/p0d-p1.log:3023:      <h1 class="evidence-focus__page-title font-serif">
_handoff/rw-v2/legs/p0d-p1.log:3024:        {selectedId && selected ? selected.title : 'Receipts behind the argument'}
_handoff/rw-v2/legs/p0d-p1.log:3025:      </h1>
_handoff/rw-v2/legs/p0d-p1.log:3026:
_handoff/rw-v2/legs/p0d-p1.log:3027:      {selected ? (
_handoff/rw-v2/legs/p0d-p1.log:3028:        <article class="evidence-focus__record">
_handoff/rw-v2/legs/p0d-p1.log:3029:          <p class="evidence-focus__eyebrow font-mono">
_handoff/rw-v2/legs/p0d-p1.log:3030:            {claimBadgeKind && <ClaimBadge kind={claimBadgeKind} />}
_handoff/rw-v2/legs/p0d-p1.log:3031:            <span>{selected.evidenceClass}</span>
_handoff/rw-v2/legs/p0d-p1.log:3032:          </p>
_handoff/rw-v2/legs/p0d-p1.log:3033:          {!selectedId && <h2 class="evidence-focus__title font-serif">{selected.title}</h2>}
_handoff/rw-v2/legs/p0d-p1.log:3034:
_handoff/rw-v2/legs/p0d-p1.log:3035:          <p class="evidence-focus__receipt-date font-mono">
_handoff/rw-v2/legs/p0d-p1.log:3036:            Receipt date: {formatDate(receiptDate)}
_handoff/rw-v2/legs/p0d-p1.log:3037:          </p>
_handoff/rw-v2/legs/p0d-p1.log:3038:
_handoff/rw-v2/legs/p0d-p1.log:3039:          <dl class="evidence-focus__facts">
_handoff/rw-v2/legs/p0d-p1.log:3040:            <div>
_handoff/rw-v2/legs/p0d-p1.log:3041:              <dt>Capture type</dt>
_handoff/rw-v2/legs/p0d-p1.log:3042:              <dd>{selected.captureType}</dd>
_handoff/rw-v2/legs/p0d-p1.log:3043:            </div>
_handoff/rw-v2/legs/p0d-p1.log:3044:            <div>
_handoff/rw-v2/legs/p0d-p1.log:3045:              <dt>Event date</dt>
_handoff/rw-v2/legs/p0d-p1.log:3046:              <dd>{formatDate(selected.eventDate)}</dd>
_handoff/rw-v2/legs/p0d-p1.log:3047:            </div>
