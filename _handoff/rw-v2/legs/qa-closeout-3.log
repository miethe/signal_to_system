_handoff/rw-v2/legs/p0d-p1.log:3380:        <span class="figure-viewer__action-label font-mono">Figure viewer</span>
_handoff/rw-v2/legs/p0d-p1.log:3381:        <a class="figure-viewer__action figure-viewer__action--copy" href={`/essays/${thread.slug}/figure/${beat.id}/`} data-focus-copy-link>
_handoff/rw-v2/legs/p0d-p1.log:3382:          Copy link
_handoff/rw-v2/legs/p0d-p1.log:3383:        </a>
_handoff/rw-v2/legs/p0d-p1.log:3384:        {!standalone && (
_handoff/rw-v2/legs/p0d-p1.log:3385:          <button type="button" class="figure-viewer__action figure-viewer__action--close" data-focus-close>
_handoff/rw-v2/legs/p0d-p1.log:3386:            Close
_handoff/rw-v2/legs/p0d-p1.log:3387:          </button>
_handoff/rw-v2/legs/p0d-p1.log:3388:        )}
_handoff/rw-v2/legs/p0d-p1.log:3389:      </div>
_handoff/rw-v2/legs/p0d-p1.log:3390:
_handoff/rw-v2/legs/p0d-p1.log:3391:      <figure class="figure-viewer__figure">
_handoff/rw-v2/legs/p0d-p1.log:3392:        <img src={beat.image.src} alt={beat.image.alt} loading="lazy" decoding="async" />
_handoff/rw-v2/legs/p0d-p1.log:3393:        <figcaption>
_handoff/rw-v2/legs/p0d-p1.log:3394:          <p class="figure-viewer__caption">{beat.image.caption}</p>
_handoff/rw-v2/legs/p0d-p1.log:3395:          <p class="figure-viewer__long-description">{beat.longDescription}</p>
_handoff/rw-v2/legs/p0d-p1.log:3396:        </figcaption>
_handoff/rw-v2/legs/p0d-p1.log:3397:      </figure>
_handoff/rw-v2/legs/p0d-p1.log:3398:
_handoff/rw-v2/legs/p0d-p1.log:3399:      <dl class="figure-viewer__metadata">
_handoff/rw-v2/legs/p0d-p1.log:3400:        <div>
_handoff/rw-v2/legs/p0d-p1.log:3401:          <dt>Filename</dt>
_handoff/rw-v2/legs/p0d-p1.log:3402:          <dd class="font-mono">{filename}</dd>
_handoff/rw-v2/legs/p0d-p1.log:3403:        </div>
_handoff/rw-v2/legs/p0d-p1.log:3404:        <div>
_handoff/rw-v2/legs/p0d-p1.log:3405:          <dt>File size</dt>
_handoff/rw-v2/legs/p0d-p1.log:3406:          <dd>{formatBytes(fileSizeBytes)}</dd>
_handoff/rw-v2/legs/p0d-p1.log:3407:        </div>
_handoff/rw-v2/legs/p0d-p1.log:3408:        <div>
_handoff/rw-v2/legs/p0d-p1.log:3409:          <dt>Dimensions</dt>
_handoff/rw-v2/legs/p0d-p1.log:3410:          <dd>{dimensionsLabel}</dd>
_handoff/rw-v2/legs/p0d-p1.log:3411:        </div>
_handoff/rw-v2/legs/p0d-p1.log:3412:      </dl>
_handoff/rw-v2/legs/p0d-p1.log:3413:    </div>
_handoff/rw-v2/legs/p0d-p1.log:3414:  )
_handoff/rw-v2/legs/p0d-p1.log:3415:}
