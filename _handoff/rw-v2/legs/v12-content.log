/**
 * ImplementationStatus — rows of "what's actually built" claims, each with
 * a status chip (IMPLEMENTED / PARTIAL / PROPOSED / TO TEST). Replaces a
 * prose list under "What this looks like in my lab" with the same
 * evidence-honesty shape as `Evidence.astro`, applied to build status
 * rather than claim confidence. Chips are colorblind-safe: the status
 * word is always rendered as text (the load-bearing signal); the glyph is
 * a decorative reinforcement, never the only cue.
 */
interface StatusRow {
  label: string;
  status: 'IMPLEMENTED' | 'PARTIAL' | 'PROPOSED' | 'TO TEST';
  detail?: string;
}

interface Props {
  rows: StatusRow[];
}

const { rows } = Astro.props;

const chipConfig: Record<StatusRow['status'], { cls: string; glyph: string }> = {
  IMPLEMENTED: {
    cls: 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300',
    glyph: '✓',
  },
  PARTIAL: {
    cls: 'border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300',
    glyph: '◐',
  },
  PROPOSED: {
    cls: 'border-violet-200 bg-violet-50 text-violet-800 dark:border-violet-800 dark:bg-violet-950/30 dark:text-violet-300',
    glyph: '◇',
  },
  'TO TEST': {
    cls: 'border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-800 dark:bg-sky-950/30 dark:text-sky-300',
    glyph: '?',
  },
};
---

<ul class="implementation-status lift-hover" role="list" aria-label="Implementation status">
  {
    rows.map(({ label, status, detail }) => {
      const chip = chipConfig[status];
      return (
        <li class="implementation-status__row" role="listitem">
          <span class:list={['implementation-status__chip', chip.cls]}>
            <span class="implementation-status__glyph" aria-hidden="true">
              {chip.glyph}
            </span>
            {status}
          </span>
          <span class="implementation-status__body">
            <span class="implementation-status__label">{label}</span>
            {detail && <span class="implementation-status__detail">{detail}</span>}
          </span>
        </li>
      );
    })
  }
</ul>

<style>
  .implementation-status {
    margin: 1.75rem 0;
    padding: 0.25rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    box-shadow: var(--shadow-sm);
    list-style: none;
  }

  .implementation-status__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .implementation-status__row:last-child {
    border-bottom: 0;
  }

  .implementation-status__chip {
    display: inline-flex;
    flex: none;
    align-items: baseline;
    gap: 0.3em;
    padding: 0.18em 0.55em 0.24em;
    border: 1px solid;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.3;
    white-space: nowrap;
  }

  .implementation-status__glyph {
    font-size: 0.9em;
  }

  .implementation-status__body {
    min-width: 0;
    flex: 1 1 12rem;
  }

