  .pull-quote__mark {
    margin-right: 0.3rem;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 1.3em;
    font-style: normal;
  }

  .pull-quote--thesis-marker .pull-quote__text--thesis {
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-style: normal;
    font-weight: 600;
    text-align: center;
    letter-spacing: 0.005em;
  }
</style>
