@import "tailwindcss";

/* Bind Tailwind's `dark:` variant to the site's own `.dark` class instead of
   the OS `prefers-color-scheme` media query (reading-experience-v2 FIX-LIST
   A1). Without this, every `dark:` utility in the project (370+) is inert
   whenever the reader's OS theme disagrees with the theme they picked on the
   site. */
@custom-variant dark (&:where(.dark, .dark *));

/* Include @miethe/ui compiled classes in Tailwind's content scan.
   Without this, showcase demos render unstyled (Tailwind v4 JIT prunes them). */
@source "../../node_modules/@miethe/ui/dist/**/*.js";

/* ============================================================
   THEME TOKENS
   Tailwind v4 custom properties via @theme
   ============================================================ */

@theme {
  /* --- Font Families --- */
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-serif: "Noto Serif", ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
  --font-mono: "Space Grotesk", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, monospace;

  /* --- Spacing scale extensions --- */
  --spacing-18: 4.5rem;
  --spacing-22: 5.5rem;
  --spacing-prose: 72ch;

  /* --- Border radius --- */
  --radius-xs: 0.125rem;
  --radius-sm: 0.25rem;
  --radius-md: 0.375rem;
  --radius-lg: 0.5rem;
  --radius-xl: 0.75rem;
  --radius-2xl: 1rem;
  --radius-pill: 9999px;

  /* --- Shadows --- */
  --shadow-ambient: var(--shadow-ambient);

  /* --- Brand color scales (light-mode defaults) --- */
  /* Backgrounds */
  --color-bg-base: #ffffff;
  --color-bg-subtle: #f8fafc;
  --color-bg-muted: #f1f5f9;
  --color-bg-surface: #ffffff;
  --color-bg-overlay: rgba(15, 23, 42, 0.6);

  /* Borders */
  --color-border-subtle: #e2e8f0;
  --color-border-default: #cbd5e1;
  --color-border-strong: #94a3b8;

  /* Text */
  --color-text-primary: #0f172a;
  --color-text-secondary: #334155;
  --color-text-tertiary: #64748b;
  --color-text-disabled: #94a3b8;
  --color-text-inverse: #f8fafc;

  /* Accent — indigo/blue family */
  --color-accent-50: #eef2ff;
  --color-accent-100: #e0e7ff;
  --color-accent-200: #c7d2fe;
  --color-accent-300: #a5b4fc;
  --color-accent-400: #818cf8;
  --color-accent-500: #6366f1;
  --color-accent-600: #4f46e5;
  --color-accent-700: #4338ca;
  --color-accent-800: #3730a3;
  --color-accent-900: #312e81;

  /* Semantic accent aliases */
  --color-accent: #4f46e5;
  --color-accent-hover: #4338ca;
  --color-accent-subtle: #eef2ff;
  --color-accent-muted: #e0e7ff;

  /* Neutrals for dark backgrounds */
  --color-slate-900: #0f172a;
  --color-slate-850: #111827;
  --color-slate-800: #1e293b;
  --color-slate-700: #334155;
  --color-slate-600: #475569;
  --color-slate-500: #64748b;
  --color-slate-400: #94a3b8;
  --color-slate-300: #cbd5e1;
  --color-slate-200: #e2e8f0;
  --color-slate-100: #f1f5f9;
  --color-slate-50: #f8fafc;

  /* Code block */
  --color-code-bg: #1e293b;
  --color-code-bg-inline: #f1f5f9;
  --color-code-text: #e2e8f0;
  --color-code-border: #334155;
}

/* ============================================================
   COLOR-SCHEME CUSTOM PROPERTIES
   :root = light mode,  .dark = dark mode
   ============================================================ */

:root {
  color-scheme: light;

  --bg-base:       #ffffff;
  --bg-subtle:     #f8fafc;
  --bg-muted:      #f1f5f9;
  --bg-surface:    #ffffff;

  --border-subtle: #e2e8f0;
  --border:        #cbd5e1;
  --border-strong: #94a3b8;

  --text-primary:   #0f172a;
  --text-secondary: #334155;
  --text-tertiary:  #64748b;
  --text-disabled:  #94a3b8;
  --text-inverse:   #f8fafc;

  --accent:         #6366f1;
  --accent-hover:   #4f46e5;
  --accent-subtle:  #e0e7ff;
  --accent-muted:   #c7d2fe;
  --accent-text:    #3730a3;

  /* Restrained cyan structural accent (reading-experience-v2 DIRECTION V10,
     from $H/contracts/design-tokens.css's --cyan). Used sparingly, next to
     violet, for mechanism/detection-flavored structure (kind labels, the
     figure-viewer chrome) — never as a second primary accent. */
  --cyan:           #0e7490;
  --cyan-text:      #0e7490;
  --cyan-subtle:    #ecfeff;

  --code-bg:        #f1f5f9;
  --code-bg-block:  #f8fafc;
  --code-text:      #0f172a;
  --code-text-block:#334155;
  --code-border:    #cbd5e1;

  --shadow-sm:  0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow:     0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --shadow-md:  0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg:  0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-ambient: 0px 32px 64px -12px rgba(11, 19, 38, 0.06);

  /* Hover lift (see the HOVER LIFT section). Back-out curve overshoots
     slightly then settles — the "bounce". */
  --lift-y: -2px;
  --lift-duration: 200ms;
  --lift-ease: cubic-bezier(0.34, 1.4, 0.64, 1);
  --lift-shadow:
    0 2px 4px rgba(15, 23, 42, 0.05),
    0 14px 30px -12px rgba(15, 23, 42, 0.22);
}

.dark {
  color-scheme: dark;

  --bg-base:       #071425;
  --bg-subtle:     #0b1b30;
  --bg-muted:      #101f36;
  --bg-surface:    #0d1d33;

  --border-subtle: #203b5d;
  --border:        #29476b;
  --border-strong: #3a5274;

  --text-primary:   #f2efea;
  --text-secondary: #b8c2d3;
  --text-tertiary:  #7790b1;
  --text-disabled:  #526a88;
  --text-inverse:   #0b1326;

  --accent:         #9b82ff;
  --accent-hover:   #c0b0ff;
  --accent-subtle:  #17294a;
  --accent-muted:   #5548a8;
  --accent-text:    #c9bdff;

  /* Restrained cyan structural accent — matches Tier A's midnight/navy/
     violet/cyan language (see the :root block above for the rationale). */
  --cyan:           #82d3ec;
  --cyan-text:      #82d3ec;
  --cyan-subtle:    rgba(130, 211, 236, 0.14);

  --code-bg:        #131b2e;
  --code-bg-block:  #060e20;
  --code-text:      #c7c4d7;
  --code-text-block:#dae2fd;
  --code-border:    rgba(70, 69, 84, 0.15);

  --shadow-sm:  0 1px 2px 0 rgb(0 0 0 / 0.3);
  --shadow:     0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.3);
  --shadow-md:  0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.3);
  --shadow-lg:  0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.4);
  --shadow-ambient: 0px 32px 64px -12px rgba(11, 19, 38, 0.4);

  /* A black drop shadow reads as dirt on a navy page, so the dark-mode lift
     is a faint accent ring plus a coloured glow instead. */
  --lift-shadow:
    0 0 0 1px rgba(192, 193, 255, 0.16),
    0 16px 34px -14px rgba(111, 0, 190, 0.5);
}

/* ============================================================
   BASE STYLES
   ============================================================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

.material-symbols-outlined {
  font-family: 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  font-size: 24px;  /* Preferred icon size */
  display: inline-block;
  line-height: 1;
  text-transform: none;
  letter-spacing: normal;
  word-wrap: normal;
  white-space: nowrap;
  direction: ltr;
  /* Support for all WebKit browsers. */
  -webkit-font-smoothing: antialiased;
  /* Support for Safari and Chrome. */
  text-rendering: optimizeLegibility;
  /* Support for Firefox. */
  -moz-osx-font-smoothing: grayscale;
  /* Support for IE. */
  font-feature-settings: 'liga';
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

html {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
  tab-size: 2;
}

body {
  background-color: var(--bg-base);
  color: var(--text-primary);
  min-height: 100dvh;
  transition:
    background-color 200ms ease,
    color 200ms ease;
}

.dark body {
  background: radial-gradient(circle at 25% 0%, rgb(20 53 91 / 18%), transparent 42%), var(--bg-base);
}

/* Registry Wave v2 is deliberately scoped to its reading surface. The
   values match the accepted two-pane composition without changing legacy
   essays, project pages, or Dev Stories. */
.post-layout--registry-wave {
  --measure: 46rem;
}

/* The body signal is the deliberate narrow-layout fallback. The rail owns
   this content at xl and above, while no-JS narrow layouts retain it once. */
@media (min-width: 1280px) {
  .post-layout--registry-wave .prose-custom > .executive-signal {
    display: none;
  }
}

@media (min-width: 1280px) {
  .post-layout--registry-wave {
    grid-template-columns: minmax(0, 756px) 266px;
    column-gap: 40px;
    max-width: 1062px;
    padding-top: 1.5rem;
  }

  .post-layout--registry-wave > .registry-wave-rail {
    padding-left: 20px;
    border-left: 1px solid rgb(117 139 181 / 24%);
  }

  .post-layout--registry-wave #post-header {
    margin: 18px 0 24px;
    padding: 0;
    row-gap: 10px;
  }

  .post-layout--registry-wave #post-header h1 {
    max-width: 760px;
    margin: 2px 0 4px;
    font-size: 43px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .post-layout--registry-wave #post-header > p {
    font-size: 1rem;
    line-height: 1.48;
  }

  .post-layout--registry-wave .prose-custom {
    max-width: 100%;
  }

}

@media (max-width: 1279px) {
  .post-layout--registry-wave {
    max-width: 430px;
    padding-top: 8px;
    padding-inline: 20px;
  }

  .post-layout--registry-wave #post-header {
    margin-bottom: 1.25rem;
    row-gap: 8px;
  }

  .post-layout--registry-wave #post-header h1 {
    font-size: 26px;
    line-height: 1.08;
  }
}

/* Smooth color transitions for interactive elements */
a,
button,
input,
  border-radius: 0.375rem;
  box-shadow: none;
}

/* Caption: mono label in accent + serif-friendly text in paper-readable slate.
   Caption lives INSIDE the light plate, so colors are fixed (not theme-var) —
   we are in "paper space" here, not page space. */
.figure-plate__caption,
.prose-custom .figure-plate__caption {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.35rem;
  margin-top: 0.625rem;
  padding: 0 0.125rem;
  font-size: 0.75rem;
  line-height: 1.45;
  font-style: normal;
  text-align: left;
  color: #475569;
}

.figure-plate__caption-main {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
}

.figure-plate__label {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #4f46e5;
  padding-top: 0.0625rem;
  white-space: nowrap;
}

.figure-plate__text {
  font-family: var(--font-sans);
  color: #475569;
  font-weight: 400;
}

.figure-plate__credit {
  color: #64748b;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  line-height: 1.4;
}

.figure-plate__credit a {
  color: inherit;
  text-underline-offset: 0.18em;
}

.figure-plate__credit a:hover {
  color: #334155;
}

.figure-lightbox {
  width: min(96vw, 100rem);
  max-width: 96vw;
  max-height: 92vh;
  margin: auto;
  padding: 0;
  overflow: visible;
  color: var(--text-primary);
  background: transparent;
  border: 0;
  animation: figure-lightbox-in 160ms ease-out;
}

.figure-lightbox::backdrop {
  background: var(--color-bg-overlay);
  animation: figure-lightbox-backdrop-in 160ms ease-out;
}

.figure-lightbox__panel {
  position: relative;
  display: flex;
  max-height: 92vh;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.figure-lightbox__panel img,
.prose-custom .figure-lightbox__panel img {
  display: block;
  width: auto;
  max-width: calc(96vw - 2rem);
  height: auto;
  max-height: calc(92vh - 5rem);
  margin: auto;
  border: 0;
  border-radius: var(--radius-md);
  box-shadow: none;
  object-fit: contain;
}

.figure-lightbox__close {
  position: absolute;
  z-index: 1;
  top: 1.5rem;
  right: 1.5rem;
  display: grid;
  width: 2.25rem;
  height: 2.25rem;
  place-items: center;
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
}

.figure-lightbox__close:hover {
  color: var(--accent-hover);
}

.figure-lightbox__close:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}

.figure-lightbox__caption {
  margin: 0;
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 0.875rem;
  line-height: 1.5;
  text-align: center;
}

@keyframes figure-lightbox-in {
  from { opacity: 0; transform: scale(0.985); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes figure-lightbox-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (hover: none) {
  .figure-plate__enlarge-affordance {
    opacity: 0.8;
  }
}

@media (prefers-reduced-motion: reduce) {
  .figure-plate__enlarge-affordance {
    transition: none;
  }

  .figure-lightbox,
  .figure-lightbox::backdrop {
    animation: none;
  }
}

@media (max-width: 640px) {
  .figure-plate {
    margin: 2rem 0;
    padding: 1rem 1rem 0.875rem;
  }
  .figure-plate--hero {
    margin: 0 0 2.5rem;
    padding: 1.125rem 1.125rem 1rem;
  }
  .figure-plate__caption {
    gap: 0.3rem;
  }
  .figure-plate__caption-main {
    flex-direction: column;
    gap: 0.25rem;
  }
}

@media (max-width: 640px) {
  .post-layout--registry-wave .prose-custom { font-size: 15px; line-height: 1.45; }
  .post-layout--registry-wave .prose-custom > p:first-child { font-size: 15px; line-height: 1.45; }
  .post-layout--registry-wave .figure-plate { margin: 18px 0; padding: 8px; border-radius: 7px; }
  .post-layout--registry-wave .thread-scene { margin: 22px 0; padding: 12px; }
}

/* --- Strong & em --- */
.prose-custom strong {
  font-weight: 700;
  color: var(--text-primary);
}

.prose-custom em {
  color: var(--text-primary);
}

/* --- Keyboard / mark --- */
.prose-custom kbd {
  font-family: var(--font-mono);
  font-size: 0.8125em;
  background-color: var(--bg-muted);
  color: var(--text-primary);
  border: 1px solid var(--border);
  border-bottom-width: 2px;
  border-radius: 0.25rem;
  padding: 0.125em 0.375em;
}

.prose-custom mark {
  background-color: #fef08a;
  color: #1c1917;
  padding: 0.0625em 0.25em;
  border-radius: 0.125rem;
    padding: 0;
    list-style: none;
  }

  .reading-companion__item--sub {
    display: none;
