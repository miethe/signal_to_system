/bin/zsh -lc "python3 - <<'PY'
import sys
sys.path.insert(0, '_handoff/rw-v2/qa')
import run_qa
from playwright.sync_api import sync_playwright

with sync_playwright() as p:
    browser = p.chromium.launch()
    for width, height in ((1440, 900), (390, 844)):
        for dark in (False, True):
            context = run_qa.capture_context(browser, width, height, dark)
            page = run_qa.new_page(context, dark=dark)
            data = page.evaluate('''() => {
              const rect = s => { const e=document.querySelector(s); if("'!e) return null; const r=e.getBoundingClientRect(); const c=getComputedStyle(e); return {x:Math.round(r.x),y:Math.round(r.y),w:Math.round(r.width),h:Math.round(r.height),display:c.display,grid:c.gridTemplateColumns,bg:c.backgroundColor,border:c.borderColor}; };
              const rail = document.querySelector('"'.registry-wave-rail .executive-signal');
              const body = document.querySelector('.prose-custom > .executive-signal');
              const name = document.querySelector('.registry-wave-rail .author-profile h2');
              const links = document.querySelector('.registry-wave-rail .author-profile nav');
              const html = document.documentElement;
              return {
                classes: html.className,
                body: rect('.prose-custom > .executive-signal'),
                rail: rect('.registry-wave-rail .executive-signal'),
                railCols: rail ? getComputedStyle(rail).gridTemplateColumns : null,
                railTakeaway: rail?.querySelector('.executive-signal__col--takeaway') ? rect('.registry-wave-rail .executive-signal__col--takeaway') : null,
                author: rect('.registry-wave-rail .author-profile'),
                avatar: rect('.registry-wave-rail .author-profile img'),
                name: name ? {w:Math.round(name.getBoundingClientRect().width),h:Math.round(name.getBoundingClientRect().height),font:getComputedStyle(name).fontSize,whiteSpace:getComputedStyle(name).whiteSpace} : null,
                links: links ? {w:Math.round(links.getBoundingClientRect().width),h:Math.round(links.getBoundingClientRect().height),wrap:getComputedStyle(links).flexWrap} : null,
                marker: rect('.section-marker'),
                ordinal: rect('.section-marker__ordinal'),
                rule: rect('.section-marker__rule'),
                heading: rect('.section-marker > h2'),
                scene: rect('.thread-scene'),
                pull: rect('.pull-quote'),
                revision: rect('.revision-note'),
                companion: rect('.reading-companion__block'),
                mobileContents: rect('.mobile-contents__section'),
              };
            }''')
            print(f'{width}x{height} {\"dark\" if dark else \"light\"}: {data}')
            page.close(); context.close()
    browser.close()
