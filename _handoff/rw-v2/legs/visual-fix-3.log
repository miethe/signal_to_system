import { site } from '../../data/site';

interface Props {
  variant?: 'featured' | 'sidebar' | 'compact';
  headingLevel?: 'h2' | 'h3';
  showSocials?: boolean;
}

const { variant = 'compact', headingLevel: Heading = 'h2', showSocials } = Astro.props;
const isFeatured = variant === 'featured';
const isSidebar = variant === 'sidebar';
const shouldShowSocials = showSocials ?? isFeatured;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const profileLinks = site.author.profileLinks.filter((link) => normalizePath(link.href) !== currentPath);
const socialLinks = [
  { label: 'GitHub', href: site.author.social.github },
  { label: 'LinkedIn', href: site.author.social.linkedin },
  { label: 'Twitter / X', href: site.author.social.twitter },
];
---

<aside
  aria-label={`About the author, ${site.author.name}`}
  class:list={[
    'author-profile relative overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-ambient',
    isFeatured && 'rounded-2xl p-6 sm:p-7',
    isSidebar && 'rounded-xl p-5',
    variant === 'compact' && 'rounded-xl p-5 sm:p-6',
  ]}
>
  {isFeatured && (
    <div
      class="pointer-events-none absolute -right-10 -top-14 h-36 w-36 rounded-full bg-[var(--accent-subtle)] opacity-60 blur-2xl"
      aria-hidden="true"
    />
  )}

  <div class:list={['relative', variant === 'compact' && 'sm:flex sm:items-center sm:gap-5']}>
    <div class:list={['flex items-center gap-4', variant === 'compact' && 'sm:min-w-64']}>
      <img
        src={site.author.avatar.src}
        alt=""
        width={site.author.avatar.width}
        height={site.author.avatar.height}
        loading={isFeatured ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'shrink-0 rounded-full border border-[var(--border)] bg-[var(--bg-muted)] object-cover object-top ring-2 ring-[var(--bg-surface)]',
          isFeatured ? '!m-0 !h-20 !w-20 !rounded-full' : '!m-0 !h-14 !w-14 !rounded-full',
        ]}
      />
      <div class="min-w-0">
        <p class="font-mono mb-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
          {isSidebar ? 'Written by' : 'The author'}
        </p>
        <Heading class:list={['font-serif font-bold text-[var(--text-primary)]', isFeatured ? 'text-2xl' : 'text-lg']}>
          {site.author.name}
        </Heading>
        <p class="author-profile__role mt-1 text-xs leading-relaxed text-[var(--text-tertiary)]">{site.author.role}</p>
      </div>
    </div>

    <div class:list={['author-profile__extra border-[var(--border-subtle)]', variant === 'compact' ? 'mt-5 border-t pt-5 sm:mt-0 sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0' : 'mt-5 border-t pt-5']}>
      <div class="author-profile__extra-inner">
      <p class:list={['leading-relaxed text-[var(--text-secondary)]', isSidebar ? 'text-sm' : 'text-sm sm:text-[15px]']}>
        {isFeatured ? site.author.bioLong : site.author.bioShort}
      </p>

      {profileLinks.length > 0 && (
      <nav aria-label="Author links" class="mt-4 flex flex-wrap items-center gap-1">
        {profileLinks.map((link, index) => (
          <a
            href={link.href}
            class:list={[
              'focus-ring inline-flex min-h-11 items-center gap-1.5 rounded-md px-2 text-sm font-medium underline-offset-4 hover:underline',
              index === 0 ? 'text-[var(--accent)] hover:text-[var(--accent-hover)]' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
            ]}
          >
            {link.label}
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        ))}
      </nav>
      )}

      {shouldShowSocials && (
        <nav aria-label="Author social profiles" class:list={['flex flex-wrap items-center gap-1', profileLinks.length > 0 ? 'border-t border-[var(--border-subtle)] pt-1' : 'mt-4']}>
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="focus-ring inline-flex min-h-11 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-[var(--text-tertiary)] underline-offset-4 hover:text-[var(--text-primary)] hover:underline"
            >
              {link.label}
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7" /><path d="M7 7h10v10" />
              </svg>
            </a>
          ))}
        </nav>
      )}
      </div>
    </div>
  </div>
</aside>

<style>
  /* Keep the card's compact rhythm when embedded inside `.prose-custom`. */
  .author-profile {
    margin: 0;
    border-color: var(--border-subtle);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-style: normal;
  }

  .author-profile :global(h2),
  .author-profile :global(h3),
  .author-profile :global(p) {
    margin: 0;
    border: 0;
  }

  /*
   * Collapse hooks: the `.is-collapsed` class is toggled externally (by
   * PostSidebar, only on the "sidebar" variant instance used in the post
   * rail) via an IntersectionObserver on the article header — never set by
   * this component itself, so `featured`/`compact` usages are unaffected.
   */
  .author-profile__role {
    max-height: 1.5rem;
    overflow: hidden;
    opacity: 1;
    transition: max-height 0.25s ease, opacity 0.2s ease, margin-top 0.25s ease;
  }

  .author-profile__extra {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
    transition:
      grid-template-rows 0.25s ease,
      opacity 0.2s ease,
      margin-top 0.25s ease,
      padding-top 0.25s ease,
      border-top-width 0.25s ease;
  }

  .author-profile__extra-inner {
    overflow: hidden;
    min-height: 0;
  }

  .author-profile.is-collapsed {
    padding: 0.625rem 0.875rem;
    transition: padding 0.25s ease;
  }

  .author-profile.is-collapsed .author-profile__role {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
  }

  /*
   * The grid-rows trick above only collapses the CONTENT height to 0 — the
   * block's own margin-top/border-top/padding-top (mt-5 border-t pt-5 from
   * the markup) are box properties of this element itself, not its grid
   * track, so they keep reserving space even at grid-template-rows: 0fr.
   * Zero them explicitly so no dead space survives the collapse. `!important`
   * is safe here: `.is-collapsed` never applies to the featured/compact
   * variants that rely on the un-collapsed mt-5/border-t/pt-5 (or compact's
   * sm:border-l) utility values.
   */
  .author-profile.is-collapsed .author-profile__extra {
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: 0 !important;
    padding-top: 0 !important;
    border-top-width: 0 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .author-profile,
    .author-profile__role,
    .author-profile__extra {
      transition: none;
    }
  }

  /* perf-lite drops the animation, never the collapse itself — the class
     toggle in PostSidebar's script always runs regardless of this mode. */
  :global(html.perf-lite) .author-profile,
  :global(html.perf-lite) .author-profile__role,
  :global(html.perf-lite) .author-profile__extra {
    transition: none;
  }

  :global(.dark) .author-profile {
    padding: 16px;
    border-color: #29476b;
    border-radius: 9px;
    background: linear-gradient(145deg, rgb(13 29 51 / 96%), rgb(10 23 42 / 92%));
    box-shadow: 0 10px 28px rgb(0 0 0 / 20%);
  }

  :global(.dark) .author-profile img { width: 38px !important; height: 38px !important; }
  :global(.dark) .author-profile :global(h2), :global(.dark) .author-profile :global(h3) { font-size: 18px; line-height: 1.15; }
  :global(.dark) .author-profile__extra { margin-top: 12px !important; padding-top: 12px !important; }
  :global(.dark) .author-profile__extra p { font-size: 12px; line-height: 1.45; }
</style>
---
/**
 * PullQuote — a wide-margin display quote pulled out of the prose flow.
 * `variant="thesis-marker"` drops the quotation-mark/attribution chrome
 * entirely (and renders a `<p>`, not a `<blockquote>` — it is a stated
 * claim, not a quotation) so a line like "Trusted artifact ≠ trusted
 * use." reads as thesis, not citation. No `lift-hover`: this is a
 * typographic treatment, not a card. Use sparingly (this essay caps at
 * four total, drawn only from the review's shortlist — a manuscript-level
 * constraint, not enforced by this component).
 */
interface Props {
  variant?: 'quote' | 'thesis-marker';
}

const { variant = 'quote' } = Astro.props;
---

<figure class:list={['pull-quote', `pull-quote--${variant}`]}>
  {
    variant === 'thesis-marker' ? (
      <p class="pull-quote__text pull-quote__text--thesis">
        <slot />
      </p>
    ) : (
      <blockquote class="pull-quote__text">
        <span class="pull-quote__mark" aria-hidden="true">
          &ldquo;
        </span>
        <slot />
      </blockquote>
    )
  }
</figure>

<style>
  .pull-quote {
    margin: 2.75rem 0;
  }

  .pull-quote__text {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .pull-quote__text {
      font-size: 1.5rem;
    }
  }

  .pull-quote--quote .pull-quote__text {
    padding-left: 1.5rem;
    border-left: 3px solid var(--accent);
  }

  .pull-quote__mark {
    margin-right: 0.3rem;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 1.3em;
    font-style: normal;
  }

  .pull-quote--thesis-marker .pull-quote__text--thesis {
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-style: normal;
    font-weight: 600;
    text-align: center;
    letter-spacing: 0.005em;
  }

  :global(.dark) .pull-quote--quote { min-height: 106px; margin: 22px 0 25px; padding: 18px 28px 18px 52px; border-left: 4px solid #9d7cff; background: linear-gradient(100deg, rgb(27 55 91 / 72%) 0%, rgb(10 27 50 / 48%) 100%); }
  :global(.dark) .pull-quote--quote .pull-quote__text { padding: 0; border: 0; color: #f1eef8; font-size: 28px; line-height: 1.35; }
  :global(.dark) .pull-quote__mark { color: #7898ef; font-size: 42px; line-height: 0; }
</style>
---
/**
 * RevisionNote — a thin, one-line revision marker (date plus a
 * `<details>` disclosure), for posts that want a quieter signal than a
 * full callout box. Replaces `EditionBanner` for this post only;
 * `EditionBanner.astro` itself is untouched and stays available where the
 * boxed treatment is still wanted.
 *
 * The line stays one line by keeping the summary text collapsed by
 * default — only "Revised {date}" and the disclosure trigger are visible
 * at rest; expanding reveals the revision note and, if given, the
 * changelog link.
 */
interface Props {
  note: string;
  revisedDate: string;
  changelogHref?: string;
}

const { note, revisedDate, changelogHref } = Astro.props;
---

<p class="revision-note">
  <span class="revision-note__date">Revised {revisedDate}</span>
  <details class="revision-note__details">
    <summary>What&rsquo;s changed?</summary>
    <span class="revision-note__note">
      {note}
      {
        changelogHref && (
          <>
            {' '}
            <a href={changelogHref}>View full changelog</a>
          </>
        )
      }
    </span>
  </details>
</p>

<style>
  .revision-note {
    margin: 0 0 1.5rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .revision-note__date {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .revision-note__details { display: inline; margin-left: auto; }

  .revision-note__details summary {
    display: inline;
    list-style: none;
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
  }

  .revision-note__details summary::-webkit-details-marker {
    display: none;
  }

  .revision-note__details summary:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .revision-note__note {
    display: block;
    margin-top: 0.4rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: normal;
    line-height: 1.6;
  }

  .revision-note__note a {
    color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .revision-note__note a:hover {
    color: var(--accent-hover);
  }

  :global(.post-layout--registry-wave .revision-note) { display: flex; align-items: center; min-height: 38px; margin: 0 0 26px; padding: 0 4px; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); font-size: 11px; line-height: 1; }
  :global(.post-layout--registry-wave .revision-note__details) { margin-left: auto; }
  :global(.post-layout--registry-wave .revision-note__note) { position: absolute; z-index: 2; max-width: min(32rem, 90vw); margin-top: 32px; padding: 10px 12px; border: 1px solid var(--border-subtle); border-radius: 6px; background: var(--bg-surface); box-shadow: var(--shadow-md); line-height: 1.45; }
</style>
---
/**
 * WhereThisSits (cross-series "reading path" locator for MDX essays).
 *
 * Looks up the current essay by slug in src/data/reading-paths.json and
 * renders prior -> this -> next within that guided path, plus a link to
 * the path's own page. Distinct from ReadingPathNav (which navigates
 * within a single content-collection `series`): a reading path spans
 * several parallel series on purpose.
 *
 * Usage in MDX:
 *   <WhereThisSits slug="agentic-operations-flow" />
 */
import pathsData from '../../data/reading-paths.json';

interface Step {
  slug: string | null;
  title: string;
  whatItAnswers: string;
  state: 'published' | 'next';
}

interface ReadingPath {
  id: string;
  pageSlug: string;
  title: string;
  umbrellaTerm: string;
  rationale: string;
  steps: Step[];
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const paths = (pathsData as { paths: ReadingPath[] }).paths;
const path = paths.find((p) => p.steps.some((s) => s.slug === slug));

if (!path) {
  throw new Error(
    `<WhereThisSits slug="${slug}" /> does not match any step in src/data/reading-paths.json. Add this essay's slug to a path's steps, or fix the slug.`
  );
}

const index = path.steps.findIndex((s) => s.slug === slug);
const prev = index > 0 ? path.steps[index - 1] : null;
const current = path.steps[index];
const next = index < path.steps.length - 1 ? path.steps[index + 1] : null;

const hrefFor = (step: Step) => (step.slug ? `/essays/${step.slug}/` : undefined);
---

<aside class="where-this-sits lift-hover my-10 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-5">
  <p class="where-this-sits__intro mb-3 text-xs font-medium uppercase tracking-wider text-[var(--text-tertiary)]">
    Part of the <span class="text-[var(--text-primary)]">{path.umbrellaTerm}</span> reading path
    (<a href={`/series/${path.pageSlug}/`} class="text-violet-600 hover:underline dark:text-violet-400">see the full path</a>)
  </p>
  <div class="where-this-sits__steps flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-2">
    <span class="where-this-sits__step text-sm text-[var(--text-tertiary)]">
      {prev ? (
        <a href={hrefFor(prev)} class="hover:text-violet-600 hover:underline dark:hover:text-violet-400">{prev.title}</a>
      ) : (
        'Start of the path'
      )}
    </span>
    <span class="hidden text-[var(--text-disabled)] sm:inline" aria-hidden="true">&rarr;</span>
    <span class="where-this-sits__step where-this-sits__step--current font-medium text-[var(--text-primary)]">{current.title} (you are here)</span>
    <span class="hidden text-[var(--text-disabled)] sm:inline" aria-hidden="true">&rarr;</span>
    <span class="where-this-sits__step text-sm text-[var(--text-tertiary)]">
      {next ? (
        next.state === 'published' ? (
          <a href={hrefFor(next)} class="hover:text-violet-600 hover:underline dark:hover:text-violet-400">{next.title}</a>
        ) : (
          <span>{next.title} <span class="italic text-[var(--text-disabled)]">(next, in progress)</span></span>
        )
      ) : (
        'End of the path'
      )}
    </span>
  </div>
</aside>

<style>
  :global(.dark) .where-this-sits { padding: 14px; border-color: #294563; border-radius: 8px; background: linear-gradient(135deg, #0b1c31 0%, #0a172a 70%, #11153a 100%); }
  :global(.dark) .where-this-sits__intro { margin: 0; color: #b8c3d4; font-size: 10px; line-height: 1.4; }
  :global(.dark) .where-this-sits__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 10px; padding: 12px 16px 14px; border: 1px solid #6550b8; border-radius: 8px; }
  :global(.dark) .where-this-sits__step { min-width: 0; padding-top: 10px; border-top: 1px solid #40506a; font-family: var(--font-serif); font-size: 14px; line-height: 1.2; }
  :global(.dark) .where-this-sits__step--current { color: #f1eff0; }
  :global(.dark) .where-this-sits__steps > [aria-hidden] { display: none; }
  @media (max-width: 640px) { :global(.dark) .where-this-sits__steps { grid-template-columns: 1fr; } }
</style>
---
import { threads } from '../../data/threads';

interface Heading { depth: number; slug: string; text: string; }
interface Props { slug?: string; headings?: Heading[]; }
const { slug, headings = [] } = Astro.props;
const thread = slug ? threads[slug] : undefined;
const outline = headings.filter((heading) => heading.depth === 2 && heading.slug !== 'footnote-label');
---

{outline.length > 0 && (
  <>
    <a class="mobile-contents__fallback" href="#post-contents">Contents</a>
    <button type="button" class="mobile-contents__trigger focus-ring" data-mobile-contents-trigger aria-haspopup="dialog">Contents</button>
    <dialog class="mobile-contents" data-mobile-contents aria-labelledby="mobile-contents-title">
      <div class="mobile-contents__sheet">
        <div class="mobile-contents__header">
          <h2 id="mobile-contents-title" class="font-serif">Contents</h2>
          <button type="button" class="mobile-contents__close focus-ring" data-mobile-contents-close>Close</button>
        </div>
        <nav aria-label="Article sections"><ol>{outline.map((heading, index) => <li><a href={`#${heading.slug}`} data-mobile-contents-link><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a></li>)}</ol></nav>
        {thread && <nav class="mobile-contents__thread" aria-label={`Running example: ${thread.title}`}><p class="font-mono">Running example</p><ol>{thread.beats.map((beat) => <li><a href={`#thread-${beat.id}`} data-mobile-contents-link><span>{String(beat.n).padStart(2, '0')}</span>{beat.label}</a><a class="mobile-contents__inspect" href={`/essays/${slug}/thread/${beat.id}/`}>Inspect</a></li>)}</ol></nav>}
        {thread && <a class="mobile-contents__evidence" href={`/essays/${slug}/evidence/`}>Receipts behind the argument</a>}
      </div>
    </dialog>
    <section id="post-contents" class="mobile-contents__section" aria-labelledby="post-contents-title">
      <h2 id="post-contents-title">Contents</h2>
      <ol>{outline.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    </section>
  </>
)}

<style>
  .mobile-contents__trigger { display: none; }
  .mobile-contents__fallback { display: none; }
  .mobile-contents__section { display: none; }
  @media (max-width: 1279px) {
    .mobile-contents__trigger { position: fixed; right: 1rem; bottom: calc(1rem + env(safe-area-inset-bottom)); z-index: 55; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--bg-surface); box-shadow: var(--shadow-md); color: var(--accent-text); cursor: pointer; font: 700 .6875rem var(--font-mono); letter-spacing: .08em; padding: .45rem .75rem; text-transform: uppercase; }
    .mobile-contents__fallback { display: inline-flex; position: fixed; right: 1rem; bottom: calc(1rem + env(safe-area-inset-bottom)); z-index: 54; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--bg-surface); color: var(--accent-text); font: 700 .6875rem var(--font-mono); padding: .45rem .75rem; text-decoration: none; }
    :global(html.mobile-contents-ready) .mobile-contents__trigger { display: inline-flex; z-index: 56; }
    :global(html.mobile-contents-ready) .mobile-contents__fallback { display: none; }
    .mobile-contents__section { display: block; margin: 3rem 0; padding: 1.25rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--bg-subtle); }
    .mobile-contents__section h2 { margin-top: 0; }
  }
  .mobile-contents { width: min(100%, 42rem); max-width: 100%; max-height: min(75dvh, 42rem); margin: auto 0 0; padding: 0; color: var(--text-primary); background: var(--bg-surface); border: 1px solid var(--border-strong); border-radius: 1rem 1rem 0 0; }
  .mobile-contents::backdrop { background: var(--color-bg-overlay); }
  .mobile-contents__sheet { max-height: min(75dvh, 42rem); overflow-y: auto; padding: 1.25rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom)); }
  .mobile-contents__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: .75rem; }
  .mobile-contents__header h2 { margin: 0; font-size: 1.5rem; }
  .mobile-contents__close { border: 0; background: transparent; color: var(--accent-text); cursor: pointer; font: 700 .6875rem var(--font-mono); text-transform: uppercase; }
  .mobile-contents ol { margin: .75rem 0 0; padding: 0; list-style: none; }
  .mobile-contents li { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; border-bottom: 1px solid var(--border-subtle); }
  .mobile-contents li > a:first-child { flex: 1; }
  .mobile-contents a { display: flex; gap: .75rem; padding: .7rem 0; color: var(--text-secondary); text-decoration: none; }
  .mobile-contents a:hover, .mobile-contents a:focus-visible { color: var(--accent-text); text-decoration: underline; }
  .mobile-contents a span { color: var(--accent-text); font: 700 .6875rem var(--font-mono); }
  .mobile-contents__thread { margin-top: 1.25rem; } .mobile-contents__thread > p { color: var(--accent-text); font-size: .6875rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .mobile-contents__inspect { color: var(--accent-text) !important; font: 700 .625rem var(--font-mono); text-transform: uppercase; }
  .mobile-contents__evidence { margin-top: 1rem; color: var(--accent-text); font-weight: 600; }
</style>

<script>
  const initMobileContents = () => {
    document.querySelectorAll<HTMLDialogElement>('[data-mobile-contents]').forEach((dialog) => {
      if (dialog.dataset.mobileContentsReady === 'true') return;
      dialog.dataset.mobileContentsReady = 'true';
      document.documentElement.classList.add('mobile-contents-ready');
      const trigger = document.querySelector<HTMLButtonElement>('[data-mobile-contents-trigger]');
      const close = dialog.querySelector<HTMLButtonElement>('[data-mobile-contents-close]');
      trigger?.addEventListener('click', () => dialog.showModal());
      close?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => trigger?.focus({ preventScroll: true }));
      dialog.querySelectorAll<HTMLAnchorElement>('[data-mobile-contents-link]').forEach((link) => link.addEventListener('click', () => dialog.close()));
    });
  };
  initMobileContents(); document.addEventListener('astro:page-load', initMobileContents);
</script>

