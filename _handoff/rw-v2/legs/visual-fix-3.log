---
/**
 * RunningExampleCard — Thread Focus rail component (ARCHITECTURE.md §4,
 * spec §7): the known artifact metadata behind the essay's running
 * example. Per V7/the semantic boundaries in spec §7, this renders only
 * verified fields already present on the `Thread` record — title and
 * artifact identity (`thread.subject`) — and omits any field this build
 * has no grounded value for (role, verified scope, provenance, or any
 * health/approval badge) rather than inferring or inventing one.
 */
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
}

const { thread } = Astro.props;
---

<section class="running-example-card" aria-label="Running example artifact">
  <p class="running-example-card__eyebrow font-mono">Running example</p>
  <h3 class="running-example-card__title font-serif">{thread.title}</h3>

  <dl class="running-example-card__facts">
    <div class="running-example-card__fact">
      <dt>Artifact identity</dt>
      <dd class="font-mono">{thread.subject}</dd>
    </div>
  </dl>

  <p class="running-example-card__note">
    Role, verified scope, and provenance beyond the artifact identity above are not captured in
    this build; nothing here infers a health or approval state from the registry.
  </p>
</section>

<style>
  .running-example-card {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    padding: 0.875rem 1rem;
  }

  .running-example-card__eyebrow {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .running-example-card__title {
    margin: 0.2rem 0 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .running-example-card__facts {
    margin: 0 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .running-example-card__fact dt {
    margin: 0 0 0.15rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .running-example-card__fact dd {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .running-example-card__note {
    margin: 0;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-tertiary);
  }
</style>
---
/**
 * ThreadFocus — the shared Thread Focus renderer (reading-experience-v2
 * DIRECTION.md V3/V4, ARCHITECTURE.md §4, spec §7). Backs BOTH the
 * standalone `/essays/<slug>/thread/<beat>/` route and the in-place
 * overlay's `<template data-focus-view="thread:<beat>">` fragment —
 * `standalone` only toggles the few actions that make sense outside a
 * dialog (no "Close" outside `standalone={false}`); every other prop
 * comes straight from the beat record in `threads.ts`, so inline and
 * focus views never diverge into two hand-written explanations (V3).
 *
 * P0-C is what will later clone this component's `<template>` copy into
 * `FocusHost`'s dialog and wire "Back to essay" / "Read this scene in the
 * essay" / prev-next to replace-in-place rather than navigate — for this
 * leg every action below is a real link, so the standalone route and the
 * eventual overlay share one navigable, no-JS-safe destination for each.
 */
import Figure from './Figure.astro';
import RunningExampleCard from './RunningExampleCard.astro';
import ThreadOverview from './ThreadOverview.astro';
import { evidence } from '../../data/evidence';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);
const beatIndex = beat ? thread.beats.findIndex((candidate) => candidate.id === beatId) : -1;
const prevBeat = beatIndex > 0 ? thread.beats[beatIndex - 1] : null;
const nextBeat = beatIndex > -1 && beatIndex < thread.beats.length - 1 ? thread.beats[beatIndex + 1] : null;
const relatedEvidence = beat ? beat.relatedEvidenceIds.map((id) => evidence[id]).filter(Boolean) : [];

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};
---

{
  beat && (
    <div class="thread-focus" data-focus-kind="thread" data-focus-key={beat.id}>
      <div class="thread-focus__grid">
        <div class="thread-focus__main">
          <div class="thread-focus__actions">
            <a class="thread-focus__action" href={`/essays/${thread.slug}/`}>
              &larr; Back to essay
            </a>
            <span class="thread-focus__action-label font-mono">Thread focus</span>
            <a
              class="thread-focus__action thread-focus__action--secondary"
              href={`/essays/${thread.slug}/#thread-${beat.id}`}
            >
              Read this scene in the essay
            </a>
            {!standalone && (
              <button type="button" class="thread-focus__action thread-focus__action--close" data-focus-close>
                Close
              </button>
            )}
          </div>

          <p class="thread-focus__eyebrow font-mono">
            <span>
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true">&middot;</span>
            <span>{kindLabel[beat.kind] ?? beat.kind}</span>
          </p>
          <h2 class="thread-focus__title font-serif">{beat.label}</h2>
          <p class="thread-focus__recap">{beat.recap}</p>

          <Figure
            src={beat.image.src}
            alt={beat.image.alt}
            caption={beat.image.caption}
            number={String(beat.n).padStart(2, '0')}
            longDescription={beat.longDescription}
            variant="wide"
            expandable={false}
          />
          <a class="thread-focus__figure-link" href={`/essays/${thread.slug}/figure/${beat.id}/`}>
            View this figure in the Figure Viewer &rarr;
          </a>

          {relatedEvidence.length > 0 && (
            <nav class="thread-focus__evidence-links" aria-label="Related evidence">
              <p class="thread-focus__boundary-label font-mono">Related evidence</p>
              <ul>
                {relatedEvidence.map((record) => (
                  <li><a href={`/evidence/${record.id}/`}>{record.title} &rarr;</a></li>
                ))}
              </ul>
            </nav>
          )}

          <div class="thread-focus__boundary">
            <div>
              <p class="thread-focus__boundary-label font-mono">What this establishes</p>
              <p>{beat.establishes}</p>
            </div>
            <div>
              <p class="thread-focus__boundary-label font-mono">What it does not establish</p>
              <p>{beat.doesNotEstablish}</p>
            </div>
          </div>

          <nav class="thread-focus__prevnext" aria-label="Adjacent thread beats">
            {prevBeat ? (
              <a href={`/essays/${thread.slug}/thread/${prevBeat.id}/`}>
                &larr; {prevBeat.label}
              </a>
            ) : (
              <span />
            )}
            {nextBeat && (
              <a href={`/essays/${thread.slug}/thread/${nextBeat.id}/`}>
                {nextBeat.label} &rarr;
              </a>
            )}
          </nav>
        </div>

        <aside class="thread-focus__rail">
          <RunningExampleCard thread={thread} />
          <ThreadOverview thread={thread} currentBeatId={beat.id} />
        </aside>
      </div>
    </div>
  )
}

<style>
  .thread-focus {
    max-width: 100%;
---
/**
 * EvidenceFocus — the shared Evidence Focus renderer (DIRECTION.md V3/V4,
 * ARCHITECTURE.md §4, spec §8). Backs BOTH `/essays/<slug>/evidence/`
 * (the essay-scoped index) and the flat, site-wide `/evidence/<record>/`
 * route, plus the in-place overlay's `<template>` fragment — same
 * component, same field set from `evidence.ts`'s `EvidenceRecord`, never
 * a second hand-written summary.
 *
 * `records` is always the full evidence set (so the rail's `ReceiptIndex`
 * can navigate anywhere); `selectedId` narrows the main pane to one
 * record's full detail. Omitting it renders the full list.
 */
import EvidenceGuide from './EvidenceGuide.astro';
import ReceiptIndex from './ReceiptIndex.astro';
import ClaimBadge from './ClaimBadge.astro';
import type { EvidenceRecord } from '../../data/evidence';

interface Props {
  records: EvidenceRecord[];
  selectedId?: string;
  /** Real anchor text for a "Read in essay" link, when a related essay exists. */
  essaySlug?: string;
  standalone?: boolean;
}

const { records, selectedId, essaySlug, standalone = true } = Astro.props;
// The essay index is a receipt surface, not a bare directory. When no record
// is named in the route, introduce the first related receipt in full and let
// the rail provide the rest of the index.
const selected = selectedId ? records.find((record) => record.id === selectedId) : records[0];
const selectedRecordId = selected?.id;
const receiptDate = selected?.recordedDate ?? selected?.eventDate ?? selected?.verifiedAt ?? null;
const claimBadgeKind = selected
  ? ({
      observed: 'observed',
      measured: 'measured',
      proposed: 'proposed',
      'externally-reported': 'external',
      illustrative: 'hypothesis',
    }[selected.evidenceClass] as 'observed' | 'measured' | 'proposed' | 'external' | 'hypothesis')
  : undefined;

const formatDate = (value: string | null) => value ?? 'Not stated';
---

<div class="evidence-focus" data-focus-kind="evidence" data-focus-key={selectedId ?? 'all'}>
  <div class="evidence-focus__grid">
    <div class="evidence-focus__main">
      <div class="evidence-focus__actions">
        {essaySlug && (
          <a class="evidence-focus__action" href={`/essays/${essaySlug}/`}>
            &larr; Back to essay
          </a>
        )}
        <span class="evidence-focus__action-label font-mono">Evidence focus</span>
        {essaySlug && (
          <a
            class="evidence-focus__action evidence-focus__action--secondary"
            href={`/essays/${essaySlug}/evidence/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in new tab
          </a>
        )}
        {!standalone && (
          <button type="button" class="evidence-focus__action evidence-focus__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      <h1 class="evidence-focus__page-title font-serif">
        {selectedId && selected ? selected.title : 'Receipts behind the argument'}
      </h1>

      {selected ? (
        <article class="evidence-focus__record">
          <p class="evidence-focus__eyebrow font-mono">
            {claimBadgeKind && <ClaimBadge kind={claimBadgeKind} />}
            <span>{selected.evidenceClass}</span>
          </p>
          {!selectedId && <h2 class="evidence-focus__title font-serif">{selected.title}</h2>}

          <p class="evidence-focus__receipt-date font-mono">
            Receipt date: {formatDate(receiptDate)}
          </p>

          <dl class="evidence-focus__facts">
            <div>
              <dt>Capture type</dt>
              <dd>{selected.captureType}</dd>
            </div>
            <div>
              <dt>Event date</dt>
              <dd>{formatDate(selected.eventDate)}</dd>
            </div>
            <div>
              <dt>Recorded date</dt>
              <dd>{formatDate(selected.recordedDate)}</dd>
            </div>
            <div>
              <dt>Verified at</dt>
              <dd>{formatDate(selected.verifiedAt)}</dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>{selected.sourceUrl ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Source revision</dt>
              <dd>{selected.sourceRevision ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Publicability</dt>
              <dd>{selected.publicability}</dd>
            </div>
          </dl>

---
/**
 * FigureViewer — the shared figure-viewer renderer (DIRECTION.md V7,
 * ARCHITECTURE.md §4, spec §10). Backs both `/essays/<slug>/figure/<id>/`
 * and the in-place overlay's `<template>` fragment: exact asset, exact
 * caption, long description, and real file metadata read from disk at
 * build time — never a fabricated size or dimension (V1).
 *
 * `sharp` is already a project dependency (Astro's own image pipeline
 * uses it), so this reads genuine width/height via its metadata probe
 * rather than falling back to an undocumented guess; file size comes from
 * `fs.statSync`. A missing asset at build time leaves both fields `null`
 * — a labeled pending slot, not a substitute value.
 */
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);

let fileSizeBytes: number | null = null;
let width: number | null = null;
let height: number | null = null;

if (beat) {
  const absolutePath = path.join(process.cwd(), 'public', beat.image.src);
  try {
    const stat = fs.statSync(absolutePath);
    fileSizeBytes = stat.size;
    const metadata = await sharp(absolutePath).metadata();
    width = metadata.width ?? null;
    height = metadata.height ?? null;
  } catch {
    // Asset unreadable at build time — leave metadata null (V1: a missing
    // input stays a labeled pending slot, never a fabricated value).
  }
}

const formatBytes = (bytes: number | null) => {
  if (bytes === null) return 'Not available in this build';
  const kb = bytes / 1024;
  return kb >= 1024 ? `${(kb / 1024).toFixed(2)} MB` : `${kb.toFixed(1)} KB`;
};

const dimensionsLabel =
  width !== null && height !== null ? `${width} × ${height}px` : 'Not available in this build';

const filename = beat?.image.src.split('/').pop() ?? '';
---

{
  beat && (
    <div class="figure-viewer" data-focus-kind="figure" data-focus-key={beat.id}>
      <div class="figure-viewer__actions">
        <a class="figure-viewer__action" href={`/essays/${thread.slug}/`}>
          &larr; Back to essay
        </a>
        <a class="figure-viewer__action" href={`/essays/${thread.slug}/thread/${beat.id}/`}>
          &larr; Back to thread focus
        </a>
        <span class="figure-viewer__action-label font-mono">Figure viewer</span>
        <a class="figure-viewer__action figure-viewer__action--copy" href={`/essays/${thread.slug}/figure/${beat.id}/`} data-focus-copy-link>
          Copy link
        </a>
        {!standalone && (
          <button type="button" class="figure-viewer__action figure-viewer__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      <p class="figure-viewer__eyebrow font-mono">Figure {String(beat.n).padStart(2, '0')} · {beat.label}</p>
      <h2 class="figure-viewer__title font-serif">{beat.image.caption}</h2>

      <figure class="figure-viewer__figure">
        <img src={beat.image.src} alt={beat.image.alt} loading="lazy" decoding="async" />
        <figcaption>
          <p class="figure-viewer__caption">{beat.image.caption}</p>
          <p class="figure-viewer__long-description">{beat.longDescription}</p>
        </figcaption>
      </figure>

      <dl class="figure-viewer__metadata">
        <div>
          <dt>Filename</dt>
          <dd class="font-mono">{filename}</dd>
        </div>
        <div>
          <dt>File size</dt>
          <dd>{formatBytes(fileSizeBytes)}</dd>
        </div>
        <div>
          <dt>Dimensions</dt>
          <dd>{dimensionsLabel}</dd>
        </div>
      </dl>
    </div>
  )
}

<style>
  .figure-viewer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

