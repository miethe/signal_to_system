--- src/layouts/PostLayout.astro ---
---
import BaseLayout from './BaseLayout.astro';
import Figure from '../components/content/Figure.astro';
import RelatedContent from '../components/content/RelatedContent.astro';
import AuthorProfile from '../components/content/AuthorProfile.astro';
import ReadingCompanion from '../components/content/ReadingCompanion.astro';
import SectionMarker from '../components/content/SectionMarker.astro';
import FocusTemplates from '../components/content/FocusTemplates.astro';
import FocusHost from '../components/content/FocusHost.astro';
import SeriesWayfinding from '../components/content/SeriesWayfinding.astro';
import ExecutiveSignal from '../components/content/ExecutiveSignal.astro';
import { generateJsonLd, buildCanonicalUrl } from '../lib/seo';
import { formatDate, formatDateISO } from '../lib/utils';
import { site } from '../data/site';
import type { Article } from '../lib/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug?: string;
  headings?: Heading[];
  frontmatter: {
    title: string;
    excerpt?: string;
    description?: string;
    date: Date | string;
    updatedDate?: Date | string;
    readTime?: number;
    category?: string;
    tags?: string[];
    ogImage?: string;
    heroImage?: string;
    heroAlt?: string;
    whyItMatters?: string;
    leaderTakeaway?: string;
    series?: string;
    seriesPart?: number;
    draft?: boolean;
    heroPlacement?: 'default' | 'frontispiece';
  };
  // Optional: inject prev/next series posts from the page. `href` is
  // collection-aware (e.g. via hrefFor()) and falls back to /essays/<slug>/.
  prevPost?: { title: string; slug: string; href?: string };
  nextPost?: { title: string; slug: string; href?: string };
  // Optional: related posts/stories from getRelatedArticles(), resolved on
  // the page (where the content collection entry is in scope).
  relatedItems?: Article[];
}

const { slug, headings = [], frontmatter, prevPost, nextPost, relatedItems = [] } = Astro.props;

const {
  title,
  excerpt,
  description,
  date,
  updatedDate,
  readTime,
  category,
  tags = [],
  ogImage,
  heroImage,
  heroAlt,
  whyItMatters,
  leaderTakeaway,
  series,
  seriesPart,
  heroPlacement = 'default',
} = frontmatter;

const isFrontispiece = heroPlacement === 'frontispiece';

const pageDescription = description || excerpt || site.description;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const publishedISO = formatDateISO(date);
const updatedISO = updatedDate ? formatDateISO(updatedDate) : undefined;
const resolvedHeroAlt = heroAlt
  || (heroImage === '/assets/posts/the-registry-wave-agentic-artifact-supply-chain/hero-governed-cube.png'
    ? 'A shared capability pattern connects several project workbenches, each retaining a distinct adaptation.'
    : `Hero illustration for ${title}`);

const jsonLd = generateJsonLd('article', {
  title,
  description: pageDescription,
  url: canonicalUrl,
  image: ogImage,
  datePublished: publishedISO,
  dateModified: updatedISO,
  tags,
});
---

<BaseLayout
  title={title}
  description={pageDescription}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 z-[60] h-[3px] bg-[var(--accent)] transition-none"
    style="width: 0%;"
    aria-hidden="true"
  ></div>

  <article class="post-layout mx-auto grid w-full max-w-[var(--measure)] items-start px-4 py-12 sm:px-6 lg:px-8 xl:max-w-7xl xl:grid-cols-[minmax(0,var(--measure))_minmax(14rem,18rem)] xl:justify-center xl:gap-x-12">
    <!-- This lives inside .post-layout so the shared --measure token is
         resolvable. It remains ahead of the title/dek/meta at every size. -->
    {
      isFrontispiece && heroImage && (
        <div class="w-full pt-0 xl:col-span-2 xl:row-start-1">
          <Figure src={heroImage} alt={resolvedHeroAlt} variant="hero" />
        </div>
      )
    }

    <!-- Article header -->
    <header
      id="post-header"
      class:list={[
        'mb-16 min-w-0 space-y-6 pb-4 xl:col-start-1',
        isFrontispiece ? 'xl:row-start-2' : 'xl:row-start-1',
      ]}
    >
      {
        category && (
          <div>
            <span class="font-mono inline-block rounded-full bg-[var(--accent-subtle)] px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[var(--accent-text)] ring-1 ring-inset ring-[var(--border-subtle)]">
              {category}
            </span>
          </div>
        )
      }

      <h1 class="font-serif text-4xl font-bold leading-[1.1] tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-7xl">
        {title}
      </h1>

      {
        excerpt && (
          <p class="text-lg leading-relaxed text-[var(--text-tertiary)]">{excerpt}</p>
        )
      }

      <!-- Series wayfinding: arc position and/or mini-series part. Grouped
           with the dek (it answers "where does this sit?", which is editorial
           context) and kept away from the grey tag chips below, so the two
           chip rows never read as one muddled row. -->
      {
        slug && (
          <SeriesWayfinding
            slug={slug}
            collection="posts"
            series={series}
            seriesPart={seriesPart}
          />
        )
      }

      <!-- Meta row -->
      <div class="font-mono flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--text-disabled)]">
        <time datetime={publishedISO} class="text-[var(--text-tertiary)]">
          {formatDate(date)}
        </time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated{' '}
                <time datetime={updatedISO}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
        {
          readTime && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{readTime} min read</span>
            </>
          )
        }
      </div>

      <!-- Tags -->
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-1">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="rounded-full bg-[var(--bg-muted)] px-3 py-0.5 text-xs font-medium text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-surface)] hover:text-[var(--text-secondary)]"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <!-- Desktop rail follows the header in source order and spans the
         article column. Reading-experience-v2 DIRECTION.md V5: the author
         card sits in flow here and scrolls away with the page; only
         ReadingCompanion (outline + ThreadDock + optional ContextualNote)
         is the sticky surface at depth. -->
    <div
      class:list={[
        'hidden xl:col-start-2 xl:row-span-2 xl:block xl:self-stretch',
        isFrontispiece ? 'xl:row-start-2' : 'xl:row-start-1',
      ]}
    >
      <div class="mb-4">
        <AuthorProfile variant="sidebar" headingLevel="h2" />
      </div>
      {
        whyItMatters && (
          <div class="mb-4">
            <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
          </div>
        )
      }
      <div class="no-scrollbar xl:sticky xl:top-24 xl:max-h-[calc(100vh-7rem)] xl:overflow-y-auto xl:pr-1">
        <ReadingCompanion slug={slug} headings={headings} />
      </div>
    </div>

    <div
      class:list={[
        'min-w-0 xl:col-start-1',
        isFrontispiece ? 'xl:row-start-3' : 'xl:row-start-2',
      ]}
    >

    <!-- Compact author context remains in the reading flow below desktop. -->
    <div class="mb-10 xl:hidden">
      <AuthorProfile variant="compact" headingLevel="h2" />
    </div>

    <!-- Hero illustration (engineering plate) — the frontispiece position
         (above the header) is rendered earlier and skips this slot. -->
    {
      !isFrontispiece && heroImage && (
        <Figure
          src={heroImage}
          alt={resolvedHeroAlt}
          variant="hero"
        />
      )
    }

    <!-- The narrow layout has no rail, so it keeps the signal in flow here.
         Desktop places the same single signal under the author card above. -->
    {
      whyItMatters && (
        <div class="xl:hidden">
          <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
        </div>
      )
    }

    <!-- Article body -->
    <div class="prose-custom">
      <slot />
      <SectionMarker />
    </div>

    <!-- Article footer: series nav + tags recap -->
    <footer class="mt-12 space-y-8 border-t border-[var(--border-subtle)] pt-8">
      <!-- Series navigation -->
      {
        (prevPost || nextPost) && (
          <nav aria-label="Series navigation" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {prevPost ? (
              <a
                href={prevPost.href ?? `/essays/${prevPost.slug}/`}
                class="group flex flex-col gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
                  &larr; Previous
                </span>
                <span class="text-sm font-medium text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
                  {prevPost.title}
                </span>
              </a>
            ) : (
              <div />
            )}
            {nextPost && (
              <a
                href={nextPost.href ?? `/essays/${nextPost.slug}/`}
                class="group flex flex-col items-end gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
                  Next &rarr;
                </span>
                <span class="text-sm font-medium text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
                  {nextPost.title}
                </span>
              </a>
            )}
          </nav>
        )
      }

      <!-- Related reading -->
      <RelatedContent items={relatedItems} />

      <!-- Back links -->
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <a
          href="/essays"
          class="text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
        >
          &larr; All Essays
        </a>
        {
          category && (
            <a
              href={`/categories/${category.toLowerCase()}`}
              class="text-[var(--text-disabled)] transition-colors hover:text-[var(--text-secondary)]"
            >
              More in {category}
            </a>
          )
        }
      </div>
    </footer>
  </div>
  </article>

  <!-- <template> fragments FocusHost clones on open — see
       FocusTemplates.astro's header comment. No-op for posts without a
       thread. FocusHost is mounted right after so its dialog always has
       this exact slug's templates to draw from (ARCHITECTURE.md §3). -->
  {slug && <FocusTemplates slug={slug} />}
  {slug && <FocusHost slug={slug} />}

  <!-- Scroll to top button -->
  <button
    id="scroll-to-top"
    type="button"
    aria-label="Scroll to top"
    class="fixed bottom-8 right-8 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-tertiary)] shadow-md opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-[var(--accent-subtle)] hover:text-[var(--accent)] hover:border-[var(--accent)]/50 focus-ring"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </button>

  <script>
    // Reading progress bar
    const progressBar = document.getElementById('reading-progress');

--- src/components/content/ReadingCompanion.astro ---
---
/**
 * ReadingCompanion — the one sticky reading companion for an essay
 * (reading-experience-v2 DIRECTION.md V5, ARCHITECTURE.md §5). Refactor of
 * `PostSidebar.astro` to the three-slot contract from
 * `02_EXPERIENCE_SPEC.md`§6:
 *
 *   1. Compact nearby-chapter outline + an "All sections" action.
 *   2. `ThreadDock`, when the post has a thread.
 *   3. At most one authored `ContextualNote` — skipped for now: no
 *      authored-note data source exists yet, so this slot stays empty
 *      rather than fabricating content (per this leg's build brief).
 *
 * `AuthorProfile` and `ExecutiveSignal` are no longer inside this sticky
 * column at all (V5: they sit in flow at the top of the rail and scroll
 * away) — `PostLayout` renders `AuthorProfile` above this component,
 * outside its sticky wrapper. That removal is also what retires the old
 * accordion between the author card, the takeaway pill, and the thread
 * rail: with only two small, independently-sized blocks left in the
 * column (the outline and the six-item `ThreadDock`), there's no
 * competing-for-space problem left to solve, so this component's script
 * is a straight scroll-spy + windowed-list fit, not an accordion
 * coordinator.
 *
 * Posts without a thread get outline-only behavior (the same generic
 * fallback `PostSidebar` provided) — `slug`/`thread` are both optional.
 */
import ThreadDock from './ThreadDock.astro';
import { threads } from '../../data/threads';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug?: string;
  headings?: Heading[];
}

const { slug, headings = [] } = Astro.props;
const thread = slug ? threads[slug] : undefined;

// The footnotes section starts at the "Footnotes" heading (id
// `footnote-label`, injected by the remark footnotes plugin) — exclude it
// and everything after it so the outline never lists footnote content.
const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = rawToc.length >= 2;

// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
// under, so the client script can show only the active section's
// sub-headings instead of the full flat list.
let h2Count = 0;
let currentH2Slug: string | null = null;
const toc = rawToc.map((heading) => {
  if (heading.depth === 2) {
    h2Count += 1;
    currentH2Slug = heading.slug;
    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
  }
  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
});
---

<div class="reading-companion flex flex-col gap-3" data-reading-companion>
  {
    showToc && (
      <div
        class="reading-companion__block reading-companion__outline rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
        data-companion-outline
      >
        <div class="reading-companion__header font-mono flex items-center justify-between gap-2 px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
          <span>On this page</span>
          <button
            type="button"
            class="reading-companion__all-toggle focus-ring text-[var(--text-tertiary)] hover:text-[var(--accent)]"
            data-companion-all-toggle
            aria-pressed="false"
          >
            All sections
          </button>
        </div>

        <div class="reading-companion__body" data-companion-scroll>
          <div class="reading-companion__rail" aria-hidden="true">
            <div class="reading-companion__rail-fill" data-companion-fill />
          </div>
          <nav aria-label="Table of contents">
            <p class="reading-companion__more" data-companion-more="above" hidden />
            <ol class="reading-companion__list">
              {toc.map((heading) => (
                <li
                  class:list={['reading-companion__item', heading.depth === 3 && 'reading-companion__item--sub']}
                  data-companion-item
                  data-companion-depth={heading.depth}
                  data-companion-parent={heading.parentSlug ?? ''}
                >
                  <a
                    href={`#${heading.slug}`}
                    class="reading-companion__link"
                    data-companion-link
                    data-companion-target={heading.slug}
                  >
                    {heading.depth === 2 && (
                      <span class="reading-companion__index font-mono" aria-hidden="true">
                        {String(heading.sectionNumber).padStart(2, '0')}
                      </span>
                    )}
                    <span class="reading-companion__label line-clamp-2">{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="reading-companion__more" data-companion-more="below" hidden />
          </nav>
        </div>
      </div>
    )
  }

  {thread && slug && <ThreadDock slug={slug} />}

  {/* ContextualNote slot: intentionally empty (see header comment). */}
</div>

<style>
  .reading-companion__header {
    border-bottom: 1px solid var(--border-subtle);
  }

  .reading-companion__all-toggle {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .reading-companion__all-toggle[aria-pressed='true'] {
    color: var(--accent);
  }

  .reading-companion__body {
    position: relative;
    overflow-y: auto;
    padding: 0.75rem 0.5rem 0.75rem 0.75rem;
    scrollbar-width: none;
  }

  .reading-companion__body::-webkit-scrollbar {
    display: none;
  }

  .reading-companion__more {
    margin: 0 0 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-disabled);
  }

  .reading-companion__list + .reading-companion__more {
    margin: 0.25rem 0 0;
  }

  .reading-companion__rail {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background-color: var(--border-strong);
  }

  .reading-companion__rail-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    border-radius: 1px;
    background-color: var(--accent);
    transition: height 0.2s ease;
  }

  .reading-companion__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-companion__item--sub {
    display: none;
  }

  .reading-companion__item--sub.is-active-branch {
    display: block;
  }

  .reading-companion__link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    border-radius: 0.25rem;
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .reading-companion__item--sub .reading-companion__link {
    margin-left: 1rem;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }

  .reading-companion__index {
    flex-shrink: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
  }

  .reading-companion__label {
    min-width: 0;
  }

  .reading-companion__link:hover,
  .reading-companion__link:focus-visible {
    background-color: var(--accent-subtle);
    color: var(--text-primary);
    outline: none;
  }

  .reading-companion__link:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .reading-companion__item.is-visited .reading-companion__link {
    color: var(--text-tertiary);
  }

  .reading-companion__item.is-window-hidden {
    display: none;
  }

  .reading-companion__link[aria-current='location'] {
    background-color: var(--accent-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  .reading-companion__link[aria-current='location'] .reading-companion__index {
    color: var(--accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-companion__link,
    .reading-companion__rail-fill {
      transition: none;
    }
  }

  :global(html.perf-lite) .reading-companion__link,
  :global(html.perf-lite) .reading-companion__rail-fill {
    transition: none;
  }
</style>

<script>
  import { computeListWindow } from '../../lib/sidebar-window';

  /** Nearby-outline default window size before "All sections" is toggled. */
  const NEARBY_MAX_VISIBLE = 6;

  const initializeReadingCompanions = () => {
    document.querySelectorAll<HTMLElement>('[data-reading-companion]').forEach((root) => {
      if (root.dataset.readingCompanionReady === 'true') return;
      root.dataset.readingCompanionReady = 'true';

      const outline = root.querySelector<HTMLElement>('[data-companion-outline]');
      const allToggle = root.querySelector<HTMLButtonElement>('[data-companion-all-toggle]');
      const body = root.querySelector<HTMLElement>('[data-companion-scroll]');
      const rail = root.querySelector<HTMLElement>('[data-companion-fill]');
      const moreAbove = root.querySelector<HTMLElement>('[data-companion-more="above"]');
      const moreBelow = root.querySelector<HTMLElement>('[data-companion-more="below"]');
      const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-companion-item]'));

      if (!outline || !body || items.length === 0 || !('IntersectionObserver' in window)) return;

      const pairs = items
        .map((item) => {
          const link = item.querySelector<HTMLAnchorElement>('[data-companion-link]');
          const target = link ? document.getElementById(link.dataset.companionTarget ?? '') : null;
          return link && target ? { item, link, target } : null;
        })
        .filter((pair): pair is { item: HTMLLIElement; link: HTMLAnchorElement; target: HTMLElement } => pair !== null);

      if (pairs.length === 0) return;

      const reduceMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        document.documentElement.classList.contains('perf-lite');

      let allExpanded = false;
      let activeIndex = 0;

      const resolveSection = (targetId: string): string | null => {
        const pair = pairs.find((candidate) => candidate.target.id === targetId);
        if (!pair) return null;
        return pair.item.dataset.companionDepth === '2' ? targetId : pair.item.dataset.companionParent || null;
      };

      const setActiveBranch = (sectionSlug: string | null) => {
        items.forEach((item) => {
          if (item.dataset.companionDepth !== '3') return;
          item.classList.toggle('is-active-branch', item.dataset.companionParent === sectionSlug);
        });
      };

      const firstH2 = pairs.find((pair) => pair.item.dataset.companionDepth === '2');
      setActiveBranch(firstH2?.target.id ?? null);

      let lastFitSignature = '';
      const fitList = () => {
        const laidOut = pairs.filter(({ item }) => item.dataset.companionDepth === '2' || item.classList.contains('is-active-branch'));
        if (laidOut.length === 0) return;

        if (allExpanded) {
          if (lastFitSignature === 'expanded') return;
          lastFitSignature = 'expanded';
          laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
          moreAbove?.setAttribute('hidden', '');
          moreBelow?.setAttribute('hidden', '');
          return;
        }

        const panelTop = outline.getBoundingClientRect().top;
        const available = window.innerHeight - panelTop - 24;
        const laidOutActiveIndex = Math.max(0, laidOut.findIndex(({ target }) => pairs[activeIndex]?.target === target));
        const signature = `windowed:${available.toFixed(1)}:${laidOut.length}:${laidOutActiveIndex}`;
        if (signature === lastFitSignature) return;
        lastFitSignature = signature;

        laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));

--- src/components/content/ThreadDock.astro ---
---
/**
 * ThreadDock — the compact beat list inside `ReadingCompanion`, replacing
 * `ThreadRail`'s role there (ARCHITECTURE.md §5, DIRECTION.md V3/V5).
 *
 * P0-B ships this as static, server-rendered markup: every beat links to
 * its inline anchor in the essay, plus a per-beat "Explore" link straight
 * to that beat's Thread Focus route — both real links, so the dock works
 * fully without JavaScript. Follow/hold-preview behavior (V6's
 * "held preview" vs "reading" split) and any live active-beat styling
 * driven by a scroll/section observer are P1 (component-ownership table:
 * ThreadDock is P1) — this component accepts an optional `activeBeatId`
 * so a later P1/P0-C pass can set `aria-current="step"` on the matching
 * row without touching this file's markup, but nothing here computes that
 * value today.
 */
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  activeBeatId?: string;
}

const { slug, activeBeatId } = Astro.props;
const thread = threads[slug];
---

{
  thread && (
    <nav class="thread-dock" aria-label={`Running example: ${thread.title}`} data-thread-dock>
      <p class="thread-dock__eyebrow font-mono">Running example</p>
      <p class="thread-dock__title font-serif">{thread.title}</p>

      <ol class="thread-dock__list">
        {
          thread.beats.map((beat) => (
            <li class="thread-dock__item">
              <a
                href={`#thread-${beat.id}`}
                class="thread-dock__link"
                data-thread-dock-link
                data-beat-id={beat.id}
                aria-current={beat.id === activeBeatId ? 'step' : undefined}
              >
                <span class="thread-dock__number font-mono" aria-hidden="true">
                  {beat.n}
                </span>
                <span class="thread-dock__label">{beat.label}</span>
              </a>
              <a class="thread-dock__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
                Explore
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  )
}

<style>
  .thread-dock {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    padding: 0.875rem 0.875rem 0.75rem;
  }

  .thread-dock__eyebrow {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .thread-dock__title {
    margin: 0.2rem 0 0.6rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .thread-dock__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread-dock__item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .thread-dock__link {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: baseline;
    gap: 0.5rem;
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.4rem;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .thread-dock__link:hover,
  .thread-dock__link:focus-visible {
    background: var(--accent-subtle);
    color: var(--text-primary);
    outline: none;
  }

  .thread-dock__link:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .thread-dock__link[aria-current='step'] {
    background: var(--accent-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  .thread-dock__number {
    flex-shrink: 0;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-tertiary);
  }

  .thread-dock__link[aria-current='step'] .thread-dock__number {
    color: var(--accent-text);
  }

  .thread-dock__label {
    min-width: 0;
  }

  .thread-dock__explore {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    text-decoration: none;
    padding: 0.2rem 0.35rem;
  }

  .thread-dock__explore:hover,
  .thread-dock__explore:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

--- src/components/content/ThreadScene.astro ---
---
/**
 * ThreadScene — inline per-beat rendering for a post's running thread,
 * placed adjacent to matching prose at each of the six canonical anchors
 * (reading-experience-v2 DIRECTION.md V3/V7, ARCHITECTURE.md §4). It looks
 * up its own beat from `threads.ts` by `slug` + `beatId` and renders the
 * canonical figure, the one real recap paragraph, a semantic kind label,
 * and an "Explore thread" link to the standalone Thread Focus route.
 *
 * `ThreadFocus.astro` renders the fuller composition from the exact same
 * beat record — recap is written once in `threads.ts` and both surfaces
 * read it, never a second hand-written explanation (V3).
 *
 * `composition` follows DIRECTION V6's four main-pane types. `measure`
 * (default) keeps the scene inside the article's prose measure; `pane`
 * breaks the whole scene out wider, for the four dense technical PNGs
 * named in this essay's build brief (incident, deployment, drift,
 * outcome). `split`/`inset` are accepted for forward compatibility with
 * V6's full set — this essay's six scenes use only `measure`/`pane` today,
 * so those two get a lighter, documented treatment rather than a full
 * adjacent-content slot this component doesn't have a use for yet.
 */
import Figure from './Figure.astro';
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  beatId: string;
  composition?: 'measure' | 'pane' | 'split' | 'inset';
}

const { slug, beatId, composition = 'measure' } = Astro.props;
const thread = threads[slug];
const beat = thread?.beats.find((candidate) => candidate.id === beatId);

if (!thread || !beat) {
  console.warn(
    `[ThreadScene] Unable to resolve beat "${beatId}" for thread "${slug}". Rendering nothing.`,
  );
}

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};

// Restrained cyan/violet split (DIRECTION V10): conceptual/mechanism beats
// (the two boundary-flagged, non-historical kinds) get the cyan structural
// accent on their kind label; historical/proposed keep the primary violet
// accent used everywhere else in the thread.
const kindUsesCyan = beat?.kind === 'conceptual' || beat?.kind === 'mechanism';
---

{
  thread && beat && (
    <section
      id={`thread-${beat.id}`}
      class:list={[
        'thread-scene lift-hover',
        composition === 'pane' && 'thread-scene--pane',
        composition === 'split' && 'thread-scene--split',
        composition === 'inset' && 'thread-scene--inset',
      ]}
      aria-labelledby={`thread-${beat.id}-label`}
    >
      <span class="thread-scene__corner thread-scene__corner--tl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--tr" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--bl" aria-hidden="true" />
      <span class="thread-scene__corner thread-scene__corner--br" aria-hidden="true" />

      <div class="thread-scene__body">
        <div class="thread-scene__head">
          <p class="thread-scene__eyebrow font-mono">
            <span class="thread-scene__count">
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true" class="thread-scene__eyebrow-sep">
              &middot;
            </span>
            <span class:list={['thread-scene__kind', kindUsesCyan && 'thread-scene__kind--cyan']}>
              {kindLabel[beat.kind] ?? beat.kind}
            </span>
          </p>
          <h3 id={`thread-${beat.id}-label`} class="thread-scene__label font-serif">
            {beat.label}
          </h3>
        </div>

        <p class="thread-scene__recap">{beat.recap}</p>

        <Figure
          src={beat.image.src}
          alt={beat.image.alt}
          caption={beat.image.caption}
          number={String(beat.n).padStart(2, '0')}
          longDescription={beat.longDescription}
          figureId={beat.id}
          slug={slug}
          variant={composition === 'pane' ? 'technical' : 'inline'}
        />

        <a class="thread-scene__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
          Explore this thread beat <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .thread-scene {
    position: relative;
    margin: 2.75rem 0;
    padding: 1.375rem 1.5rem 1.5rem;
    border: 1px solid var(--border-strong);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    scroll-margin-top: 6rem;
  }

  .thread-scene--inset {
    margin: 2rem 0;
    padding: 1rem 1.25rem 1.25rem;
    border-style: dashed;
  }

  .thread-scene--split {
    background: var(--bg-subtle);
  }

  .thread-scene__corner {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--border-strong);
    opacity: 0.65;
    pointer-events: none;
  }

  .thread-scene__corner--tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .thread-scene__corner--tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
  .thread-scene__corner--bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
  .thread-scene__corner--br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; }

  .thread-scene__body {
    border-left: 2px solid var(--accent);
    padding-left: 1.125rem;
  }

  .thread-scene__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .thread-scene__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .thread-scene__eyebrow-sep {
    color: var(--text-tertiary);
  }

  .thread-scene__kind--cyan {
    color: var(--cyan-text);
  }

  .thread-scene__label {
    margin: 0.2rem 0 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .thread-scene__recap {
    margin: 0.85rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .thread-scene__body :global(.figure-plate) {
    margin: 1.25rem 0 0;
  }

  .thread-scene__explore {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }

  .thread-scene__explore:hover,
  .thread-scene__explore:focus-visible {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .thread-scene__explore:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Pane composition (V6): the whole scene breaks out wider than the prose
     measure, for the essay's four dense technical PNGs — same technique
     the existing figure-plate wide/technical variants use. */
  @media (min-width: 1024px) {
    .prose-custom > .thread-scene.thread-scene--pane {
      width: min(calc(100% + 6rem), calc(100vw - 2rem));
      max-width: none;
      margin-right: -3rem;
      margin-left: -3rem;
    }
  }
</style>

