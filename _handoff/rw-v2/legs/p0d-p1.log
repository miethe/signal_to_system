--- src/components/content/SectionMarker.astro ---
---
/**
 * SectionMarker — static editorial furniture for article-level headings.
 *
 * MDX supplies its headings through PostLayout's slot, so this component
 * enhances those rendered h2 elements once without attaching a scroll
 * observer. P1 owns the active-section state; this shell deliberately only
 * establishes the stable ordinal and reserved gutter.
 */
---

<script>
  const addSectionMarkers = () => {
    const headings = document.querySelectorAll<HTMLHeadingElement>(
      '.prose-custom > h2:not([data-section-marker-heading])',
    );

    headings.forEach((heading, index) => {
      const section = document.createElement('section');
      const gutter = document.createElement('div');
      const ordinal = document.createElement('span');
      const rule = document.createElement('span');

      section.className = 'section-marker';
      section.dataset.sectionMarker = '';
      section.dataset.sectionOrdinal = String(index + 1);
      gutter.className = 'section-marker__gutter';
      gutter.setAttribute('aria-hidden', 'true');
      ordinal.className = 'section-marker__ordinal';
      ordinal.textContent = String(index + 1).padStart(2, '0');
      rule.className = 'section-marker__rule';

      gutter.append(ordinal, rule);
      heading.dataset.sectionMarkerHeading = '';
      heading.parentNode?.insertBefore(section, heading);
      section.append(gutter, heading);
    });
  };

  addSectionMarkers();
  document.addEventListener('astro:page-load', addSectionMarkers);
</script>

<style>
  :global(.section-marker) {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 0.875rem;
    align-items: start;
    margin-top: 2.5rem;
  }

  :global(.section-marker__gutter) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.15rem;
  }

  :global(.section-marker__ordinal) {
    display: grid;
    width: 2.2rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 0.2rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  :global(.section-marker__rule) {
    display: block;
    width: 1px;
    min-height: 2.2rem;
    background: var(--border-strong);
  }

  :global(.section-marker > h2) {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    :global(.section-marker) {
      width: calc(100% + 3.875rem);
      margin-left: -3.875rem;
    }
  }
</style>

--- src/components/content/EvidenceFocus.astro ---
---
/**
 * EvidenceFocus — the shared Evidence Focus renderer (DIRECTION.md V3/V4,
 * ARCHITECTURE.md §4, spec §8). Backs BOTH `/essays/<slug>/evidence/`
 * (the essay-scoped index) and the flat, site-wide `/evidence/<record>/`
 * route, plus the in-place overlay's `<template>` fragment — same
 * component, same field set from `evidence.ts`'s `EvidenceRecord`, never
 * a second hand-written summary.
 *
 * `records` is always the full evidence set (so the rail's `ReceiptIndex`
 * can navigate anywhere); `selectedId` narrows the main pane to one
 * record's full detail. Omitting it renders the full list.
 */
import EvidenceGuide from './EvidenceGuide.astro';
import ReceiptIndex from './ReceiptIndex.astro';
import ClaimBadge from './ClaimBadge.astro';
import type { EvidenceRecord } from '../../data/evidence';

interface Props {
  records: EvidenceRecord[];
  selectedId?: string;
  /** Real anchor text for a "Read in essay" link, when a related essay exists. */
  essaySlug?: string;
  standalone?: boolean;
}

const { records, selectedId, essaySlug, standalone = true } = Astro.props;
// The essay index is a receipt surface, not a bare directory. When no record
// is named in the route, introduce the first related receipt in full and let
// the rail provide the rest of the index.
const selected = selectedId ? records.find((record) => record.id === selectedId) : records[0];
const selectedRecordId = selected?.id;
const receiptDate = selected?.recordedDate ?? selected?.eventDate ?? selected?.verifiedAt ?? null;
const claimBadgeKind = selected
  ? ({
      observed: 'observed',
      measured: 'measured',
      proposed: 'proposed',
      'externally-reported': 'external',
      illustrative: 'hypothesis',
    }[selected.evidenceClass] as 'observed' | 'measured' | 'proposed' | 'external' | 'hypothesis')
  : undefined;

const formatDate = (value: string | null) => value ?? 'Not stated';
---

<div class="evidence-focus" data-focus-kind="evidence" data-focus-key={selectedId ?? 'all'}>
  <div class="evidence-focus__grid">
    <div class="evidence-focus__main">
      <div class="evidence-focus__actions">
        {essaySlug && (
          <a class="evidence-focus__action" href={`/essays/${essaySlug}/`}>
            &larr; Back to essay
          </a>
        )}
        <span class="evidence-focus__action-label font-mono">Evidence focus</span>
        {essaySlug && (
          <a
            class="evidence-focus__action evidence-focus__action--secondary"
            href={`/essays/${essaySlug}/evidence/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in new tab
          </a>
        )}
        {!standalone && (
          <button type="button" class="evidence-focus__action evidence-focus__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      <h1 class="evidence-focus__page-title font-serif">
        {selectedId && selected ? selected.title : 'Receipts behind the argument'}
      </h1>

      {selected ? (
        <article class="evidence-focus__record">
          <p class="evidence-focus__eyebrow font-mono">
            {claimBadgeKind && <ClaimBadge kind={claimBadgeKind} />}
            <span>{selected.evidenceClass}</span>
          </p>
          {!selectedId && <h2 class="evidence-focus__title font-serif">{selected.title}</h2>}

          <p class="evidence-focus__receipt-date font-mono">
            Receipt date: {formatDate(receiptDate)}
          </p>

          <dl class="evidence-focus__facts">
            <div>
              <dt>Capture type</dt>
              <dd>{selected.captureType}</dd>
            </div>
            <div>
              <dt>Event date</dt>
              <dd>{formatDate(selected.eventDate)}</dd>
            </div>
            <div>
              <dt>Recorded date</dt>
              <dd>{formatDate(selected.recordedDate)}</dd>
            </div>
            <div>
              <dt>Verified at</dt>
              <dd>{formatDate(selected.verifiedAt)}</dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>{selected.sourceUrl ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Source revision</dt>
              <dd>{selected.sourceRevision ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Publicability</dt>
              <dd>{selected.publicability}</dd>
            </div>
          </dl>

          <div class="evidence-focus__claim-split">
            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">What this supports</p>
              <ul>
                {selected.supports.map((line) => <li>{line}</li>)}
              </ul>
            </div>

            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">Limits</p>
              <ul>
                {selected.limitations.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </div>

          {selected.publicCapturePath ? (
            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">Capture</p>
              <p class="evidence-focus__capture-path">{selected.publicCapturePath}</p>
            </div>
          ) : (
            <p class="evidence-focus__no-capture">
              No standalone capture asset is published for this record; its capture type is{' '}
              <strong>{selected.captureType}</strong>.
            </p>
          )}
        </article>
      ) : <p class="evidence-focus__intro">No public receipts are available for this essay.</p>}
    </div>

    <aside class="evidence-focus__rail">
      <EvidenceGuide />
      <ReceiptIndex records={records} currentId={selectedRecordId} />
    </aside>
  </div>
</div>

<style>
  .evidence-focus__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .evidence-focus__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .evidence-focus__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .evidence-focus__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .evidence-focus__action:hover,
  .evidence-focus__action:focus-visible {
    text-decoration: underline;
  }

  .evidence-focus__action-label {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .evidence-focus__action--secondary {
    color: var(--text-secondary);
  }

  .evidence-focus__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .evidence-focus__title {
    margin: 0.3rem 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .evidence-focus__page-title {
    margin: 0 0 0.35rem;
    color: var(--text-primary);
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.1;
  }

  .evidence-focus__receipt-date {
    margin: -0.35rem 0 1.25rem;
    color: var(--text-tertiary);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .evidence-focus__claim-split {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 700px) {
    .evidence-focus__claim-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .evidence-focus__facts {
    display: grid;
    gap: 0.75rem 1.5rem;
    margin: 0 0 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  @media (min-width: 560px) {
    .evidence-focus__facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .evidence-focus__facts dt {
    margin: 0 0 0.15rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .evidence-focus__facts dd {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-primary);
    word-break: break-word;
  }

  .evidence-focus__section {
    margin: 0 0 1.25rem;
  }

  .evidence-focus__section-label {
    margin: 0 0 0.35rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .evidence-focus__section ul {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .evidence-focus__capture-path {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .evidence-focus__no-capture {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .evidence-focus__intro {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .evidence-focus__list {
    display: flex;
    flex-direction: column;
  }

  .evidence-focus__list ol {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-focus__list-item a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
  }

  .evidence-focus__list-item a:hover,
  .evidence-focus__list-item a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

--- src/components/content/FigureViewer.astro ---
---
/**
 * FigureViewer — the shared figure-viewer renderer (DIRECTION.md V7,
 * ARCHITECTURE.md §4, spec §10). Backs both `/essays/<slug>/figure/<id>/`
 * and the in-place overlay's `<template>` fragment: exact asset, exact
 * caption, long description, and real file metadata read from disk at
 * build time — never a fabricated size or dimension (V1).
 *
 * `sharp` is already a project dependency (Astro's own image pipeline
 * uses it), so this reads genuine width/height via its metadata probe
 * rather than falling back to an undocumented guess; file size comes from
 * `fs.statSync`. A missing asset at build time leaves both fields `null`
 * — a labeled pending slot, not a substitute value.
 */
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);

let fileSizeBytes: number | null = null;
let width: number | null = null;
let height: number | null = null;

if (beat) {
  const absolutePath = path.join(process.cwd(), 'public', beat.image.src);
  try {
    const stat = fs.statSync(absolutePath);
    fileSizeBytes = stat.size;
    const metadata = await sharp(absolutePath).metadata();
    width = metadata.width ?? null;
    height = metadata.height ?? null;
  } catch {
    // Asset unreadable at build time — leave metadata null (V1: a missing
    // input stays a labeled pending slot, never a fabricated value).
  }
}

const formatBytes = (bytes: number | null) => {
  if (bytes === null) return 'Not available in this build';
  const kb = bytes / 1024;
  return kb >= 1024 ? `${(kb / 1024).toFixed(2)} MB` : `${kb.toFixed(1)} KB`;
};

const dimensionsLabel =
  width !== null && height !== null ? `${width} × ${height}px` : 'Not available in this build';

const filename = beat?.image.src.split('/').pop() ?? '';
---

{
  beat && (
    <div class="figure-viewer" data-focus-kind="figure" data-focus-key={beat.id}>
      <div class="figure-viewer__actions">
        <a class="figure-viewer__action" href={`/essays/${thread.slug}/`}>
          &larr; Back to essay
        </a>
        <a class="figure-viewer__action" href={`/essays/${thread.slug}/thread/${beat.id}/`}>
          &larr; Back to thread focus
        </a>
        <span class="figure-viewer__action-label font-mono">Figure viewer</span>
        <a class="figure-viewer__action figure-viewer__action--copy" href={`/essays/${thread.slug}/figure/${beat.id}/`} data-focus-copy-link>
          Copy link
        </a>
        {!standalone && (
          <button type="button" class="figure-viewer__action figure-viewer__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      <figure class="figure-viewer__figure">
        <img src={beat.image.src} alt={beat.image.alt} loading="lazy" decoding="async" />
        <figcaption>
          <p class="figure-viewer__caption">{beat.image.caption}</p>
          <p class="figure-viewer__long-description">{beat.longDescription}</p>
        </figcaption>
      </figure>

      <dl class="figure-viewer__metadata">
        <div>
          <dt>Filename</dt>
          <dd class="font-mono">{filename}</dd>
        </div>
        <div>
          <dt>File size</dt>
          <dd>{formatBytes(fileSizeBytes)}</dd>
        </div>
        <div>
          <dt>Dimensions</dt>
          <dd>{dimensionsLabel}</dd>
        </div>
      </dl>
    </div>
  )
}

<style>
  .figure-viewer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .figure-viewer__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .figure-viewer__action:hover,
  .figure-viewer__action:focus-visible {
    text-decoration: underline;
  }

  .figure-viewer__action-label {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .figure-viewer__action--close {
    color: var(--text-tertiary);
  }

  .figure-viewer__figure {
    margin: 0 0 1.5rem;
    padding: 1.25rem;
    background: #f6f8fb;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .figure-viewer__figure img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 0.875rem;
    border-radius: var(--radius-md);
  }

  .figure-viewer__caption {
    margin: 0 0 0.35rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #334155;
  }

  .figure-viewer__long-description {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #64748b;
  }

  .figure-viewer__metadata {
    display: grid;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  @media (min-width: 560px) {
    .figure-viewer__metadata {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .figure-viewer__metadata dt {
    margin: 0 0 0.15rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .figure-viewer__metadata dd {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-primary);
    word-break: break-word;
  }
</style>

--- src/lib/focus-host.ts ---
/**
 * FocusHost controller — reading-experience-v2 P0-C
 * (docs/blog-work/the-registry-wave-agentic-artifact-supply-chain/reading-experience-v2/ARCHITECTURE.md §3).
 *
 * Owns one native <dialog> (mounted by `FocusHost.astro`) that every
 * "Explore thread" / evidence / figure trigger on an essay page can open
 * in place, by cloning the matching `<template data-focus-view="kind:id">`
 * fragment `FocusTemplates.astro` already rendered on the page — never a
 * client fetch, never a second hand-written explanation of a beat/record.
 *
 * Every trigger is first and always a real `<a href>` to the standalone
 * route P0-B built (`/essays/<slug>/thread/<beat>/`, `/essays/<slug>/evidence/`,
 * `/evidence/<record>/`, `/essays/<slug>/figure/<id>/`). This module only
 * decides, on an unmodified primary click, whether to intercept that link
 * and render the matching template in the dialog instead of navigating —
 * derived from the clicked link's own `href` (a static route shape), never
 * from author-added `data-kind`/`data-key` markup. That keeps every
 * existing "Explore thread" / rail / prev-next / figure link correct by
 * construction: the standalone route and the overlay agree because they
 * are reading the same URL.
 *
 * History is owned directly (`pushState`/`replaceState`/one `popstate`
 * listener) rather than integrated with Astro ClientRouter, because
 * ClientRouter is not wired anywhere in this codebase today — see
 * ARCHITECTURE.md §1's correction to its own brief before changing this.
 */

type FocusKind = 'thread' | 'evidence' | 'figure';
type EntryKind = FocusKind | 'root';

interface FocusEntry {
  kind: EntryKind;
  id: string;
  parentKey: string | null;
  scrollTop: number;
  focusTargetId: string | null;
}

interface RootSnapshot {
  x: number;
  y: number;
  trigger: HTMLElement | null;
  /** A stable fallback focus target near `trigger`, in case it's gone by the time we restore. */
  headingId: string | null;
}

type FocusAction =
  | { type: 'open'; kind: FocusKind; id: string }
  | { type: 'back' }
  | { type: 'jump'; anchorId: string };

const THREAD_RE = /^\/essays\/([^/]+)\/thread\/([^/]+)\/?$/;
const EVIDENCE_INDEX_RE = /^\/essays\/([^/]+)\/evidence\/?$/;
const EVIDENCE_RECORD_RE = /^\/evidence\/([^/]+)\/?$/;
const FIGURE_RE = /^\/essays\/([^/]+)\/figure\/([^/]+)\/?$/;
const ESSAY_ROOT_RE = /^\/essays\/([^/]+)\/?$/;

/**
 * Reads the clicked link's own URL and returns what it means to FocusHost,
 * or `null` if it's none of its concern (an ordinary in-page anchor, an
 * external link, a route it doesn't own). Distinguishes "Back to essay"
 * from "Read this scene in the essay" purely by hash: the former is the
 * bare essay URL, the latter carries `#thread-<beatId>` — matching the two
 * links' actual, distinct hrefs (`ThreadFocus.astro`/`EvidenceFocus.astro`
 * write them differently on purpose).
 */
function parseFocusAction(pathname: string, hash: string): FocusAction | null {
  let match = THREAD_RE.exec(pathname);
  if (match) return { type: 'open', kind: 'thread', id: match[2] };

  match = FIGURE_RE.exec(pathname);
  if (match) return { type: 'open', kind: 'figure', id: match[2] };

  match = EVIDENCE_INDEX_RE.exec(pathname);
  if (match) return { type: 'open', kind: 'evidence', id: 'all' };

  match = EVIDENCE_RECORD_RE.exec(pathname);
  if (match) return { type: 'open', kind: 'evidence', id: match[1] };

  match = ESSAY_ROOT_RE.exec(pathname);
  if (match) {
    const anchorId = hash.replace(/^#/, '');
    if (anchorId.startsWith('thread-')) return { type: 'jump', anchorId };
    if (!hash) return { type: 'back' };
  }

  return null;
}

function reduceMotion(): boolean {
  return (
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    document.documentElement.classList.contains('perf-lite')
  );
}

export function initFocusHost(): void {
  const dialogEl = document.querySelector<HTMLDialogElement>('[data-focus-dialog]');
  if (!dialogEl || typeof dialogEl.showModal !== 'function') return;
  if (dialogEl.dataset.focusHostReady === 'true') return;
  dialogEl.dataset.focusHostReady = 'true';

  const essaySlug = dialogEl.dataset.essaySlug ?? '';
  const docToken = Math.random().toString(36).slice(2);

  const entries = new Map<string, FocusEntry>();
  let seq = 0;
  let rootKey: string | null = null;
  let currentKey: string | null = null;
  let origin: RootSnapshot | null = null;
  let historyCapable = true;
  let pendingAfterRestore: (() => void) | null = null;
  let previousBodyStyle: string | null = null;

  const generateKey = (): string => {
    seq += 1;
    return `focus-${seq}`;
  };

  const stateFor = (key: string): Record<string, unknown> => ({
    ...((history.state as Record<string, unknown> | null) ?? {}),
    rwFocus: { doc: docToken, key },
  });

  const writeHistory = (method: 'pushState' | 'replaceState', state: unknown, url: string): boolean => {
    try {
      history[method](state, '', url);
      return true;
    } catch {
      historyCapable = false;
      return false;
    }
  };

  const isOwnHistoryState = (key: string | null): boolean => {
    const state = history.state as { rwFocus?: { doc: string; key: string } } | null;
    return Boolean(key) && state?.rwFocus?.doc === docToken && state?.rwFocus?.key === key;
  };

  const localHref = (kind: FocusKind, id: string): string => {
    switch (kind) {
      case 'thread':
        return `/essays/${essaySlug}/thread/${id}/`;
      case 'figure':
        return `/essays/${essaySlug}/figure/${id}/`;
      case 'evidence':
        return id === 'all' ? `/essays/${essaySlug}/evidence/` : `/evidence/${id}/`;
    }
  };

  const templateFor = (kind: EntryKind, id: string): HTMLTemplateElement | null => {
    if (kind === 'root') return null;
    const safeId = id.replace(/"/g, '\\"');
    return document.querySelector<HTMLTemplateElement>(
      `[data-focus-templates] template[data-focus-view="${kind}:${safeId}"]`,
    );
  };

  const closePrivateFigureLightboxes = () => {
    // Hard invariant (ARCHITECTURE.md §3 risk 3): Figure.astro's own private
    // lightbox and this shared dialog must never both be open at once.
    document.querySelectorAll<HTMLDialogElement>('[data-figure-dialog][open]').forEach((lightbox) => {
      lightbox.close();
    });
  };

  const lockScroll = () => {
    const y = window.scrollY;
    previousBodyStyle = document.body.getAttribute('style');
    document.body.style.position = 'fixed';
    document.body.style.top = `-${y}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
  };

  const unlockScroll = () => {
    if (previousBodyStyle === null) {
      document.body.removeAttribute('style');
    } else {
      document.body.setAttribute('style', previousBodyStyle);
    }
    previousBodyStyle = null;
  };

  const captureOrigin = (trigger: HTMLElement | null): RootSnapshot => ({
    x: window.scrollX,
    y: window.scrollY,
    trigger,
    headingId: trigger?.closest('section')?.querySelector('h2, h3')?.id ?? null,
  });

  const saveCurrentEntryState = () => {
    if (!currentKey) return;
    const entry = entries.get(currentKey);
    if (!entry) return;
    entry.scrollTop = dialogEl.scrollTop;
    const active = document.activeElement;
    if (active instanceof HTMLElement && dialogEl.contains(active)) {
      const token = active.dataset.focusToken ?? `ft-${++seq}`;
      active.dataset.focusToken = token;
      entry.focusTargetId = token;
    } else {
      entry.focusTargetId = null;
    }
  };

  const focusEntryTitle = (entry: FocusEntry, isRestore: boolean) => {
    requestAnimationFrame(() => {
      // The dialog's accessible name always comes from the view's own
      // title, regardless of what was focused when the entry was saved.
      const title = dialogEl.querySelector<HTMLElement>('h2, h3');
      if (title) {
        if (!title.id) title.id = `focus-host-title-${++seq}`;
        dialogEl.setAttribute('aria-labelledby', title.id);
      } else {
        dialogEl.removeAttribute('aria-labelledby');
      }

      // Initial focus target: the element that had focus when this entry
      // was last left (restore), else the title itself (fresh open) — never
      // a giant aria-describedby wrapper.
      let target: HTMLElement | null = null;
      if (isRestore && entry.focusTargetId) {
        target = dialogEl.querySelector<HTMLElement>(`[data-focus-token="${entry.focusTargetId}"]`);
      }
      if (!target) target = title;
      if (target) {
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }
    });
  };

  const renderEntry = (entry: FocusEntry, isRestore: boolean) => {
    const template = templateFor(entry.kind, entry.id);
    if (!template) return;
    dialogEl.replaceChildren(template.content.cloneNode(true));
    if (!dialogEl.open) dialogEl.showModal();
    dialogEl.scrollTop = isRestore ? entry.scrollTop : 0;
    focusEntryTitle(entry, isRestore);
  };

  const restoreFocusToOrigin = (snapshot: RootSnapshot | null) => {
    if (snapshot?.trigger?.isConnected) {
      snapshot.trigger.focus({ preventScroll: true });
      return;
    }
    const fallback =
      (snapshot?.headingId ? document.getElementById(snapshot.headingId) : null) ??
      document.querySelector<HTMLElement>('article h1') ??
      document.querySelector<HTMLElement>('h1');
    if (fallback) {
      if (!fallback.hasAttribute('tabindex')) fallback.setAttribute('tabindex', '-1');
      fallback.focus({ preventScroll: true });
    }
  };

  const restoreRoot = (afterRestore?: () => void) => {
    if (dialogEl.open) dialogEl.close();
    unlockScroll();
    const snapshot = origin;
    if (snapshot) window.scrollTo(snapshot.x, snapshot.y);
    entries.clear();
    currentKey = null;
    rootKey = null;
    requestAnimationFrame(() => {
      if (afterRestore) afterRestore();
      else restoreFocusToOrigin(snapshot);
    });
  };

  const jump = (anchorId: string) => {
    const target = document.getElementById(anchorId);
    if (!target) return;
    writeHistory('replaceState', history.state, `#${anchorId}`);
    target.scrollIntoView({ block: 'start', behavior: reduceMotion() ? 'auto' : 'smooth' });
    const heading = target.querySelector<HTMLElement>('h2, h3') ?? target;
    requestAnimationFrame(() => {
      if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1');
      heading.focus({ preventScroll: true });
    });
  };

  const closeOne = () => {
    if (!dialogEl.open) return;
    saveCurrentEntryState();
    if (historyCapable && isOwnHistoryState(currentKey)) {
      history.back();
      return;
    }
    const current = currentKey ? entries.get(currentKey) : null;
    const parentKey = current?.parentKey ?? null;
    if (parentKey && parentKey !== rootKey && entries.has(parentKey)) {
      currentKey = parentKey;
      renderEntry(entries.get(parentKey) as FocusEntry, true);
    } else {
      restoreRoot();
    }
  };

  const closeAll = (afterRestore?: () => void) => {
    if (!dialogEl.open) {
      afterRestore?.();
      return;
    }
    saveCurrentEntryState();
    let depth = 0;
    let key = currentKey;
    while (key && key !== rootKey) {
      depth += 1;
      key = entries.get(key)?.parentKey ?? null;
    }
    if (historyCapable && depth > 0 && key === rootKey && isOwnHistoryState(currentKey)) {
      pendingAfterRestore = afterRestore ?? null;
      history.go(-depth);
      return;
    }
    restoreRoot(afterRestore);
  };

  const open = (kind: FocusKind, id: string, trigger: HTMLElement | null): boolean => {
    const template = templateFor(kind, id);
    if (!template) return false;

    closePrivateFigureLightboxes();

    const wasOpen = dialogEl.open;

    if (!wasOpen) {
      const candidateRootKey = generateKey();
      if (!writeHistory('replaceState', stateFor(candidateRootKey), window.location.href)) return false;
      origin = captureOrigin(trigger);
      rootKey = candidateRootKey;
      entries.clear();
      entries.set(rootKey, { kind: 'root', id: '', parentKey: null, scrollTop: 0, focusTargetId: null });
      currentKey = rootKey;
    } else {
      saveCurrentEntryState();
    }

    const current = currentKey ? entries.get(currentKey) ?? null : null;

    // Clicking a link back to this entry's own parent (e.g. FigureViewer's
    // "Back to thread focus" reached via Thread → Figure) is a pop, not a
    // fresh push — the destination already exists one level up.
    if (current?.parentKey) {
      const parent = entries.get(current.parentKey);
      if (parent && parent.kind === kind && parent.id === id) {
        closeOne();
        return true;
      }
    }

    const currentKind: EntryKind | undefined = current?.kind;
    const isSwap = currentKind !== undefined && currentKind !== 'root' && currentKind === kind;

    if (isSwap && current && currentKey) {
      if (!writeHistory('replaceState', stateFor(currentKey), localHref(kind, id))) {
        if (!wasOpen) restoreRoot();

--- src/styles/global.css ---
@import "tailwindcss";

/* Bind Tailwind's `dark:` variant to the site's own `.dark` class instead of
   the OS `prefers-color-scheme` media query (reading-experience-v2 FIX-LIST
   A1). Without this, every `dark:` utility in the project (370+) is inert
   whenever the reader's OS theme disagrees with the theme they picked on the
   site. */
@custom-variant dark (&:where(.dark, .dark *));

/* Include @miethe/ui compiled classes in Tailwind's content scan.
   Without this, showcase demos render unstyled (Tailwind v4 JIT prunes them). */
@source "../../node_modules/@miethe/ui/dist/**/*.js";

/* ============================================================
   THEME TOKENS
   Tailwind v4 custom properties via @theme
   ============================================================ */

@theme {
  /* --- Font Families --- */
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-serif: "Noto Serif", ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
  --font-mono: "Space Grotesk", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, monospace;

  /* --- Spacing scale extensions --- */
  --spacing-18: 4.5rem;
  --spacing-22: 5.5rem;
  --spacing-prose: 72ch;

  /* --- Border radius --- */
  --radius-xs: 0.125rem;
  --radius-sm: 0.25rem;
  --radius-md: 0.375rem;
  --radius-lg: 0.5rem;
  --radius-xl: 0.75rem;
  --radius-2xl: 1rem;
  --radius-pill: 9999px;

  /* --- Shadows --- */
  --shadow-ambient: var(--shadow-ambient);

  /* --- Brand color scales (light-mode defaults) --- */
  /* Backgrounds */
  --color-bg-base: #ffffff;
  --color-bg-subtle: #f8fafc;
  --color-bg-muted: #f1f5f9;
  --color-bg-surface: #ffffff;
  --color-bg-overlay: rgba(15, 23, 42, 0.6);

  /* Borders */
  --color-border-subtle: #e2e8f0;
  --color-border-default: #cbd5e1;
  --color-border-strong: #94a3b8;

  /* Text */
  --color-text-primary: #0f172a;
  --color-text-secondary: #334155;
  --color-text-tertiary: #64748b;
  --color-text-disabled: #94a3b8;
  --color-text-inverse: #f8fafc;

  /* Accent — indigo/blue family */
  --color-accent-50: #eef2ff;
  --color-accent-100: #e0e7ff;
  --color-accent-200: #c7d2fe;
  --color-accent-300: #a5b4fc;
  --color-accent-400: #818cf8;
  --color-accent-500: #6366f1;
  --color-accent-600: #4f46e5;
  --color-accent-700: #4338ca;
  --color-accent-800: #3730a3;
  --color-accent-900: #312e81;

  /* Semantic accent aliases */
  --color-accent: #4f46e5;
  --color-accent-hover: #4338ca;
  --color-accent-subtle: #eef2ff;
  --color-accent-muted: #e0e7ff;

  /* Neutrals for dark backgrounds */
  --color-slate-900: #0f172a;
  --color-slate-850: #111827;
  --color-slate-800: #1e293b;
  --color-slate-700: #334155;
  --color-slate-600: #475569;
  --color-slate-500: #64748b;
  --color-slate-400: #94a3b8;
  --color-slate-300: #cbd5e1;
  --color-slate-200: #e2e8f0;
  --color-slate-100: #f1f5f9;
  --color-slate-50: #f8fafc;

  /* Code block */
  --color-code-bg: #1e293b;
  --color-code-bg-inline: #f1f5f9;
  --color-code-text: #e2e8f0;
  --color-code-border: #334155;
}

/* ============================================================
   COLOR-SCHEME CUSTOM PROPERTIES
   :root = light mode,  .dark = dark mode
   ============================================================ */

:root {
  color-scheme: light;

  --bg-base:       #ffffff;
  --bg-subtle:     #f8fafc;
  --bg-muted:      #f1f5f9;
  --bg-surface:    #ffffff;

  --border-subtle: #e2e8f0;
  --border:        #cbd5e1;
  --border-strong: #94a3b8;

  --text-primary:   #0f172a;
  --text-secondary: #334155;
  --text-tertiary:  #64748b;
  --text-disabled:  #94a3b8;
  --text-inverse:   #f8fafc;

  --accent:         #6366f1;
  --accent-hover:   #4f46e5;
  --accent-subtle:  #e0e7ff;
  --accent-muted:   #c7d2fe;
  --accent-text:    #3730a3;

  /* Restrained cyan structural accent (reading-experience-v2 DIRECTION V10,
     from $H/contracts/design-tokens.css's --cyan). Used sparingly, next to
     violet, for mechanism/detection-flavored structure (kind labels, the
     figure-viewer chrome) — never as a second primary accent. */
  --cyan:           #0e7490;
  --cyan-text:      #0e7490;
  --cyan-subtle:    #ecfeff;

  --code-bg:        #f1f5f9;
  --code-bg-block:  #f8fafc;
  --code-text:      #0f172a;
  --code-text-block:#334155;
  --code-border:    #cbd5e1;

  --shadow-sm:  0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow:     0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --shadow-md:  0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg:  0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-ambient: 0px 32px 64px -12px rgba(11, 19, 38, 0.06);

  /* Hover lift (see the HOVER LIFT section). Back-out curve overshoots
     slightly then settles — the "bounce". */
  --lift-y: -2px;
  --lift-duration: 200ms;
  --lift-ease: cubic-bezier(0.34, 1.4, 0.64, 1);
  --lift-shadow:
    0 2px 4px rgba(15, 23, 42, 0.05),
    0 14px 30px -12px rgba(15, 23, 42, 0.22);
}

.dark {
  color-scheme: dark;

  --bg-base:       #0b1326;
  --bg-subtle:     #131b2e;
  --bg-muted:      #171f33;
  --bg-surface:    #222a3d;

  --border-subtle: rgba(70, 69, 84, 0.15); /* outline-variant at 15% */
  --border:        #464554;
  --border-strong: #908fa0;

  --text-primary:   #dae2fd;
  --text-secondary: #c7c4d7;
  --text-tertiary:  #908fa0;
  --text-disabled:  #464554;
  --text-inverse:   #0b1326;

  --accent:         #c0c1ff;
  --accent-hover:   #8083ff;
  --accent-subtle:  #464554;
  --accent-muted:   #6f00be;
  --accent-text:    #c0c1ff;

  /* Restrained cyan structural accent — matches Tier A's midnight/navy/
     violet/cyan language (see the :root block above for the rationale). */
  --cyan:           #82d3ec;
  --cyan-text:      #82d3ec;
  --cyan-subtle:    rgba(130, 211, 236, 0.14);

  --code-bg:        #131b2e;
  --code-bg-block:  #060e20;
  --code-text:      #c7c4d7;
  --code-text-block:#dae2fd;
  --code-border:    rgba(70, 69, 84, 0.15);

  --shadow-sm:  0 1px 2px 0 rgb(0 0 0 / 0.3);
  --shadow:     0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.3);
  --shadow-md:  0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.3);
  --shadow-lg:  0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.4);
  --shadow-ambient: 0px 32px 64px -12px rgba(11, 19, 38, 0.4);

  /* A black drop shadow reads as dirt on a navy page, so the dark-mode lift
     is a faint accent ring plus a coloured glow instead. */
  --lift-shadow:
    0 0 0 1px rgba(192, 193, 255, 0.16),
    0 16px 34px -14px rgba(111, 0, 190, 0.5);
}

/* ============================================================
   BASE STYLES
   ============================================================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

.material-symbols-outlined {
  font-family: 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  font-size: 24px;  /* Preferred icon size */
  display: inline-block;
  line-height: 1;
  text-transform: none;
  letter-spacing: normal;
  word-wrap: normal;
  white-space: nowrap;
  direction: ltr;
  /* Support for all WebKit browsers. */
  -webkit-font-smoothing: antialiased;
  /* Support for Safari and Chrome. */
  text-rendering: optimizeLegibility;
  /* Support for Firefox. */
  -moz-osx-font-smoothing: grayscale;
  /* Support for IE. */
  font-feature-settings: 'liga';
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

html {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
  tab-size: 2;
}

body {
  background-color: var(--bg-base);
  color: var(--text-primary);
  min-height: 100dvh;
  transition:
    background-color 200ms ease,
    color 200ms ease;
}

/* Smooth color transitions for interactive elements */
a,
button,
input,
textarea,
select,
[role="button"] {
  transition:
    color 150ms ease,
    background-color 150ms ease,
    border-color 150ms ease,
    box-shadow 150ms ease,
    opacity 150ms ease;
}

/* --- Scrollbar (dark mode) --- */
@media (prefers-color-scheme: dark) {
  :root:not(.light) {
    scrollbar-color: #334155 #0f172a;
    scrollbar-width: thin;
  }
}

.dark {
  scrollbar-color: #334155 #0f172a;
  scrollbar-width: thin;
}

.dark ::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.dark ::-webkit-scrollbar-track {
  background: #0f172a;
}

.dark ::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 4px;
}

.dark ::-webkit-scrollbar-thumb:hover {
  background: #475569;
}

/* An overflow region that should never show a track — used where layout is
   designed to fit without scrolling and overflow:auto is kept only as an
   invisible fallback (e.g. the post sidebar rail). */
.no-scrollbar {
  scrollbar-width: none;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

/* --- Typography base --- */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-serif);
  font-weight: 700;
  line-height: 1.25;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

h1 { font-size: 2.25rem; }
h2 { font-size: 1.75rem; }
h3 { font-size: 1.375rem; }
h4 { font-size: 1.125rem; }
h5 { font-size: 1rem; }
h6 { font-size: 0.875rem; }

p {
  color: var(--text-secondary);
  margin-top: 0;
  margin-bottom: 1.25rem;
}

a {
  color: var(--accent);
  text-decoration: none;
}

a:hover {
  color: var(--accent-hover);
  text-decoration: underline;
  text-underline-offset: 3px;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 2rem 0;

