              <a
                href={`/tags/${tag}`}
                class="rounded-full bg-[var(--bg-muted)] px-3 py-0.5 text-xs font-medium text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-surface)] hover:text-[var(--text-secondary)]"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <!-- Desktop rail follows the header in source order and spans the
         article column. Reading-experience-v2 DIRECTION.md V5: the author
         card sits in flow here and scrolls away with the page; only
         ReadingCompanion (outline + ThreadDock + optional ContextualNote)
         is the sticky surface at depth. -->
    <div
      class:list={[
        'hidden xl:col-start-2 xl:row-span-2 xl:block xl:self-stretch',
        isRegistryWave ? 'xl:row-start-1' : isFrontispiece ? 'xl:row-start-2' : 'xl:row-start-1',
      ]}
    >
      <div class="mb-4">
        <AuthorProfile variant="sidebar" headingLevel="h2" />
      </div>
      {
        whyItMatters && (
          <div class="mb-4">
            <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
          </div>
        )
      }
      <div class="xl:sticky xl:top-24 xl:pr-1">
        <ReadingCompanion slug={slug} headings={headings} />
      </div>
    </div>

    <div
      class:list={[
        'min-w-0 xl:col-start-1',
        isRegistryWave ? 'xl:row-start-3' : isFrontispiece ? 'xl:row-start-3' : 'xl:row-start-2',
      ]}
    >

    <!-- Compact author context remains in the reading flow below desktop. -->
    <div class="mb-10 xl:hidden">
      <AuthorProfile variant="compact" headingLevel="h2" />
    </div>

    <!-- Hero illustration (engineering plate) — the frontispiece position
         (above the header) is rendered earlier and skips this slot. -->
    {
      !isFrontispiece && heroImage && (
        <Figure
          src={heroImage}
          alt={resolvedHeroAlt}
          variant="hero"
        />
      )
    }

    <!-- The narrow layout has no rail, so it keeps the signal in flow here.
         Desktop places the same single signal under the author card above. -->
    {
      whyItMatters && (
        <div class="xl:hidden">
  border-radius: 9999px;
  background-color: var(--accent-subtle);
  color: var(--accent-text);
  border: 1px solid var(--accent-muted);
  text-decoration: none;
  transition: background-color 150ms ease, border-color 150ms ease;
}

.tag:hover {
  background-color: var(--accent-muted);
  text-decoration: none;
}

/* Focus ring utility.
   No border-radius here: the outline follows each element's own rounding, so
   applying .focus-ring to a rounded-lg button no longer reshapes it on focus. */
.focus-ring:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Skip-to-content link (accessibility) */
.skip-link {
  position: absolute;
  top: -100%;
  left: 1rem;
  z-index: 9999;
  padding: 0.5rem 1rem;
  background-color: var(--accent);
  color: var(--text-inverse);
  font-weight: 600;
  border-radius: 0 0 0.375rem 0.375rem;
  text-decoration: none;
  transition: top 200ms ease;
}

.skip-link:focus {
  top: 0;
}

/* Reading progress / prose container */
.prose-container {
  width: 100%;
  max-width: var(--measure, 72ch);
  margin-inline: auto;
  padding-inline: 1.5rem;
}

/* Truncate text to N lines */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================================
   PERFORMANCE LITE MODE
   Disable all transitions and animations when user has opted in
   to reduced-motion or toggled lite mode.
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

.perf-lite *,
  a.wayfind--arc:hover {
    background: var(--accent-muted);
  }

  .dark a.wayfind--arc:hover {
    background: rgba(192, 193, 255, 0.16);
  }
}

a.wayfind:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* No series page to link to — same chip, no affordance. */
.wayfind--static {
  cursor: default;
}

@media (max-width: 640px) {
  .wayfind {
    font-size: 0.78125rem;
  }
}

/* ============================================================
   LEADER TAKEAWAY CARD
   The post-level executive summary (frontmatter `leaderTakeaway`),
   rendered by components/content/LeaderTakeaway.astro. Lives here
   rather than in a scoped block because it needs `.dark` rules.
   ============================================================ */

.leader-takeaway {
  position: relative;
  overflow: hidden;
  margin: 0 0 1.75rem;
  padding: 1.125rem 1.25rem 1.1875rem 1.5rem;
  border: 1px solid var(--border-subtle);
  border-radius: 0.75rem;
  background:
    linear-gradient(
      135deg,
      rgba(99, 102, 241, 0.07) 0%,
      rgba(99, 102, 241, 0) 58%
    ),
    var(--bg-surface);
  box-shadow:
    0 1px 2px rgba(15, 23, 42, 0.04),
    0 10px 24px -14px rgba(15, 23, 42, 0.16);
}


