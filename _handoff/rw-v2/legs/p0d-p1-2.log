  --border-subtle: #e2e8f0;
  --border:        #cbd5e1;
  --border-strong: #94a3b8;

  --text-primary:   #0f172a;
  --text-secondary: #334155;
  --text-tertiary:  #64748b;
  --text-disabled:  #94a3b8;
  --text-inverse:   #f8fafc;

  --accent:         #6366f1;
  --accent-hover:   #4f46e5;
  --accent-subtle:  #e0e7ff;
  --accent-muted:   #c7d2fe;
  --accent-text:    #3730a3;

  /* Restrained cyan structural accent (reading-experience-v2 DIRECTION V10,
     from $H/contracts/design-tokens.css's --cyan). Used sparingly, next to
     violet, for mechanism/detection-flavored structure (kind labels, the
     figure-viewer chrome) — never as a second primary accent. */
  --cyan:           #0e7490;
  --cyan-text:      #0e7490;
  --cyan-subtle:    #ecfeff;

  --code-bg:        #f1f5f9;
  --code-bg-block:  #f8fafc;
  --code-text:      #0f172a;
  --code-text-block:#334155;
  --code-border:    #cbd5e1;

  --shadow-sm:  0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow:     0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --shadow-md:  0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg:  0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-ambient: 0px 32px 64px -12px rgba(11, 19, 38, 0.06);

  /* Hover lift (see the HOVER LIFT section). Back-out curve overshoots
     slightly then settles — the "bounce". */
  --lift-y: -2px;
  --lift-duration: 200ms;
  --lift-ease: cubic-bezier(0.34, 1.4, 0.64, 1);
  --lift-shadow:
    0 2px 4px rgba(15, 23, 42, 0.05),
    0 14px 30px -12px rgba(15, 23, 42, 0.22);
}

.dark {
  color-scheme: dark;

  --bg-base:       #0b1326;
  --bg-subtle:     #131b2e;
  --bg-muted:      #171f33;
  --bg-surface:    #222a3d;

  --border-subtle: rgba(70, 69, 84, 0.15); /* outline-variant at 15% */
  --border:        #464554;
  --border-strong: #908fa0;

  --text-primary:   #dae2fd;
  --text-secondary: #c7c4d7;
  --text-tertiary:  #908fa0;
  --text-disabled:  #464554;
  --text-inverse:   #0b1326;

  --accent:         #c0c1ff;
  --accent-hover:   #8083ff;
  --accent-subtle:  #464554;
  --accent-muted:   #6f00be;
  --accent-text:    #c0c1ff;

  /* Restrained cyan structural accent — matches Tier A's midnight/navy/
     violet/cyan language (see the :root block above for the rationale). */
  --cyan:           #82d3ec;
  --cyan-text:      #82d3ec;
  --cyan-subtle:    rgba(130, 211, 236, 0.14);

  --code-bg:        #131b2e;
  --code-bg-block:  #060e20;
  --code-text:      #c7c4d7;
  --code-text-block:#dae2fd;
  --code-border:    rgba(70, 69, 84, 0.15);

  --shadow-sm:  0 1px 2px 0 rgb(0 0 0 / 0.3);
  --shadow:     0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.3);
  --shadow-md:  0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.3);
  --shadow-lg:  0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.4);
  --shadow-ambient: 0px 32px 64px -12px rgba(11, 19, 38, 0.4);

  /* A black drop shadow reads as dirt on a navy page, so the dark-mode lift
     is a faint accent ring plus a coloured glow instead. */
  --lift-shadow:
    0 0 0 1px rgba(192, 193, 255, 0.16),
    0 16px 34px -14px rgba(111, 0, 190, 0.5);
}

/* ============================================================
   BASE STYLES
   ============================================================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

.material-symbols-outlined {
  font-family: 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  font-size: 24px;  /* Preferred icon size */
  display: inline-block;
  line-height: 1;
  text-transform: none;
  letter-spacing: normal;
  word-wrap: normal;
  white-space: nowrap;
  direction: ltr;
  /* Support for all WebKit browsers. */
  -webkit-font-smoothing: antialiased;
  /* Support for Safari and Chrome. */
  text-rendering: optimizeLegibility;
  /* Support for Firefox. */
  -moz-osx-font-smoothing: grayscale;
  /* Support for IE. */
  font-feature-settings: 'liga';
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

html {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
  tab-size: 2;
}

body {
  background-color: var(--bg-base);
  color: var(--text-primary);
  min-height: 100dvh;
  transition:
    background-color 200ms ease,
    color 200ms ease;
}


