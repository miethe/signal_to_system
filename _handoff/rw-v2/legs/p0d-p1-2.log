    pointer-events: none;
  }

  .thread-scene__corner--tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .thread-scene__corner--tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
  .thread-scene__corner--bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
  .thread-scene__corner--br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; }

  .thread-scene__body {
    border-left: 2px solid var(--accent);
