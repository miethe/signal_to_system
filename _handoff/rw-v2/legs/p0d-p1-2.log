+<script>
+  const initThreadDocks = () => {
+    document.querySelectorAll<HTMLElement>('[data-thread-dock]').forEach((dock) => {
+      if (dock.dataset.threadDockReady === 'true') return;
+      dock.dataset.threadDockReady = 'true';
+      const content = dock.querySelector<HTMLElement>('[data-thread-dock-content]');
+      const toggle = dock.querySelector<HTMLButtonElement>('[data-thread-dock-toggle]');
+      const state = dock.querySelector<HTMLElement>('[data-thread-dock-state]');
+      let heldId: string | null = null;
+      let readingId: string | null = null;
+      toggle?.addEventListener('click', () => {
+        const collapsed = !content?.hidden;
+        if (content) content.hidden = collapsed;
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.textContent = collapsed ? 'Expand' : 'Collapse';
+      });
+      dock.querySelectorAll<HTMLButtonElement>('[data-thread-dock-hold]').forEach((button) => {
+        button.addEventListener('click', () => {
+          const id = button.dataset.beatId ?? null;
+          heldId = heldId === id ? null : id;
+          dock.querySelectorAll<HTMLButtonElement>('[data-thread-dock-hold]').forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate.dataset.beatId === heldId)));
+          update();
+        });
+      });
+      const update = () => {
+        const label = (id: string | null) => dock.querySelector<HTMLElement>(`[data-beat-id="${id}"] .thread-dock__label`)?.textContent ?? 'Last thread scene';
+        if (state) state.textContent = heldId && readingId && heldId !== readingId ? `Held preview: ${label(heldId)} · Reading: ${label(readingId)}` : heldId ? `Held preview: ${label(heldId)}` : readingId ? `Reading: ${label(readingId)}` : 'Following reading';
+        dock.querySelectorAll<HTMLAnchorElement>('[data-thread-dock-link]').forEach((link) => link.toggleAttribute('aria-current', !heldId && link.dataset.beatId === readingId));
+      };
+      document.addEventListener('reading-section-change', ((event: CustomEvent<{ activeId: string }>) => {
+        const id = event.detail.activeId.replace(/^thread-/, '');
+        if (dock.querySelector(`[data-beat-id="${id}"]`)) { readingId = id; update(); }
+      }) as EventListener);
+    });
+  };
+  initThreadDocks();
+  document.addEventListener('astro:page-load', initThreadDocks);
+</script>

