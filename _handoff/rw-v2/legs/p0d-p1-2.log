.figure-plate__corner--tl { top: 7px; left: 7px;  border-right: 0; border-bottom: 0; }
.figure-plate__corner--tr { top: 7px; right: 7px; border-left: 0;  border-bottom: 0; }
.figure-plate__corner--bl { bottom: 7px; left: 7px;  border-right: 0; border-top: 0; }
.figure-plate__corner--br { bottom: 7px; right: 7px; border-left: 0;  border-top: 0; }

/* Image frame inside the plate — reset any inherited prose-custom img styling */
.figure-plate__frame {
  position: relative;
  border-radius: 0.375rem;
  overflow: hidden;
  background: #ffffff;
}

.figure-plate__enlarge {
  position: relative;
  display: block;
  color: var(--text-primary);
  cursor: zoom-in;
}

.figure-plate__enlarge:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 3px;
}

.figure-plate__enlarge-affordance {
  position: absolute;
  top: 0.625rem;
  right: 0.625rem;
  display: grid;
  width: 2rem;
  height: 2rem;
  place-items: center;
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  opacity: 0;
  transition: opacity 150ms ease;
}

.figure-plate__enlarge:hover .figure-plate__enlarge-affordance,
.figure-plate__enlarge:focus-visible .figure-plate__enlarge-affordance {
  opacity: 0.9;
}

.figure-plate__frame img,
.prose-custom .figure-plate__frame img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0;
  border: 0;
  border-radius: 0.375rem;
  box-shadow: none;
}

