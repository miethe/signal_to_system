---
import BaseLayout from './BaseLayout.astro';
import Figure from '../components/content/Figure.astro';
import RelatedContent from '../components/content/RelatedContent.astro';
import AuthorProfile from '../components/content/AuthorProfile.astro';
import ReadingCompanion from '../components/content/ReadingCompanion.astro';
import SectionMarker from '../components/content/SectionMarker.astro';
import FocusTemplates from '../components/content/FocusTemplates.astro';
import FocusHost from '../components/content/FocusHost.astro';
import SeriesWayfinding from '../components/content/SeriesWayfinding.astro';
import ExecutiveSignal from '../components/content/ExecutiveSignal.astro';
import { generateJsonLd, buildCanonicalUrl } from '../lib/seo';
import { formatDate, formatDateISO } from '../lib/utils';
import { site } from '../data/site';
import type { Article } from '../lib/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug?: string;
  headings?: Heading[];
  frontmatter: {
    title: string;
    excerpt?: string;
    description?: string;
    date: Date | string;
    updatedDate?: Date | string;
    readTime?: number;
    category?: string;
    tags?: string[];
    ogImage?: string;
    heroImage?: string;
    heroAlt?: string;
    whyItMatters?: string;
    leaderTakeaway?: string;
    series?: string;
    seriesPart?: number;
    draft?: boolean;
    heroPlacement?: 'default' | 'frontispiece';
  };
  // Optional: inject prev/next series posts from the page. `href` is
  // collection-aware (e.g. via hrefFor()) and falls back to /essays/<slug>/.
  prevPost?: { title: string; slug: string; href?: string };
  nextPost?: { title: string; slug: string; href?: string };
  // Optional: related posts/stories from getRelatedArticles(), resolved on
  // the page (where the content collection entry is in scope).
  relatedItems?: Article[];
}

const { slug, headings = [], frontmatter, prevPost, nextPost, relatedItems = [] } = Astro.props;

const {
  title,
  excerpt,
  description,
  date,
  updatedDate,
  readTime,
  category,
  tags = [],
  ogImage,
  heroImage,
  heroAlt,
  whyItMatters,
  leaderTakeaway,
  series,
  seriesPart,
  heroPlacement = 'default',
} = frontmatter;

const isFrontispiece = heroPlacement === 'frontispiece';

const pageDescription = description || excerpt || site.description;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const publishedISO = formatDateISO(date);
const updatedISO = updatedDate ? formatDateISO(updatedDate) : undefined;
const resolvedHeroAlt = heroAlt
  || (heroImage === '/assets/posts/the-registry-wave-agentic-artifact-supply-chain/hero-governed-cube.png'
    ? 'A shared capability pattern connects several project workbenches, each retaining a distinct adaptation.'
    : `Hero illustration for ${title}`);

const jsonLd = generateJsonLd('article', {
  title,
  description: pageDescription,
  url: canonicalUrl,
  image: ogImage,
  datePublished: publishedISO,
  dateModified: updatedISO,
  tags,
});
---

<BaseLayout
  title={title}
  description={pageDescription}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 z-[60] h-[3px] bg-[var(--accent)] transition-none"
    style="width: 0%;"
    aria-hidden="true"
  ></div>

  <article class="post-layout mx-auto grid w-full max-w-[var(--measure)] items-start px-4 py-12 sm:px-6 lg:px-8 xl:max-w-7xl xl:grid-cols-[minmax(0,var(--measure))_minmax(14rem,18rem)] xl:justify-center xl:gap-x-12">
    <!-- This lives inside .post-layout so the shared --measure token is
         resolvable. It remains ahead of the title/dek/meta at every size. -->
    {
      isFrontispiece && heroImage && (
        <div class="w-full pt-0 xl:col-span-2 xl:row-start-1">
          <Figure src={heroImage} alt={resolvedHeroAlt} variant="hero" />
        </div>
      )
    }

    <!-- Article header -->
    <header
      id="post-header"
      class:list={[
        'mb-16 min-w-0 space-y-6 pb-4 xl:col-start-1',
        isFrontispiece ? 'xl:row-start-2' : 'xl:row-start-1',
      ]}
    >
      {
        category && (
          <div>
            <span class="font-mono inline-block rounded-full bg-[var(--accent-subtle)] px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[var(--accent-text)] ring-1 ring-inset ring-[var(--border-subtle)]">
              {category}
            </span>
          </div>
        )
      }

      <h1 class="font-serif text-4xl font-bold leading-[1.1] tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-7xl">
        {title}
      </h1>

      {
        excerpt && (
          <p class="text-lg leading-relaxed text-[var(--text-tertiary)]">{excerpt}</p>
        )
      }

      <!-- Series wayfinding: arc position and/or mini-series part. Grouped
           with the dek (it answers "where does this sit?", which is editorial
           context) and kept away from the grey tag chips below, so the two
           chip rows never read as one muddled row. -->
      {
        slug && (
          <SeriesWayfinding
            slug={slug}
            collection="posts"
            series={series}
            seriesPart={seriesPart}
          />
        )
      }

      <!-- Meta row -->
      <div class="font-mono flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--text-disabled)]">
        <time datetime={publishedISO} class="text-[var(--text-tertiary)]">
          {formatDate(date)}
        </time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated{' '}
                <time datetime={updatedISO}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
        {
          readTime && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{readTime} min read</span>
            </>
          )
        }
      </div>

      <!-- Tags -->
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-1">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="rounded-full bg-[var(--bg-muted)] px-3 py-0.5 text-xs font-medium text-[var(--text-tertiary)] transition-colors hover:bg-[var(--bg-surface)] hover:text-[var(--text-secondary)]"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <!-- Desktop rail follows the header in source order and spans the
         article column. Reading-experience-v2 DIRECTION.md V5: the author
         card sits in flow here and scrolls away with the page; only
         ReadingCompanion (outline + ThreadDock + optional ContextualNote)
         is the sticky surface at depth. -->
    <div
      class:list={[
        'hidden xl:col-start-2 xl:row-span-2 xl:block xl:self-stretch',
        isFrontispiece ? 'xl:row-start-2' : 'xl:row-start-1',
      ]}
    >
      <div class="mb-4">
        <AuthorProfile variant="sidebar" headingLevel="h2" />
      </div>
      {
        whyItMatters && (
          <div class="mb-4">
            <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
          </div>
        )
      }
      <div class="no-scrollbar xl:sticky xl:top-24 xl:max-h-[calc(100vh-7rem)] xl:overflow-y-auto xl:pr-1">
        <ReadingCompanion slug={slug} headings={headings} />
      </div>
    </div>

    <div
      class:list={[
        'min-w-0 xl:col-start-1',
        isFrontispiece ? 'xl:row-start-3' : 'xl:row-start-2',
      ]}
    >

    <!-- Compact author context remains in the reading flow below desktop. -->
    <div class="mb-10 xl:hidden">
      <AuthorProfile variant="compact" headingLevel="h2" />
    </div>

    <!-- Hero illustration (engineering plate) — the frontispiece position
         (above the header) is rendered earlier and skips this slot. -->
    {
      !isFrontispiece && heroImage && (
        <Figure
          src={heroImage}
          alt={resolvedHeroAlt}
          variant="hero"
        />
      )
    }

    <!-- The narrow layout has no rail, so it keeps the signal in flow here.
         Desktop places the same single signal under the author card above. -->
    {
      whyItMatters && (
        <div class="xl:hidden">
          <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
        </div>
      )
    }

    <!-- Article body -->
    <div class="prose-custom">
      <slot />
      <SectionMarker />
    </div>

    <!-- Article footer: series nav + tags recap -->
    <footer class="mt-12 space-y-8 border-t border-[var(--border-subtle)] pt-8">
      <!-- Series navigation -->
      {
        (prevPost || nextPost) && (
          <nav aria-label="Series navigation" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {prevPost ? (
              <a
                href={prevPost.href ?? `/essays/${prevPost.slug}/`}
                class="group flex flex-col gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
                  &larr; Previous
                </span>
                <span class="text-sm font-medium text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
                  {prevPost.title}
                </span>
              </a>
            ) : (
              <div />
            )}
            {nextPost && (
              <a
                href={nextPost.href ?? `/essays/${nextPost.slug}/`}
                class="group flex flex-col items-end gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
                  Next &rarr;
                </span>
                <span class="text-sm font-medium text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
                  {nextPost.title}
                </span>
              </a>
            )}
          </nav>
        )
      }

      <!-- Related reading -->
      <RelatedContent items={relatedItems} />

      <!-- Back links -->
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <a
          href="/essays"
          class="text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
        >
          &larr; All Essays
        </a>
        {
          category && (
            <a
              href={`/categories/${category.toLowerCase()}`}
              class="text-[var(--text-disabled)] transition-colors hover:text-[var(--text-secondary)]"
            >
              More in {category}
            </a>
          )
        }
      </div>
    </footer>
  </div>
  </article>

  <!-- <template> fragments FocusHost clones on open — see
       FocusTemplates.astro's header comment. No-op for posts without a
       thread. FocusHost is mounted right after so its dialog always has
       this exact slug's templates to draw from (ARCHITECTURE.md §3). -->
  {slug && <FocusTemplates slug={slug} />}
  {slug && <FocusHost slug={slug} />}

  <!-- Scroll to top button -->
  <button
