    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .thread-scene__eyebrow-sep {
    color: var(--text-tertiary);
  }

  .thread-scene__kind--cyan {
    color: var(--cyan-text);
  }

  .thread-scene__label {
    margin: 0.2rem 0 0;
    font-size: 1.25rem;
    font-weight: 600;
