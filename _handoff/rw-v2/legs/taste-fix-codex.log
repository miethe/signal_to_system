---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getRelatedArticles } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedItems = await getRelatedArticles(post);
---

<PostLayout
  slug={post.id}
  headings={headings}
  frontmatter={{
    title: post.data.title,
    excerpt: post.data.excerpt,
    date: post.data.date,
    updatedDate: post.data.updatedDate,
    readTime: post.data.readTime ? parseInt(post.data.readTime) : undefined,
    category: post.data.category,
    tags: post.data.tags,
    ogImage: post.data.ogImage ?? post.data.heroImage,
    heroImage: post.data.heroImage,
    heroAlt: post.data.heroAlt,
    whyItMatters: post.data.whyItMatters,
    leaderTakeaway: post.data.leaderTakeaway,
    series: post.data.series,
    seriesPart: post.data.seriesOrder,
    draft: post.data.status === 'draft',
    heroPlacement: post.data.heroPlacement,
  }}
  relatedItems={relatedItems}
>
  <Content />
</PostLayout>
---
/**
 * Evidence — an inline marker for the confidence class of an adjacent claim.
 *
 * Keep these markers in receipt sections, figure captions, and other places
 * where readers are evaluating evidence; do not interrupt narrative prose.
 */
interface Props {
  kind: string;
  date?: string;
  href?: string;
}

const { kind, date, href } = Astro.props;

const evidenceClasses: Record<string, { label: string; definition: string }> = {
  observed: {
    label: 'Observed',
    definition: 'A directly witnessed event or artifact state.',
  },
  measured: {
    label: 'Measured',
    definition: 'A result with a stated method, unit, or denominator.',
  },
  proposed: {
    label: 'Proposed synthesis',
    definition: 'An interpretation or design proposal assembled from the available evidence.',
  },
  'related-work': {
    label: 'Related work',
    definition: 'A relevant method, idea, or result from adjacent work.',
  },
  external: {
    label: 'Externally reported',
    definition: 'A claim reported by an external source and attributed to it.',
  },
  hypothesis: {
    label: 'Hypothesis',
    definition: 'A testable explanation that has not yet been established.',
  },
};

const evidence = evidenceClasses[kind];
---

{
  href ? (
    <a
      href={href}
      class:list={['evidence', `evidence--${kind}`]}
      aria-label={`Evidence class: ${kind}`}
      title={evidence.definition}
    >
      <span class="evidence__label">{evidence.label}</span>
      {date && <span class="evidence__date">· {date}</span>}
    </a>
  ) : (
    <span
      class:list={['evidence', `evidence--${kind}`]}
      aria-label={`Evidence class: ${kind}`}
      title={evidence.definition}
    >
      <span class="evidence__label">{evidence.label}</span>
      {date && <span class="evidence__date">· {date}</span>}
    </span>
  )
}

<style>
  .evidence {
    display: inline-flex;
    align-items: baseline;
    width: fit-content;
    box-sizing: border-box;
    margin: 0 0.16em;
    padding: 0.06em 0.44em 0.1em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-muted);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.68em;
