  .reading-companion__rail-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    border-radius: 1px;
    background-color: var(--accent);
    transition: height 0.2s ease;
  }

  .reading-companion__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-companion__item--sub {
    display: none;
