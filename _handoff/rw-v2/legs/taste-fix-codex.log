    gap: 0.5rem;
    border-radius: 0.25rem;
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--text-secondary);
    text-decoration: none;
---
/**
 * EvidenceGuide — Evidence Focus rail component (ARCHITECTURE.md §4,
 * spec §8): "how to read the receipts" for the `EvidenceRecord.evidenceClass`
 * vocabulary specifically (observed / externally-reported / proposed /
 * measured / illustrative — `src/data/evidence.ts`).
 *
 * This is adapted from `EvidenceLegend.astro`'s visual pattern, not a
 * rename of that file: `EvidenceLegend` stays in place because the essay
 * body already renders it for a *different* vocabulary — `Evidence.astro`
 * / `ClaimBadge`'s inline claim-kind labels (observed / measured /
 * proposed / related-work / external / hypothesis), which is a distinct
 * taxonomy from `evidenceClass` (spec §8: "Evidence label is not evidence
 * quality" — the two systems answer different questions and shouldn't be
 * collapsed into one shared definition list).
 */
const entries: Array<{ kind: string; label: string; definition: string }> = [
  { kind: 'observed', label: 'Observed', definition: 'A directly witnessed event or artifact state.' },
  {
    kind: 'externally-reported',
    label: 'Externally reported',
    definition: 'Attributed to an external source; not independently validated by this record.',
  },
  {
    kind: 'proposed',
    label: 'Proposed',
    definition: 'A design proposal or interpretation, not an implemented or measured result.',
  },
  { kind: 'measured', label: 'Measured', definition: 'A result with a stated method, unit, or denominator.' },
  {
    kind: 'illustrative',
    label: 'Illustrative',
    definition: 'An illustrative example, not a captured production event.',
  },
];
---

<section class="evidence-guide" aria-label="How to read the evidence classes">
  <p class="evidence-guide__title font-mono">Evidence classes</p>
  <ul class="evidence-guide__list">
    {
      entries.map(({ kind, label, definition }) => (
        <li>
          <span class:list={['evidence-guide__badge', `evidence-guide__badge--${kind}`]}>{label}</span>
          <span class="evidence-guide__definition">{definition}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .evidence-guide {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    padding: 0.875rem 1rem;
  }

  .evidence-guide__title {
    margin: 0 0 0.6rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .evidence-guide__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-guide__list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .evidence-guide__badge {
    align-self: flex-start;
    padding: 0.06em 0.5em 0.1em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-muted);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .evidence-guide__badge--observed,
  .evidence-guide__badge--measured {
    border-color: var(--accent-muted);
    background: var(--accent-subtle);
    color: var(--accent-text);
  }

  .evidence-guide__badge--proposed {
    border-style: dashed;
  }

  .evidence-guide__badge--externally-reported {
    background: var(--bg-subtle);
  }

  .evidence-guide__badge--illustrative {
    border-color: var(--cyan);
    color: var(--cyan-text);
  }

  .evidence-guide__definition {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-tertiary);
  }
</style>
---
/**
 * ReceiptIndex — Evidence Focus rail component (ARCHITECTURE.md §4, spec
 * §8): source navigation across the full evidence set, pairing with
 * `EvidenceGuide`'s class definitions. Each record links to its own
 * canonical `/evidence/<id>/` route.
 */
import type { EvidenceRecord } from '../../data/evidence';

interface Props {
  records: EvidenceRecord[];
  currentId?: string;
}

const { records, currentId } = Astro.props;
---

<nav class="receipt-index" aria-label="All receipts">
  <p class="receipt-index__title font-mono">Receipts</p>
  <ol class="receipt-index__list">
    {
      records.map((record) => (
        <li>
          <a
            href={`/evidence/${record.id}/`}
            class="receipt-index__link"
            aria-current={record.id === currentId ? 'page' : undefined}
          >
            <span class="receipt-index__link-title">{record.title}</span>
            <span class="receipt-index__link-class font-mono">{record.evidenceClass}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .receipt-index {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    padding: 0.875rem 1rem;
  }

  .receipt-index__title {
    margin: 0 0 0.6rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .receipt-index__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .receipt-index__link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.5rem;
    text-decoration: none;
  }

  .receipt-index__link:hover,
  .receipt-index__link:focus-visible {
    background: var(--accent-subtle);
    outline: none;
  }

  .receipt-index__link:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .receipt-index__link[aria-current='page'] {
    background: var(--accent-subtle);
  }

  .receipt-index__link-title {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .receipt-index__link-class {
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
</style>
