      </div>
      <div class="no-scrollbar xl:sticky xl:top-24 xl:max-h-[calc(100vh-7rem)] xl:overflow-y-auto xl:pr-1">
        <ReadingCompanion slug={slug} headings={headings} />
      </div>
    </div>

    <div class="min-w-0 xl:col-start-1 xl:row-start-2">

    <!-- Compact author context remains in the reading flow below desktop. -->
    <div class="mb-10 xl:hidden">
      <AuthorProfile variant="compact" headingLevel="h2" />
    </div>

    <!-- Hero illustration (engineering plate) — the frontispiece position
         (above the header) is rendered earlier and skips this slot. -->
    {
      !isFrontispiece && heroImage && (
        <Figure
          src={heroImage}
          alt={resolvedHeroAlt}
          variant="hero"
        />
      )
    }

    <!-- Executive signal: "why this matters" plus "carry this forward",
         always in flow at every breakpoint (DIRECTION.md V5) — there is
         no more rail-only takeaway card to avoid duplicating. -->
    {
      whyItMatters && (
        <ExecutiveSignal whyItMatters={whyItMatters} takeaway={leaderTakeaway} />
      )
    }

    <!-- Article body -->
    <div class="prose-custom">
      <slot />
    </div>

    <!-- Article footer: series nav + tags recap -->
    <footer class="mt-12 space-y-8 border-t border-[var(--border-subtle)] pt-8">
      <!-- Series navigation -->
      {
        (prevPost || nextPost) && (
          <nav aria-label="Series navigation" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {prevPost ? (
              <a
                href={prevPost.href ?? `/essays/${prevPost.slug}/`}
                class="group flex flex-col gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
                  &larr; Previous
                </span>
                <span class="text-sm font-medium text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
                  {prevPost.title}
                </span>
              </a>
            ) : (
              <div />
            )}
            {nextPost && (
              <a
                href={nextPost.href ?? `/essays/${nextPost.slug}/`}
                class="group flex flex-col items-end gap-1 rounded-lg border border-[var(--border-subtle)] p-4 transition-colors hover:border-indigo-500/50 hover:bg-[var(--bg-subtle)]"
              >
                <span class="text-xs font-medium uppercase tracking-widest text-[var(--text-disabled)] transition-colors group-hover:text-[var(--accent)]">
                  Next &rarr;
                </span>
                <span class="text-sm font-medium text-[var(--text-secondary)] transition-colors group-hover:text-[var(--text-primary)]">
                  {nextPost.title}
                </span>
              </a>
            )}
          </nav>
        )
      }

      <!-- Related reading -->
      <RelatedContent items={relatedItems} />

      <!-- Back links -->
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <a
          href="/essays"
          class="text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
        >
          &larr; All Essays
        </a>
        {
          category && (
            <a
              href={`/categories/${category.toLowerCase()}`}
              class="text-[var(--text-disabled)] transition-colors hover:text-[var(--text-secondary)]"
            >
              More in {category}
            </a>
          )
        }
      </div>
    </footer>
  </div>
  </article>

  <!-- <template> fragments FocusHost clones on open — see
       FocusTemplates.astro's header comment. No-op for posts without a
       thread. FocusHost is mounted right after so its dialog always has
       this exact slug's templates to draw from (ARCHITECTURE.md §3). -->
  {slug && <FocusTemplates slug={slug} />}
  {slug && <FocusHost slug={slug} />}

  <!-- Scroll to top button -->
  <button
    id="scroll-to-top"
    type="button"
    aria-label="Scroll to top"
    class="fixed bottom-8 right-8 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-tertiary)] shadow-md opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-[var(--accent-subtle)] hover:text-[var(--accent)] hover:border-[var(--accent)]/50 focus-ring"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </button>

  <script>
    // Reading progress bar
    const progressBar = document.getElementById('reading-progress');
    const articleEl = document.querySelector('article');
    const scrollToTopBtn = document.getElementById('scroll-to-top');
    const isLite = document.documentElement.classList.contains('perf-lite');

    if (progressBar && articleEl && !isLite) {
      const updateProgress = () => {
        const rect = articleEl.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = rect.height;
        const scrolled = window.scrollY - articleTop;
        const progress = Math.min(Math.max(scrolled / (articleHeight - window.innerHeight), 0), 1);
        progressBar.style.width = `${progress * 100}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    } else if (progressBar && isLite) {
      progressBar.style.display = 'none';
    }

    // Scroll to top button
    if (scrollToTopBtn) {
      const toggleButton = () => {
        const show = window.scrollY > window.innerHeight * 0.5;
        scrollToTopBtn.classList.toggle('opacity-0', !show);
        scrollToTopBtn.classList.toggle('translate-y-4', !show);
        scrollToTopBtn.classList.toggle('pointer-events-none', !show);
        scrollToTopBtn.classList.toggle('opacity-100', show);
        scrollToTopBtn.classList.toggle('translate-y-0', show);
        scrollToTopBtn.classList.toggle('pointer-events-auto', show);
      };

      window.addEventListener('scroll', toggleButton, { passive: true });
      toggleButton();

      scrollToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</BaseLayout>
---
/**
 * EvidenceFocus — the shared Evidence Focus renderer (DIRECTION.md V3/V4,
 * ARCHITECTURE.md §4, spec §8). Backs BOTH `/essays/<slug>/evidence/`
 * (the essay-scoped index) and the flat, site-wide `/evidence/<record>/`
 * route, plus the in-place overlay's `<template>` fragment — same
 * component, same field set from `evidence.ts`'s `EvidenceRecord`, never
 * a second hand-written summary.
 *
 * `records` is always the full evidence set (so the rail's `ReceiptIndex`
 * can navigate anywhere); `selectedId` narrows the main pane to one
 * record's full detail. Omitting it renders the full list.
 */
import EvidenceGuide from './EvidenceGuide.astro';
import ReceiptIndex from './ReceiptIndex.astro';
import type { EvidenceRecord } from '../../data/evidence';

interface Props {
  records: EvidenceRecord[];
  selectedId?: string;
  /** Real anchor text for a "Read in essay" link, when a related essay exists. */
  essaySlug?: string;
  standalone?: boolean;
}

const { records, selectedId, essaySlug, standalone = true } = Astro.props;
const selected = selectedId ? records.find((record) => record.id === selectedId) : undefined;

const formatDate = (value: string | null) => value ?? 'Not stated';
---

<div class="evidence-focus" data-focus-kind="evidence" data-focus-key={selectedId ?? 'all'}>
  <div class="evidence-focus__grid">
    <div class="evidence-focus__main">
      <div class="evidence-focus__actions">
        {essaySlug && (
          <a class="evidence-focus__action" href={`/essays/${essaySlug}/`}>
            &larr; Back to essay
          </a>
        )}
        <span class="evidence-focus__action-label font-mono">Evidence focus</span>
        {essaySlug && (
          <a
            class="evidence-focus__action evidence-focus__action--secondary"
            href={`/essays/${essaySlug}/evidence/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in new tab
          </a>
        )}
        {!standalone && (
          <button type="button" class="evidence-focus__action evidence-focus__action--close" data-focus-close>
            Close
          </button>
        )}
      </div>

      {selected ? (
        <article class="evidence-focus__record">
          <p class="evidence-focus__eyebrow font-mono">{selected.evidenceClass}</p>
          <h2 class="evidence-focus__title font-serif">{selected.title}</h2>

          <dl class="evidence-focus__facts">
            <div>
              <dt>Capture type</dt>
              <dd>{selected.captureType}</dd>
            </div>
            <div>
              <dt>Event date</dt>
              <dd>{formatDate(selected.eventDate)}</dd>
            </div>
            <div>
              <dt>Recorded date</dt>
              <dd>{formatDate(selected.recordedDate)}</dd>
            </div>
            <div>
              <dt>Verified at</dt>
              <dd>{formatDate(selected.verifiedAt)}</dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>{selected.sourceUrl ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Source revision</dt>
              <dd>{selected.sourceRevision ?? 'Not stated'}</dd>
            </div>
            <div>
              <dt>Publicability</dt>
              <dd>{selected.publicability}</dd>
            </div>
          </dl>

          <div class="evidence-focus__section">
            <p class="evidence-focus__section-label font-mono">What this supports</p>
            <ul>
              {selected.supports.map((line) => <li>{line}</li>)}
            </ul>
          </div>

          <div class="evidence-focus__section">
            <p class="evidence-focus__section-label font-mono">Limits</p>
            <ul>
              {selected.limitations.map((line) => <li>{line}</li>)}
            </ul>
          </div>

          {selected.publicCapturePath ? (
            <div class="evidence-focus__section">
              <p class="evidence-focus__section-label font-mono">Capture</p>
              <p class="evidence-focus__capture-path">{selected.publicCapturePath}</p>
            </div>
          ) : (
            <p class="evidence-focus__no-capture">
              No standalone capture asset is published for this record — its capture type is{' '}
              <strong>{selected.captureType}</strong>.
            </p>
          )}
        </article>
      ) : (
        <div class="evidence-focus__list">
          <p class="evidence-focus__intro">The full receipt set behind this essay's argument.</p>
          <ol>
            {records.map((record) => (
              <li class="evidence-focus__list-item">
                <a href={`/evidence/${record.id}/`}>
                  <span class="evidence-focus__list-title">{record.title}</span>
                  <span class="evidence-focus__list-meta font-mono">
                    {record.evidenceClass} &middot; {record.captureType}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>

    <aside class="evidence-focus__rail">
      <EvidenceGuide />
      <ReceiptIndex records={records} currentId={selectedId} />
    </aside>
  </div>
</div>

<style>
  .evidence-focus__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .evidence-focus__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .evidence-focus__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .evidence-focus__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .evidence-focus__action:hover,
  .evidence-focus__action:focus-visible {
    text-decoration: underline;
  }

  .evidence-focus__action-label {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .evidence-focus__action--secondary {
    color: var(--text-secondary);
  }

  .evidence-focus__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .evidence-focus__title {
    margin: 0.3rem 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .evidence-focus__facts {
    display: grid;
    gap: 0.75rem 1.5rem;
    margin: 0 0 1.5rem;
    padding: 1rem 1.125rem;
