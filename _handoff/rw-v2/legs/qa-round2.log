/**
 * ThreadFocus — the shared Thread Focus renderer (reading-experience-v2
 * DIRECTION.md V3/V4, ARCHITECTURE.md §4, spec §7). Backs BOTH the
 * standalone `/essays/<slug>/thread/<beat>/` route and the in-place
 * overlay's `<template data-focus-view="thread:<beat>">` fragment —
 * `standalone` only toggles the few actions that make sense outside a
 * dialog (no "Close" outside `standalone={false}`); every other prop
 * comes straight from the beat record in `threads.ts`, so inline and
 * focus views never diverge into two hand-written explanations (V3).
 *
 * P0-C is what will later clone this component's `<template>` copy into
 * `FocusHost`'s dialog and wire "Back to essay" / "Read this scene in the
 * essay" / prev-next to replace-in-place rather than navigate — for this
 * leg every action below is a real link, so the standalone route and the
 * eventual overlay share one navigable, no-JS-safe destination for each.
 */
import Figure from './Figure.astro';
import RunningExampleCard from './RunningExampleCard.astro';
import ThreadOverview from './ThreadOverview.astro';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);
const beatIndex = beat ? thread.beats.findIndex((candidate) => candidate.id === beatId) : -1;
const prevBeat = beatIndex > 0 ? thread.beats[beatIndex - 1] : null;
const nextBeat = beatIndex > -1 && beatIndex < thread.beats.length - 1 ? thread.beats[beatIndex + 1] : null;

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};
---

{
  beat && (
    <div class="thread-focus" data-focus-kind="thread" data-focus-key={beat.id}>
      <div class="thread-focus__grid">
        <div class="thread-focus__main">
          <div class="thread-focus__actions">
            <a class="thread-focus__action" href={`/essays/${thread.slug}/`}>
              &larr; Back to essay
            </a>
            <span class="thread-focus__action-label font-mono">Thread focus</span>
            <a
              class="thread-focus__action thread-focus__action--secondary"
              href={`/essays/${thread.slug}/#thread-${beat.id}`}
            >
              Read this scene in the essay
            </a>
            {!standalone && (
              <button type="button" class="thread-focus__action thread-focus__action--close" data-focus-close>
                Close
              </button>
            )}
          </div>

          <p class="thread-focus__eyebrow font-mono">
            <span>
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true">&middot;</span>
            <span>{kindLabel[beat.kind] ?? beat.kind}</span>
          </p>
          <h2 class="thread-focus__title font-serif">{beat.label}</h2>
          <p class="thread-focus__recap">{beat.recap}</p>

          <Figure
            src={beat.image.src}
            alt={beat.image.alt}
            caption={beat.image.caption}
            number={String(beat.n).padStart(2, '0')}
            longDescription={beat.longDescription}
            variant="wide"
            expandable={false}
          />
          <a class="thread-focus__figure-link" href={`/essays/${thread.slug}/figure/${beat.id}/`}>
            View this figure in the Figure Viewer &rarr;
          </a>

          <div class="thread-focus__boundary">
            <div>
              <p class="thread-focus__boundary-label font-mono">What this establishes</p>
              <p>{beat.establishes}</p>
            </div>
            <div>
              <p class="thread-focus__boundary-label font-mono">What it does not establish</p>
              <p>{beat.doesNotEstablish}</p>
            </div>
          </div>

          <nav class="thread-focus__prevnext" aria-label="Adjacent thread beats">
            {prevBeat ? (
              <a href={`/essays/${thread.slug}/thread/${prevBeat.id}/`}>
                &larr; {prevBeat.label}
              </a>
            ) : (
              <span />
            )}
            {nextBeat && (
              <a href={`/essays/${thread.slug}/thread/${nextBeat.id}/`}>
                {nextBeat.label} &rarr;
              </a>
            )}
          </nav>
        </div>

        <aside class="thread-focus__rail">
          <RunningExampleCard thread={thread} />
          <ThreadOverview thread={thread} currentBeatId={beat.id} />
        </aside>
      </div>
    </div>
  )
}

<style>
  .thread-focus {
    max-width: 100%;
  }

  .thread-focus__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .thread-focus__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .thread-focus__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .thread-focus__action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .thread-focus__action:hover,
  .thread-focus__action:focus-visible {
    text-decoration: underline;
  }

  .thread-focus__action-label {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .thread-focus__action--secondary {
    color: var(--text-secondary);
  }
---
/**
 * ReceiptDisclosure — a raw evidence receipt (YAML, shell output) tucked
 * behind a native `<details>` so the page stays readable. The label and
 * the finding stay visible without expanding — this is never the only
 * place the finding appears; the prose carries it too.
 */
interface Props {
  label: string;
  summary: string;
}

const { label, summary } = Astro.props;
---

<figure class="receipt-disclosure lift-hover">
  <figcaption class="receipt-disclosure__head">
    <span class="receipt-disclosure__label">{label}</span>
    <p class="receipt-disclosure__summary">{summary}</p>
  </figcaption>
  <details class="receipt-disclosure__details">
    <summary>Show receipt</summary>
    <div class="receipt-disclosure__body">
      <slot />
    </div>
  </details>
</figure>

<style>
  .receipt-disclosure {
    margin: 1.75rem 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-muted);
  }

  .receipt-disclosure__head {
    margin: 0 0 0.75rem;
  }

  .receipt-disclosure__label {
    display: inline-block;
    margin-bottom: 0.35rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .receipt-disclosure__summary {
    margin: 0;
    color: var(--text-primary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .receipt-disclosure__details {
    margin: 0;
  }

  .receipt-disclosure__details summary {
    cursor: pointer;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    list-style: none;
  }

  .receipt-disclosure__details summary::-webkit-details-marker {
    display: none;
  }

  .receipt-disclosure__details summary::before {
    content: '▸ ';
  }

  .receipt-disclosure__details[open] summary::before {
    content: '▾ ';
  }

  .receipt-disclosure__details[open] summary {
    margin-bottom: 0.6rem;
  }

  .receipt-disclosure__details summary:hover {
    color: var(--accent-hover);
  }

  .receipt-disclosure__body {
    margin-top: 0.25rem;
  }

  .receipt-disclosure__body :global(pre) {
    margin: 0.5rem 0 0;
  }
</style>
  :global(html.perf-lite) .reading-companion__link,
  :global(html.perf-lite) .reading-companion__rail-fill {
    transition: none;
  }
</style>

<script>
  import { computeListWindow } from '../../lib/sidebar-window';

  /** Nearby-outline default window size before "All sections" is toggled. */
  const NEARBY_MAX_VISIBLE = 6;

  const initializeReadingCompanions = () => {
    document.querySelectorAll<HTMLElement>('[data-reading-companion]').forEach((root) => {
      if (root.dataset.readingCompanionReady === 'true') return;
      root.dataset.readingCompanionReady = 'true';

      const outline = root.querySelector<HTMLElement>('[data-companion-outline]');
      const allToggle = root.querySelector<HTMLButtonElement>('[data-companion-all-toggle]');
      const body = root.querySelector<HTMLElement>('[data-companion-scroll]');
      const rail = root.querySelector<HTMLElement>('[data-companion-fill]');
      const moreAbove = root.querySelector<HTMLElement>('[data-companion-more="above"]');
      const moreBelow = root.querySelector<HTMLElement>('[data-companion-more="below"]');
      const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-companion-item]'));

      if (!outline || !body || items.length === 0 || !('IntersectionObserver' in window)) return;

      const pairs = items
        .map((item) => {
          const link = item.querySelector<HTMLAnchorElement>('[data-companion-link]');
          const target = link ? document.getElementById(link.dataset.companionTarget ?? '') : null;
          return link && target ? { item, link, target } : null;
        })
        .filter((pair): pair is { item: HTMLLIElement; link: HTMLAnchorElement; target: HTMLElement } => pair !== null);

      if (pairs.length === 0) return;
      const noteRoot = root.querySelector<HTMLElement>('[data-contextual-note]');
      const dismissedNotes = new Set<string>();

      const reduceMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        document.documentElement.classList.contains('perf-lite');

      let allExpanded = false;
      let activeIndex = 0;

      const resolveSection = (targetId: string): string | null => {
        const pair = pairs.find((candidate) => candidate.target.id === targetId);
        if (!pair) return null;
        return pair.item.dataset.companionDepth === '2' ? targetId : pair.item.dataset.companionParent || null;
      };

      const setActiveBranch = (sectionSlug: string | null) => {
        items.forEach((item) => {
          if (item.dataset.companionDepth !== '3') return;
          item.classList.toggle('is-active-branch', item.dataset.companionParent === sectionSlug);
        });
      };

      const firstH2 = pairs.find((pair) => pair.item.dataset.companionDepth === '2');
      setActiveBranch(firstH2?.target.id ?? null);

      let lastFitSignature = '';
      const fitList = () => {
        const laidOut = pairs.filter(({ item }) => item.dataset.companionDepth === '2' || item.classList.contains('is-active-branch'));
        if (laidOut.length === 0) return;

        if (allExpanded) {
          if (lastFitSignature === 'expanded') return;
          lastFitSignature = 'expanded';
          laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
          moreAbove?.setAttribute('hidden', '');
          moreBelow?.setAttribute('hidden', '');
          return;
        }

        const panelTop = outline.getBoundingClientRect().top;
        const available = window.innerHeight - panelTop - 24;
        const laidOutActiveIndex = Math.max(0, laidOut.findIndex(({ target }) => pairs[activeIndex]?.target === target));
        const signature = `windowed:${available.toFixed(1)}:${laidOut.length}:${laidOutActiveIndex}`;
        if (signature === lastFitSignature) return;
        lastFitSignature = signature;

        laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
        moreAbove?.setAttribute('hidden', '');
        moreBelow?.setAttribute('hidden', '');

        const rowHeight = laidOut[0].link.getBoundingClientRect().height || 32;
        const totalRowsHeight = laidOut.reduce((sum, { link }) => sum + link.getBoundingClientRect().height, 0);
        const chromeHeight = Math.max(0, body.clientHeight - totalRowsHeight);
        const budgetForRows = available - chromeHeight;
        const maxVisible = Math.max(1, Math.min(NEARBY_MAX_VISIBLE, Math.floor(budgetForRows / rowHeight)));

        const win = computeListWindow(laidOut.length, laidOutActiveIndex, maxVisible);
        laidOut.forEach(({ item }, i) => {
          item.classList.toggle('is-window-hidden', i < win.start || i > win.end);
        });
        moreAbove?.toggleAttribute('hidden', win.above === 0);
        if (moreAbove) moreAbove.textContent = `+${win.above} more above`;
        moreBelow?.toggleAttribute('hidden', win.below === 0);
        if (moreBelow) moreBelow.textContent = `+${win.below} more below`;
      };

      let fitQueued = false;
      const queueFit = () => {
        if (fitQueued) return;
        fitQueued = true;
        requestAnimationFrame(() => {
          fitQueued = false;
          fitList();
        });
      };

      const setActive = (id: string) => {
        activeIndex = pairs.findIndex((pair) => pair.target.id === id);
        pairs.forEach(({ item, link }, index) => {
          if (index === activeIndex) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
          item.classList.toggle('is-visited', activeIndex > -1 && index < activeIndex);
        });

        setActiveBranch(resolveSection(id));
        document.dispatchEvent(new CustomEvent('reading-section-change', { detail: { sectionId: resolveSection(id), activeId: id } }));

        if (rail && pairs.length > 1) {
          const pct = activeIndex > -1 ? (activeIndex / (pairs.length - 1)) * 100 : 0;
          rail.style.height = `${Math.max(0, pct)}%`;
        }

        const activeLink = activeIndex > -1 ? pairs[activeIndex]?.link : null;
        activeLink?.scrollIntoView({ block: 'nearest', behavior: reduceMotion() ? 'auto' : 'smooth' });
        lastFitSignature = ''; // active index changed — force a re-evaluation
        queueFit();
      };

      const showContextualNote = (sectionId: string | null) => {
        if (!noteRoot || noteRoot.contains(document.activeElement) || document.querySelector('[data-focus-dialog][open]')) return;
        const candidates = Array.from(noteRoot.querySelectorAll<HTMLElement>('[data-contextual-note-item]'));
        const visible = candidates.find((item) => item.dataset.sectionId === sectionId && !dismissedNotes.has(item.dataset.noteId ?? ''));
        noteRoot.hidden = !visible;
        candidates.forEach((item) => { item.hidden = item !== visible; });
      };

      document.addEventListener('reading-section-change', ((event: CustomEvent<{ sectionId: string | null }>) => {
        showContextualNote(event.detail.sectionId);
      }) as EventListener);
      noteRoot?.querySelectorAll<HTMLButtonElement>('[data-contextual-note-dismiss]').forEach((button) => {
        button.addEventListener('click', () => {
          const note = button.closest<HTMLElement>('[data-contextual-note-item]');
          if (note?.dataset.noteId) dismissedNotes.add(note.dataset.noteId);
          showContextualNote(note?.dataset.sectionId ?? null);
        });
      });

      const visibleTargets = new Set<HTMLElement>();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const target = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              visibleTargets.add(target);
            } else {
              visibleTargets.delete(target);
            }
          });

          const visible = Array.from(visibleTargets);
          if (visible.length === 0) return;

          const closest = visible.reduce((current, candidate) =>
            Math.abs(candidate.getBoundingClientRect().top) < Math.abs(current.getBoundingClientRect().top)
              ? candidate
              : current,
          );
          setActive(closest.id);
        },
        { rootMargin: '-10% 0px -80% 0px', threshold: 0 },
      );

      pairs.forEach(({ target }) => observer.observe(target));

      // Belt-and-suspenders synchronous recompute (see PostSidebar's prior
      // version of this comment): the observer's first callback is async
      // and can miss a page that loads already scrolled deep in.
      const currentActiveTarget = () =>
        root.querySelector<HTMLAnchorElement>('[data-companion-link][aria-current="location"]')?.dataset.companionTarget ?? null;

      const recomputeActive = () => {
        const activationLine = window.innerHeight * 0.1;
        let activeId: string | null = null;
        for (const { target } of pairs) {
          if (target.getBoundingClientRect().top <= activationLine) {
            activeId = target.id;
          } else {
            break;
          }
        }
        if (activeId && activeId !== currentActiveTarget()) setActive(activeId);
      };

      let recomputeQueued = false;
      const queueRecompute = () => {
        if (recomputeQueued) return;
        recomputeQueued = true;
        requestAnimationFrame(() => {
          recomputeQueued = false;
          recomputeActive();
        });
      };

      recomputeActive();
      window.addEventListener('scroll', queueRecompute, { passive: true });
      window.addEventListener('resize', queueRecompute, { passive: true });
      window.addEventListener(
        'resize',
        () => {
          lastFitSignature = '';
          queueFit();
        },
        { passive: true },
      );

      if ('ResizeObserver' in window) {
        new ResizeObserver(() => {
          lastFitSignature = '';
          queueFit();
        }).observe(outline);
      }

      allToggle?.addEventListener('click', () => {
        allExpanded = !allExpanded;
        allToggle.setAttribute('aria-pressed', String(allExpanded));
        allToggle.textContent = allExpanded ? 'Nearby only' : 'All sections';
        lastFitSignature = '';
        fitList();
      });

      queueFit();

exec
