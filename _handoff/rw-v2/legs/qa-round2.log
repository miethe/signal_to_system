/**
 * ThreadFocus — the shared Thread Focus renderer (reading-experience-v2
 * DIRECTION.md V3/V4, ARCHITECTURE.md §4, spec §7). Backs BOTH the
 * standalone `/essays/<slug>/thread/<beat>/` route and the in-place
 * overlay's `<template data-focus-view="thread:<beat>">` fragment —
 * `standalone` only toggles the few actions that make sense outside a
 * dialog (no "Close" outside `standalone={false}`); every other prop
 * comes straight from the beat record in `threads.ts`, so inline and
 * focus views never diverge into two hand-written explanations (V3).
 *
 * P0-C is what will later clone this component's `<template>` copy into
 * `FocusHost`'s dialog and wire "Back to essay" / "Read this scene in the
 * essay" / prev-next to replace-in-place rather than navigate — for this
 * leg every action below is a real link, so the standalone route and the
 * eventual overlay share one navigable, no-JS-safe destination for each.
 */
import Figure from './Figure.astro';
import RunningExampleCard from './RunningExampleCard.astro';
import ThreadOverview from './ThreadOverview.astro';
import type { Thread } from '../../data/threads';

interface Props {
  thread: Thread;
  beatId: string;
  standalone?: boolean;
}

const { thread, beatId, standalone = true } = Astro.props;
const beat = thread.beats.find((candidate) => candidate.id === beatId);
const beatIndex = beat ? thread.beats.findIndex((candidate) => candidate.id === beatId) : -1;
const prevBeat = beatIndex > 0 ? thread.beats[beatIndex - 1] : null;
const nextBeat = beatIndex > -1 && beatIndex < thread.beats.length - 1 ? thread.beats[beatIndex + 1] : null;

const kindLabel: Record<string, string> = {
  historical: 'Historical account',
  conceptual: 'Conceptual branch',
  mechanism: 'Mechanism',
  proposed: 'Proposed',
};
---

{
  beat && (
    <div class="thread-focus" data-focus-kind="thread" data-focus-key={beat.id}>
      <div class="thread-focus__grid">
        <div class="thread-focus__main">
          <div class="thread-focus__actions">
            <a class="thread-focus__action" href={`/essays/${thread.slug}/`}>
              &larr; Back to essay
            </a>
            <span class="thread-focus__action-label font-mono">Thread focus</span>
            <a
              class="thread-focus__action thread-focus__action--secondary"
              href={`/essays/${thread.slug}/#thread-${beat.id}`}
            >
              Read this scene in the essay
            </a>
            {!standalone && (
              <button type="button" class="thread-focus__action thread-focus__action--close" data-focus-close>
                Close
              </button>
            )}
          </div>

          <p class="thread-focus__eyebrow font-mono">
            <span>
              {beat.n}/{thread.beats.length}
            </span>
            <span aria-hidden="true">&middot;</span>
            <span>{kindLabel[beat.kind] ?? beat.kind}</span>
          </p>
          <h2 class="thread-focus__title font-serif">{beat.label}</h2>
          <p class="thread-focus__recap">{beat.recap}</p>

          <Figure
            src={beat.image.src}
            alt={beat.image.alt}
            caption={beat.image.caption}
            number={String(beat.n).padStart(2, '0')}
            longDescription={beat.longDescription}
            variant="wide"
            expandable={false}
          />
          <a class="thread-focus__figure-link" href={`/essays/${thread.slug}/figure/${beat.id}/`}>
            View this figure in the Figure Viewer &rarr;
          </a>

          <div class="thread-focus__boundary">
            <div>
              <p class="thread-focus__boundary-label font-mono">What this establishes</p>
              <p>{beat.establishes}</p>
            </div>
            <div>
              <p class="thread-focus__boundary-label font-mono">What it does not establish</p>
              <p>{beat.doesNotEstablish}</p>
            </div>
          </div>

          <nav class="thread-focus__prevnext" aria-label="Adjacent thread beats">
            {prevBeat ? (
              <a href={`/essays/${thread.slug}/thread/${prevBeat.id}/`}>
                &larr; {prevBeat.label}
              </a>
            ) : (
              <span />
            )}
            {nextBeat && (
              <a href={`/essays/${thread.slug}/thread/${nextBeat.id}/`}>
                {nextBeat.label} &rarr;
              </a>
            )}
          </nav>
        </div>

        <aside class="thread-focus__rail">
          <RunningExampleCard thread={thread} />
          <ThreadOverview thread={thread} currentBeatId={beat.id} />
        </aside>
      </div>
    </div>
  )
}

