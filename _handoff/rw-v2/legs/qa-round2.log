    text-transform: uppercase;
    color: var(--accent-text);
  }

  .evidence-focus__title {
    margin: 0.3rem 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
