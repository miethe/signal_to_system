---
import { formatTitle, resolveOgImage } from '../lib/seo';
import { site } from '../data/site';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import '../styles/global.css';
import { serializeJsonLd } from '../lib/safe-json-ld.mjs';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, unknown>;
  class?: string;
  /** Emit robots noindex/nofollow. For pages that build but aren't published yet. */
  noindex?: boolean;
  /**
   * Mark <main> as a reader page (ReaderShell). Since M2 the reader sits in
   * the site frame like every other page; the flag only adds `.s2s-main--reader`
   * as a styling hook.
   */
  reader?: boolean;
}

const {
  title,
  description = site.description,
  ogImage,
  canonicalUrl,
  jsonLd,
  class: className,
  noindex = false,
  reader = false,
} = Astro.props;

const resolvedTitle = formatTitle(title);
const resolvedOgImage = resolveOgImage(ogImage);
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, site.siteUrl).href;
const resolvedDescription = description.slice(0, 160);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    <!-- Fonts are self-hosted (@fontsource, imported by src/styles/tokens/type.css);
         there is no font CDN at runtime. -->

    <!-- Primary Meta -->
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={resolvedCanonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content={site.title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:site" content="@nickmiethe" />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} RSS Feed`}
      href="/rss.xml"
    />

    <!-- JSON-LD Structured Data -->
    {
      jsonLd && (
        <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
      )
    }

    <!--
      Theme boot: runs synchronously before first paint. Observatory dark is
      the default (the <html> element already carries .dark, so no-JS and
      first-visit renders are dark); a stored "light" preference swaps it
      before paint, so there is no flash either way.
    -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('s2s-theme'); } catch (_) {}
        if (stored === 'light') {
          html.classList.remove('dark');
          html.classList.add('light');
        }
        var perfMode = null;
        try { perfMode = localStorage.getItem('s2s-performance-mode'); } catch (_) {}
        if (perfMode === 'lite') html.classList.add('perf-lite');
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- The framed panel from the mockups (every page, the reader included). -->
    <div class="s2s-frame">
      <!-- Navigation slot: a page may pass its own header; default is the v2 shell header. -->
      <slot name="nav">
        <SiteHeader />
      </slot>

      <main id="main-content" tabindex="-1" class:list={['s2s-main', reader && 's2s-main--reader', className]}>
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>

  <!-- IntersectionObserver for entrance animations -->
  <script>
    function initScrollAnimations() {
      const animatedSections = document.querySelectorAll('.animate-on-scroll:not(.is-visible)');
      if (animatedSections.length > 0 && !document.documentElement.classList.contains('perf-lite')) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        animatedSections.forEach((section) => observer.observe(section));
      } else {
        // Ensure content is visible if perf-lite or no observer support
        animatedSections.forEach((s) => {
          const htmlS = s as HTMLElement;
          htmlS.style.opacity = '1';
          htmlS.style.transform = 'none';
          htmlS.classList.add('is-visible');
        });
      }
    }

    // Run on first load
    initScrollAnimations();

    // Run on view transitions if Astro ViewTransitions is used
    document.addEventListener('astro:page-load', initScrollAnimations);
    document.addEventListener('astro:after-swap', initScrollAnimations);
  </script>
</html>
