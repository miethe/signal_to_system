---
/**
 * SeriesLayout — the reading-path detail body (v2 re-skin,
 * node_01M35CKMYGY080GKHKBGR7F1J2). IndexRailLayout-like: a left column of
 * ordered part rows, a right "About this path" rail (desktop only).
 *
 * Consumed by src/pages/series/[...slug].astro, which supplies the frontmatter
 * (title/excerpt/status/ogImage/topic — all real `series` collection data)
 * and the ordered posts/stories in the series.
 */
import StateNotice from '../components/primitives/StateNotice.astro';
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/primitives/PageHero.astro';
import Card from '../components/primitives/Card.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import Badge from '../components/ui/Badge.astro';
import { buildCanonicalUrl } from '../lib/seo';
import { formatDate, formatDateISO } from '../lib/utils';
import { site } from '../data/site';
import { TOPIC_HUBS } from '../data/taxonomy';

interface SeriesPost {
  slug: string;
  title: string;
  excerpt?: string;
  date?: Date | string;
  readTime?: number;
  part?: number;
  /** Collection-aware URL (e.g. via hrefFor()). Falls back to /essays/<slug>/ for callers that don't pass one. */
  href?: string;
  /** Row kind chip: "essay" (posts) vs "story" (dev stories/build notes). */
  kind?: 'essay' | 'story';
}

interface Props {
  frontmatter: {
    title: string;
    excerpt?: string;
    description?: string;
    date?: Date | string;
    status?: 'active' | 'planned' | 'complete';
    tags?: string[];
    ogImage?: string;
    /** Series `topic` field (a Category label) — links the rail to its topic hub when matched. */
    topic?: string;
  };
  posts: SeriesPost[];
}

const { frontmatter, posts } = Astro.props;

const {
  title,
  excerpt,
  description,
  status = 'active',
  tags = [],
  ogImage,
  topic,
} = frontmatter;

const pageDescription = description || excerpt || site.description;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);

const statusLabel: Record<string, string> = { active: 'Active', planned: 'Planned', complete: 'Complete' };
const kindLabel: Record<string, string> = { essay: 'Essay', story: 'Build note' };

// Sort posts by part number, then by date
const sortedPosts = [...posts].sort((a, b) => {
  if (a.part !== undefined && b.part !== undefined) return a.part - b.part;
  if (a.date && b.date) return new Date(a.date).getTime() - new Date(b.date).getTime();
  return 0;
});

const topicHub = topic ? TOPIC_HUBS.find((h) => h.label.toLowerCase() === topic.toLowerCase()) : undefined;
---

<BaseLayout
  title={title}
  description={pageDescription}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
>
  <PageHero
    compact
    eyebrow={['Writing', 'Series', title]}
    heading={title}
    lede={excerpt}
  />

  <div class="sl-ir">
    <div class="sl-ir__main">
      {sortedPosts.length === 0 ? (
        <StateNotice kind="empty" compact title="No parts published yet." body="This reading path is planned; its first part has not been published." />
      ) : (
        <ol class="sl-list">
          {sortedPosts.map((post, index) => (
            <li>
              <Card as="article" variant="panel" href={post.href ?? `/essays/${post.slug}/`} class="sl-row">
                <span class="sl-row__n" aria-hidden="true">{String(post.part ?? index + 1).padStart(2, '0')}</span>
                <div class="sl-row__body">
                  <div class="sl-row__top">
                    {post.kind && <Badge variant="chip" text={kindLabel[post.kind]} />}
                    {post.date && <time class="s2s-meta" datetime={formatDateISO(post.date)}>{formatDate(post.date)}</time>}
                  </div>
                  <h3 class="sl-row__title">{post.title}</h3>
                  {post.excerpt && <p class="sl-row__excerpt">{post.excerpt}</p>}
                  {post.readTime && <p class="s2s-meta sl-row__read">{post.readTime} min read</p>}
                </div>
              </Card>
            </li>
          ))}
        </ol>
      )}
    </div>

    <aside class="sl-ir__rail" aria-label="About this path">
      <Card variant="panel">
        <SectionHeading title="About this path" level={3} />
        <dl class="sl-about">
          <div class="sl-about__row">
            <dt>Status</dt>
            <dd>
              <span class:list={['sl-status', `sl-status--${status}`]}>
                <span class="sl-status__dot" aria-hidden="true"></span>{statusLabel[status]}
              </span>
            </dd>
          </div>
          <div class="sl-about__row">
            <dt>Parts</dt>
            <dd>{sortedPosts.length}</dd>
          </div>
          {topicHub && (
            <div class="sl-about__row">
              <dt>Topic</dt>
              <dd><a class="s2s-focus" href={`/topics/${topicHub.slug}/`}>{topicHub.label}</a></dd>
            </div>
          )}
        </dl>
        {tags.length > 0 && (
          <div class="sl-about__tags">
            {tags.map((tag) => <Badge variant="chip" href={`/tags/${tag}/`} text={`#${tag}`} />)}
          </div>
        )}
      </Card>
      <Card variant="panel">
        <SectionHeading title="Browse" level={3} />
        <ul class="sl-browse">
          <li><a class="s2s-focus" href="/series/">All series</a></li>
          <li><a class="s2s-focus" href="/tags/">All tags</a></li>
        </ul>
      </Card>
    </aside>
  </div>

  {Astro.slots.has('default') && (
    <div class="sl-body-slot">
      <slot />
    </div>
  )}
</BaseLayout>

<style>
  .sl-ir {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding: 20px 16px 48px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .sl-ir__rail { display: flex; flex-direction: column; gap: 14px; }

  .sl-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .sl-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }
  .sl-row__n {
    font: 400 1.5rem / 1 var(--font-mono);
    color: var(--s2s-ink-subtle);
    letter-spacing: 0.02em;
  }
  .sl-row__body { min-width: 0; }
  .sl-row__top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .sl-row__title {
    margin: 0 0 6px;
    font: var(--type-heading-weight) var(--type-card) / 1.25 var(--font-display);
    color: var(--s2s-ink);
  }
  .sl-row__excerpt {
    margin: 0;
    font: 400 var(--type-ui) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sl-row__read { margin: 8px 0 0; }

  .sl-about { margin: 0; }
  .sl-about__row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 6px 0; font: 400 var(--type-meta) / 1.3 var(--font-sans); }
  .sl-about__row dt { color: var(--s2s-ink-subtle); }
  .sl-about__row dd { margin: 0; color: var(--s2s-ink-soft); }
  .sl-about__row a { color: var(--s2s-accent); text-decoration: none; }
  .sl-about__row a:hover { color: var(--s2s-accent-strong); }
  .sl-about__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }

  .sl-status { display: inline-flex; align-items: center; gap: 6px; }
  .sl-status__dot { width: 6px; height: 6px; border-radius: 999px; background: currentColor; }
  .sl-status--active .sl-status__dot { background: var(--s2s-secondary); box-shadow: 0 0 6px var(--s2s-secondary); }
  .sl-status--planned .sl-status__dot { background: transparent; border: 1px solid var(--s2s-accent); }
  .sl-status--complete .sl-status__dot { background: var(--s2s-ink-muted); }

  .sl-browse { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .sl-browse a { font: 400 var(--type-ui) / 1.3 var(--font-sans); color: var(--s2s-accent); text-decoration: none; }
  .sl-browse a:hover { color: var(--s2s-accent-strong); }

  .sl-body-slot { max-width: 1180px; margin: 0 auto; padding: 0 16px 48px; }

  @media (min-width: 1024px) {
    .sl-ir {
      grid-template-columns: minmax(0, 1fr) var(--s2s-rail);
      gap: 24px 22px;
      padding: 16px 22px 56px 28px;
    }
    .sl-ir__rail { position: sticky; top: calc(var(--s2s-header-h) + 16px); align-self: start; }
    .sl-body-slot { padding: 0 22px 56px 28px; }
  }
</style>
