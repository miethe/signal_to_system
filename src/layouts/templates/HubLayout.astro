---
/**
 * Hub template — a section front (Home, /writing, /labs, /notebooks,
 * /studio in the mockups): hero band, then a stack of sections laid out on
 * a two-column grid.
 *
 * Slot contract
 *   hero-actions  optional  CTA Buttons under the lede
 *   hero-aside    optional  right side of the hero (quote, MethodRail)
 *   default       required  sections; each direct child is a grid item.
 *                           Add class `s2s-span-wide` (7/12), `s2s-span-narrow`
 *                           (5/12), `s2s-span-half`, `s2s-span-major` (8/12),
 *                           `s2s-span-minor` (4/12) or `s2s-span-full` (default).
 *   after         optional  full-width closing band (newsletter, CTA)
 */
import BaseLayout from '../BaseLayout.astro';
import PageHero from '../../components/primitives/PageHero.astro';

interface Props {
  /** Omit on the homepage: the document title is then just the site name. */
  title?: string;
  description?: string;
  heading: string;
  accent?: string;
  eyebrow?: string[];
  lede?: string;
  noindex?: boolean;
  /** Photo hero pass-through (PageHero): Home and About use the observatory band. */
  hero?: {
    photo?: string;
    subheading?: string;
    quote?: { text: string; by?: string };
    rail?: string[];
    railFoot?: string[];
  };
  ogImage?: string;
}
const { title, description, heading, accent, eyebrow, lede, noindex, hero = {}, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex} ogImage={ogImage}>
  <PageHero heading={heading} accent={accent} eyebrow={eyebrow} lede={lede} {...hero}>
    {Astro.slots.has('hero-actions') && <Fragment slot="actions"><slot name="hero-actions" /></Fragment>}
    {Astro.slots.has('hero-aside') && <Fragment slot="aside"><slot name="hero-aside" /></Fragment>}
  </PageHero>
  <div class="s2s-hub">
    <slot />
  </div>
  {Astro.slots.has('after') && <div class="s2s-hub__after"><slot name="after" /></div>}
</BaseLayout>

<style>
  .s2s-hub {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding: 24px 16px 0;
  }
  .s2s-hub__after { padding: 20px 16px 0; }
  @media (min-width: 1024px) {
    .s2s-hub {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 24px 22px;
      padding: 18px 32px 0;
    }
    .s2s-hub > :global(*) { grid-column: span 12; }
    .s2s-hub > :global(.s2s-span-wide) { grid-column: span 7; }
    .s2s-hub > :global(.s2s-span-narrow) { grid-column: span 5; }
    .s2s-hub > :global(.s2s-span-half) { grid-column: span 6; }
    .s2s-hub > :global(.s2s-span-major) { grid-column: span 8; }
    .s2s-hub > :global(.s2s-span-minor) { grid-column: span 4; }
    .s2s-hub__after { padding: 24px 32px 0; }
  }
</style>
