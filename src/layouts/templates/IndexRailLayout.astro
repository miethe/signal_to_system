---
/**
 * Index + rail template — a filterable listing with a right rail (the
 * Writing hub's collection grid + "Start here" / "Popular topics" rail;
 * Labs, Dev Stories and Projects indexes share it).
 *
 * Slot contract
 *   hero-actions  optional  CTA Buttons under the lede
 *   subnav        optional  a row between the hero and the grid, outside
 *                           `data-studio-scope` (the studio Tabs +
 *                           LanguageSwitch row)
 *   toolbar       optional  a FilterToolbar above the index
 *   default       required  the index: cards/rows, any layout
 *   rail          required  280px right rail: FacetRail and rail Cards, stacked
 *   after         optional  full-width band under both columns
 *
 * Below 1024px the rail drops under the index.
 *
 * Studio preview (node_01M35CKMTWWPWA3DJNSGR930A6): pass `scope` on
 * /studio/ pages so the grid carries `data-studio-scope` and
 * LanguageSwitch.astro can re-skin it. Off by default, so a production
 * route never inherits a stored preview language.
 */
import BaseLayout from '../BaseLayout.astro';
import PageHero from '../../components/primitives/PageHero.astro';
import StudioScopeRestore from '../../components/studio/StudioScopeRestore.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  accent?: string;
  eyebrow?: string[];
  lede?: string;
  noindex?: boolean;
  /** Accessible name for the rail landmark. */
  railLabel?: string;
  scope?: boolean;
}
const { title, description, heading, accent, eyebrow, lede, noindex, railLabel = 'Related', scope = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <PageHero heading={heading} accent={accent} eyebrow={eyebrow} lede={lede} compact>
    {Astro.slots.has('hero-actions') && <Fragment slot="actions"><slot name="hero-actions" /></Fragment>}
  </PageHero>
  {Astro.slots.has('subnav') && <div class="s2s-ir__subnav"><slot name="subnav" /></div>}
  <div class="s2s-ir" data-studio-scope={scope ? true : undefined}>
    <div class="s2s-ir__main">
      {Astro.slots.has('toolbar') && <div class="s2s-ir__toolbar"><slot name="toolbar" /></div>}
      <slot />
    </div>
    <aside class="s2s-ir__rail" aria-label={railLabel}>
      <slot name="rail" />
    </aside>
    {Astro.slots.has('after') && <div class="s2s-ir__after"><slot name="after" /></div>}
  </div>
  {scope && <StudioScopeRestore />}
</BaseLayout>

<style>
  .s2s-ir__subnav { padding: 16px 16px 0; }
  .s2s-ir {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding: 20px 16px 0;
  }
  .s2s-ir__toolbar { margin-bottom: 16px; }
  .s2s-ir__rail { display: flex; flex-direction: column; gap: 14px; }
  @media (min-width: 1024px) {
    .s2s-ir__subnav { padding: 16px 22px 0 28px; }
    .s2s-ir {
      grid-template-columns: minmax(0, 1fr) var(--s2s-rail);
      gap: 24px 22px;
      padding: 16px 22px 0 28px;
    }
    .s2s-ir__rail { position: sticky; top: calc(var(--s2s-header-h) + 16px); align-self: start; }
    .s2s-ir__after { grid-column: 1 / -1; }
  }
</style>
