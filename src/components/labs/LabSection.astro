---
/**
 * LabSection — a report section as the storyboard sets it: line icon,
 * serif title, optional number and one-line description, "View all →" at
 * the right; the section id is a permalink target (the report's anchor
 * tabs point here, so they work without JS).
 */
import Icon from '../brand/Icon.astro';

interface Props {
  id: string;
  title: string;
  icon?: string;
  number?: number;
  description?: string;
  action?: { label: string; href: string };
  level?: 2 | 3;
  class?: string;
}
const { id, title, icon, number, description, action, level = 2, class: className } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---

<section class:list={['lab-sec', className]} id={id} aria-labelledby={`${id}-title`}>
  <header class="lab-sec__head">
    {icon && <span class="lab-sec__icon"><Icon name={icon} size={24} /></span>}
    <div class="lab-sec__titles">
      <H class="lab-sec__title" id={`${id}-title`}>
        {number !== undefined && <span class="lab-sec__num">{number}.</span>}
        <a class="lab-sec__anchor s2s-focus" href={`#${id}`}>{title}</a>
      </H>
      {description && <p class="lab-sec__desc">{description}</p>}
    </div>
    {action && <a class="lab-sec__action s2s-focus" href={action.href}>{action.label} <span aria-hidden="true">→</span></a>}
  </header>
  <div class="lab-sec__body"><slot /></div>
</section>

<style>
  .lab-sec { min-width: 0; scroll-margin-top: calc(var(--s2s-header-h) + 16px); }
  .lab-sec__head { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6px 12px; margin-bottom: 14px; }
  .lab-sec__icon { flex: none; margin-top: 2px; color: var(--s2s-accent); }
  .lab-sec__titles { flex: 1 1 260px; min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 16px; }
  .lab-sec__title { margin: 0; font: 400 1.5rem / 1.2 var(--font-display); color: var(--s2s-ink); letter-spacing: var(--type-tracking-display); }
  .lab-sec__num { margin-right: 8px; font-family: var(--font-mono); font-size: 0.8em; color: var(--s2s-ink-subtle); }
  .lab-sec__anchor { color: inherit; text-decoration: none; }
  .lab-sec__anchor:hover { color: var(--s2s-accent-hover); }
  .lab-sec__desc { margin: 0; font: 400 var(--type-body-s) / 1.5 var(--font-sans); color: var(--s2s-ink-subtle); }
  .lab-sec__action { margin-top: 6px; font: 450 var(--type-meta) / 1 var(--font-sans); color: var(--s2s-accent); text-decoration: none; white-space: nowrap; }
  .lab-sec__action:hover { text-decoration: underline; }
</style>
