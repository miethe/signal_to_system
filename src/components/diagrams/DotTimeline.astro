---
/**
 * DotTimeline — the About "Selected timeline" (horizontal, dated) and the
 * Dev Stories "execution -> published" flow (vertical, numbered).
 *
 * Semantics live in an <ol>, so the sequence is real list structure for
 * screen readers and wraps like text. Each step's marker is a small inline
 * SVG (decorative); the rail between markers is a CSS rule on --rule.
 *
 * state: done (filled), current (ring + halo), next (hollow).
 * tone: which role colors the marker — accent | secondary | muted.
 */
interface Item {
  label: string;
  /** Year / date / short kicker shown above the label. */
  date?: string;
  detail?: string;
  state?: 'done' | 'current' | 'next';
  tone?: 'accent' | 'secondary' | 'muted';
}

interface Props {
  items?: Item[];
  orientation?: 'horizontal' | 'vertical';
  numbered?: boolean;
  /** Accessible name for the list. */
  label?: string;
  class?: string;
}

const {
  items = [
    // Deliberately placeholder: real dates and milestones must be passed in.
    { date: 'Date A', label: 'Milestone A', detail: 'Placeholder', tone: 'secondary' },
    { date: 'Date B', label: 'Milestone B', detail: 'Placeholder', tone: 'accent' },
    { date: 'Date C', label: 'Milestone C', detail: 'Placeholder', tone: 'accent' },
    { date: 'Date D', label: 'Milestone D', detail: 'Placeholder', tone: 'secondary' },
    { date: 'Date E', label: 'Milestone E', detail: 'Placeholder', state: 'current', tone: 'accent' },
  ],
  orientation = 'horizontal',
  numbered = false,
  label = 'Timeline',
  class: className,
} = Astro.props;
---

<ol class:list={['s2s-timeline', `s2s-timeline--${orientation}`, numbered && 's2s-timeline--numbered', className]} aria-label={label}>
  {items.map((item, i) => {
    const state = item.state ?? 'done';
    const tone = item.tone ?? 'accent';
    return (
      <li class:list={['s2s-timeline__item', `is-${state}`, `tone-${tone}`]} aria-current={state === 'current' ? 'step' : undefined}>
        <svg class="s2s-timeline__marker" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          {state === 'current' && <circle class="halo" cx="12" cy="12" r="10.5" />}
          {numbered ? (
            <>
              <circle class="num-ring" cx="12" cy="12" r="8.5" />
              <text class="num" x="12" y="12" text-anchor="middle" dominant-baseline="central">{i + 1}</text>
            </>
          ) : (
            <circle class="pip" cx="12" cy="12" r={state === 'next' ? 4.25 : 5} />
          )}
        </svg>
        <div class="s2s-timeline__text">
          {item.date && <span class="s2s-timeline__date">{item.date}</span>}
          <span class="s2s-timeline__label">{item.label}</span>
          {item.detail && <span class="s2s-timeline__detail">{item.detail}</span>}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .s2s-timeline {
    --tl-marker: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    position: relative;
    color: var(--ink, currentColor);
    font-family: var(--font-sans, system-ui, sans-serif);
  }
  .s2s-timeline--horizontal {
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .s2s-timeline--vertical { gap: 18px; }

  /* The rail: one rule behind the markers, from the first marker's center to the last. */
  .s2s-timeline__item { position: relative; display: flex; gap: 12px; }
  .s2s-timeline--horizontal .s2s-timeline__item { flex-direction: column; }
  .s2s-timeline__item::before {
    content: '';
    position: absolute;
    background: var(--rule, currentColor);
    opacity: 0.9;
  }
  .s2s-timeline--horizontal .s2s-timeline__item::before {
    top: calc(var(--tl-marker) / 2 - 0.5px);
    height: 1px;
    left: var(--tl-marker);
    right: -12px;
  }
  .s2s-timeline--vertical .s2s-timeline__item::before {
    left: calc(var(--tl-marker) / 2 - 0.5px);
    width: 1px;
    top: var(--tl-marker);
    bottom: -18px;
  }
  .s2s-timeline__item:last-child::before { display: none; }

  .s2s-timeline__marker { flex-shrink: 0; position: relative; }
  .tone-accent { --tl-tone: var(--accent, currentColor); }
  .tone-secondary { --tl-tone: var(--secondary, currentColor); }
  .tone-muted { --tl-tone: var(--muted, currentColor); }
  .pip { fill: var(--tl-tone); stroke: var(--tl-tone); stroke-width: 1.5; }
  .is-next .pip { fill: var(--canvas, transparent); }
  .halo { fill: none; stroke: var(--tl-tone); stroke-width: 1; opacity: 0.45; }
  .num-ring { fill: var(--canvas, transparent); stroke: var(--tl-tone); stroke-width: 1.5; }
  .is-done .num-ring { fill: var(--tl-tone); }
  .num { font: 600 10px var(--font-mono, ui-monospace, monospace); fill: var(--tl-tone); }
  .is-done .num { fill: var(--canvas, currentColor); }

  .s2s-timeline__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .s2s-timeline--vertical .s2s-timeline__text { padding-top: 2px; }
  .s2s-timeline__date {
    font: 600 13px var(--font-sans, system-ui, sans-serif);
    color: var(--ink, currentColor);
  }
  .s2s-timeline__label { font-size: 13px; line-height: 1.35; color: var(--ink, currentColor); }
  .s2s-timeline__detail { font-size: 12px; line-height: 1.35; color: var(--muted, currentColor); }
  .is-next .s2s-timeline__label { color: var(--muted, currentColor); }
</style>
