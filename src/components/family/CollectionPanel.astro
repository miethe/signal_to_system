---
/**
 * CollectionPanel — a bordered section for one kind of thing: icon, small
 * caps title, count, a one-line description, a "View all →" action, then
 * its body (a featured card, a list, a grid).
 *
 * Writing: the four format panels on /writing (Essays, Field Notes, Dev
 * Stories, Guides / Companions). Labs reuse (labs-storyboard): "All
 * investigations", and the Sources / Figures / Artifacts sections of a
 * report, which are the same shape with a card grid as the body.
 */
import Icon from '../brand/Icon.astro';

interface Props {
  title: string;
  icon?: string;
  count?: number;
  countNoun?: [string, string];
  description?: string;
  action?: { label: string; href: string };
  id?: string;
  class?: string;
  [key: string]: unknown;
}
const { title, icon, count, countNoun = ['piece', 'pieces'], description, action, id, class: className, ...rest } = Astro.props;
const hid = id ?? `panel-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class:list={['s2s-panel', className]} aria-labelledby={hid} {...rest}>
  <header class="s2s-panel__head">
    {icon && <span class="s2s-panel__icon"><Icon name={icon} size={24} /></span>}
    <div class="s2s-panel__titles">
      <h2 class="s2s-panel__title" id={hid}>{title}</h2>
      {count !== undefined && <span class="s2s-panel__count">{count} {count === 1 ? countNoun[0] : countNoun[1]}</span>}
    </div>
    {action && <a class="s2s-panel__action s2s-focus" href={action.href}>{action.label} <span aria-hidden="true">→</span></a>}
    {description && <p class="s2s-panel__desc">{description}</p>}
  </header>
  <div class="s2s-panel__body"><slot /></div>
</section>

<style>
  .s2s-panel {
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--s2s-rule);
    border-radius: var(--s2s-radius-card);
    background: var(--s2s-surface);
    box-shadow: var(--s2s-shadow-card);
  }
  .s2s-panel__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 12px;
    row-gap: 6px;
    margin-bottom: 16px;
  }
  .s2s-panel__icon { grid-row: span 2; align-self: start; color: var(--s2s-accent); }
  .s2s-panel__titles { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; min-width: 0; }
  .s2s-panel__title {
    margin: 0;
    font: 500 var(--type-ui) / 1.3 var(--font-sans);
    letter-spacing: var(--type-tracking-caps);
    text-transform: uppercase;
    color: var(--s2s-ink);
  }
  .s2s-panel__count { font: 400 var(--type-meta) / 1.3 var(--font-sans); color: var(--s2s-ink-subtle); }
  .s2s-panel__action {
    font: 450 var(--type-meta) / 1.3 var(--font-sans);
    color: var(--s2s-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .s2s-panel__action:hover { color: var(--s2s-accent-hover); text-decoration: none; }
  .s2s-panel__desc {
    grid-column: 2 / -1;
    margin: 0;
    font: 400 var(--type-body-s) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .s2s-panel:not(:has(.s2s-panel__icon)) .s2s-panel__desc { grid-column: 1 / -1; }
  @media (max-width: 480px) {
    .s2s-panel { padding: 14px; }
    .s2s-panel__head { grid-template-columns: auto minmax(0, 1fr); }
    .s2s-panel__action { grid-column: 2; justify-self: start; }
    .s2s-panel__icon { grid-row: span 3; }
  }
</style>
