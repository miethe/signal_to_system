---
/**
 * EntryRow — one compact list row: a small kind label, a serif title and a
 * MetaLine, with a trailing arrow. For the "more in this collection" list
 * under a FeatureCard.
 *
 * Writing: the remaining pieces in a /writing format panel. Labs reuse:
 * compact rows for claims, sources and timeline entries where a full card
 * is too heavy (labs-storyboard: claims/evidence and resources pages).
 */
import MetaLine from './MetaLine.astro';

interface Props {
  href: string;
  title: string;
  kind?: string;
  meta?: { label: string; value?: string | number; icon?: string; datetime?: string }[];
  class?: string;
  [key: string]: unknown;
}
const { href, title, kind, meta = [], class: className, ...rest } = Astro.props;
---

<li class:list={['s2s-row', className]} {...rest}>
  <a class="s2s-row__link s2s-focus" href={href}>
    <span class="s2s-row__text">
      {kind && <span class="s2s-row__kind">{kind}</span>}
      <span class="s2s-row__title">{title}</span>
      <MetaLine items={meta} />
    </span>
    <span class="s2s-row__arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .s2s-row { list-style: none; }
  .s2s-row + .s2s-row { border-top: 1px solid var(--s2s-rule); }
  .s2s-row__link { display: flex; align-items: center; gap: 12px; padding: 12px 4px; text-decoration: none; }
  .s2s-row__link:hover { text-decoration: none; }
  .s2s-row__text { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
  .s2s-row__kind {
    font: 500 var(--type-micro) / 1.3 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--s2s-ink-subtle);
  }
  .s2s-row__title { font: 400 1.0625rem / 1.3 var(--font-display); color: var(--s2s-ink); }
  .s2s-row__link:hover .s2s-row__title { color: var(--s2s-accent); }
  .s2s-row__arrow { color: var(--s2s-ink-subtle); }
  .s2s-row__link:hover .s2s-row__arrow { color: var(--s2s-accent); }
</style>
