---
/**
 * Pill — a small status/provenance label: a tinted pill in one role tone.
 *
 * Writing: Dev Stories provenance ("Human + agent", "Automated",
 * "Reviewed") and post-type pills ("After-action review") on cards and
 * panel headings. Labs reuse (labs-storyboard): evidence and claim status
 * ("Supported", "Partial", "Open question") and a report's state pill.
 *
 * tone: neutral (rule edge, muted ink) | accent | secondary | ok | warn |
 * danger | info (Labs: contradicted claims, unresolved claims).
 * dot: a leading status dot (Labs claim/evidence status).
 * caps: small-caps tracking for panel-heading pills.
 * Honesty rule for callers: a pill states a recorded fact (frontmatter),
 * never an inferred one.
 */
export type PillTone = 'neutral' | 'accent' | 'secondary' | 'ok' | 'warn' | 'danger' | 'info';
interface Props {
  label: string;
  tone?: PillTone;
  caps?: boolean;
  dot?: boolean;
  title?: string;
  class?: string;
}
const { label, tone = 'neutral', caps = false, dot = false, title, class: className } = Astro.props;
---

<span class:list={['s2s-pill', `s2s-pill--${tone}`, caps && 's2s-pill--caps', dot && 's2s-pill--dot', className]} title={title}>{label}</span>

<style>
  .s2s-pill {
    --pill-tone: var(--s2s-ink-muted);
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    border: 1px solid color-mix(in srgb, var(--pill-tone) 45%, var(--s2s-rule));
    border-radius: var(--s2s-radius-pill);
    background: color-mix(in srgb, var(--pill-tone) 10%, transparent);
    font: 500 var(--type-micro) / 1.45 var(--font-sans);
    color: var(--pill-tone);
    white-space: nowrap;
  }
  .s2s-pill--neutral {
    border-color: var(--s2s-rule-strong);
    background: color-mix(in srgb, var(--s2s-canvas) 55%, transparent);
  }
  .s2s-pill--accent { --pill-tone: var(--s2s-accent-label); }
  .s2s-pill--secondary { --pill-tone: var(--s2s-secondary); }
  .s2s-pill--ok { --pill-tone: var(--s2s-status-ok); }
  .s2s-pill--warn { --pill-tone: var(--s2s-status-warn); }
  .s2s-pill--danger { --pill-tone: var(--s2s-status-danger); }
  .s2s-pill--info { --pill-tone: var(--s2s-status-info); }
  .s2s-pill--dot::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--pill-tone);
  }
  .s2s-pill--neutral.s2s-pill--dot::before { background: transparent; border: 1.5px solid var(--s2s-ink-subtle); }
  .s2s-pill--caps { padding: 2px 10px; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.6875rem; }
</style>
