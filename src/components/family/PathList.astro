---
/**
 * PathList — a rail module of guided links: a heading row (icon, serif
 * title, optional "View all →"), an optional intro line, then rows of
 * [marker] title / subtitle [→]. The marker is a step number ("Start
 * here"), an icon, or nothing.
 *
 * Writing: "Start here" and "Reading paths" on /writing. Labs reuse
 * (labs-storyboard): "Start in Labs", "Research programs", and the
 * "Explore the research" section links on a report.
 */
import Card from '../primitives/Card.astro';
import Icon from '../brand/Icon.astro';

interface Item { title: string; href: string; sub?: string; icon?: string; current?: boolean }
interface Props {
  heading: string;
  items: Item[];
  icon?: string;
  intro?: string;
  numbered?: boolean;
  action?: { label: string; href: string };
  class?: string;
}
const { heading, items, icon, intro, numbered = false, action, class: className } = Astro.props;
const hid = `paths-${heading.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<Card as="aside" class:list={['s2s-paths', className]} aria-labelledby={hid}>
  <div class="s2s-paths__head">
    {icon && <span class="s2s-paths__icon"><Icon name={icon} size={22} /></span>}
    <h3 id={hid} class="s2s-paths__title">{heading}</h3>
    {action && <a class="s2s-paths__action s2s-focus" href={action.href}>{action.label} <span aria-hidden="true">→</span></a>}
  </div>
  {intro && <p class="s2s-paths__intro">{intro}</p>}
  <ol class:list={['s2s-paths__list', numbered && 's2s-paths__list--numbered']}>
    {items.map((it, i) => (
      <li>
        <a class="s2s-path s2s-focus" href={it.href} aria-current={it.current ? 'true' : undefined}>
          {numbered ? <span class="s2s-path__step" aria-hidden="true">{i + 1}</span> : it.icon ? <span class="s2s-path__icon"><Icon name={it.icon} size={20} /></span> : null}
          <span class="s2s-path__text">
            <span class="s2s-path__title">{it.title}</span>
            {it.sub && <span class="s2s-path__sub">{it.sub}</span>}
          </span>
          <span class="s2s-path__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</Card>

<style>
  .s2s-paths__head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .s2s-paths__icon { color: var(--s2s-secondary); }
  .s2s-paths__title { flex: 1; margin: 0; font: 400 1.25rem / 1.2 var(--font-display); color: var(--s2s-ink); }
  .s2s-paths__action { font: 450 var(--type-meta) / 1 var(--font-sans); color: var(--s2s-accent); text-decoration: none; white-space: nowrap; }
  .s2s-paths__intro { margin: 0 0 12px; font: 400 var(--type-body-s) / 1.5 var(--font-sans); color: var(--s2s-ink-muted); }
  .s2s-paths__list { display: flex; flex-direction: column; margin: 8px 0 0; padding: 0; list-style: none; }
  .s2s-paths__list > li + li { border-top: 1px solid var(--s2s-rule); }
  .s2s-path {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 4px;
    color: var(--s2s-ink);
    text-decoration: none;
  }
  .s2s-path:hover { text-decoration: none; }
  .s2s-path:hover .s2s-path__title, .s2s-path[aria-current='true'] .s2s-path__title { color: var(--s2s-accent); }
  .s2s-path__step {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border: 1px solid var(--s2s-rule-emphasis);
    border-radius: 999px;
    font: 400 var(--type-body-s) / 1 var(--font-display);
    color: var(--s2s-ink-soft);
  }
  .s2s-path__icon { flex-shrink: 0; color: var(--s2s-accent); }
  .s2s-path__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .s2s-path__title { font: 400 var(--type-body-s) / 1.3 var(--font-display); font-size: 0.9375rem; color: var(--s2s-ink); }
  .s2s-path__sub { font: 400 var(--type-micro) / 1.4 var(--font-sans); color: var(--s2s-ink-subtle); }
  .s2s-path__arrow { flex-shrink: 0; color: var(--s2s-ink-subtle); }
  .s2s-path:hover .s2s-path__arrow { color: var(--s2s-accent); }
</style>
