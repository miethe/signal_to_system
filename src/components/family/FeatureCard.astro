---
/**
 * FeatureCard — media on the left, then an accent eyebrow ("FEATURED
 * ESSAY"), a serif title, a dek, a MetaLine and chips; optional actions.
 * Collapses to media-on-top below 560px.
 *
 * Writing: the featured piece inside each /writing format panel. Labs
 * reuse (labs-storyboard): the featured investigation (eyebrow "FEATURED
 * INVESTIGATION", MetaLine of claim/source/figure/artifact counts, and
 * "Open report / See evidence" actions in the `actions` slot), and the
 * investigation grid cards via `layout="stack"`.
 *
 * Pills: `pills` (type / provenance, Dev Stories; evidence status, Labs).
 *
 * Media: `image` (a public path) or the `media` slot (e.g. a V2Image); with
 * neither, a quiet format glyph panel so the card never shows a broken box.
 */
import Icon from '../brand/Icon.astro';
import MetaLine from './MetaLine.astro';
import Pill, { type PillTone } from './Pill.astro';

interface Props {
  href: string;
  title: string;
  eyebrow?: string;
  dek?: string;
  image?: string;
  imageAlt?: string;
  glyph?: string;
  meta?: { label: string; value?: string | number; icon?: string; datetime?: string }[];
  chips?: { label: string; href?: string }[];
  /** Type / provenance pills above the title (Dev Stories; Labs evidence status). */
  pills?: { label: string; tone?: PillTone }[];
  /** side: compact media column (inside a panel); wide: big split (a page's lead item); stack: media on top (grids). */
  layout?: 'side' | 'wide' | 'stack';
  headingLevel?: 2 | 3 | 4;
  class?: string;
}
const {
  href, title, eyebrow, dek, image, imageAlt = '', glyph = 'essays', meta = [], chips = [], pills = [],
  layout = 'side', headingLevel = 3, class: className,
} = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const hasActions = Astro.slots.has('actions');
---

<article class:list={['s2s-feature', `s2s-feature--${layout}`, className]}>
  <div class="s2s-feature__media" aria-hidden={image || Astro.slots.has('media') ? undefined : 'true'}>
    {Astro.slots.has('media') ? <slot name="media" /> : image ? (
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    ) : (
      <span class="s2s-feature__glyph"><Icon name={glyph} size={40} /></span>
    )}
  </div>
  <div class="s2s-feature__body">
    {pills.length > 0 && (
      <p class="s2s-feature__pills">{pills.map((p) => <Pill label={p.label} tone={p.tone} />)}</p>
    )}
    {eyebrow && <p class="s2s-feature__eyebrow">{eyebrow}</p>}
    <H class="s2s-feature__title"><a class="s2s-feature__link s2s-focus" href={href}>{title}</a></H>
    {dek && <p class="s2s-feature__dek">{dek}</p>}
    <MetaLine items={meta} class="s2s-feature__meta" />
    {chips.length > 0 && (
      <ul class="s2s-feature__chips">
        {chips.map((c) => (
          <li>{c.href ? <a class="s2s-feature__chip s2s-focus" href={c.href}>{c.label}</a> : <span class="s2s-feature__chip">{c.label}</span>}</li>
        ))}
      </ul>
    )}
    {hasActions && <div class="s2s-feature__actions"><slot name="actions" /></div>}
  </div>
</article>

<style>
  .s2s-feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 14px;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--s2s-rule);
    border-radius: var(--s2s-radius-card);
    background: var(--s2s-canvas-raised);
    transition: border-color var(--s2s-dur) ease;
  }
  .s2s-feature:hover { border-color: var(--s2s-rule-emphasis); }
  @media (min-width: 420px) {
    .s2s-feature--side { grid-template-columns: 132px minmax(0, 1fr); gap: 16px; }
    .s2s-feature--side .s2s-feature__media { aspect-ratio: 1 / 1.05; }
  }
  @media (min-width: 640px) {
    .s2s-feature--wide { grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr); gap: 20px; }
  }
  .s2s-feature__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--s2s-radius-card) - 4px);
    background: var(--s2s-inset);
  }
  .s2s-feature--stack .s2s-feature__media { aspect-ratio: 16 / 7; }
  /* A glyph placeholder never needs a photo-sized box on one column. */
  @media (max-width: 419px) {
    .s2s-feature__media:has(.s2s-feature__glyph) { aspect-ratio: 16 / 5; }
  }
  .s2s-feature__media img,
  .s2s-feature__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .s2s-feature__glyph {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--s2s-accent);
    background: radial-gradient(ellipse at 30% 20%, var(--s2s-accent-soft), transparent 70%);
  }
  .s2s-feature__body { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 4px 4px 4px 0; }
  .s2s-feature--stack .s2s-feature__body { padding: 0 4px 4px; }
  .s2s-feature__pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .s2s-feature__eyebrow {
    margin: 0;
    font: 500 var(--type-micro) / 1.3 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--s2s-secondary);
  }
  .s2s-feature__title { margin: 0; font: 400 1.3125rem / 1.2 var(--font-display); letter-spacing: -0.01em; }
  .s2s-feature--wide .s2s-feature__title { font-size: var(--type-title); }
  .s2s-feature__link { color: var(--s2s-ink); text-decoration: none; }
  /* The whole card is the target; the title link carries the name. */
  .s2s-feature__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .s2s-feature__link:hover { color: var(--s2s-ink); text-decoration: none; }
  .s2s-feature:has(.s2s-feature__link:hover) { border-color: var(--s2s-accent); }
  .s2s-feature__dek {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font: 400 var(--type-body-s) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .s2s-feature--wide .s2s-feature__dek { -webkit-line-clamp: 4; }
  .s2s-feature__chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 0; padding: 0; list-style: none; }
  .s2s-feature__chip {
    position: relative;
    z-index: 1;
    display: inline-flex;
    padding: 3px 10px;
    border: 1px solid var(--s2s-rule-strong);
    border-radius: var(--s2s-radius-pill);
    font: 450 var(--type-micro) / 1.4 var(--font-sans);
    color: var(--s2s-ink-muted);
    text-decoration: none;
  }
  a.s2s-feature__chip:hover { border-color: var(--s2s-accent); color: var(--s2s-ink); text-decoration: none; }
  .s2s-feature__actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
</style>
