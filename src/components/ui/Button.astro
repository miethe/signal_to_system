---
/**
 * Button — renders as <a> when href is provided, otherwise <button>.
 *
 * Props:
 *   variant  — visual style
 *   size     — sm | md | lg
 *   href     — optional link target
 *
 * v2 (Observatory) variants, from the mockups' hero and card CTAs:
 *   signal   — lavender fill, dark ink ("Explore Labs →", "View Investigation →")
 *   outline  — transparent with an emphasis rule ("Read Essays", "See Evidence")
 * The v1 variants are unchanged.
 */

interface Props {
  variant?: "primary" | "secondary" | "ghost" | "signal" | "outline";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all focus-ring disabled:opacity-50 disabled:pointer-events-none";

const variants: Record<string, string> = {
  primary:
    "bg-primary text-primary-foreground hover:bg-primary/90 !text-primary-foreground",
  secondary:
    "bg-[var(--bg-surface)] text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] border border-[var(--border-subtle)] !text-[var(--text-primary)]",
  ghost:
    "bg-transparent text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] !text-[var(--text-secondary)]",
  signal: "s2s-btn s2s-btn--signal",
  outline: "s2s-btn s2s-btn--outline",
};

const sizes: Record<string, string> = {
  sm: "text-xs px-3 py-1.5",
  md: "text-sm px-4 py-2",
  lg: "text-base px-6 py-3",
};

const v2 = variant === "signal" || variant === "outline";
const cls = (v2
  ? [variants[variant], `s2s-btn--${size}`, "s2s-focus", className]
  : [base, variants[variant] ?? variants.primary, sizes[size] ?? sizes.md, className]
).join(" ");
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <slot />
    </button>
  )
}

<style is:global>
  .s2s-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 4px;
    font: 500 var(--type-ui) / 1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--s2s-dur) ease, border-color var(--s2s-dur) ease, color var(--s2s-dur) ease;
  }
  .s2s-btn--sm { height: 28px; padding: 0 14px; font-size: var(--type-micro); }
  .s2s-btn--md { height: 32px; padding: 0 22px; }
  .s2s-btn--lg { height: 34px; padding: 0 30px; }
  .s2s-btn--signal {
    border: 1px solid var(--s2s-accent-strong);
    background: var(--s2s-accent-strong);
    color: var(--s2s-on-accent);
  }
  .s2s-btn--signal:hover {
    background: var(--s2s-accent-strong-hover);
    border-color: var(--s2s-accent-strong-hover);
    color: var(--s2s-on-accent);
  }
  .s2s-btn--outline {
    border: 1px solid var(--s2s-rule-emphasis);
    background: transparent;
    color: var(--s2s-ink-soft);
  }
  .s2s-btn--outline:hover {
    border-color: var(--s2s-ink-subtle);
    background: var(--s2s-inset);
    color: var(--s2s-ink);
  }
</style>
