---
/**
 * The Signal to System orbit/trail mark, inline.
 *
 * Ring = var(--accent), trail = var(--secondary): each language recolors the
 * mark with no new asset (02 §3). At 24px and below the optical "small" cut
 * is used automatically, because the full mark's 2px ring / 1.5px trail
 * rasterize to sub-pixel hairlines at favicon sizes.
 *
 * `variant="constellation"` is the reserve network mark (not for <= 20px).
 */
interface Props {
  size?: number;
  variant?: 'auto' | 'full' | 'small' | 'constellation';
  /** Accessible name. Set `decorative` when a visible wordmark sits next to it. */
  label?: string;
  decorative?: boolean;
  class?: string;
}

const { size = 32, variant = 'auto', label = 'Signal to System', decorative = false, class: className } = Astro.props;
const cut = variant === 'auto' ? (size <= 24 ? 'small' : 'full') : variant;
const a11y = decorative ? { 'aria-hidden': 'true', focusable: 'false' } : { role: 'img', 'aria-label': label };
---

{cut === 'small' && (
  <svg viewBox="0 0 16 16" width={size} height={size} class:list={['s2s-mark', className]} {...a11y}>
    {!decorative && <title>{label}</title>}
    <circle class="ring" cx="8" cy="8" r="4.75" stroke-width="1.5" />
    <path class="trail" d="M1.5 11.5L14.5 5.4" stroke-width="1.35" />
  </svg>
)}
{cut === 'full' && (
  <svg viewBox="0 0 32 32" width={size} height={size} class:list={['s2s-mark', className]} {...a11y}>
    {!decorative && <title>{label}</title>}
    <circle class="ring" cx="15.6" cy="16" r="9" stroke-width="2" />
    <path class="trail" d="M5 22L27 11.75" stroke-width="1.5" />
  </svg>
)}
{cut === 'constellation' && (
  <svg viewBox="0 0 32 32" width={size} height={size} class:list={['s2s-mark', 's2s-mark--constellation', className]} {...a11y}>
    {!decorative && <title>{label}</title>}
    <path class="edge" d="M17.88 8.78L9.43 19.82M20 9.5v6.3M10.82 21.82l6.12-1.88M22.26 21.26l2.62 2.62" stroke-width="1.5" />
    <g class="ring" stroke-width="1.5">
      <circle cx="20" cy="6" r="2.5" />
      <circle cx="7" cy="23" r="3" />
      <circle cx="20" cy="19" r="2.2" />
      <circle cx="27" cy="26" r="2" />
    </g>
    <g class="core">
      <circle cx="20" cy="6" r="1" />
      <circle cx="7" cy="23" r="1.2" />
      <circle cx="27" cy="26" r=".8" />
    </g>
  </svg>
)}

<style is:global>
  .s2s-mark { flex-shrink: 0; fill: none; stroke-linecap: round; }
  .s2s-mark .ring { stroke: var(--mark-ring, var(--accent, currentColor)); }
  .s2s-mark .trail { stroke: var(--mark-trail, var(--secondary, currentColor)); }
  .s2s-mark .edge { stroke: var(--muted, currentColor); }
  .s2s-mark .core { fill: var(--mark-trail, var(--secondary, currentColor)); stroke: none; }
</style>
