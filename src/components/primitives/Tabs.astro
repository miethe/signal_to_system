---
/**
 * Tabs — the Studio mockup's section tabs: boxed items with a line icon, a
 * title and a one-line subtitle; the current tab is outlined and washed in
 * accent. These are navigation tabs (each item is a link to a view), which
 * is what every mockup instance shows, so they render as a <nav> list with
 * aria-current rather than an ARIA tablist. For in-page panels, wrap
 * @miethe/ui's Tabs (Radix) instead; see docs/design/shell.md.
 */
import Icon from '../brand/Icon.astro';

interface Item { label: string; href: string; sub?: string; icon?: string; current?: boolean }
interface Props {
  items: Item[];
  label: string;
  aside?: string;
  class?: string;
}
const { items, label, aside, class: className } = Astro.props;
---

<nav class:list={['s2s-tabs', className]} aria-label={label}>
  <ul>
    {items.map((it) => (
      <li>
        <a href={it.href} class="s2s-tab s2s-focus" aria-current={it.current ? 'page' : undefined}>
          {it.icon && <span class="s2s-tab__icon"><Icon name={it.icon} size={22} /></span>}
          <span class="s2s-tab__text">
            <span class="s2s-tab__label">{it.label}</span>
            {it.sub && <span class="s2s-tab__sub">{it.sub}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
  {aside && <p class="s2s-tabs__aside">{aside}</p>}
</nav>

<style>
  .s2s-tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; min-width: 0; max-width: 100%; }
  .s2s-tabs ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .s2s-tab {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 186px;
    height: 44px;
    padding: 0 16px;
    border: 1px solid var(--s2s-rule);
    border-radius: 6px;
    background: var(--s2s-surface);
    color: var(--s2s-ink-soft);
    text-decoration: none;
    transition: border-color var(--s2s-dur) ease, color var(--s2s-dur) ease;
  }
  .s2s-tab:hover { border-color: var(--s2s-rule-emphasis); color: var(--s2s-ink); }
  .s2s-tab[aria-current='page'] {
    border-color: var(--s2s-accent);
    background: var(--s2s-accent-soft);
    color: var(--s2s-accent-hover);
  }
  .s2s-tab__icon { display: inline-flex; color: currentColor; --icon-accent: var(--s2s-accent); }
  .s2s-tab__text { display: flex; flex-direction: column; gap: 2px; }
  .s2s-tab__label { font: 450 var(--type-ui) / 1.1 var(--font-sans); }
  .s2s-tab__sub { font: 400 0.625rem / 1.1 var(--font-sans); color: var(--s2s-ink-subtle); }
  .s2s-tab[aria-current='page'] .s2s-tab__sub { color: var(--s2s-accent); }
  .s2s-tabs__aside {
    margin: 0 0 0 auto;
    font: 400 var(--type-micro) / 1.3 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  @media (max-width: 639px) {
    .s2s-tabs { width: 100%; }
    .s2s-tabs ul { flex-wrap: nowrap; overflow-x: auto; width: 100%; min-width: 0; padding-bottom: 4px; }
    .s2s-tab { min-width: max-content; }
  }
</style>
