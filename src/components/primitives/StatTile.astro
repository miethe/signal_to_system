---
/**
 * StatTile — one row of the mockup's "Evidence at a glance": an icon in a
 * rounded well, a serif figure over a short label, and a muted note at the
 * right. Stack several inside a Card; adjacent tiles get a hairline divider.
 */
import Icon from '../brand/Icon.astro';

interface Props {
  value: string | number;
  label: string;
  note?: string;
  icon?: string;
  href?: string;
  class?: string;
}
const { value, label, note, icon, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['s2s-stat', href && 's2s-focus', className]}>
  {icon && <span class="s2s-stat__well"><Icon name={icon} size={20} /></span>}
  <span class="s2s-stat__figure">
    <span class="s2s-stat__value">{value}</span>
    <span class="s2s-stat__label">{label}</span>
  </span>
  {note && <span class="s2s-stat__note">{note}</span>}
</Tag>

<style>
  .s2s-stat {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 9px 0;
    color: var(--s2s-ink);
    text-decoration: none;
  }
  .s2s-stat + .s2s-stat { border-top: 1px solid var(--s2s-rule); }
  .s2s-stat__well {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--s2s-rule-strong);
    border-radius: 8px;
    background: var(--s2s-inset);
    color: var(--s2s-ink-soft);
    --icon-accent: var(--s2s-accent);
  }
  .s2s-stat__figure { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .s2s-stat__value {
    font: 400 1.125rem / 1 var(--font-display);
    color: var(--s2s-ink);
  }
  .s2s-stat__label {
    font: 400 var(--type-micro) / 1.2 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .s2s-stat__note {
    font: 400 var(--type-micro) / 1.3 var(--font-sans);
    color: var(--s2s-ink-muted);
    text-align: right;
  }
  a.s2s-stat:hover .s2s-stat__value { color: var(--s2s-accent); }
</style>
