---
/**
 * ThreadDock — the compact beat list inside `ReadingCompanion`, replacing
 * `ThreadRail`'s role there (ARCHITECTURE.md §5, DIRECTION.md V3/V5).
 *
 * P0-B ships this as static, server-rendered markup: every beat links to
 * its inline anchor in the essay, plus a per-beat "Explore" link straight
 * to that beat's Thread Focus route — both real links, so the dock works
 * fully without JavaScript. Follow/hold-preview behavior (V6's
 * "held preview" vs "reading" split) and any live active-beat styling
 * driven by a scroll/section observer are P1 (component-ownership table:
 * ThreadDock is P1) — this component accepts an optional `activeBeatId`
 * so a later P1/P0-C pass can set `aria-current="step"` on the matching
 * row without touching this file's markup, but nothing here computes that
 * value today.
 */
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  activeBeatId?: string;
}

const { slug, activeBeatId } = Astro.props;
const thread = threads[slug];
---

{
  thread && (
    <nav class="thread-dock" aria-label={`Running example: ${thread.title}`} data-thread-dock>
      <p class="thread-dock__eyebrow font-mono">Running example</p>
      <p class="thread-dock__title font-serif">{thread.title}</p>

      <ol class="thread-dock__list">
        {
          thread.beats.map((beat) => (
            <li class="thread-dock__item">
              <a
                href={`#thread-${beat.id}`}
                class="thread-dock__link"
                data-thread-dock-link
                data-beat-id={beat.id}
                aria-current={beat.id === activeBeatId ? 'step' : undefined}
              >
                <span class="thread-dock__number font-mono" aria-hidden="true">
                  {beat.n}
                </span>
                <span class="thread-dock__label">{beat.label}</span>
              </a>
              <a class="thread-dock__explore" href={`/essays/${slug}/thread/${beat.id}/`}>
                Explore
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  )
}

<style>
  .thread-dock {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    padding: 0.875rem 0.875rem 0.75rem;
  }

  .thread-dock__eyebrow {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .thread-dock__title {
    margin: 0.2rem 0 0.6rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .thread-dock__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread-dock__item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .thread-dock__link {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: baseline;
    gap: 0.5rem;
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.4rem;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .thread-dock__link:hover,
  .thread-dock__link:focus-visible {
    background: var(--accent-subtle);
    color: var(--text-primary);
    outline: none;
  }

  .thread-dock__link:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .thread-dock__link[aria-current='step'] {
    background: var(--accent-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  .thread-dock__number {
    flex-shrink: 0;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-tertiary);
  }

  .thread-dock__link[aria-current='step'] .thread-dock__number {
    color: var(--accent-text);
  }

  .thread-dock__label {
    min-width: 0;
  }

  .thread-dock__explore {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    text-decoration: none;
    padding: 0.2rem 0.35rem;
  }

  .thread-dock__explore:hover,
  .thread-dock__explore:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
