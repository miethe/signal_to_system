---
/**
 * AutomatedDisclaimer — provenance banner for Dev Stories.
 *
 * Signals that a dev story is an artifact of the agentic execution workflow,
 * assembled and edited with AI help. Used on the /dev-stories/ index (banner)
 * and at the top of each automated story (banner), or inline elsewhere.
 *
 * Props:
 *   variant   — "banner" (default) for a full callout, "inline" for a compact note
 *   text      — override copy; defaults to site.devStories.disclaimer(Short)
 *   sourceAar — optional provenance label (internal-safe string only)
 */
import { site } from "../../data/site";

interface Props {
  variant?: "banner" | "inline";
  text?: string;
  sourceAar?: string;
  class?: string;
}

const { variant = "banner", text, sourceAar, class: className = "" } = Astro.props;

const copy =
  text ??
  (variant === "inline"
    ? site.devStories.disclaimerShort
    : site.devStories.disclaimer);
---

{
  variant === "inline" ? (
    <p class={`flex items-start gap-2 text-xs text-[var(--text-tertiary)] ${className}`}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mt-0.5 shrink-0 text-[var(--accent)]"
        aria-hidden="true"
      >
        <path d="M12 8V4H8" />
        <rect width="16" height="12" x="4" y="8" rx="2" />
        <path d="M2 14h2M20 14h2M15 13v2M9 13v2" />
      </svg>
      <span>{copy}</span>
    </p>
  ) : (
    <aside
      class={`rounded-lg border border-[var(--border-subtle)] bg-[var(--accent-subtle)] p-4 sm:p-5 ${className}`}
      role="note"
      aria-label="Automated content notice"
    >
      <div class="flex items-start gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mt-0.5 shrink-0 text-[var(--accent)]"
          aria-hidden="true"
        >
          <path d="M12 8V4H8" />
          <rect width="16" height="12" x="4" y="8" rx="2" />
          <path d="M2 14h2M20 14h2M15 13v2M9 13v2" />
        </svg>
        <div class="space-y-1">
          <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-[var(--accent)]">
            Automated · Agentic Build Loop
          </p>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{copy}</p>
          {sourceAar && (
            <p class="font-mono text-[11px] text-[var(--text-disabled)]">
              Source: {sourceAar}
            </p>
          )}
        </div>
      </div>
    </aside>
  )
}
