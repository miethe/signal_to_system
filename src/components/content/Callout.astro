---
/**
 * Callout — styled callout box for MDX content.
 *
 * Props:
 *   type  — "info" | "warning" | "leader-takeaway" | "why-it-matters"
 *   title — optional heading (defaults to type label if omitted)
 *
 * Usage in MDX:
 *   <Callout type="leader-takeaway" title="The Takeaway">
 *     Your content here.
 *   </Callout>
 */

interface Props {
  type?: "info" | "warning" | "leader-takeaway" | "why-it-matters";
  title?: string;
}

const { type = "info", title } = Astro.props;

interface CalloutConfig {
  label: string;
  containerCls: string;
  iconCls: string;
  titleCls: string;
  icon: string; // raw SVG path data
}

const configs: Record<string, CalloutConfig> = {
  info: {
    label: "Note",
    containerCls: "border-l-2 border-[var(--accent-muted)] bg-transparent",
    iconCls: "text-[var(--accent-text)]",
    titleCls: "text-[var(--text-primary)]",
    icon: "info",
  },
  warning: {
    label: "Warning",
    containerCls: "border-l-2 border-[var(--accent-muted)] bg-transparent",
    iconCls: "text-[var(--accent-text)]",
    titleCls: "text-[var(--text-primary)]",
    icon: "warning",
  },
  "leader-takeaway": {
    label: "Leader Takeaway",
    containerCls: "border-l-2 border-[var(--accent-muted)] bg-transparent",
    iconCls: "text-[var(--accent-text)]",
    titleCls: "text-[var(--text-primary)]",
    icon: "star",
  },
  "why-it-matters": {
    label: "Why It Matters",
    containerCls: "border-l-2 border-[var(--accent-muted)] bg-transparent",
    iconCls: "text-[var(--accent-text)]",
    titleCls: "text-[var(--text-primary)]",
    icon: "zap",
  },
};

const cfg = configs[type] ?? configs.info;
const displayTitle = title ?? cfg.label;
---

<aside
  class={`my-5 flex gap-3 py-1 pl-4 pr-1 ${cfg.containerCls}`}
  role="note"
>
  <!-- Icon -->
  <div class={`mt-0.5 shrink-0 ${cfg.iconCls}`} aria-hidden="true">
    {
      cfg.icon === "info" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
      )
    }
    {
      cfg.icon === "warning" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </svg>
      )
    }
    {
      cfg.icon === "star" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
      )
    }
    {
      cfg.icon === "zap" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
      )
    }
  </div>

  <!-- Content -->
  <div class="min-w-0 flex-1">
    <p class={`mb-0.5 text-xs font-semibold ${cfg.titleCls}`}>
      {displayTitle}
    </p>
    <div class="prose prose-sm dark:prose-invert max-w-none text-inherit [&>*:last-child]:mb-0">
      <slot />
    </div>
  </div>
</aside>
