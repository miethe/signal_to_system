---
/**
 * Callout — the one callout for MDX bodies and editorial furniture (M2,
 * reader-core: "rewrite Callout"). Replaces the parallel Callout.tsx; MDX
 * imports `components/content/Callout.astro`.
 *
 * Props:
 *   type  — "info" | "warning" | "leader-takeaway" | "why-it-matters" | "story"
 *   title — optional heading (defaults to the type's label)
 *
 * One tone per type, all role tokens: a left rule and label in the tone over
 * a faint tint of it. Shared with Labs (evidence/caveat callouts) — keep the
 * type names stable.
 *
 * Usage in MDX:
 *   <Callout type="leader-takeaway" title="The Takeaway">
 *     Your content here.
 *   </Callout>
 */

type CalloutType = 'info' | 'warning' | 'leader-takeaway' | 'why-it-matters' | 'story';

interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = 'info', title } = Astro.props;

const LABEL: Record<CalloutType, string> = {
  info: 'Note',
  warning: 'Warning',
  'leader-takeaway': 'Leader Takeaway',
  'why-it-matters': 'Why It Matters',
  story: 'Story',
};

const kind: CalloutType = type in LABEL ? type : 'info';
const displayTitle = title ?? LABEL[kind];
---

<aside class:list={['callout-v2', `callout-v2--${kind}`, 'lift-hover']} role="note">
  <span class="callout-v2__icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {kind === 'info' && (<><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></>)}
      {kind === 'warning' && (<><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" /><path d="M12 9v4" /><path d="M12 17h.01" /></>)}
      {kind === 'leader-takeaway' && <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />}
      {kind === 'why-it-matters' && <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />}
      {kind === 'story' && <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />}
    </svg>
  </span>
  <div class="callout-v2__body">
    <p class="callout-v2__title">{displayTitle}</p>
    <div class="callout-v2__content"><slot /></div>
  </div>
</aside>

<style>
  .callout-v2 {
    --tone: var(--s2s-status-info);
    display: flex;
    gap: 14px;
    margin: 28px 0;
    padding: 16px 18px 16px 16px;
    border: 1px solid color-mix(in srgb, var(--tone) 28%, var(--s2s-rule));
    border-left: 3px solid var(--tone);
    border-radius: var(--s2s-radius-card);
    background: color-mix(in srgb, var(--tone) 7%, var(--s2s-surface));
    color: var(--s2s-ink-muted);
  }
  .callout-v2--warning { --tone: var(--s2s-status-warn); }
  .callout-v2--leader-takeaway { --tone: var(--s2s-accent); }
  .callout-v2--why-it-matters { --tone: var(--s2s-status-ok); }
  .callout-v2--story { --tone: var(--s2s-ink-subtle); }

  .callout-v2__icon { flex-shrink: 0; margin-top: 1px; color: var(--tone); }
  .callout-v2__body { min-width: 0; flex: 1; }
  .callout-v2__title {
    margin: 0 0 6px;
    font: 600 var(--type-ui) / 1.4 var(--font-sans);
    letter-spacing: 0.02em;
    color: var(--tone);
  }
  .callout-v2__content {
    font: 400 0.9688rem / 1.62 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .callout-v2__content :global(p) { margin: 0 0 10px; color: inherit; font: inherit; }
  .callout-v2__content > :global(:last-child) { margin-bottom: 0; }
  .callout-v2__content :global(strong) { color: var(--s2s-ink); }
  .callout-v2__content :global(ul),
  .callout-v2__content :global(ol) { margin: 0 0 10px; padding-left: 1.25rem; }
</style>
