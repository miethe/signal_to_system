---
/**
 * ThreadBeat — a repeatable worked-example marker for long-form MDX.
 *
 * Two variants:
 *   - `card` (default): today's full recap card. Unchanged — other posts
 *     still use this for their own running threads.
 *   - `marker`: a light inline mention (`"{n}/{total} · {label}"`) linking
 *     to the beat's panel in `ThreadStoryboard`. No recap, no figure, no
 *     card chrome. This is the shape the Registry Wave essay uses, since
 *     `ThreadStoryboard` is now the only place a beat's recap/figure render
 *     (see COMPONENT-API.md §2-3 in
 *     docs/blog-work/the-registry-wave-agentic-artifact-supply-chain/v2-research-integrated/).
 *
 * Usage in MDX:
 *   <ThreadBeat slug="post-slug" beat="incident">
 *     Optional detail that advances the running example.
 *   </ThreadBeat>
 *
 *   <ThreadBeat slug="post-slug" beat="incident" variant="marker" />
 */
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  beat: string;
  variant?: 'card' | 'marker';
}

const { slug, beat, variant = 'card' } = Astro.props;
const thread = threads[slug];
const threadBeat = thread?.beats.find((candidate) => candidate.id === beat);

if (!thread || !threadBeat) {
  console.warn(
    `[ThreadBeat] Unable to resolve beat "${beat}" for thread "${slug}". Rendering nothing.`,
  );
}
---

{
  thread && threadBeat && variant === 'marker' && (
    // A real heading element (D10) — replaces the old `<p>` + `aria-labelledby`
    // pattern the card variant still uses. The whole beat mention is the
    // heading; there's no separate label paragraph to attach it to.
    <h4 class="thread-beat-marker my-6 font-serif text-sm font-semibold text-[var(--text-primary)]">
      <a href={`#thread-${threadBeat.id}`} class="thread-beat-marker__link inline-flex items-baseline gap-2 no-underline">
        <span class="thread-beat-marker__count font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-[var(--accent-text)]">
          {threadBeat.n}/{thread.beats.length}
        </span>
        <span aria-hidden="true" class="text-[var(--text-tertiary)]">·</span>
        <span class="thread-beat-marker__label">{threadBeat.label}</span>
      </a>
    </h4>
  )
}

{
  thread && threadBeat && variant === 'card' && (
    <section
      id={`thread-${threadBeat.id}`}
      class="thread-beat lift-hover my-8 border border-[var(--border-strong)] bg-[var(--bg-surface)] p-4 sm:p-5"
      aria-labelledby={`thread-${threadBeat.id}-label`}
    >
      <span class="thread-beat__corner thread-beat__corner--tl" aria-hidden="true"></span>
      <span class="thread-beat__corner thread-beat__corner--tr" aria-hidden="true"></span>
      <span class="thread-beat__corner thread-beat__corner--bl" aria-hidden="true"></span>
      <span class="thread-beat__corner thread-beat__corner--br" aria-hidden="true"></span>

      <div class="border-l-2 border-[var(--accent)] pl-4 sm:pl-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-[var(--accent-text)]">
            The thread · {threadBeat.n} of {thread.beats.length}
          </p>
          <p
            id={`thread-${threadBeat.id}-label`}
            class="font-mono text-xs font-medium text-[var(--text-secondary)]"
          >
            {threadBeat.label}
          </p>
        </div>

        <p class="mt-3 text-sm leading-6 text-[var(--text-secondary)]">
          <span class="font-mono mr-2 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-[var(--text-tertiary)]">
            Where we left it
          </span>
          {threadBeat.recap}
        </p>

        <div class="thread-beat__detail mt-4 border-t border-[var(--border-subtle)] pt-4 text-[var(--text-secondary)]">
          <slot />
        </div>
      </div>
    </section>
  )
}

<style>
  .thread-beat {
    position: relative;
    scroll-margin-top: 6rem;
  }

  .thread-beat__corner {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--border-strong);
    opacity: 0.72;
    pointer-events: none;
  }

  .thread-beat__corner--tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .thread-beat__corner--tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
  .thread-beat__corner--bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
  .thread-beat__corner--br { right: 6px; bottom: 6px; border-left: 0; border-top: 0; }

  .thread-beat p {
    margin: 0;
  }

  .thread-beat__detail :global(> :first-child) {
    margin-top: 0;
  }

  .thread-beat__detail :global(> :last-child) {
    margin-bottom: 0;
  }

  .thread-beat-marker {
    margin: 0;
  }

  .thread-beat-marker__link {
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 1px;
    color: inherit;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .thread-beat-marker__link:hover,
  .thread-beat-marker__link:focus-visible {
    border-color: var(--accent);
    color: var(--accent-text);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .thread-beat-marker__link {
      transition: none;
    }
  }

  :global(html.perf-lite) .thread-beat-marker__link {
    transition: none;
  }
</style>
