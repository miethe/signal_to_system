---
/**
 * PostSidebar — the sticky desktop rail beside a post: a collapsible author
 * card, a scroll-spy table of contents that appears in the space the author
 * card frees up, and (when the post has one) the running-example thread.
 *
 * The author card and TOC are two faces of the same IntersectionObserver on
 * the article header — collapsing the card is what frees the room the TOC
 * renders into, so one script owns both rather than splitting the signal.
 *
 * When a thread exists, the TOC and ThreadRail become a two-item accordion
 * (only one expanded at a time) so the column never needs to scroll — this
 * component owns that coordination; ThreadRail keeps owning its own beat
 * IntersectionObservers and reports auto-open/close via events.
 */
import AuthorProfile from './AuthorProfile.astro';
import ThreadRail from './ThreadRail.astro';
import { threads } from '../../data/threads';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug?: string;
  headings?: Heading[];
}

const { slug, headings = [] } = Astro.props;
const thread = slug ? threads[slug] : undefined;

// The footnotes section starts at the "Footnotes" heading (id
// `footnote-label`, injected by the remark footnotes plugin) — exclude it
// and everything after it so the TOC never lists footnote content.
const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = rawToc.length >= 2;

// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
// under, so the client script can show only the active section's
// sub-headings instead of the full flat list.
let h2Count = 0;
let currentH2Slug: string | null = null;
const toc = rawToc.map((heading) => {
  if (heading.depth === 2) {
    h2Count += 1;
    currentH2Slug = heading.slug;
    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
  }
  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
});
---

<div class="post-sidebar flex flex-col gap-3" data-post-sidebar>
  <div data-author-slot>
    <AuthorProfile variant="sidebar" headingLevel="h2" />
  </div>

  {
    showToc && (
      <div
        class="post-sidebar__block post-sidebar__toc rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
        data-post-toc-block
        hidden
      >
        {
          thread ? (
            <button
              type="button"
              class="post-sidebar__toc-header font-mono flex w-full items-center gap-2 px-4 py-2.5 text-left text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)] focus-ring"
              data-toc-header
              aria-expanded="true"
              aria-controls="post-sidebar-toc-panel"
            >
              <span class="shrink-0 whitespace-nowrap">On this page</span>
              <span
                class="post-sidebar__toc-header-current min-w-0 flex-1 truncate text-[var(--text-tertiary)]"
                data-toc-header-current
                hidden
              />
            </button>
          ) : (
            <p class="post-sidebar__toc-header font-mono px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
              On this page
            </p>
          )
        }

        <div id="post-sidebar-toc-panel" class="post-sidebar__toc-panel" data-toc-panel>
          <div class="post-sidebar__toc-body" data-toc-scroll>
            <div class="post-sidebar__toc-rail" aria-hidden="true">
              <div class="post-sidebar__toc-rail-fill" data-toc-fill />
            </div>
            <nav aria-label="Table of contents">
              <p class="post-sidebar__toc-more" data-toc-more="above" hidden />
              <ol class="post-sidebar__toc-list">
                {toc.map((heading) => (
                  <li
                    class:list={['post-sidebar__toc-item', heading.depth === 3 && 'post-sidebar__toc-item--sub']}
                    data-toc-item
                    data-toc-depth={heading.depth}
                    data-toc-parent={heading.parentSlug ?? ''}
                  >
                    <a
                      href={`#${heading.slug}`}
                      class="post-sidebar__toc-link"
                      data-toc-link
                      data-toc-target={heading.slug}
                    >
                      {heading.depth === 2 && (
                        <span class="post-sidebar__toc-index font-mono" aria-hidden="true">
                          {String(heading.sectionNumber).padStart(2, '0')}
                        </span>
                      )}
                      <span class="post-sidebar__toc-label line-clamp-2">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
              <p class="post-sidebar__toc-more" data-toc-more="below" hidden />
            </nav>
          </div>
        </div>
      </div>
    )
  }

  {slug && <ThreadRail slug={slug} />}
</div>

<style>
  /* Collapse styling lives on AuthorProfile itself (see its own <style>) —
     this component only decides *when* to toggle `.is-collapsed`, via the
     script below. */

  .post-sidebar__toc.is-expanded > .post-sidebar__toc-header {
    border-bottom: 1px solid var(--border-subtle);
  }

  .post-sidebar__toc-header-current::before {
    content: '\00b7';
    margin-right: 0.375rem;
  }

  .post-sidebar__toc-panel[hidden] {
    display: none;
  }

  .post-sidebar__toc-body {
    position: relative;
    overflow-y: auto;
    padding: 0.75rem 0.5rem 0.75rem 0.75rem;
    scrollbar-width: none;
  }

  .post-sidebar__toc-body::-webkit-scrollbar {
    display: none;
  }

  .post-sidebar__toc-more {
    margin: 0 0 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-disabled);
  }

  .post-sidebar__toc-list + .post-sidebar__toc-more {
    margin: 0.25rem 0 0;
  }

  .post-sidebar__toc-rail {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: 0;
    width: 2px;
    border-radius: 1px;
    /* border-subtle was too faint to read as a track in either theme;
       border-strong stays understated but is actually visible. */
    background-color: var(--border-strong);
  }

  .post-sidebar__toc-rail-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    border-radius: 1px;
    background-color: var(--accent);
    transition: height 0.2s ease;
  }

  .post-sidebar__toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .post-sidebar__toc-item--sub {
    display: none;
  }

  .post-sidebar__toc-item--sub.is-active-branch {
    display: block;
  }

  .post-sidebar__toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    border-radius: 0.25rem;
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .post-sidebar__toc-item--sub .post-sidebar__toc-link {
    margin-left: 1rem;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }

  .post-sidebar__toc-index {
    flex-shrink: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    /* text-disabled reads as invisible in dark mode; text-tertiary is the
       muted floor that's still legible. */
    color: var(--text-tertiary);
  }

  .post-sidebar__toc-label {
    min-width: 0;
  }

  .post-sidebar__toc-link:hover,
  .post-sidebar__toc-link:focus-visible {
    background-color: var(--accent-subtle);
    color: var(--text-primary);
    outline: none;
  }

  .post-sidebar__toc-link:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  /* Sections already scrolled past read as slightly more muted than the
     upcoming (neutral) default above; the active section is set apart by
     accent color, weight, and a subtle fill. */
  .post-sidebar__toc-item.is-visited .post-sidebar__toc-link {
    color: var(--text-tertiary);
  }

  .post-sidebar__toc-item.is-window-hidden {
    display: none;
  }

  .post-sidebar__toc-link[aria-current='location'] {
    background-color: var(--accent-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  .post-sidebar__toc-link[aria-current='location'] .post-sidebar__toc-index {
    color: var(--accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-sidebar__toc-link,
    .post-sidebar__toc-rail-fill {
      transition: none;
    }
  }

  :global(html.perf-lite) .post-sidebar__toc-link,
  :global(html.perf-lite) .post-sidebar__toc-rail-fill {
    transition: none;
  }
</style>

<script>
  import { computeListWindow, measureExpandedHeight } from '../../lib/sidebar-window';

  /** gap-3 on `.post-sidebar` — the vertical space between each stacked block. */
  const SIDEBAR_GAP_PX = 12;

  const initializePostSidebars = () => {
    document.querySelectorAll<HTMLElement>('[data-post-sidebar]').forEach((root) => {
      if (root.dataset.postSidebarReady === 'true') return;
      root.dataset.postSidebarReady = 'true';

      const authorEl = root.querySelector<HTMLElement>('[data-author-slot] .author-profile');
      const tocBlock = root.querySelector<HTMLElement>('[data-post-toc-block]');
      const toc = root.querySelector<HTMLElement>('[data-toc-panel]');
      const header = document.getElementById('post-header');

      const setCollapsed = (collapsed: boolean) => {
        authorEl?.classList.toggle('is-collapsed', collapsed);
        tocBlock?.toggleAttribute('hidden', !collapsed);
      };

      // Collapsing is cheap and must keep working in every performance mode
      // — perf-lite only drops the CSS transition (see AuthorProfile's and
      // this file's <style>). There is deliberately no perf-lite branch
      // here: an earlier version disconnected this observer the moment a
      // `class` mutation on <html> left `perf-lite` present, but
      // `applyPerfClass()` in themeStore re-toggles that class (to the same
      // value) on every client-side import of the store — which any
      // ModeToggle/ThemeToggle island triggers on every page load — so the
      // observer was disconnecting itself almost immediately whenever a
      // reader had lite mode set from an earlier visit, regardless of
      // scroll position. Don't reintroduce that watcher.
      if (header && authorEl && 'IntersectionObserver' in window) {
        const headerObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => setCollapsed(!entry.isIntersecting));
          },
          { threshold: 0 },
        );
        headerObserver.observe(header);
      }

      if (!toc || !tocBlock) return;

      const tocHeader = tocBlock.querySelector<HTMLButtonElement>('[data-toc-header]');
      const tocHeaderCurrent = tocBlock.querySelector<HTMLElement>('[data-toc-header-current]');
      const tocBody = toc.querySelector<HTMLElement>('[data-toc-scroll]');
      const rail = toc.querySelector<HTMLElement>('[data-toc-fill]');
      const moreAbove = toc.querySelector<HTMLElement>('[data-toc-more="above"]');
      const moreBelow = toc.querySelector<HTMLElement>('[data-toc-more="below"]');
      const items = Array.from(toc.querySelectorAll<HTMLLIElement>('[data-toc-item]'));
      // Pair each link with its target element and owning <li> up front —
      // one array, built once, so every lookup below is a plain index/get
      // instead of a re-query.
      const pairs = items
        .map((item) => {
          const link = item.querySelector<HTMLAnchorElement>('[data-toc-link]');
          const target = link ? document.getElementById(link.dataset.tocTarget ?? '') : null;
          return link && target ? { item, link, target } : null;
        })
        .filter((pair): pair is { item: HTMLLIElement; link: HTMLAnchorElement; target: HTMLElement } => pair !== null);

      if (pairs.length === 0 || !('IntersectionObserver' in window)) return;

      const reduceMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        document.documentElement.classList.contains('perf-lite');

      // Each h3's own section is its recorded parent slug; an h2's own
      // section is itself. Used to show only the active section's h3s.
      const resolveSection = (targetId: string): string | null => {
        const pair = pairs.find((candidate) => candidate.target.id === targetId);
        if (!pair) return null;
        return pair.item.dataset.tocDepth === '2' ? targetId : pair.item.dataset.tocParent || null;
      };

      const setActiveBranch = (sectionSlug: string | null) => {
        items.forEach((item) => {
          if (item.dataset.tocDepth !== '3') return;
          item.classList.toggle('is-active-branch', item.dataset.tocParent === sectionSlug);
        });
      };

      // Default to the first section's sub-headings before any scroll-spy
      // event has fired, so the list isn't empty-looking pre-scroll.
      const firstH2 = pairs.find((pair) => pair.item.dataset.tocDepth === '2');
      setActiveBranch(firstH2?.target.id ?? null);

      let activeIndex = 0;

      // Set once the accordion coordinator (below) exists, so setActive can
      // ask it to re-check whether the TOC and rail both fit whenever the
      // active branch's h3 set changes the TOC's own height.
      let refreshAccordionFit: (() => void) | null = null;

      // Fit the list to whatever room the panel actually has — measured,
      // not guessed, so it's correct at any viewport height. `maxVisible`
      // is a row COUNT: available px for the list, divided by one row's
      // real rendered height (h2 and h3 rows differ, so measure whichever
      // kind is first visible). A window of items around the active one is
      // shown when the full list wouldn't fit; `overflow-y:auto` (scrollbar
      // hidden) on the body is kept as a fallback only — this is meant to
      // never be needed in practice.
      //
      // `toc.getBoundingClientRect().top` moves whenever the author card
      // above it collapses/expands — measuring at the wrong instant (mid
      // collapse-transition) windows against a transient, too-small
      // "available" and hides rows that would actually fit once the
      // column settles. See the ResizeObserver/transitionend wiring below
      // (on the whole `.post-sidebar` column, not just this block), which
      // re-runs this whenever that could have happened.
      let lastFitSignature = '';
      const fitList = () => {
        if (!tocBody) return;
        // The set actually laid out right now: every h2, plus h3s of the
        // active branch only (others are display:none via CSS already).
        const laidOut = pairs.filter(({ item }) => item.dataset.tocDepth === '2' || item.classList.contains('is-active-branch'));
        if (laidOut.length === 0) return;

        // Measure from the PANEL's own top (below the header row), not the
        // block's — the header's height isn't part of the list's budget.
        // Checked before touching the DOM: `top` isn't affected by this
        // list's own visible-row count, so if it — and what's laid out —
        // haven't moved since the last fit, recomputing would only
        // reproduce the same window. Skipping avoids the unhide/measure/
        // rehide cycle below resizing this block and retriggering the
        // ResizeObserver on its own account.
        const panelTop = toc.getBoundingClientRect().top;
        const available = window.innerHeight - panelTop - 24; // 24px bottom breathing room
        const laidOutActiveIndex = Math.max(0, laidOut.findIndex(({ target }) => pairs[activeIndex]?.target === target));
        const signature = `${available.toFixed(1)}:${laidOut.length}:${laidOutActiveIndex}`;
        if (signature === lastFitSignature) return;
        lastFitSignature = signature;

        // Measure with nothing window-hidden — a hidden (display:none) row
        // reads back a zero-height rect, which would corrupt the estimate.
        laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
        moreAbove?.setAttribute('hidden', '');
        moreBelow?.setAttribute('hidden', '');

        const panelRect = toc.getBoundingClientRect();
        const rowHeight = laidOut[0].link.getBoundingClientRect().height || 32;
        const totalRowsHeight = laidOut.reduce((sum, { link }) => sum + link.getBoundingClientRect().height, 0);
        const chromeHeight = Math.max(0, tocBody.clientHeight - totalRowsHeight);
        const budgetForRows = available - chromeHeight;
        const maxVisible = Math.max(1, Math.floor(budgetForRows / rowHeight));

        const win = computeListWindow(laidOut.length, laidOutActiveIndex, maxVisible);

        laidOut.forEach(({ item }, i) => {
          item.classList.toggle('is-window-hidden', i < win.start || i > win.end);
        });
        moreAbove?.toggleAttribute('hidden', win.above === 0);
        if (moreAbove) moreAbove.textContent = `+${win.above} more above`;
        moreBelow?.toggleAttribute('hidden', win.below === 0);
        if (moreBelow) moreBelow.textContent = `+${win.below} more below`;
      };

      let fitQueued = false;
      const queueFit = () => {
        if (fitQueued) return;
        fitQueued = true;
        requestAnimationFrame(() => {
          fitQueued = false;
          fitList();
        });
      };

      const setActive = (id: string) => {
        activeIndex = pairs.findIndex((pair) => pair.target.id === id);
        pairs.forEach(({ item, link }, index) => {
          if (index === activeIndex) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
          item.classList.toggle('is-visited', activeIndex > -1 && index < activeIndex);
        });

        setActiveBranch(resolveSection(id));

        if (rail && pairs.length > 1) {
          const pct = activeIndex > -1 ? (activeIndex / (pairs.length - 1)) * 100 : 0;
          rail.style.height = `${Math.max(0, pct)}%`;
        }

        if (tocHeaderCurrent) {
          const label = activeIndex > -1 ? pairs[activeIndex]?.link.textContent?.trim() : '';
          tocHeaderCurrent.textContent = label ?? '';
          tocHeaderCurrent.toggleAttribute('hidden', !label);
        }

        const activeLink = activeIndex > -1 ? pairs[activeIndex]?.link : null;
        if (!tocBlock.hasAttribute('hidden') && tocPanelExpanded()) {
          activeLink?.scrollIntoView({ block: 'nearest', behavior: reduceMotion() ? 'auto' : 'smooth' });
        }
        queueFit();
        // The active branch's h3 set (toggled by setActiveBranch above) can
        // change the TOC's natural height — re-check whether both blocks
        // still fit now that it might have.
        refreshAccordionFit?.();
      };

      const visibleTargets = new Set<HTMLElement>();
      const tocObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const target = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              visibleTargets.add(target);
            } else {
              visibleTargets.delete(target);
            }
          });

          const visible = Array.from(visibleTargets);
          if (visible.length === 0) return;

          const closest = visible.reduce((current, candidate) =>
            Math.abs(candidate.getBoundingClientRect().top) < Math.abs(current.getBoundingClientRect().top)
              ? candidate
              : current,
          );
          setActive(closest.id);
        },
        { rootMargin: '-10% 0px -80% 0px', threshold: 0 },
      );

      pairs.forEach(({ target }) => tocObserver.observe(target));

      // Belt-and-suspenders: IntersectionObserver is the primary signal
      // above, but its first callback is async and can, on some
      // browser/scroll-timing combinations, be missed for a page that
      // loads (or jumps) already scrolled deep into the article — which
      // would otherwise leave every link with no `aria-current` until the
      // next observed crossing. This recomputes the same "closest heading
      // at or above the activation line" answer synchronously from layout,
      // so the active section is always correct on init and on scroll
      // regardless of whether the observer has fired yet. Cheap (a handful
      // of getBoundingClientRect calls) and only writes when the answer
      // actually changed, so it never fights the observer for scrollIntoView.
      const currentActiveTarget = () =>
        toc.querySelector<HTMLAnchorElement>('[data-toc-link][aria-current="location"]')?.dataset.tocTarget ?? null;

      const recomputeActive = () => {
        const activationLine = window.innerHeight * 0.1;
        let activeId: string | null = null;
        for (const { target } of pairs) {
          if (target.getBoundingClientRect().top <= activationLine) {
            activeId = target.id;
          } else {
            break;
          }
        }
        if (activeId && activeId !== currentActiveTarget()) setActive(activeId);
      };

      let recomputeQueued = false;
      const queueRecompute = () => {
        if (recomputeQueued) return;
        recomputeQueued = true;
        requestAnimationFrame(() => {
          recomputeQueued = false;
          recomputeActive();
        });
      };

      recomputeActive();
      window.addEventListener('scroll', queueRecompute, { passive: true });
      window.addEventListener('resize', queueRecompute, { passive: true });

      let windowResizeFitQueued = false;
      window.addEventListener(
        'resize',
        () => {
          if (windowResizeFitQueued) return;
          windowResizeFitQueued = true;
          requestAnimationFrame(() => {
            windowResizeFitQueued = false;
            queueFit();
            refreshAccordionFit?.();
          });
        },
        { passive: true },
      );

      if ('ResizeObserver' in window) {
        new ResizeObserver(() => {
          queueFit();
          refreshAccordionFit?.();
        }).observe(tocBlock);
      }

      // ---------------------------------------------------------------
      // Accordion: when a thread rail exists, the TOC and rail SHARE a
      // sticky column with finite height. If both fully expanded (every
      // row, no windowing) fit in the room left after the collapsed author
      // badge, they stay expanded independently — each header only ever
      // toggles its own block. If they don't fit, fall back to a strict
      // one-open accordion where the rail wins while a beat is in view. The
      // rail keeps owning its own beat IntersectionObservers (it knows its
      // own beat targets); it reports open/close intent here via events on
      // the wrap element, and this coordinator tells it (and the TOC) what
      // to actually show.
      // ---------------------------------------------------------------
      const railWrap = root.querySelector<HTMLElement>('[data-thread-rail-wrap]');

      const tocPanelExpandedState = { value: true };
      function tocPanelExpanded() {
        return tocPanelExpandedState.value;
      }

      if (railWrap) {
        const railPanel = railWrap.querySelector<HTMLElement>('[data-thread-rail]');

        // Exclusive-accordion state (used when the two blocks don't fit).
        let manualPanel: 'toc' | 'rail' | null = null;
        // Independent-toggle state (used when they do fit).
        let tocManualClosed = false;
        let railManualOverride: boolean | null = null;
        let railAutoOpen = false;
        let bothFit = false;

        // The collapsed-badge height, measured on a clone with
        // `.is-collapsed` forced on *before* it's inserted — so it reads
        // the final target height instantly, never a mid-transition value
        // (the class-added-then-transitioned case only applies to an
        // element already on-screen; a freshly inserted clone renders at
        // its end state immediately).
        const measureCollapsedAuthorHeight = (): number => {
          if (!authorEl) return 0;
          const clone = authorEl.cloneNode(true) as HTMLElement;
          clone.classList.add('is-collapsed');
          clone.style.position = 'fixed';
          clone.style.top = '-9999px';
          clone.style.left = '-9999px';
          clone.style.margin = '0';
          clone.style.visibility = 'hidden';
          clone.style.pointerEvents = 'none';
          clone.style.width = `${root.getBoundingClientRect().width}px`;
          document.body.appendChild(clone);
          const height = clone.getBoundingClientRect().height;
          clone.remove();
          return height;
        };

        // Fully-expanded (unwindowed) height of the TOC block plus the
        // rail panel, plus the collapsed author badge and the two gap-3
        // gaps between the three stacked blocks — compared against the
        // room actually left in the sticky column. Measured off-screen on
        // clones (see measureExpandedHeight) so nothing visibly flickers
        // open just to be measured.
        const evaluateFits = (): boolean => {
          if (!railPanel) return false;
          const columnWidth = root.getBoundingClientRect().width;
          if (columnWidth === 0) return false;
          const authorHeight = measureCollapsedAuthorHeight();
          const tocHeight = measureExpandedHeight(tocBlock, columnWidth, '[data-toc-more]');
          const railHeight = measureExpandedHeight(railPanel, columnWidth, '[data-thread-more]');
          const available = window.innerHeight - root.getBoundingClientRect().top - 24; // 24px bottom breathing room
          const total = authorHeight + SIDEBAR_GAP_PX + tocHeight + SIDEBAR_GAP_PX + railHeight;
          return total <= available;
        };

        const applyAccordion = () => {
          let tocExpanded: boolean;
          let railExpanded: boolean;

          if (bothFit) {
            tocExpanded = !tocManualClosed;
            railExpanded = railManualOverride ?? railAutoOpen;
          } else {
            const active = manualPanel ?? (railAutoOpen ? 'rail' : 'toc');
            tocExpanded = active === 'toc';
            railExpanded = active === 'rail';
          }

          tocPanelExpandedState.value = tocExpanded;
          tocHeader?.setAttribute('aria-expanded', String(tocExpanded));
          toc.toggleAttribute('hidden', !tocExpanded);
          tocBlock.classList.toggle('is-expanded', tocExpanded);
          if (tocHeaderCurrent) tocHeaderCurrent.toggleAttribute('hidden', tocExpanded || !tocHeaderCurrent.textContent);
          railWrap.dispatchEvent(new CustomEvent('threadrail:setexpanded', { detail: { expanded: railExpanded } }));
          if (tocExpanded) queueFit();
        };

        refreshAccordionFit = () => {
          bothFit = evaluateFits();
          applyAccordion();
        };

        tocHeader?.addEventListener('click', () => {
          if (bothFit) {
            tocManualClosed = !tocManualClosed;
          } else {
            manualPanel = tocPanelExpanded() ? 'rail' : 'toc';
          }
          applyAccordion();
        });

        railWrap.addEventListener('threadrail:request-open', () => {
          if (bothFit) {
            railManualOverride = true;
          } else {
            manualPanel = 'rail';
          }
          applyAccordion();
        });
        railWrap.addEventListener('threadrail:request-close', () => {
          if (bothFit) {
            railManualOverride = false;
          } else {
            manualPanel = 'toc';
          }
          applyAccordion();
        });
        railWrap.addEventListener('threadrail:auto', (event) => {
          const detail = (event as CustomEvent<{ open: boolean }>).detail;
          railAutoOpen = detail.open;
          // "Manual overrides auto until the current beat leaves view" — the
          // override is cleared on the close-side transition only (in both
          // modes), so it never fights an in-progress manual choice while a
          // beat is still visible, but auto resumes cleanly once nothing is.
          if (!detail.open) {
            manualPanel = null;
            railManualOverride = null;
          }
          // Re-check the fit right as the rail wants to expand (or stop
          // wanting to) — the trigger named in the brief for this check.
          bothFit = evaluateFits();
          applyAccordion();
        });

        refreshAccordionFit();
      } else {
        // No thread on this post: the TOC is the only block, always open,
        // no accordion header/click affordance needed.
        toc.removeAttribute('hidden');
        tocBlock.classList.add('is-expanded');
        queueFit();
      }

      // ---------------------------------------------------------------
      // Sibling-driven refit: the rail's step list and this TOC's own row
      // list are each windowed against a `getBoundingClientRect()` read
      // that assumes the column's layout is settled. But the author card
      // collapsing, the TOC expanding, a `bothFit` flip, or the rail's own
      // expand can all still be mid-transition when that read happens —
      // the panel/rail's `top` shifts as the block above it changes
      // height, and a fit computed against that transient position
      // windows too aggressively (fewer rows than actually fit). `root`
      // (`.post-sidebar`) is a flex column, so its own box height is the
      // sum of every sibling's height — watching just it, rather than one
      // observer per block, catches all of the above in one place.
      // ---------------------------------------------------------------
      let globalRefitQueued = false;
      const scheduleGlobalRefit = () => {
        if (globalRefitQueued) return;
        globalRefitQueued = true;
        requestAnimationFrame(() => {
          globalRefitQueued = false;
          queueFit();
          refreshAccordionFit?.();
          railWrap?.dispatchEvent(new CustomEvent('threadrail:refit'));
        });
      };

      if ('ResizeObserver' in window) {
        // Fires only on an actual size delta, so this can't spin on its
        // own: a fit call that changes nothing (see the signature guards
        // in both this file's and ThreadRail's `fitList`) never touches
        // the DOM, so it can't retrigger this observer.
        new ResizeObserver(scheduleGlobalRefit).observe(root);
      }
      // One more fit once any transition inside the column (chiefly the
      // author card's collapse) finishes, so the very last measurement
      // always uses the settled layout rather than a mid-transition one.
      root.addEventListener('transitionend', scheduleGlobalRefit);
    });
  };

  initializePostSidebars();
  document.addEventListener('astro:page-load', initializePostSidebars);
</script>
