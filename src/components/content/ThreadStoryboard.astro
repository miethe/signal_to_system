---
/**
 * ThreadStoryboard — one selectable frame for a post's running worked
 * example, replacing six separate `ThreadBeat` cards in the body (D2 in
 * REVIEW-V4-DIRECTION.md). A reader picks a beat (button row, Prev/Next, or
 * arrow keys) and it expands in place to show: label, recap, figure(s), and
 * caption. This is now the ONLY place a beat's recap/figure renders — the
 * body prose must not restate it, and `ThreadBeat`'s `marker` variant is at
 * most a light "{n}/{total} · {label}" mention linking back here.
 *
 * No-JS fallback: beats ship as an <ol> of <details>/<summary> panels
 * (first one `open`), so every label and recap is real, always-present
 * text and a reader can open any beat by hand — no script required. On
 * mount, `initializeThreadStoryboards()` upgrades this into a single-open
 * accordion (opening one panel closes the rest, matching the "one frame"
 * requirement) driven by three inputs that all converge on the same
 * `applyActive()` call: the button row, native `<details>` toggling
 * (a reader can still click a panel's own heading), and the URL hash.
 *
 * Every beat's `Figure` is rendered server-side rather than literally only
 * the first (a deliberate simplification from the frozen API's "lazy-reveal
 * on selection" wording — see this leg's report): each panel is a real
 * `<Figure>` with the site's existing lightbox, and non-active panels sit
 * inside a closed `<details>`, which keeps their images out of the
 * network's way without hand-rolling a second figure renderer in vanilla
 * JS. `loading="lazy"` (already on `Figure`) does the rest.
 *
 * Every active-beat change (click, arrow key, or hash match) dispatches
 * `threadstoryboard:beatchange` on this section's root — `ThreadRail` is
 * the only listener today (see its header comment).
 */
import Figure from './Figure.astro';
import { threads } from '../../data/threads';

interface Props {
  slug: string;
  initialBeat?: string;
}

const { slug, initialBeat } = Astro.props;
const thread = threads[slug];
const beats = thread?.beats ?? [];
const startId = initialBeat && beats.some((beat) => beat.id === initialBeat) ? initialBeat : beats[0]?.id;
---

{
  thread && beats.length > 0 && (
    <section
      class="thread-storyboard lift-hover my-8 border border-[var(--border-strong)] bg-[var(--bg-surface)] p-4 sm:p-5"
      data-thread-storyboard
      data-slug={slug}
      id="thread-storyboard"
      aria-label={`Running example: ${thread.title}`}
    >
      <span class="thread-storyboard__corner thread-storyboard__corner--tl" aria-hidden="true"></span>
      <span class="thread-storyboard__corner thread-storyboard__corner--tr" aria-hidden="true"></span>
      <span class="thread-storyboard__corner thread-storyboard__corner--bl" aria-hidden="true"></span>
      <span class="thread-storyboard__corner thread-storyboard__corner--br" aria-hidden="true"></span>

      <div class="border-l-2 border-[var(--accent)] pl-4 sm:pl-5">
        <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-[var(--accent-text)]">
          Running example · {thread.title}
        </p>

        <div
          class="thread-storyboard__selector mt-4 flex items-center gap-2"
          role="group"
          aria-label="Select a beat"
          data-thread-storyboard-selector
        >
          <button
            type="button"
            class="thread-storyboard__nav-button focus-ring shrink-0 border border-[var(--border-strong)] px-2 py-1 font-mono text-xs text-[var(--text-tertiary)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
            data-thread-storyboard-prev
            aria-label="Previous beat"
          >
            &larr;
          </button>

          <div class="thread-storyboard__buttons flex min-w-0 flex-1 flex-wrap gap-1.5" data-thread-storyboard-buttons>
            {beats.map((beat) => (
              <button
                type="button"
                class="thread-storyboard__button focus-ring font-mono flex items-center gap-1.5 border border-[var(--border-strong)] px-2 py-1 text-[0.6875rem] text-[var(--text-secondary)] hover:border-[var(--accent)]/50 hover:bg-[var(--accent-subtle)]"
                data-thread-storyboard-button
                data-beat-id={beat.id}
                aria-pressed={beat.id === startId ? 'true' : 'false'}
              >
                <span class="thread-storyboard__button-n" aria-hidden="true">{beat.n}</span>
                <span class="thread-storyboard__button-label">{beat.label}</span>
              </button>
            ))}
          </div>

          <button
            type="button"
            class="thread-storyboard__nav-button focus-ring shrink-0 border border-[var(--border-strong)] px-2 py-1 font-mono text-xs text-[var(--text-tertiary)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
            data-thread-storyboard-next
            aria-label="Next beat"
          >
            &rarr;
          </button>
        </div>

        <ol class="thread-storyboard__panels mt-4 space-y-2" data-thread-storyboard-panels>
          {beats.map((beat) => (
            <li>
              <details
                class="thread-storyboard__panel border border-[var(--border-subtle)] bg-[var(--bg-subtle)] p-3 sm:p-4"
                id={`thread-${beat.id}`}
                data-thread-storyboard-panel
                data-beat-id={beat.id}
                open={beat.id === startId}
              >
                <summary class="thread-storyboard__summary font-mono flex cursor-pointer items-baseline gap-2 text-xs text-[var(--text-secondary)]">
                  <span class="thread-storyboard__summary-n text-[var(--accent-text)]">{beat.n}/{beats.length}</span>
                  <span class="thread-storyboard__summary-label">{beat.label}</span>
                </summary>

                <div class="thread-storyboard__panel-body mt-3 border-l-2 border-[var(--accent)] pl-4 sm:pl-5">
                  <h3 class="font-serif text-lg font-semibold leading-tight text-[var(--text-primary)]">
                    {beat.label}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">{beat.recap}</p>

                  <div class="thread-storyboard__figures mt-4 space-y-4">
                    <Figure
                      src={beat.image.src}
                      alt={beat.image.alt}
                      caption={beat.image.caption}
                      number={String(beat.n).padStart(2, '0')}
                    />
                    {beat.secondaryImage && (
                      <Figure src={beat.secondaryImage.src} alt={beat.secondaryImage.alt} caption={beat.secondaryImage.caption} />
                    )}
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .thread-storyboard {
    position: relative;
    scroll-margin-top: 6rem;
  }

  .thread-storyboard__corner {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--border-strong);
    opacity: 0.72;
    pointer-events: none;
  }

  .thread-storyboard__corner--tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .thread-storyboard__corner--tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
  .thread-storyboard__corner--bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
  .thread-storyboard__corner--br { right: 6px; bottom: 6px; border-left: 0; border-top: 0; }

  .thread-storyboard__button[aria-pressed='true'] {
    border-color: var(--accent);
    background-color: var(--accent-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  .thread-storyboard__nav-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .thread-storyboard__panel > summary {
    list-style: none;
  }

  .thread-storyboard__panel > summary::-webkit-details-marker {
    display: none;
  }

  .thread-storyboard__panel[open] > summary {
    color: var(--text-primary);
    font-weight: 600;
  }

  .thread-storyboard__panel-body :global(> :first-child) {
    margin-top: 0;
  }

  .thread-storyboard__panel-body :global(> :last-child) {
    margin-bottom: 0;
  }

  /* No animated transition, in either mode — the simplest way to honor
     prefers-reduced-motion is to never add motion here in the first
     place (see this component's header comment). Panels swap instantly. */
</style>

<script>
  const initializeThreadStoryboards = () => {
    document.querySelectorAll<HTMLElement>('[data-thread-storyboard]').forEach((section) => {
      if (section.dataset.threadStoryboardReady === 'true') return;
      section.dataset.threadStoryboardReady = 'true';

      const panels = Array.from(section.querySelectorAll<HTMLDetailsElement>('[data-thread-storyboard-panel]'));
      const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-thread-storyboard-button]'));
      const prevButton = section.querySelector<HTMLButtonElement>('[data-thread-storyboard-prev]');
      const nextButton = section.querySelector<HTMLButtonElement>('[data-thread-storyboard-next]');
      if (panels.length === 0 || buttons.length === 0) return;

      let activeIndex = Math.max(0, panels.findIndex((panel) => panel.open));
      let suspendToggleSync = false;

      const applyActive = (index: number, options: { focus?: boolean; dispatch?: boolean } = {}) => {
        const { focus = false, dispatch = true } = options;
        const clamped = Math.max(0, Math.min(index, panels.length - 1));
        activeIndex = clamped;

        // `toggle` fires as a side effect of setting `open` below — the
        // panel-level listener re-enters `applyActive` on its own, which
        // would just repeat this same work. Suspend it for the duration of
        // this synchronous pass rather than let it recurse.
        suspendToggleSync = true;
        panels.forEach((panel, i) => panel.toggleAttribute('open', i === clamped));
        suspendToggleSync = false;

        buttons.forEach((button, i) => {
          button.setAttribute('aria-pressed', String(i === clamped));
          if (i === clamped && focus) button.focus();
        });
        prevButton?.toggleAttribute('disabled', clamped === 0);
        nextButton?.toggleAttribute('disabled', clamped === panels.length - 1);

        if (dispatch) {
          const beatId = panels[clamped]?.dataset.beatId;
          if (beatId) {
            section.dispatchEvent(
              new CustomEvent('threadstoryboard:beatchange', { detail: { beatId }, bubbles: true }),
            );
          }
        }
      };

      buttons.forEach((button, index) => {
        button.addEventListener('click', () => applyActive(index));
        button.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            applyActive(index + 1, { focus: true });
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            applyActive(index - 1, { focus: true });
          }
        });
      });

      prevButton?.addEventListener('click', () => applyActive(activeIndex - 1, { focus: true }));
      nextButton?.addEventListener('click', () => applyActive(activeIndex + 1, { focus: true }));

      // A reader can also open a beat by clicking its own <summary> — this
      // is the single source of truth for that path too, and it's what
      // enforces "only one open at a time" once JS is driving the section.
      panels.forEach((panel, index) => {
        panel.addEventListener('toggle', () => {
          if (suspendToggleSync) return;
          if (panel.open) applyActive(index);
        });
      });

      const selectFromHash = () => {
        const hash = window.location.hash.replace(/^#/, '');
        if (!hash) return;
        const index = panels.findIndex((panel) => panel.id === hash);
        if (index !== -1) applyActive(index);
      };

      window.addEventListener('hashchange', selectFromHash);

      // Announce the server-rendered initial state (or the hash, if the
      // page loaded with one already pointing at a beat) so ThreadRail's
      // aria-current sync has something to react to even before any
      // interaction.
      const hash = window.location.hash.replace(/^#/, '');
      const hashIndex = hash ? panels.findIndex((panel) => panel.id === hash) : -1;
      applyActive(hashIndex !== -1 ? hashIndex : activeIndex);
    });
  };

  initializeThreadStoryboards();
  document.addEventListener('astro:page-load', initializeThreadStoryboards);
</script>
