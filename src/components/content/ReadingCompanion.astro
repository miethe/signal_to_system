---
/**
 * ReadingCompanion — the one sticky reading companion for an essay
 * (reading-experience-v2 DIRECTION.md V5, ARCHITECTURE.md §5). Refactor of
 * `PostSidebar.astro` to the three-slot contract from
 * `02_EXPERIENCE_SPEC.md`§6:
 *
 *   1. Compact nearby-chapter outline + an "All sections" action.
 *   2. `ThreadDock`, when the post has a thread.
 *   3. At most one authored `ContextualNote` — skipped for now: no
 *      authored-note data source exists yet, so this slot stays empty
 *      rather than fabricating content (per this leg's build brief).
 *
 * `AuthorProfile` and `ExecutiveSignal` are no longer inside this sticky
 * column at all (V5: they sit in flow at the top of the rail and scroll
 * away) — `PostLayout` renders `AuthorProfile` above this component,
 * outside its sticky wrapper. That removal is also what retires the old
 * accordion between the author card, the takeaway pill, and the thread
 * rail: with only two small, independently-sized blocks left in the
 * column (the outline and the six-item `ThreadDock`), there's no
 * competing-for-space problem left to solve, so this component's script
 * is a straight scroll-spy + windowed-list fit, not an accordion
 * coordinator.
 *
 * Posts without a thread get outline-only behavior (the same generic
 * fallback `PostSidebar` provided) — `slug`/`thread` are both optional.
 */
import ThreadDock from './ThreadDock.astro';
import { threads } from '../../data/threads';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug?: string;
  headings?: Heading[];
}

const { slug, headings = [] } = Astro.props;
const thread = slug ? threads[slug] : undefined;

// The footnotes section starts at the "Footnotes" heading (id
// `footnote-label`, injected by the remark footnotes plugin) — exclude it
// and everything after it so the outline never lists footnote content.
const footnoteIndex = headings.findIndex((heading) => heading.slug === 'footnote-label');
const contentHeadings = footnoteIndex === -1 ? headings : headings.slice(0, footnoteIndex);
const rawToc = contentHeadings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = rawToc.length >= 2;

// Number each h2 section (01, 02…) and record which h2 slug each h3 falls
// under, so the client script can show only the active section's
// sub-headings instead of the full flat list.
let h2Count = 0;
let currentH2Slug: string | null = null;
const toc = rawToc.map((heading) => {
  if (heading.depth === 2) {
    h2Count += 1;
    currentH2Slug = heading.slug;
    return { ...heading, sectionNumber: h2Count, parentSlug: null as string | null };
  }
  return { ...heading, sectionNumber: null as number | null, parentSlug: currentH2Slug };
});
---

<div class="reading-companion flex flex-col gap-3" data-reading-companion>
  {
    showToc && (
      <div
        class="reading-companion__block reading-companion__outline rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
        data-companion-outline
      >
        <div class="reading-companion__header font-mono flex items-center justify-between gap-2 px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
          <span>On this page</span>
          <button
            type="button"
            class="reading-companion__all-toggle focus-ring text-[var(--text-tertiary)] hover:text-[var(--accent)]"
            data-companion-all-toggle
            aria-pressed="false"
          >
            All sections
          </button>
        </div>

        <div class="reading-companion__body" data-companion-scroll>
          <div class="reading-companion__rail" aria-hidden="true">
            <div class="reading-companion__rail-fill" data-companion-fill />
          </div>
          <nav aria-label="Table of contents">
            <p class="reading-companion__more" data-companion-more="above" hidden />
            <ol class="reading-companion__list">
              {toc.map((heading) => (
                <li
                  class:list={['reading-companion__item', heading.depth === 3 && 'reading-companion__item--sub']}
                  data-companion-item
                  data-companion-depth={heading.depth}
                  data-companion-parent={heading.parentSlug ?? ''}
                >
                  <a
                    href={`#${heading.slug}`}
                    class="reading-companion__link"
                    data-companion-link
                    data-companion-target={heading.slug}
                  >
                    {heading.depth === 2 && (
                      <span class="reading-companion__index font-mono" aria-hidden="true">
                        {String(heading.sectionNumber).padStart(2, '0')}
                      </span>
                    )}
                    <span class="reading-companion__label line-clamp-2">{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="reading-companion__more" data-companion-more="below" hidden />
          </nav>
        </div>
      </div>
    )
  }

  {thread && slug && <ThreadDock slug={slug} />}

  {/* ContextualNote slot: intentionally empty (see header comment). */}
</div>

<style>
  .reading-companion__header {
    border-bottom: 1px solid var(--border-subtle);
  }

  .reading-companion__all-toggle {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .reading-companion__all-toggle[aria-pressed='true'] {
    color: var(--accent);
  }

  .reading-companion__body {
    position: relative;
    overflow-y: auto;
    padding: 0.75rem 0.5rem 0.75rem 0.75rem;
    scrollbar-width: none;
  }

  .reading-companion__body::-webkit-scrollbar {
    display: none;
  }

  .reading-companion__more {
    margin: 0 0 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-disabled);
  }

  .reading-companion__list + .reading-companion__more {
    margin: 0.25rem 0 0;
  }

  .reading-companion__rail {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background-color: var(--border-strong);
  }

  .reading-companion__rail-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    border-radius: 1px;
    background-color: var(--accent);
    transition: height 0.2s ease;
  }

  .reading-companion__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-companion__item--sub {
    display: none;
  }

  .reading-companion__item--sub.is-active-branch {
    display: block;
  }

  .reading-companion__link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    border-radius: 0.25rem;
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .reading-companion__item--sub .reading-companion__link {
    margin-left: 1rem;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }

  .reading-companion__index {
    flex-shrink: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
  }

  .reading-companion__label {
    min-width: 0;
  }

  .reading-companion__link:hover,
  .reading-companion__link:focus-visible {
    background-color: var(--accent-subtle);
    color: var(--text-primary);
    outline: none;
  }

  .reading-companion__link:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .reading-companion__item.is-visited .reading-companion__link {
    color: var(--text-tertiary);
  }

  .reading-companion__item.is-window-hidden {
    display: none;
  }

  .reading-companion__link[aria-current='location'] {
    background-color: var(--accent-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  .reading-companion__link[aria-current='location'] .reading-companion__index {
    color: var(--accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-companion__link,
    .reading-companion__rail-fill {
      transition: none;
    }
  }

  :global(html.perf-lite) .reading-companion__link,
  :global(html.perf-lite) .reading-companion__rail-fill {
    transition: none;
  }
</style>

<script>
  import { computeListWindow } from '../../lib/sidebar-window';

  /** Nearby-outline default window size before "All sections" is toggled. */
  const NEARBY_MAX_VISIBLE = 6;

  const initializeReadingCompanions = () => {
    document.querySelectorAll<HTMLElement>('[data-reading-companion]').forEach((root) => {
      if (root.dataset.readingCompanionReady === 'true') return;
      root.dataset.readingCompanionReady = 'true';

      const outline = root.querySelector<HTMLElement>('[data-companion-outline]');
      const allToggle = root.querySelector<HTMLButtonElement>('[data-companion-all-toggle]');
      const body = root.querySelector<HTMLElement>('[data-companion-scroll]');
      const rail = root.querySelector<HTMLElement>('[data-companion-fill]');
      const moreAbove = root.querySelector<HTMLElement>('[data-companion-more="above"]');
      const moreBelow = root.querySelector<HTMLElement>('[data-companion-more="below"]');
      const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-companion-item]'));

      if (!outline || !body || items.length === 0 || !('IntersectionObserver' in window)) return;

      const pairs = items
        .map((item) => {
          const link = item.querySelector<HTMLAnchorElement>('[data-companion-link]');
          const target = link ? document.getElementById(link.dataset.companionTarget ?? '') : null;
          return link && target ? { item, link, target } : null;
        })
        .filter((pair): pair is { item: HTMLLIElement; link: HTMLAnchorElement; target: HTMLElement } => pair !== null);

      if (pairs.length === 0) return;

      const reduceMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        document.documentElement.classList.contains('perf-lite');

      let allExpanded = false;
      let activeIndex = 0;

      const resolveSection = (targetId: string): string | null => {
        const pair = pairs.find((candidate) => candidate.target.id === targetId);
        if (!pair) return null;
        return pair.item.dataset.companionDepth === '2' ? targetId : pair.item.dataset.companionParent || null;
      };

      const setActiveBranch = (sectionSlug: string | null) => {
        items.forEach((item) => {
          if (item.dataset.companionDepth !== '3') return;
          item.classList.toggle('is-active-branch', item.dataset.companionParent === sectionSlug);
        });
      };

      const firstH2 = pairs.find((pair) => pair.item.dataset.companionDepth === '2');
      setActiveBranch(firstH2?.target.id ?? null);

      let lastFitSignature = '';
      const fitList = () => {
        const laidOut = pairs.filter(({ item }) => item.dataset.companionDepth === '2' || item.classList.contains('is-active-branch'));
        if (laidOut.length === 0) return;

        if (allExpanded) {
          if (lastFitSignature === 'expanded') return;
          lastFitSignature = 'expanded';
          laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
          moreAbove?.setAttribute('hidden', '');
          moreBelow?.setAttribute('hidden', '');
          return;
        }

        const panelTop = outline.getBoundingClientRect().top;
        const available = window.innerHeight - panelTop - 24;
        const laidOutActiveIndex = Math.max(0, laidOut.findIndex(({ target }) => pairs[activeIndex]?.target === target));
        const signature = `windowed:${available.toFixed(1)}:${laidOut.length}:${laidOutActiveIndex}`;
        if (signature === lastFitSignature) return;
        lastFitSignature = signature;

        laidOut.forEach(({ item }) => item.classList.remove('is-window-hidden'));
        moreAbove?.setAttribute('hidden', '');
        moreBelow?.setAttribute('hidden', '');

        const rowHeight = laidOut[0].link.getBoundingClientRect().height || 32;
        const totalRowsHeight = laidOut.reduce((sum, { link }) => sum + link.getBoundingClientRect().height, 0);
        const chromeHeight = Math.max(0, body.clientHeight - totalRowsHeight);
        const budgetForRows = available - chromeHeight;
        const maxVisible = Math.max(1, Math.min(NEARBY_MAX_VISIBLE, Math.floor(budgetForRows / rowHeight)));

        const win = computeListWindow(laidOut.length, laidOutActiveIndex, maxVisible);
        laidOut.forEach(({ item }, i) => {
          item.classList.toggle('is-window-hidden', i < win.start || i > win.end);
        });
        moreAbove?.toggleAttribute('hidden', win.above === 0);
        if (moreAbove) moreAbove.textContent = `+${win.above} more above`;
        moreBelow?.toggleAttribute('hidden', win.below === 0);
        if (moreBelow) moreBelow.textContent = `+${win.below} more below`;
      };

      let fitQueued = false;
      const queueFit = () => {
        if (fitQueued) return;
        fitQueued = true;
        requestAnimationFrame(() => {
          fitQueued = false;
          fitList();
        });
      };

      const setActive = (id: string) => {
        activeIndex = pairs.findIndex((pair) => pair.target.id === id);
        pairs.forEach(({ item, link }, index) => {
          if (index === activeIndex) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
          item.classList.toggle('is-visited', activeIndex > -1 && index < activeIndex);
        });

        setActiveBranch(resolveSection(id));

        if (rail && pairs.length > 1) {
          const pct = activeIndex > -1 ? (activeIndex / (pairs.length - 1)) * 100 : 0;
          rail.style.height = `${Math.max(0, pct)}%`;
        }

        const activeLink = activeIndex > -1 ? pairs[activeIndex]?.link : null;
        activeLink?.scrollIntoView({ block: 'nearest', behavior: reduceMotion() ? 'auto' : 'smooth' });
        lastFitSignature = ''; // active index changed — force a re-evaluation
        queueFit();
      };

      const visibleTargets = new Set<HTMLElement>();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const target = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              visibleTargets.add(target);
            } else {
              visibleTargets.delete(target);
            }
          });

          const visible = Array.from(visibleTargets);
          if (visible.length === 0) return;

          const closest = visible.reduce((current, candidate) =>
            Math.abs(candidate.getBoundingClientRect().top) < Math.abs(current.getBoundingClientRect().top)
              ? candidate
              : current,
          );
          setActive(closest.id);
        },
        { rootMargin: '-10% 0px -80% 0px', threshold: 0 },
      );

      pairs.forEach(({ target }) => observer.observe(target));

      // Belt-and-suspenders synchronous recompute (see PostSidebar's prior
      // version of this comment): the observer's first callback is async
      // and can miss a page that loads already scrolled deep in.
      const currentActiveTarget = () =>
        root.querySelector<HTMLAnchorElement>('[data-companion-link][aria-current="location"]')?.dataset.companionTarget ?? null;

      const recomputeActive = () => {
        const activationLine = window.innerHeight * 0.1;
        let activeId: string | null = null;
        for (const { target } of pairs) {
          if (target.getBoundingClientRect().top <= activationLine) {
            activeId = target.id;
          } else {
            break;
          }
        }
        if (activeId && activeId !== currentActiveTarget()) setActive(activeId);
      };

      let recomputeQueued = false;
      const queueRecompute = () => {
        if (recomputeQueued) return;
        recomputeQueued = true;
        requestAnimationFrame(() => {
          recomputeQueued = false;
          recomputeActive();
        });
      };

      recomputeActive();
      window.addEventListener('scroll', queueRecompute, { passive: true });
      window.addEventListener('resize', queueRecompute, { passive: true });
      window.addEventListener(
        'resize',
        () => {
          lastFitSignature = '';
          queueFit();
        },
        { passive: true },
      );

      if ('ResizeObserver' in window) {
        new ResizeObserver(() => {
          lastFitSignature = '';
          queueFit();
        }).observe(outline);
      }

      allToggle?.addEventListener('click', () => {
        allExpanded = !allExpanded;
        allToggle.setAttribute('aria-pressed', String(allExpanded));
        allToggle.textContent = allExpanded ? 'Nearby only' : 'All sections';
        lastFitSignature = '';
        fitList();
      });

      queueFit();
    });
  };

  initializeReadingCompanions();
  document.addEventListener('astro:page-load', initializeReadingCompanions);
</script>
