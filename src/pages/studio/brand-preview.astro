---
/**
 * Brand + SVG preview (noindex, unlisted). Every hand-authored brand asset,
 * icon, ornament and diagram on all three language backgrounds and at
 * several sizes, for taste review and screenshot capture.
 *
 * Standalone page (no BaseLayout) so the shell's current tokens don't bleed
 * in. The language values below are PREVIEW FIXTURES copied from the design
 * token files (02 §2); the token node owns the real ones.
 */
import Mark from '../../components/brand/Mark.astro';
import Lockup from '../../components/brand/Lockup.astro';
import Icon from '../../components/brand/Icon.astro';
import SectionDivider from '../../components/brand/SectionDivider.astro';
import { iconNames } from '../../components/brand/svg-inline';
import ProcessLoopDiagram from '../../components/diagrams/ProcessLoopDiagram.astro';
import DotTimeline from '../../components/diagrams/DotTimeline.astro';
import LayeredDiamond from '../../components/diagrams/LayeredDiamond.astro';
import SystemArchitectureDiagram from '../../components/diagrams/SystemArchitectureDiagram.astro';

const languages = [
  { id: 'observatory', name: 'Observatory', note: 'dark editorial default' },
  { id: 'folio', name: 'Folio', note: 'paper and ink, Notebooks' },
  { id: 'instrument', name: 'Instrument', note: 'light technical, Studio' },
];
const navIcons = [
  ['writing', 'Writing'],
  ['labs', 'Labs'],
  ['projects', 'Projects'],
  ['notebooks', 'Notebooks'],
  ['studio', 'Studio'],
];
const titleCase = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const markSizes = [16, 20, 24, 32, 48, 96];
const devFlow = [
  { label: 'Workflow runs', detail: 'Agents execute a bounded task', tone: 'secondary' as const },
  { label: 'AAR generated', detail: 'Automated after-action review', tone: 'secondary' as const },
  { label: 'Human review', detail: 'Nick edits and approves', state: 'current' as const, tone: 'accent' as const },
  { label: 'Published', detail: 'Labelled Automated + Reviewed', state: 'next' as const, tone: 'muted' as const },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Brand preview · Signal to System</title>
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/brand/site.webmanifest" />
  </head>
  <body>
    {languages.map((lang) => (
      <section class="lang" data-language={lang.id} id={lang.id} aria-labelledby={`${lang.id}-h`}>
        <header class="bar">
          <Lockup size={30} href="#top" />
          <nav aria-label="Primary (preview)">
            {navIcons.map(([icon, label], i) => (
              <a href="#" class:list={[i === 0 && 'active']}>
                <Icon name={icon} size={18} />
                {label}
              </a>
            ))}
            <span class="search"><Icon name="search" size={16} label="Search" /></span>
          </nav>
        </header>

        <p class="kicker">Brand preview / {lang.name} / {lang.note}</p>
        <h2 id={`${lang.id}-h`}>The orbit and the trail.</h2>

        <div class="grid two">
          <div class="card">
            <h3>Mark, auto optical size</h3>
            <div class="row sizes">
              {markSizes.map((s) => (
                <figure>
                  <Mark size={s} />
                  <figcaption>{s}px{s <= 24 ? ' · small cut' : ''}</figcaption>
                </figure>
              ))}
            </div>
            <h3>16px: full geometry vs small cut</h3>
            <div class="row sizes">
              <figure><Mark size={16} variant="full" /><figcaption>full @16</figcaption></figure>
              <figure><Mark size={16} variant="small" /><figcaption>small @16</figcaption></figure>
              <figure><Mark size={24} variant="full" /><figcaption>full @24</figcaption></figure>
              <figure><Mark size={24} variant="small" /><figcaption>small @24</figcaption></figure>
            </div>
          </div>
          <div class="card">
            <h3>Lockups</h3>
            <div class="row lockups">
              <Lockup size={40} />
              <Lockup orientation="stacked" size={56} byline="By Nick Miethe" />
            </div>
            <h3>Reserve: constellation variant</h3>
            <div class="row sizes">
              {[24, 32, 48, 96].map((s) => (
                <figure><Mark size={s} variant="constellation" /><figcaption>{s}px</figcaption></figure>
              ))}
              <Lockup size={32} variant="constellation" byline="By Nick Miethe" />
            </div>
          </div>
        </div>

        <div class="card">
          <h3>Favicon set (rendered PNGs, identical in every language)</h3>
          <div class="row sizes favicons">
            <figure><img src="/brand/favicon-16.png" width="16" height="16" alt="" /><figcaption>16</figcaption></figure>
            <figure><img src="/brand/favicon-32.png" width="32" height="32" alt="" /><figcaption>32</figcaption></figure>
            <figure><img src="/brand/favicon.svg" width="32" height="32" alt="" /><figcaption>favicon.svg</figcaption></figure>
            <figure><img src="/brand/apple-touch-icon.png" width="64" height="64" alt="" /><figcaption>180 apple</figcaption></figure>
            <figure><img src="/brand/icon-192.png" width="64" height="64" alt="" class="rounded" /><figcaption>192</figcaption></figure>
            <figure><img src="/brand/icon-512.png" width="96" height="96" alt="" class="rounded" /><figcaption>512</figcaption></figure>
            <figure class="maskable"><img src="/brand/icon-maskable-512.png" width="96" height="96" alt="" /><figcaption>maskable 512 (safe zone)</figcaption></figure>
          </div>
        </div>

        <div class="card">
          <h3>Icons · 24px grid, 1.5 stroke, one accent detail</h3>
          <ul class="icons">
            {iconNames.map((n) => (
              <li><Icon name={n} size={24} /><span>{titleCase(n)}</span></li>
            ))}
          </ul>
          <div class="row sizes">
            {[16, 20, 24, 32, 48].map((s) => (
              <figure class="iconsize">
                <span>{['labs', 'claims', 'datasets', 'reproduce', 'research-programs'].map((n) => <Icon name={n} size={s} />)}</span>
                <figcaption>{s}px</figcaption>
              </figure>
            ))}
          </div>
        </div>

        <div class="card">
          <h3>Section dividers</h3>
          <SectionDivider variant="sparkle" width="560" />
          <SectionDivider variant="waveform" width="560" />
          <SectionDivider variant="moon" width="560" />
        </div>

        <div class="grid two">
          <div class="card">
            <h3>ProcessLoopDiagram</h3>
            <ProcessLoopDiagram width="420" />
          </div>
          <div class="card">
            <h3>DotTimeline · horizontal (About)</h3>
            <DotTimeline label="Selected timeline" />
            <h3 class="gap">DotTimeline · vertical, numbered (Dev Stories)</h3>
            <DotTimeline orientation="vertical" numbered items={devFlow} label="From execution to a published story" />
          </div>
        </div>

        <div class="grid two">
          <div class="card">
            <h3>LayeredDiamond · labelled (Studio composition)</h3>
            <LayeredDiamond
              width="460"
              labels={[
                { title: 'ResearchHeader', caption: 'Sets the context' },
                { title: 'ClaimRef', caption: 'Anchors the claim' },
                { title: 'FigureWithData', caption: 'Adds evidence' },
                { title: 'NotebookLeaf', caption: 'Captures thinking' },
                { title: 'ProvenanceTimeline', caption: 'Shows the trail' },
              ]}
            />
          </div>
          <div class="card">
            <h3>LayeredDiamond · 3 and 4 layers, bare</h3>
            <div class="row">
              <LayeredDiamond layers={3} width="180" />
              <LayeredDiamond layers={4} width="180" />
            </div>
            <h3 class="gap">SystemArchitectureDiagram · orbit</h3>
            <SystemArchitectureDiagram layout="orbit" width="400" />
          </div>
        </div>

        <div class="card">
          <h3>SystemArchitectureDiagram · flow (project dossier)</h3>
          <SystemArchitectureDiagram width="760" />
        </div>
      </section>
    ))}
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; }
  body { margin: 0; }
  [data-language='observatory'] {
    --canvas: #111517; --surface: #191e21; --ink: #f3f0e9; --muted: #a9b4b7;
    --accent: #b8a5f2; --secondary: #9cceb9; --rule: #3a4448;
  }
  [data-language='folio'] {
    --canvas: #f6f1e7; --surface: #fffaf1; --ink: #302c29; --muted: #6e645b;
    --accent: #974b32; --secondary: #456759; --rule: #c9bdad;
  }
  [data-language='instrument'] {
    --canvas: #f0f4f7; --surface: #ffffff; --ink: #142d42; --muted: #4f6579;
    --accent: #244fb0; --secondary: #006d70; --rule: #b9c7d2;
  }
  .lang {
    --font-display: Georgia, 'Times New Roman', serif;
    --font-sans: 'Helvetica Neue', Arial, system-ui, sans-serif;
    --font-mono: ui-monospace, 'SF Mono', Menlo, monospace;
    --icon-accent: var(--secondary);
    background: var(--canvas);
    color: var(--ink);
    font-family: var(--font-sans);
    padding: 28px 48px 48px;
  }
</style>

<style>
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 18px; border-bottom: 1px solid var(--rule); margin-bottom: 28px;
  }
  nav { display: flex; align-items: center; gap: 22px; font-size: 14px; }
  nav a { display: inline-flex; align-items: center; gap: 7px; color: var(--ink); text-decoration: none; }
  nav a.active { color: var(--accent); }
  nav a :global(.s2s-icon) { color: var(--muted); }
  nav a.active :global(.s2s-icon) { color: var(--accent); }
  .search { display: inline-grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--rule); border-radius: 6px; color: var(--muted); }
  .kicker { font: 11px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--secondary); margin: 0 0 6px; }
  h2 { font: 400 40px/1.1 var(--font-display); margin: 0 0 24px; }
  h3 { font: 500 11px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; }
  h3.gap { margin-top: 26px; }
  .grid.two { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 20px 22px; margin-bottom: 20px; }
  .row { display: flex; align-items: flex-end; gap: 22px; flex-wrap: wrap; margin-bottom: 18px; }
  .lockups { align-items: center; gap: 48px; }
  figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  figcaption { font: 10px var(--font-mono); color: var(--muted); letter-spacing: 0.04em; }
  .favicons img.rounded { border-radius: 14px; }
  .maskable { position: relative; }
  .maskable::after {
    content: ''; position: absolute; top: 9.6px; left: 50%; width: 76.8px; height: 76.8px;
    transform: translateX(-50%); border-radius: 50%; border: 1px dashed var(--secondary); pointer-events: none;
  }
  .icons { list-style: none; margin: 0 0 20px; padding: 0; display: grid; grid-template-columns: repeat(9, 1fr); gap: 18px 8px; }
  .icons li { display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--accent); }
  .icons span { font-size: 11px; color: var(--muted); text-align: center; }
  .iconsize span { display: flex; gap: 10px; color: var(--ink); }
  :global(.s2s-divider) { margin: 10px 0 18px; }
</style>
