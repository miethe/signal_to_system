---
import HubLayout from '../../layouts/templates/HubLayout.astro';
import CollectionPanel from '../../components/family/CollectionPanel.astro';
import PublicationList from '../../components/family/PublicationList.astro';
import Tabs from '../../components/primitives/Tabs.astro';
import { getPublications, byFormat, FORMAT_PLURAL } from '../../lib/writing';

const publications = await getPublications();
const formats = byFormat(publications.filter((item) => item.collection === 'posts' && item.format !== 'companion'));
const groups = Object.entries(formats).filter(([, items]) => items.length > 0) as [keyof typeof formats, typeof publications][];
---
<HubLayout title="Essays" description="Long-form writing on AI agents, agentic SDLC, architecture, platform engineering, and technical leadership." heading="Essays" eyebrow={['Writing', 'Essays']} lede="Long-form writing on the systems, decisions, and architectures that shape modern software.">
  <Fragment slot="head"><link rel="alternate" type="application/rss+xml" href="/feeds/essay.xml" title="Signal to System essays" /></Fragment>
  <Fragment slot="subnav"><Tabs label="Writing sections" items={[{ label: 'All writing', href: '/writing/', icon: 'writing' }, { label: 'Essays', href: '/essays/', icon: 'essays', current: true }, { label: 'Dev Stories', href: '/dev-stories/', icon: 'dev-stories' }]} /></Fragment>
  <div class="s2s-span-major essays-list">
    {groups.map(([format, items]) => <CollectionPanel title={FORMAT_PLURAL[format]} icon="essays" count={items.length}><PublicationList items={items} /></CollectionPanel>)}
  </div>
</HubLayout>
<style>.essays-list { display: grid; gap: 18px; min-width: 0; }</style>
