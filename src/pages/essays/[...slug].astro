---
import { getCollection, render } from 'astro:content';
import ReaderShell from '../../layouts/ReaderShell.astro';
import { getRelatedArticles } from '../../lib/content';
import { isPublishable } from '../../lib/publication.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('posts', isPublishable);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedItems = await getRelatedArticles(post);
---

<ReaderShell entry={post} headings={headings} relatedItems={relatedItems}>
  <Content />
</ReaderShell>
