---
import FacetPage from '../../../components/family/FacetPage.astro';
import { getPublications } from '../../../lib/writing';
import { getPublishedStories } from '../../../lib/content';

export async function getStaticPaths() {
  const [publications, stories] = await Promise.all([getPublications(), getPublishedStories()]);
  const byId = new Map(stories.map((story) => [story.id, story.data.workflow?.orchestrator]));
  const values = [...new Set(stories.map((story) => story.data.workflow?.orchestrator).filter(Boolean))] as string[];
  return values.map((orchestrator) => ({ params: { orchestrator }, props: { orchestrator, items: publications.filter((item) => item.format === 'dev-story' && byId.get(item.id) === orchestrator) } }));
}
const { orchestrator, items } = Astro.props;
---
<FacetPage icon="methods" title={orchestrator} description={`Dev Stories driven by the ${orchestrator} orchestrator.`} eyebrow={['Dev Stories', 'Orchestrator']} items={items} panelTitle="Dev Stories" back={{ href: '/dev-stories/', label: 'All Dev Stories' }} />
