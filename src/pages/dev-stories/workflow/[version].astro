---
import FacetPage from '../../../components/family/FacetPage.astro';
import { getPublications } from '../../../lib/writing';
import { getPublishedStories } from '../../../lib/content';
export async function getStaticPaths() {
  const [publications, stories] = await Promise.all([getPublications(), getPublishedStories()]);
  const versions = [...new Set(stories.map((story) => story.data.workflow?.version).filter(Boolean))] as string[];
  return versions.map((version) => ({ params: { version }, props: { version, items: publications.filter((item) => item.format === 'dev-story' && stories.find((story) => story.id === item.id)?.data.workflow?.version === version) } }));
}
const { version, items } = Astro.props;
---
<FacetPage title={`Workflow ${version}`} description={`Dev Stories built with workflow ${version} of the agentic execution loop.`} eyebrow={['Dev Stories', 'Workflow']} items={items} panelTitle="Dev Stories" back={{ href: '/dev-stories/', label: 'All Dev Stories' }} />
