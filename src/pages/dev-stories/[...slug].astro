---
import { getCollection, render } from 'astro:content';
import ReaderShell from '../../layouts/ReaderShell.astro';
import { isPublishable } from '../../lib/publication.mjs';
import { getRelatedArticles } from '../../lib/content';

export async function getStaticPaths() {
  const stories = await getCollection('stories', isPublishable);
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content, headings } = await render(story);
const relatedItems = await getRelatedArticles(story);
---

<ReaderShell entry={story} headings={headings} relatedItems={relatedItems}>
  <Content />
</ReaderShell>
