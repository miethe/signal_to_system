---
/**
 * Tag index (v2 re-skin, node_01M35CKMYGY080GKHKBGR7F1J2). One panel card
 * holding every tag as a chip, sorted by count desc then name.
 */
import StateNotice from '../../components/primitives/StateNotice.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/primitives/PageHero.astro';
import Card from '../../components/primitives/Card.astro';
import SectionHeading from '../../components/primitives/SectionHeading.astro';
import Badge from '../../components/ui/Badge.astro';
import { TAG_REGISTRY, tagsBySlug } from '../../data/taxonomy';
import { slugify } from '../../lib/utils';

// ---------------------------------------------------------------------------
// Build tag frequency map across posts + projects + stories
// ---------------------------------------------------------------------------

const allPosts = await getCollection('posts');
const allProjects = await getCollection('projects');
const allStories = await getCollection('stories');

const tagCounts = new Map<string, number>();
let totalPieces = 0;

for (const post of allPosts) {
  if (post.data.status === 'draft') continue;
  totalPieces += 1;
  for (const tag of post.data.tags ?? []) {
    const slug = slugify(tag);
    tagCounts.set(slug, (tagCounts.get(slug) ?? 0) + 1);
  }
}

for (const project of allProjects) {
  totalPieces += 1;
  for (const tag of project.data.tags ?? []) {
    const slug = slugify(tag);
    tagCounts.set(slug, (tagCounts.get(slug) ?? 0) + 1);
  }
}

for (const story of allStories) {
  if (story.data.status === 'draft') continue;
  totalPieces += 1;
  for (const tag of story.data.tags ?? []) {
    const slug = slugify(tag);
    tagCounts.set(slug, (tagCounts.get(slug) ?? 0) + 1);
  }
}

const allTags = [...tagCounts.keys()]
  .map((slug) => {
    const def = tagsBySlug[slug];
    return {
      slug,
      label: def?.label ?? slug.replace(/-/g, ' '),
      description: def?.description,
      count: tagCounts.get(slug)!,
    };
  })
  .sort((a, b) => (b.count !== a.count ? b.count - a.count : a.label.localeCompare(b.label)));

const totalTagCount = allTags.length;
void TAG_REGISTRY; // registry is consulted via tagsBySlug above for labels/descriptions
---

<BaseLayout
  title="Tags"
  description="Browse all tags across essays, dev stories, and projects on Signal to System."
>
  <PageHero
    compact
    eyebrow={['Writing', 'Tags']}
    heading="Tags"
    lede={`${totalTagCount} tags across ${totalPieces} pieces. Each links to every essay, build note and project sharing that concept.`}
  />

  <div class="tags-body">
    <SectionHeading title="All tags" description="Sorted by how often each concept shows up, then alphabetically." level={2} />
    {allTags.length === 0 ? (
      <StateNotice kind="empty" compact title="No tags yet." />
    ) : (
      <Card variant="panel" class="tags-cloud">
        {allTags.map(({ slug, label, description, count }) => (
          <a href={`/tags/${slug}/`} class="tags-chip s2s-focus" title={description}>
            <Badge variant="chip" text={label} />
            <Badge variant="count" text={String(count)} />
          </a>
        ))}
      </Card>
    )}
  </div>
</BaseLayout>

<style>
  .tags-body { max-width: 1180px; margin: 0 auto; padding: 24px 16px 64px; }
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .tags-body :global(.tags-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: var(--s2s-radius-pill);
    text-decoration: none;
  }
  .tags-body :global(.tags-chip:hover .s2s-badge--chip) {
    border-color: var(--s2s-rule-emphasis);
    color: var(--s2s-ink);
  }
  @media (min-width: 1024px) {
    .tags-body { padding: 24px var(--s2s-frame-gutter) 72px; }
  }
</style>
