---
/**
 * Tag detail (v2 re-skin, node_01M35CKMYGY080GKHKBGR7F1J2). IndexRailLayout
 * body: real essays/build notes/projects tagged with this concept, rail =
 * related tags (co-occurrence, computed) + a Browse card.
 */
import StateNotice from '../../components/primitives/StateNotice.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/primitives/PageHero.astro';
import Card from '../../components/primitives/Card.astro';
import SectionHeading from '../../components/primitives/SectionHeading.astro';
import Badge from '../../components/ui/Badge.astro';
import { TAG_REGISTRY, tagsBySlug } from '../../data/taxonomy';
import { slugify, formatDate, formatDateISO } from '../../lib/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const allProjects = await getCollection('projects');
  const allStories = await getCollection('stories');

  const tagSlugSet = new Set<string>();

  for (const post of allPosts) {
    if (post.data.status === 'draft') continue;
    for (const tag of post.data.tags ?? []) {
      tagSlugSet.add(slugify(tag));
    }
  }
  for (const project of allProjects) {
    for (const tag of project.data.tags ?? []) {
      tagSlugSet.add(slugify(tag));
    }
  }
  for (const story of allStories) {
    if (story.data.status === 'draft') continue;
    for (const tag of story.data.tags ?? []) {
      tagSlugSet.add(slugify(tag));
    }
  }

  return [...tagSlugSet].map((tagSlug) => {
    const matchedPosts = allPosts.filter(
      (p) => p.data.status !== 'draft' && (p.data.tags ?? []).some((t) => slugify(t) === tagSlug),
    ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    const matchedProjects = allProjects.filter((p) =>
      (p.data.tags ?? []).some((t) => slugify(t) === tagSlug),
    ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    const matchedStories = allStories.filter(
      (s) => s.data.status !== 'draft' && (s.data.tags ?? []).some((t) => slugify(t) === tagSlug),
    ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return {
      params: { tag: tagSlug },
      props: { tagSlug, posts: matchedPosts, projects: matchedProjects, stories: matchedStories },
    };
  });
}

const { tagSlug, posts, projects, stories } = Astro.props;

const tagDef = tagsBySlug[tagSlug];
const tagLabel = tagDef?.label ?? tagSlug.replace(/-/g, ' ');
const tagDescription = tagDef?.description;
const totalCount = posts.length + stories.length + projects.length;
const readLabel = (t: string) => `${t.replace(/\s*read$/i, '')} read`;

// Related tags: computed by co-occurrence on the matched posts/stories/projects — never invented.
const coCounts = new Map<string, number>();
for (const item of [...posts, ...stories, ...projects]) {
  for (const t of item.data.tags ?? []) {
    const s = slugify(t);
    if (s === tagSlug) continue;
    coCounts.set(s, (coCounts.get(s) ?? 0) + 1);
  }
}
const relatedTags = [...coCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([slug, count]) => ({ slug, label: tagsBySlug[slug]?.label ?? slug.replace(/-/g, ' '), count }));

void TAG_REGISTRY;
---

<BaseLayout
  title={`#${tagLabel}`}
  description={tagDescription ?? `All content tagged "${tagLabel}" on Signal to System.`}
>
  <PageHero
    compact
    eyebrow={['Writing', 'Tags', tagLabel]}
    heading={tagLabel}
    lede={tagDescription ?? `${totalCount} ${totalCount === 1 ? 'item' : 'items'} tagged "${tagLabel}".`}
  />

  <div class="tag-ir">
    <div class="tag-ir__main">
      {totalCount === 0 ? (
        <StateNotice kind="empty" compact title={`Nothing tagged “${tagLabel}” yet.`} body="Browse all tags for related concepts." />
      ) : (
        <>
          {posts.length > 0 && (
            <section class="tag-section" aria-labelledby="tag-essays">
              <SectionHeading id="tag-essays" icon="essays" title={`Essays — ${posts.length}`} level={2} />
              <ul class="tag-list">
                {posts.map((post) => (
                  <li>
                    <Card as="article" variant="panel" href={`/essays/${post.id}/`} class="tag-row">
                      <div class="tag-row__top">
                        <Badge variant="chip" text="Essay" />
                        <time class="s2s-meta" datetime={formatDateISO(post.data.date)}>{formatDate(post.data.date)}</time>
                        {post.data.readTime && <span class="s2s-meta">· {readLabel(post.data.readTime)}</span>}
                      </div>
                      <h3 class="tag-row__title">{post.data.title}</h3>
                      <p class="tag-row__excerpt">{post.data.excerpt}</p>
                    </Card>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {stories.length > 0 && (
            <section class="tag-section" aria-labelledby="tag-stories">
              <SectionHeading id="tag-stories" icon="dev-stories" title={`Build notes — ${stories.length}`} level={2} />
              <ul class="tag-list">
                {stories.map((story) => (
                  <li>
                    <Card as="article" variant="panel" href={`/dev-stories/${story.id}/`} class="tag-row">
                      <div class="tag-row__top">
                        <Badge variant="chip" text="Build note" />
                        <time class="s2s-meta" datetime={formatDateISO(story.data.date)}>{formatDate(story.data.date)}</time>
                        {story.data.readTime && <span class="s2s-meta">· {readLabel(story.data.readTime)}</span>}
                      </div>
                      <h3 class="tag-row__title">{story.data.title}</h3>
                      <p class="tag-row__excerpt">{story.data.excerpt}</p>
                    </Card>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {projects.length > 0 && (
            <section class="tag-section" aria-labelledby="tag-projects">
              <SectionHeading id="tag-projects" icon="projects" title={`Projects — ${projects.length}`} level={2} />
              <ul class="tag-list">
                {projects.map((project) => (
                  <li>
                    <Card as="article" variant="panel" href={`/projects/${project.id}/`} class="tag-row">
                      <div class="tag-row__top">
                        <Badge variant="chip" text="Project" />
                        {project.data.type && <span class="s2s-meta">{project.data.type}</span>}
                      </div>
                      <h3 class="tag-row__title">{project.data.title}</h3>
                      <p class="tag-row__excerpt">{project.data.excerpt}</p>
                    </Card>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )}
    </div>

    <aside class="tag-ir__rail" aria-label="Related">
      {relatedTags.length > 0 && (
        <Card variant="panel">
          <SectionHeading title="Related tags" level={3} />
          <div class="tag-related">
            {relatedTags.map((t) => (
              <Badge variant="chip" href={`/tags/${t.slug}/`} text={t.label} />
            ))}
          </div>
        </Card>
      )}
      <Card variant="panel">
        <SectionHeading title="Browse" level={3} />
        <ul class="tag-browse">
          <li><a class="s2s-focus" href="/tags/">All tags</a></li>
          <li><a class="s2s-focus" href="/series/">All series</a></li>
        </ul>
      </Card>
    </aside>
  </div>
</BaseLayout>

<style>
  .tag-ir {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding: 20px 16px 48px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .tag-ir__rail { display: flex; flex-direction: column; gap: 14px; }
  .tag-section + .tag-section { margin-top: 32px; }

  .tag-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .tag-ir :global(.tag-row) { display: block; color: inherit; text-decoration: none; }
  .tag-row__top { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .tag-row__title {
    margin: 0 0 6px;
    font: var(--type-heading-weight) var(--type-card) / 1.25 var(--font-display);
    color: var(--s2s-ink);
  }
  .tag-row__excerpt {
    margin: 0;
    font: 400 var(--type-ui) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-related { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag-browse { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .tag-browse a { font: 400 var(--type-ui) / 1.3 var(--font-sans); color: var(--s2s-accent); text-decoration: none; }
  .tag-browse a:hover { color: var(--s2s-accent-strong); }

  @media (min-width: 1024px) {
    .tag-ir {
      grid-template-columns: minmax(0, 1fr) var(--s2s-rail);
      gap: 24px 22px;
      padding: 16px 22px 56px 28px;
    }
    .tag-ir__rail { position: sticky; top: calc(var(--s2s-header-h) + 16px); align-self: start; }
  }
</style>
