---
/**
 * About v2 (node_01M35CKMX2NGE49N5YQP0ADT4E).
 * Visual authority: 01-site-mockups/signal_to_system_about_nick_miethe.png
 *
 * Content rule: nothing biographical is invented. Every fact below comes
 * from the pre-v2 About page (git history) or src/data/site.ts. The
 * mockup's placeholder copy (a Pacific Northwest location, an attributed
 * compass quote, a dated 2016-2025 timeline) is replaced with the real
 * equivalents: Bermuda Run NC, a sentence Nick wrote on this page, and the
 * career sequence without dates the page never stated.
 */
import HubLayout from '../layouts/templates/HubLayout.astro';
import Card from '../components/primitives/Card.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/brand/Icon.astro';
import ProcessLoopDiagram from '../components/diagrams/ProcessLoopDiagram.astro';
import DotTimeline from '../components/diagrams/DotTimeline.astro';
import { site } from '../data/site';
import { TOPIC_HUBS } from '../data/taxonomy';
import { portfolioItems } from '../data/portfolio';
import { getPublishedPosts, hrefFor } from '../lib/content';
import { formatDate } from '../lib/utils';

const posts = await getPublishedPosts();
const firstYear = posts.length ? Math.min(...posts.map((p) => p.data.date.getFullYear())) : undefined;

const areaIcons: Record<string, string> = {
  'ai-agents': 'research-programs',
  'agentic-sdlc': 'reproduce',
  'technical-leadership': 'reading-paths',
  cto: 'timeline',
  architecture: 'datasets',
  'platform-engineering': 'artifacts',
};
const areas = TOPIC_HUBS.filter((h) => h.slug in areaIcons);

// The two tools the About page names as his test beds, then the next in-progress one.
const named = ['SkillMeat', 'CCDash'];
const building = [
  ...named.map((n) => portfolioItems.find((p) => p.title === n)).filter((p): p is (typeof portfolioItems)[number] => Boolean(p)),
  ...portfolioItems.filter((p) => !named.includes(p.title) && p.status === 'in-progress' && !p.private && p.category === 'AI Agents'),
].slice(0, 3);
const statusLabel: Record<string, string> = { active: 'Active', 'in-progress': 'In progress', planned: 'Planned', archived: 'Archived' };
const hrefOf = (p: (typeof portfolioItems)[number]) => p.links[0]?.href ?? '/portfolio/';

const path = [
  { label: 'Network engineering', detail: 'Consulting, Cisco', tone: 'accent' as const },
  { label: 'Software engineering', detail: 'SAS, Allscripts', tone: 'accent' as const },
  { label: 'Platform enablement', detail: 'Containers and automation transformation', tone: 'accent' as const },
  { label: 'Consulting leadership', detail: 'Chief Architect, Red Hat practice · CTO, BoxBoat (IBM Consulting)', tone: 'secondary' as const },
  { date: firstYear ? String(firstYear) : undefined, label: 'Signal to System', detail: 'Writing it down in public', state: 'current' as const, tone: 'accent' as const },
];

const explore = [
  { label: 'Labs', note: 'Investigations and the AOS program', href: '/aos/', icon: 'labs' },
  { label: 'Projects', note: 'Tools, libraries and systems', href: '/portfolio/', icon: 'projects' },
  { label: 'Writing', note: 'Essays and series', href: '/essays/', icon: 'essays' },
  { label: 'Notebook', note: 'Build notes as they happen', href: '/dev-stories/', icon: 'notebooks' },
];
---

<HubLayout
  title="About"
  description="About Nick Miethe: technical executive, architect, and builder writing about AI agents, agentic SDLC, and modern software delivery."
  heading="About Nick Miethe"
  eyebrow={['People', 'Ideas', 'Systems', 'A brighter tomorrow']}
  lede={site.author.bioShort}
  hero={{
    photo: 'observatory',
    subheading: 'Building systems from signals.',
    quote: { text: 'I treat platform, process, and people as three views of the same problem.', by: 'Nick Miethe' },
    rail: ['Explore', 'Question', 'Build', 'Learn', 'Share', 'Repeat'],
    railFoot: ['A brighter', 'tomorrow', 'through better', 'questions.'],
  }}
>
  <Fragment slot="hero-actions">
    <Button href="/start-here/" variant="signal" size="lg">Start here <span aria-hidden="true">→</span></Button>
    <Button href="/portfolio/" variant="outline" size="lg"><Icon name="projects" size={16} /> View projects</Button>
  </Fragment>

  <!-- Bio -->
  <section class="s2s-span-half about-scope" aria-labelledby="about-bio">
    <Card variant="panel" class="about-bio">
      <figure class="about-bio__portrait">
        <img src={site.author.avatar.src} alt={`Portrait of ${site.author.name}`} width={site.author.avatar.width} height={site.author.avatar.height} loading="eager" decoding="async" />
      </figure>
      <div class="about-bio__body">
        <SectionHeading id="about-bio" icon="sparkle" title="Technical executive. Architect. Builder." />
        <p>
          I work where enterprise modernization meets the emerging agentic SDLC. Most of my paid time goes to being
          Chief Architect for the Red Hat practice and CTO of BoxBoat, both within IBM Consulting Hybrid Cloud &amp; Data:
          VMware migrations, delivery platforms, and the operating models that make cloud-native work at scale.
        </p>
        <p>
          Outside client work I build tools like SkillMeat and CCDash, the places I test ideas before they show up in
          an engagement or on this site. Right now I'm focused on AI agents as genuine participants in software
          delivery, not autocomplete.
        </p>
        <div class="about-chips">
          <span class="about-chip"><Icon name="topics" size={14} /> Bermuda Run, NC</span>
          <span class="about-chip"><Icon name="projects" size={14} /> IBM Consulting</span>
          <a class="about-chip about-chip--link s2s-focus" href={site.author.social.linkedin}>LinkedIn ↗</a>
        </div>
      </div>
    </Card>
  </section>

  <!-- What I work on -->
  <section class="s2s-span-half about-scope" aria-labelledby="about-areas">
    <SectionHeading
      id="about-areas"
      icon="topics"
      title="What I work on"
      description="Interconnected domains, written for technical executives, architects and senior practitioners."
      action={{ label: 'View all areas', href: '/start-here/' }}
    />
    <ul class="about-areas">
      {areas.map((a) => (
        <li>
          <Card variant="tile" href={`/topics/${a.slug}/`} class="about-area">
            <span class="about-area__icon"><Icon name={areaIcons[a.slug]} size={24} /></span>
            <span class="about-area__text">
              <span class="about-area__title">{a.label}</span>
              <span class="about-area__desc">{a.description}</span>
            </span>
          </Card>
        </li>
      ))}
    </ul>
  </section>

  <!-- Method -->
  <Card as="section" variant="panel" class="s2s-span-half about-method" aria-labelledby="about-method">
    <div class="about-method__text">
      <SectionHeading id="about-method" icon="methods" title="From ideas to evidence to systems" description="Practitioner-first, and honest about uncertainty." />
      <p>
        Everything here comes from real systems experience, not research summaries or think-pieces divorced from
        implementation. I write essays that develop an argument, surface the organizational and architectural
        factors behind a decision, and say so where I'm uncertain.
      </p>
      <Button href="/start-here/" variant="outline" size="md">Read more about my approach <span aria-hidden="true">→</span></Button>
    </div>
    <div class="about-method__loop">
      <ProcessLoopDiagram width="100%" />
    </div>
  </Card>

  <!-- Path -->
  <Card as="section" variant="panel" class="s2s-span-half about-path" aria-labelledby="about-path">
    <SectionHeading id="about-path" icon="timeline" title="The path so far" description="The sequence, not the dates." />
    <DotTimeline items={path} label="Career path, in order" class="about-path__h" />
    <DotTimeline items={path} orientation="vertical" label="Career path, in order" class="about-path__v" />
  </Card>

  <!-- Current building -->
  <section class="s2s-span-minor about-scope" aria-labelledby="about-building">
    <SectionHeading id="about-building" icon="projects" title="Current research & building" description="Where ideas get stress-tested." action={{ label: 'View all', href: '/portfolio/' }} />
    <ul class="about-list">
      {building.map((p) => (
        <li>
          <Card variant="tile" href={hrefOf(p)} class="about-build">
            <span class="about-build__title">{p.title}</span>
            <span class="about-build__desc">{p.description}</span>
            <span class:list={['about-status', p.status === 'active' ? 'about-status--live' : 'about-status--pending']}>
              <span class="about-status__dot" aria-hidden="true"></span>{statusLabel[p.status]}
            </span>
          </Card>
        </li>
      ))}
    </ul>
  </section>

  <!-- Selected writing -->
  <section class="s2s-span-minor about-scope" aria-labelledby="about-writing">
    <SectionHeading id="about-writing" icon="essays" title="Selected writing" description="Essays, argued in public." action={{ label: 'View all', href: '/essays/' }} />
    <ul class="about-list">
      {posts.slice(0, 3).map((p) => (
        <li>
          <Card variant="tile" href={hrefFor(p)} class="about-post">
            {p.data.heroImage && <img class="about-post__img" src={p.data.heroImage} alt="" width="64" height="48" loading="lazy" decoding="async" />}
            <span class="about-post__text">
              <span class="about-post__title">{p.data.title}</span>
              <span class="s2s-meta">{formatDate(p.data.date)} · Essay</span>
            </span>
          </Card>
        </li>
      ))}
    </ul>
  </section>

  <!-- Explore more -->
  <section class="s2s-span-minor about-scope" aria-labelledby="about-explore">
    <SectionHeading id="about-explore" icon="reading-paths" title="Explore more" description="Different entry points into the work." />
    <ul class="about-explore">
      {explore.map((e) => (
        <li>
          <Card variant="tile" href={e.href} class="about-explore__item">
            <span class="about-area__icon"><Icon name={e.icon} size={22} /></span>
            <span class="about-area__text">
              <span class="about-area__title">{e.label} <span aria-hidden="true">→</span></span>
              <span class="about-area__desc">{e.note}</span>
            </span>
          </Card>
        </li>
      ))}
    </ul>
  </section>

  <!-- Outside the office (real, from the pre-v2 page) -->
  <Card as="section" variant="panel" class="about-outside" aria-labelledby="about-outside">
    <SectionHeading id="about-outside" icon="notebooks" title="Outside the office" description="I don't separate the professional and personal lenses all that cleanly." />
    <ul class="about-outside__list">
      <li>Most of the research here starts in my homelab: a Proxmox cluster, Fedora hosts, a macOS box, and more mini-PCs than a responsible adult should admit to.</li>
      <li>Dad of three. Watching Montessori-aligned learning work (and occasionally not) at home sharpens how I think about learning systems.</li>
      <li>A makerspace of 3D printers, an electronics lab and drawers of IoT parts, next to shelves of aspirational board games.</li>
      <li>Based in Bermuda Run, NC, with my family and two dogs, Ty and Stanley, who have strong opinions about squirrels.</li>
    </ul>
    <p class="about-outside__contact">
      I occasionally advise on technical strategy, AI agent adoption and platform engineering. Reach me on
      <a href={site.author.social.linkedin}>LinkedIn</a> or <a href={site.author.social.twitter}>Twitter / X</a>.
    </p>
  </Card>
</HubLayout>

<style>
  /* ---------- Bio ---------- */
  .about-scope :global(.about-bio) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .about-bio__portrait {
    align-self: start;
    margin: 0;
    border: 1px solid var(--s2s-rule-strong);
    border-radius: var(--s2s-radius-control);
    overflow: hidden;
    background: var(--s2s-inset);
  }
  .about-bio__portrait img { display: block; width: 100%; height: auto; }
  .about-bio__body p {
    margin: 0 0 12px;
    font: 400 var(--type-ui) / 1.6 var(--font-sans);
    color: var(--s2s-ink-soft);
  }
  .about-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .about-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--s2s-rule-strong);
    border-radius: var(--s2s-radius-control);
    font: 400 var(--type-micro) / 1.2 var(--font-sans);
    color: var(--s2s-ink-soft);
    text-decoration: none;
  }
  .about-chip--link:hover { color: var(--s2s-accent); border-color: var(--s2s-rule-emphasis); }

  /* ---------- Areas / explore tiles ---------- */
  .about-areas, .about-explore, .about-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-areas > li, .about-explore > li, .about-list > li { display: flex; min-width: 0; }
  .about-scope :global(.about-area),
  .about-scope :global(.about-explore__item) {
    display: flex;
    gap: 12px;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .about-area__icon {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--s2s-accent);
    --icon-accent: var(--s2s-accent-strong);
  }
  .about-area__text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .about-area__title {
    font: var(--type-heading-weight) var(--type-card) / 1.2 var(--font-display);
    color: var(--s2s-ink);
  }
  .about-area__desc {
    font: 400 var(--type-micro) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- Method ---------- */
  :global(.about-method.about-method) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }
  .about-method__text p {
    margin: 0 0 16px;
    font: 400 var(--type-ui) / 1.6 var(--font-sans);
    color: var(--s2s-ink-soft);
  }
  .about-method__loop { max-width: 340px; margin-inline: auto; width: 100%; }

  /* ---------- Current building / writing ---------- */
  .about-scope :global(.about-build) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .about-build__title {
    font: var(--type-heading-weight) var(--type-card) / 1.2 var(--font-display);
    color: var(--s2s-ink);
  }
  .about-build__desc {
    font: 400 var(--type-micro) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .about-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font: 450 var(--type-micro) / 1 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .about-status__dot { width: 6px; height: 6px; border-radius: 999px; }
  .about-status--live .about-status__dot { background: var(--s2s-secondary); box-shadow: 0 0 6px var(--s2s-secondary); }
  .about-status--pending .about-status__dot { border: 1px solid var(--s2s-accent); }

  .about-scope :global(.about-post) {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .about-post__img {
    flex-shrink: 0;
    width: 64px;
    height: 48px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--s2s-rule);
    background: var(--s2s-inset);
  }
  .about-post__text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .about-post__title {
    font: var(--type-heading-weight) var(--type-ui) / 1.3 var(--font-display);
    font-size: 0.9375rem;
    color: var(--s2s-ink);
  }

  /* ---------- Outside ---------- */
  .about-outside__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px 32px;
    margin: 0 0 14px;
    padding-left: 18px;
    font: 400 var(--type-ui) / 1.55 var(--font-sans);
    color: var(--s2s-ink-soft);
  }
  .about-outside__list li::marker { color: var(--s2s-accent); }
  .about-outside__contact {
    margin: 0;
    font: 400 var(--type-ui) / 1.55 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .about-outside__contact a { color: var(--s2s-accent); }

  :global(.about-path__h) { display: none !important; }
  .about-bio__portrait { max-width: 160px; }

  @media (min-width: 640px) {
    :global(.about-path__h) { display: grid !important; }
    :global(.about-path__v) { display: none !important; }
    .about-bio__portrait { max-width: 200px; }
    .about-scope :global(.about-bio) { grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr); }
    .about-areas { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .about-explore { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(.about-method.about-method) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .about-outside__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .about-areas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
