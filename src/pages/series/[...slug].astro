---
import { getCollection } from 'astro:content';
import SeriesLayout from '../../layouts/SeriesLayout.astro';
import { getPostsBySeries, getStoriesBySeries, hrefFor } from '../../lib/content';
import { seriesMembers } from '../../lib/series.mjs';
import { SUBTYPE_LABEL } from '../../lib/writing';

export async function getStaticPaths() {
  const allSeries = await getCollection('series');

  return Promise.all(
    allSeries.map(async (seriesEntry) => {
      // Find all published posts + stories belonging to this series
      const [seriesPosts, seriesStories] = await Promise.all([
        getPostsBySeries(seriesEntry.id),
        getStoriesBySeries(seriesEntry.id),
      ]);

      // One reading order for both collections (seriesOrder, then date).
      const seriesEntries = seriesMembers(seriesEntry.id, [...seriesPosts, ...seriesStories]);

      return {
        params: { slug: seriesEntry.id },
        props: { seriesEntry, seriesEntries },
      };
    }),
  );
}

const { seriesEntry, seriesEntries } = Astro.props;
---

<SeriesLayout
  frontmatter={{
    title: seriesEntry.data.title,
    excerpt: seriesEntry.data.excerpt,
    status: seriesEntry.data.status,
    ogImage: seriesEntry.data.ogImage ?? `/og/series/${seriesEntry.id}.png`,
    topic: seriesEntry.data.topic,
  }}
  posts={seriesEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    date: entry.data.date,
    readTime: entry.data.readTime ? parseInt(entry.data.readTime) : undefined,
    part: entry.data.seriesOrder,
    href: hrefFor(entry),
    kind: entry.collection === 'stories' ? 'story' : 'essay',
    kindLabel: entry.collection === 'stories' ? SUBTYPE_LABEL[entry.data.storyType] : undefined,
  }))}
/>
