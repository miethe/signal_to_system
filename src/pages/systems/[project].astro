---
import FacetPage from '../../components/family/FacetPage.astro';
import { getAllProjects } from '../../lib/content';
import { getPublications } from '../../lib/writing';
import { projectsBySlug } from '../../data/taxonomy';

export async function getStaticPaths() {
  const [facets, publications] = await Promise.all([getAllProjects(), getPublications()]);
  return facets.map((facet) => {
    const definition = projectsBySlug[facet.slug];
    const label = definition?.label ?? facet.slug.replace(/-/g, ' ');
    return {
      params: { project: facet.slug },
      props: {
        label,
        description: definition?.description ?? `All writing about ${label} on Signal to System.`,
        items: publications.filter((publication) => publication.projects.includes(facet.slug)),
      },
    };
  });
}

const { label, description, items } = Astro.props;
---

<FacetPage title={label} description={description} eyebrow={['Systems']} items={items} panelTitle="Related writing" panelDescription={`Published essays and Dev Stories about ${label}.`} back={{ href: '/systems/', label: 'All systems' }} />
