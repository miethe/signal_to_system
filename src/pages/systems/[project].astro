---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayCard from '../../components/cards/EssayCard.astro';
import StoryCard from '../../components/cards/StoryCard.astro';
import { getAllProjects, getContentByProject } from '../../lib/content';
import { projectsBySlug } from '../../data/taxonomy';
import { slugify } from '../../lib/utils';

export async function getStaticPaths() {
  const projectFacets = await getAllProjects();
  const portfolioProjects = await getCollection('projects');

  return Promise.all(
    projectFacets.map(async (facet) => {
      const { posts, stories } = await getContentByProject(facet.slug);

      // Best-effort link to a matching portfolio project entry (id or title match).
      const portfolioMatch = portfolioProjects.find(
        (p) => p.id === facet.slug || slugify(p.data.title) === facet.slug,
      );

      return {
        params: { project: facet.slug },
        props: {
          projectSlug: facet.slug,
          posts,
          stories,
          portfolioId: portfolioMatch?.id,
        },
      };
    }),
  );
}

const { projectSlug, posts, stories, portfolioId } = Astro.props;

// Look up registry definition
const projectDef = projectsBySlug[projectSlug];
const projectLabel = projectDef?.label ?? projectSlug.replace(/-/g, ' ');
const projectDescription = projectDef?.description;
const isAos = projectDef?.aos === true;
const totalCount = posts.length + stories.length;
---

<BaseLayout
  title={projectLabel}
  description={projectDescription ?? `All writing about ${projectLabel} on Signal to System.`}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/systems/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Systems</a>
      <span aria-hidden="true">/</span>
      <span class="text-zinc-900 dark:text-zinc-100">{projectLabel}</span>
    </nav>

    <!-- Page header -->
    <header class="mb-12 border-b border-zinc-200 dark:border-zinc-800 pb-10">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <span class="inline-block rounded-md bg-indigo-100 dark:bg-indigo-900/40 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:text-indigo-300">
          System
        </span>
        {isAos && (
          <span class="inline-block rounded-md bg-violet-100 dark:bg-violet-900/40 px-2.5 py-1 text-xs font-medium text-violet-700 dark:text-violet-300">
            Agentic OS
          </span>
        )}
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-5xl mb-4">
        {projectLabel}
      </h1>
      {projectDescription && (
        <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed mb-2">
          {projectDescription}
        </p>
      )}
      <p class="text-zinc-500 dark:text-zinc-400">
        {totalCount} {totalCount === 1 ? 'item' : 'items'} — {posts.length} {posts.length === 1 ? 'essay' : 'essays'}, {stories.length} {stories.length === 1 ? 'dev story' : 'dev stories'}
      </p>
      {portfolioId && (
        <a
          href={`/projects/${portfolioId}/`}
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors"
        >
          View the project page
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      )}
    </header>

    <div class="space-y-16">
      <!-- Essays -->
      {posts.length > 0 && (
        <section>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400 mb-6">
            Essays — {posts.length}
          </h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <EssayCard
                title={post.data.title}
                excerpt={post.data.excerpt}
                date={post.data.date}
                readTime={post.data.readTime}
                category={post.data.category}
                tags={post.data.tags}
                slug={post.id}
                contentType={post.data.contentType}
                featured={false}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Dev Stories -->
      {stories.length > 0 && (
        <section>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400 mb-6">
            Dev Stories — {stories.length}
          </h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {stories.map((story) => (
              <StoryCard
                title={story.data.title}
                excerpt={story.data.excerpt}
                date={story.data.date}
                readTime={story.data.readTime}
                slug={story.id}
                storyType={story.data.storyType}
                projects={story.data.projects}
                automated={story.data.automated}
                workflow={story.data.workflow}
                tags={story.data.tags}
                featured={false}
              />
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Back link -->
    <div class="mt-12">
      <a
        href="/systems/"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
        </svg>
        All Systems
      </a>
    </div>
  </div>
</BaseLayout>
