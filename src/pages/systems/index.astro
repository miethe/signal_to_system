---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS_REGISTRY } from '../../data/taxonomy';
import { getAllProjects } from '../../lib/content';

// ---------------------------------------------------------------------------
// Build project/system list — registry-first (with descriptions), then any
// unregistered project slugs referenced in frontmatter.
// ---------------------------------------------------------------------------

const projectFacets = await getAllProjects();
const countsBySlug = new Map(projectFacets.map((p) => [p.slug, p.count]));
const registrySet = new Set(PROJECTS_REGISTRY.map((p) => p.slug));

const registeredProjects = PROJECTS_REGISTRY.filter((p) => countsBySlug.has(p.slug))
  .map((p) => ({
    slug: p.slug,
    label: p.label,
    description: p.description,
    aos: p.aos === true,
    count: countsBySlug.get(p.slug)!,
  }))
  .sort((a, b) => b.count - a.count);

const unregisteredProjects = projectFacets
  .filter((p) => !registrySet.has(p.slug))
  .map((p) => ({
    slug: p.slug,
    label: p.slug.replace(/-/g, ' '),
    description: undefined,
    aos: false,
    count: p.count,
  }))
  .sort((a, b) => b.count - a.count);

const allProjects = [...registeredProjects, ...unregisteredProjects];
const totalCount = allProjects.length;
---

<BaseLayout
  title="Systems"
  description="Browse writing by the projects and systems it relates to on Signal to System."
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <!-- Page header -->
    <header class="mb-12 border-b border-zinc-200 dark:border-zinc-800 pb-10">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-5xl mb-4">
        Systems
      </h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed">
        The projects and systems this writing relates to. Each links to the essays and dev stories that touch it.
      </p>
    </header>

    {allProjects.length === 0 ? (
      <div class="rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 p-16 text-center">
        <p class="text-zinc-500 dark:text-zinc-400">No systems found.</p>
      </div>
    ) : (
      <div class="space-y-10">
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400 mb-6">
            {totalCount} {totalCount === 1 ? 'system' : 'systems'}
          </h2>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {allProjects.map(({ slug, label, description, aos, count }) => (
              <li>
                <a
                  href={`/systems/${slug}/`}
                  class="group flex items-start gap-3 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 hover:border-indigo-300 dark:hover:border-indigo-700 transition-all duration-150"
                >
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-0.5">
                      <span class="flex items-center gap-2">
                        <span class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                          {label}
                        </span>
                        {aos && (
                          <span class="inline-block rounded-md bg-violet-100 dark:bg-violet-900/40 px-1.5 py-0.5 text-[10px] font-medium text-violet-700 dark:text-violet-300">
                            AOS
                          </span>
                        )}
                      </span>
                      <span class="text-xs text-zinc-400 dark:text-zinc-500 shrink-0">
                        {count} {count === 1 ? 'item' : 'items'}
                      </span>
                    </div>
                    {description && (
                      <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                        {description}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    )}
  </div>
</BaseLayout>
