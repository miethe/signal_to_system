---
import HubLayout from '../../layouts/templates/HubLayout.astro';
import CollectionPanel from '../../components/family/CollectionPanel.astro';
import FacetRail from '../../components/primitives/FacetRail.astro';
import StateNotice from '../../components/primitives/StateNotice.astro';
import { PROJECTS_REGISTRY } from '../../data/taxonomy';
import { getAllProjects } from '../../lib/content';

// ---------------------------------------------------------------------------
// Build project/system list — registry-first (with descriptions), then any
// unregistered project slugs referenced in frontmatter.
// ---------------------------------------------------------------------------

const projectFacets = await getAllProjects();
const countsBySlug = new Map(projectFacets.map((p) => [p.slug, p.count]));
const registrySet = new Set(PROJECTS_REGISTRY.map((p) => p.slug));

const registeredProjects = PROJECTS_REGISTRY.filter((p) => countsBySlug.has(p.slug))
  .map((p) => ({
    slug: p.slug,
    label: p.label,
    description: p.description,
    aos: p.aos === true,
    count: countsBySlug.get(p.slug)!,
  }))
  .sort((a, b) => b.count - a.count);

const unregisteredProjects = projectFacets
  .filter((p) => !registrySet.has(p.slug))
  .map((p) => ({
    slug: p.slug,
    label: p.slug.replace(/-/g, ' '),
    description: undefined,
    aos: false,
    count: p.count,
  }))
  .sort((a, b) => b.count - a.count);

const allProjects = [...registeredProjects, ...unregisteredProjects];
const totalCount = allProjects.length;
---

<HubLayout title="Systems" description="Browse writing by the projects and systems it relates to on Signal to System." heading="Systems" eyebrow={['Explore']} lede="The projects and systems this writing relates to. Each links to the essays and Dev Stories that touch it.">
  <CollectionPanel class="s2s-span-major" title="Systems" icon="projects" count={totalCount} description="Browse the systems behind the work.">
    {allProjects.length ? <FacetRail heading="Systems" icon="projects" items={allProjects.map((project) => ({ label: project.label, href: `/systems/${project.slug}/`, count: project.count }))} /> : <StateNotice title="No systems found" body="Systems will appear here when published writing references them." />}
  </CollectionPanel>
</HubLayout>
