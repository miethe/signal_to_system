---
/** 404 (v2, node_01M35CKMYGY080GKHKBGR7F1J2) — a compact hero + StateNotice,
 * with the real nav destinations for a quiet way back. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/primitives/PageHero.astro';
import StateNotice from '../components/primitives/StateNotice.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist or has moved."
  noindex
>
  <PageHero
    compact
    eyebrow={['404', 'Off the map']}
    heading="This page isn't in the notebook."
    lede="The link may be old, or the page may have moved when the site was reorganised."
  />

  <div class="nf">
    <StateNotice kind="not-found" art title="Nothing at this address" body="Try one of the real destinations below, or head back to the front page.">
      <Fragment slot="actions">
        <Button href="/" variant="signal">Go home</Button>
        <Button href="/essays/" variant="outline">Browse essays</Button>
      </Fragment>
    </StateNotice>

    <nav class="nf__nav" aria-label="Site sections">
      <p class="s2s-label nf__nav-label">Or try</p>
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 20px 60px;
  }
  .nf__nav { text-align: center; }
  .nf__nav-label { margin: 0 0 10px; }
  .nf__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nf__nav a {
    font: 400 var(--type-ui) / 1.4 var(--font-sans);
    color: var(--s2s-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .nf__nav a:hover { color: var(--s2s-accent); border-color: var(--s2s-accent); }

  @media (min-width: 1024px) {
    .nf { padding: 32px var(--s2s-frame-gutter) 72px; }
  }
</style>
