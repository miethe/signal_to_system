---
/**
 * Homepage v2 (node_01M35CKMWBR6YJ06DBNZY6AW5V).
 * Visual authority: 01-site-mockups/signal_to_system_better_questions_brighter_futur.png
 *
 * Every figure on this page is counted from a real collection or data file.
 * Labs has no published investigation yet, so its slot is an honest
 * "in preparation" state that points at the program that does exist, never
 * a mocked dataset. Projects show status and stack, never invented stars.
 */
import HubLayout from '../layouts/templates/HubLayout.astro';
import Card from '../components/primitives/Card.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import StatTile from '../components/primitives/StatTile.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/brand/Icon.astro';
import V2Image from '../components/media/V2Image.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { evidence } from '../data/evidence';
import { portfolioItems } from '../data/portfolio';
import { getPublishedPosts, getPublishedStories, hrefFor } from '../lib/content';
import { getTagLabel } from '../lib/tags';
import { formatDate } from '../lib/utils';

const posts = await getPublishedPosts();
const stories = await getPublishedStories();
const uiDocs = await getCollection('ui');

const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const latestStory = stories[0];

const STUDIO_PROJECT = '@miethe/ui Component Library';
const SELF = 'Signal to System Blog';
const projectPool = portfolioItems.filter((p) => !p.private && p.title !== SELF && p.title !== STUDIO_PROJECT);
const selectedProjects = [
  ...projectPool.filter((p) => p.featured),
  ...projectPool.filter((p) => !p.featured && p.status !== 'archived'),
].slice(0, 3);
const studio = portfolioItems.find((p) => p.title === STUDIO_PROJECT);

const statusLabel: Record<string, string> = {
  active: 'Active',
  'in-progress': 'In progress',
  planned: 'Planned',
  archived: 'Archived',
};
const projectIcon: Record<string, string> = {
  'AI Agents': 'research-programs',
  'Developer Tools': 'reproduce',
  Apps: 'projects',
};
const githubOf = (p: (typeof portfolioItems)[number]) =>
  p.links.find((l) => l.label.toLowerCase().startsWith('github'))?.href ?? p.links[0]?.href;

const readLabel = (t: string) => `${t.replace(/\s*read$/i, '')} read`;

const stats = [
  { value: posts.length, label: 'Essays', note: 'Long-form, argued in public', icon: 'essays', href: '/essays/' },
  { value: stories.length, label: 'Build notes', note: 'Execution records, reviewed', icon: 'field-notes', href: '/dev-stories/' },
  { value: Object.keys(evidence).length, label: 'Evidence records', note: 'Claims with their receipts', icon: 'evidence', href: '/aos/' },
  { value: portfolioItems.filter((p) => !p.private).length, label: 'Projects', note: 'Code, tools and systems', icon: 'projects', href: '/portfolio/' },
];
---

<HubLayout
  description={site.description}
  heading="A more rigorous relationship with reality."
  eyebrow={['Ideas', 'Evidence', 'Systems']}
  lede="Signal to System is a public research and engineering practice by Nick Miethe that investigates questions, exposes evidence, and builds systems, from first principles to real-world impact."
  hero={{
    photo: 'observatory',
    quote: { text: 'Better questions.\nClearer evidence.\nMore useful systems.' },
    rail: ['Observe', 'Investigate', 'Build', 'Share', 'Repeat'],
    railFoot: ['A quieter', 'brighter', 'tomorrow'],
  }}
>
  <Fragment slot="hero-actions">
    <Button href="/aos/" variant="signal" size="lg">Explore Labs <span aria-hidden="true">→</span></Button>
    <Button href="/essays/" variant="outline" size="lg"><Icon name="essays" size={16} /> Read Essays</Button>
  </Fragment>

  <!-- Featured investigation: Labs is in preparation -->
  <section class="s2s-span-major home-block home-scope" aria-labelledby="home-labs">
    <SectionHeading
      id="home-labs"
      icon="labs"
      title="Featured Investigation"
      label="Labs"
      description="Deep dives with evidence, not hot takes."
      action={{ label: 'View all labs', href: '/aos/' }}
    />
    <Card variant="panel" class="home-lab">
      <div class="home-lab__art">
        <V2Image kind="sticker" id="mountain-arc" class="home-lab__sticker" />
        <p class="home-lab__art-caption s2s-meta" aria-hidden="true">Investigation 001<br />in preparation</p>
      </div>
      <div class="home-lab__body">
        <div class="home-chips">
          <Badge variant="chip" text="Labs" />
          <Badge variant="chip" text="Evidence-first" />
          <span class="home-status home-status--pending"><span class="home-status__dot" aria-hidden="true"></span>In preparation</span>
        </div>
        <h3 class="home-lab__title">The first investigation is on the bench.</h3>
        <p class="home-lab__desc">
          Labs will publish investigations with their datasets, methods and findings attached, so every
          claim can be traced back to its evidence. Until the first one ships, the Agentic OS program is
          where that evidence lives today.
        </p>
        <ul class="home-lab__meta" aria-label="What each investigation will carry">
          <li><Icon name="datasets" size={15} /> Datasets</li>
          <li><Icon name="methods" size={15} /> Methods</li>
          <li><Icon name="reproduce" size={15} /> Reproducible</li>
        </ul>
        <div class="home-lab__actions">
          <Button href="/aos/" variant="signal" size="md">Follow the AOS program <span aria-hidden="true">→</span></Button>
          <Button href="/start-here/" variant="outline" size="md"><Icon name="reading-paths" size={15} /> Start here</Button>
        </div>
      </div>
    </Card>
  </section>

  <!-- Evidence at a glance -->
  <Card as="section" variant="panel" class="s2s-span-minor home-glance" aria-labelledby="home-glance">
    <SectionHeading id="home-glance" icon="datasets" title="Evidence at a glance" level={2} action={{ label: 'View all', href: '/aos/' }} />
    <div class="home-glance__list">
      {stats.map((s) => <StatTile {...s} />)}
    </div>
    <p class="home-glance__quote">“Claims deserve evidence. Here’s the trail.”</p>
  </Card>

  <!-- Featured writing -->
  {featuredPost && (
    <section class="s2s-span-half home-block home-scope" aria-labelledby="home-writing">
      <SectionHeading
        id="home-writing"
        icon="essays"
        title="Featured Writing"
        label="Essays"
        description="Long-form thinking on agents, systems and delivery."
        action={{ label: 'View all writing', href: '/essays/' }}
      />
      <Card variant="panel" href={hrefFor(featuredPost)} class="home-essay">
        {featuredPost.data.heroImage && (
          <img class="home-essay__img" src={featuredPost.data.heroImage} alt="" width="280" height="190" loading="lazy" decoding="async" />
        )}
        <div class="home-essay__body">
          <div class="home-essay__top">
            <div class="home-chips">
              {featuredPost.data.tags.slice(0, 3).map((t) => <Badge variant="chip" text={getTagLabel(t)} />)}
            </div>
            {featuredPost.data.readTime && <span class="s2s-meta home-nowrap">{readLabel(featuredPost.data.readTime)}</span>}
          </div>
          <h3 class="home-card-title">{featuredPost.data.title}</h3>
          <p class="home-card-desc">{featuredPost.data.excerpt}</p>
          <p class="s2s-meta home-essay__date">
            <time datetime={featuredPost.data.date.toISOString()}>{formatDate(featuredPost.data.date)}</time>
            {featuredPost.data.category && <span>· {featuredPost.data.category}</span>}
          </p>
        </div>
      </Card>
    </section>
  )}

  <!-- Selected projects -->
  <section class="s2s-span-half home-block home-scope" aria-labelledby="home-projects">
    <SectionHeading
      id="home-projects"
      icon="projects"
      title="Selected Projects"
      label="Build"
      description="From research to working systems."
      action={{ label: 'View all projects', href: '/portfolio/' }}
    />
    <ul class="home-projects">
      {selectedProjects.map((p) => (
        <li>
          <Card variant="tile" href={githubOf(p)} class="home-project">
            <span class="home-project__icon"><Icon name={projectIcon[p.category] ?? 'projects'} size={22} /></span>
            <h3 class="home-project__title">{p.title}</h3>
            <p class="home-project__desc">{p.description}</p>
            <div class="home-chips home-project__foot">
              <Badge variant="chip" text={p.category} />
              <span class:list={['home-status', p.status === 'active' ? 'home-status--live' : 'home-status--pending']}>
                <span class="home-status__dot" aria-hidden="true"></span>{statusLabel[p.status]}
              </span>
            </div>
          </Card>
        </li>
      ))}
    </ul>
  </section>

  <!-- Notebook -->
  {latestStory && (
    <section class="s2s-span-half home-block home-scope" aria-labelledby="home-notebook">
      <SectionHeading
        id="home-notebook"
        icon="notebooks"
        title="Notebook"
        label="Build notes"
        description="Work in progress, written down as it happens."
        action={{ label: 'View all notebooks', href: '/dev-stories/' }}
      />
      <Card variant="panel" href={hrefFor(latestStory)} class="home-note">
        <V2Image kind="sticker" id="notebook" class="home-note__art" />
        <div class="home-note__body">
          <h3 class="home-card-title home-card-title--sm">{latestStory.data.title}</h3>
          <p class="s2s-meta">
            <time datetime={latestStory.data.date.toISOString()}>{formatDate(latestStory.data.date)}</time>
            · {readLabel(latestStory.data.readTime)}
          </p>
          <p class="home-card-desc home-card-desc--clamp">{latestStory.data.excerpt}</p>
          <div class="home-chips">
            {latestStory.data.tags.slice(0, 2).map((t) => <Badge variant="chip" text={getTagLabel(t)} />)}
          </div>
        </div>
      </Card>
    </section>
  )}

  <!-- Studio -->
  <section class="s2s-span-half home-block home-scope" aria-labelledby="home-studio">
    <SectionHeading
      id="home-studio"
      icon="studio"
      title="Studio"
      label="Components"
      description="Reusable tools for researchers and builders."
      action={{ label: 'View all studio', href: '/portfolio/ui/' }}
    />
    <Card variant="panel" href="/portfolio/ui/" class="home-studio">
      <span class="home-studio__icon"><Icon name="studio" size={24} /></span>
      <div class="home-studio__body">
        <h3 class="home-card-title home-card-title--sm">@miethe/ui</h3>
        <p class="home-card-desc home-card-desc--clamp">{studio?.description ?? 'The component library behind this site.'}</p>
        <div class="home-chips">
          <Badge variant="chip" text="TypeScript" />
          <Badge variant="chip" text="React" />
          <Badge variant="count" text={`${uiDocs.length} documented`} />
        </div>
      </div>
      <V2Image kind="sticker" id="signal-noise" class="home-studio__art" />
    </Card>
  </section>
</HubLayout>

<style>
  .home-block { min-width: 0; }

  .home-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .home-nowrap { white-space: nowrap; }

  .home-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 450 var(--type-micro) / 1 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .home-status__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
  }
  .home-status--live .home-status__dot { background: var(--s2s-secondary); box-shadow: 0 0 6px var(--s2s-secondary); }
  .home-status--pending .home-status__dot { background: transparent; border: 1px solid var(--s2s-accent); }

  .home-card-title {
    margin: 10px 0 6px;
    font: var(--type-heading-weight) var(--type-title) / 1.15 var(--font-display);
    color: var(--s2s-ink);
    text-wrap: balance;
  }
  .home-card-title--sm { font-size: var(--type-card); margin-top: 0; }
  .home-card-desc {
    margin: 0 0 12px;
    font: 400 var(--type-ui) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .home-card-desc--clamp {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- Featured investigation (in preparation) ---------- */
  .home-scope :global(.home-lab) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .home-lab__art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 180px;
    border: 1px solid var(--s2s-rule-strong);
    border-radius: var(--s2s-radius-control);
    background:
      radial-gradient(70% 80% at 50% 30%, var(--s2s-accent-soft), transparent 70%),
      var(--s2s-inset);
    overflow: hidden;
  }
  .home-lab__art :global(img) { width: min(88%, 260px); height: auto; display: block; }
  .home-lab__art-caption {
    position: absolute;
    left: 12px;
    top: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--s2s-ink-subtle);
  }
  .home-lab__title {
    margin: 12px 0 6px;
    font: var(--type-heading-weight) var(--type-title) / 1.15 var(--font-display);
    color: var(--s2s-ink);
  }
  .home-lab__desc {
    margin: 0;
    max-width: 58ch;
    font: 400 var(--type-ui) / 1.55 var(--font-sans);
    color: var(--s2s-ink-soft);
  }
  .home-lab__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font: 400 var(--type-micro) / 1 var(--font-sans);
    color: var(--s2s-ink-muted);
  }
  .home-lab__meta li { display: inline-flex; align-items: center; gap: 6px; }
  .home-lab__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }

  /* ---------- Evidence at a glance ---------- */
  :global(.home-glance.home-glance) { display: flex; flex-direction: column; }
  .home-glance__list { flex: 1; }
  .home-glance__quote {
    margin: 12px 0 0;
    text-align: right;
    font: italic 400 var(--type-ui) / 1.4 var(--font-serif);
    color: var(--s2s-ink-soft);
  }

  /* ---------- Featured writing ---------- */
  .home-scope :global(.home-essay) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    color: inherit;
    text-decoration: none;
  }
  .home-essay__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--s2s-radius-control);
    border: 1px solid var(--s2s-rule);
    background: var(--s2s-inset);
  }
  .home-essay__top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .home-essay__date { display: flex; gap: 6px; margin: 0; }

  /* ---------- Selected projects ---------- */
  .home-projects {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-projects > li { display: flex; min-width: 0; }
  .home-scope :global(.home-project) {
    display: flex;
    flex-direction: column;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .home-project__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--s2s-rule-strong);
    background: var(--s2s-inset);
    color: var(--s2s-accent);
    --icon-accent: var(--s2s-accent-strong);
  }
  .home-project__title {
    margin: 12px 0 4px;
    font: var(--type-heading-weight) var(--type-card) / 1.2 var(--font-display);
    color: var(--s2s-ink);
  }
  .home-project__desc {
    flex: 1;
    margin: 0 0 12px;
    font: 400 var(--type-micro) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .home-project__foot { justify-content: space-between; }

  /* ---------- Notebook ---------- */
  .home-scope :global(.home-note) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    color: inherit;
    text-decoration: none;
  }
  .home-scope :global(.home-note__art) { display: block; }
  .home-scope :global(.home-note__art) :global(img) { display: block; width: 100%; max-width: 220px; height: auto; margin-inline: auto; }
  .home-note__body .s2s-meta { margin: 0 0 8px; }

  /* ---------- Studio ---------- */
  .home-scope :global(.home-studio) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }
  .home-studio__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--s2s-radius-control);
    border: 1px solid var(--s2s-rule-strong);
    background: var(--s2s-inset);
    color: var(--s2s-accent);
    --icon-accent: var(--s2s-accent-strong);
  }
  .home-scope :global(.home-studio__art) { display: none; }

  @media (min-width: 640px) {
    .home-scope :global(.home-lab) { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr); }
    .home-scope :global(.home-essay) { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.6fr); }
    .home-essay__img { aspect-ratio: auto; height: 100%; min-height: 150px; max-height: 170px; }
    .home-projects { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-scope :global(.home-note) { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr); align-items: center; }
    .home-scope :global(.home-studio) { grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.9fr); }
    .home-scope :global(.home-studio__art) { display: block; align-self: center; }
    .home-scope :global(.home-studio__art) :global(img) { display: block; width: 100%; height: auto; border-radius: var(--s2s-radius-control); }
  }
</style>
