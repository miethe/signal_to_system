---
/**
 * Workflow Showcase — Astro page.
 *
 * Renders the interactive `<WorkflowStage>` island for a chosen stage.
 * Stage is selected via `?stage=<id>` query parameter; defaults to the
 * first published stage.
 *
 * Phase 1 scope: only the test-fixture stage exists. Real stages (Stage 1,
 * Stage 2, …) are authored in Phases 2–3 via the demo-foundry pipeline.
 *
 * See: docs/specs/workflow-showcase-implementation.md (WS-1.8)
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import WorkflowStage from "../components/interactive/WorkflowStage.tsx";
import workflowData from "../data/workflow-stages.json";
import type { Stage, WorkflowStagesData } from "../types/workflow";
import "../styles/workflow-showcase.css";

const data = workflowData as WorkflowStagesData;
const publishedStages: Stage[] = data.stages.filter(
  (s) => s.status === "published",
);

const requestedStageId = Astro.url.searchParams.get("stage") ?? "";
const selectedStage: Stage | undefined =
  publishedStages.find((s) => s.id === requestedStageId) ??
  publishedStages[0];

const stageNotFound = requestedStageId !== "" && !publishedStages.find((s) => s.id === requestedStageId);

const pageTitle = selectedStage
  ? `${selectedStage.title} · Workflow Showcase`
  : "Workflow Showcase";

const pageDescription = selectedStage
  ? selectedStage.description
  : "Interactive visualization of the Governed Agentic SDLC workflow.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div data-showcase class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <header class="mb-10 border-b border-[var(--border-subtle)] pb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">
        Living Workflow Showcase
      </p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">
        The Governed Agentic SDLC, stage by stage
      </h1>
      <p class="mt-3 text-[var(--text-secondary)] max-w-prose">
        Scrub through a real agentic workflow. Each stage mirrors a post in the
        Governed Agentic SDLC series and links to the MeatySkill that produced it.
      </p>

      {publishedStages.length > 1 && (
        <form method="get" class="ws-stage-selector mt-6">
          <label for="stage-select" class="text-[var(--text-tertiary)] font-medium">
            Stage:
          </label>
          <select id="stage-select" name="stage" aria-label="Select workflow stage" onchange="this.form.submit()">
            {publishedStages.map((s) => (
              <option value={s.id} selected={s.id === selectedStage?.id}>
                {s.title}
              </option>
            ))}
          </select>
          <noscript>
            <button type="submit" class="ws-scrubber__btn">Go</button>
          </noscript>
        </form>
      )}
    </header>

    {stageNotFound && (
      <div class="surface mb-6 p-4 text-sm text-[var(--text-secondary)]">
        <strong>Stage not found.</strong> The id <code>{requestedStageId}</code> is
        not a published stage. Showing
        <code>{selectedStage?.id ?? "(none)"}</code> instead.
      </div>
    )}

    {selectedStage ? (
      <WorkflowStage client:idle stage={selectedStage} />
    ) : (
      <div class="surface p-8 text-center">
        <p class="text-[var(--text-secondary)]">
          No published stages yet. The first stage will land alongside Post 1 of
          the Governed Agentic SDLC series.
        </p>
      </div>
    )}
  </div>
</BaseLayout>
