---
import HubLayout from '../../layouts/templates/HubLayout.astro';
import CollectionPanel from '../../components/family/CollectionPanel.astro';
import FacetRail from '../../components/primitives/FacetRail.astro';
import StateNotice from '../../components/primitives/StateNotice.astro';
import { AOS_AREAS_REGISTRY } from '../../data/taxonomy';
import { getAllAosAreas } from '../../lib/content';
const facets = await getAllAosAreas();
const counts = new Map(facets.map((facet) => [facet.slug, facet.count]));
const areas = AOS_AREAS_REGISTRY.filter((area) => counts.has(area.slug)).map((area) => ({ ...area, count: counts.get(area.slug)! }));
---
<HubLayout title="The Agentic OS" description="Writing about building the Agentic OS — orchestration, memory, research, knowledge, artifacts, execution, and the infrastructure underneath it." heading="The Agentic OS" eyebrow={['Systems']} lede="Writing about the personal umbrella of orchestration, memory, research, knowledge, and execution subsystems — and the infrastructure that keeps it running.">
  <CollectionPanel class="s2s-span-major" title="Areas" icon="projects" count={areas.length} description="Browse the Agentic OS by area.">
    {areas.length ? <FacetRail heading="Areas" icon="aos" items={areas.map((area) => ({ label: area.label, href: `/aos/${area.slug}/`, count: area.count }))} /> : <StateNotice title="No Agentic OS content found" body="Published writing about the Agentic OS will appear here." />}
  </CollectionPanel>
</HubLayout>
