---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayCard from '../../components/cards/EssayCard.astro';
import StoryCard from '../../components/cards/StoryCard.astro';
import { getContentByAosArea, getAllAosAreas } from '../../lib/content';
import { AOS_AREAS_REGISTRY } from '../../data/taxonomy';

// ---------------------------------------------------------------------------
// All aos:true content, grouped by AOS area.
// ---------------------------------------------------------------------------

const { posts, stories } = await getContentByAosArea();
const areaFacets = await getAllAosAreas();
const countsBySlug = new Map(areaFacets.map((a) => [a.slug, a.count]));

const groups = AOS_AREAS_REGISTRY.filter((area) => countsBySlug.has(area.slug)).map(
  (area) => ({
    slug: area.slug,
    label: area.label,
    description: area.description,
    posts: posts.filter((p) => (p.data.aosAreas ?? []).includes(area.slug)),
    stories: stories.filter((s) => (s.data.aosAreas ?? []).includes(area.slug)),
  }),
);

// aos:true content that isn't tagged with any registered area still belongs
// on this page — collect it under a General bucket so nothing is dropped.
const generalPosts = posts.filter(
  (p) => !(p.data.aosAreas ?? []).some((slug) => countsBySlug.has(slug)),
);
const generalStories = stories.filter(
  (s) => !(s.data.aosAreas ?? []).some((slug) => countsBySlug.has(slug)),
);

const totalCount = posts.length + stories.length;
---

<BaseLayout
  title="The Agentic OS"
  description="Writing about building the Agentic OS — orchestration, memory, research, knowledge, artifacts, execution, and the infrastructure underneath it."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <!-- Page header -->
    <header class="mb-12 border-b border-zinc-200 dark:border-zinc-800 pb-10">
      <div class="mb-3">
        <span class="inline-block rounded-md bg-violet-100 dark:bg-violet-900/40 px-2.5 py-1 text-xs font-medium text-violet-700 dark:text-violet-300">
          Agentic OS
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-5xl mb-4">
        The Agentic OS
      </h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed mb-4">
        Writing about building the Agentic OS: the personal umbrella of orchestration, memory, research, knowledge, and execution subsystems, and the infrastructure that keeps it running.
      </p>
      <p class="text-zinc-500 dark:text-zinc-400">
        {totalCount} {totalCount === 1 ? 'item' : 'items'} — {posts.length} {posts.length === 1 ? 'essay' : 'essays'}, {stories.length} {stories.length === 1 ? 'dev story' : 'dev stories'}
      </p>
    </header>

    <!-- Area nav -->
    {groups.length > 0 && (
      <nav class="mb-12 flex flex-wrap gap-2" aria-label="AOS areas">
        {groups.map((group) => (
          <a
            href={`/aos/${group.slug}/`}
            class="inline-flex items-center gap-1.5 rounded-md border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-sm font-medium text-zinc-700 hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-zinc-300 dark:hover:border-violet-700 dark:hover:bg-violet-900/30 dark:hover:text-violet-300 transition-colors"
          >
            {group.label}
            <sup class="text-[10px] text-zinc-400 dark:text-zinc-500">
              {group.posts.length + group.stories.length}
            </sup>
          </a>
        ))}
      </nav>
    )}

    {totalCount === 0 ? (
      <div class="rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 p-16 text-center">
        <p class="text-zinc-500 dark:text-zinc-400">No Agentic OS content found yet.</p>
      </div>
    ) : (
      <div class="space-y-16">
        {groups.map((group) => (
          (group.posts.length > 0 || group.stories.length > 0) && (
            <section id={group.slug}>
              <div class="mb-6">
                <h2 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-50">
                  <a href={`/aos/${group.slug}/`} class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
                    {group.label}
                  </a>
                </h2>
                {group.description && (
                  <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 max-w-2xl">
                    {group.description}
                  </p>
                )}
              </div>
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {group.posts.map((post) => (
                  <EssayCard
                    title={post.data.title}
                    excerpt={post.data.excerpt}
                    date={post.data.date}
                    readTime={post.data.readTime}
                    category={post.data.category}
                    tags={post.data.tags}
                    slug={post.id}
                    contentType={post.data.contentType}
                    featured={false}
                  />
                ))}
                {group.stories.map((story) => (
                  <StoryCard
                    title={story.data.title}
                    excerpt={story.data.excerpt}
                    date={story.data.date}
                    readTime={story.data.readTime}
                    slug={story.id}
                    storyType={story.data.storyType}
                    projects={story.data.projects}
                    automated={story.data.automated}
                    workflow={story.data.workflow}
                    tags={story.data.tags}
                    featured={false}
                  />
                ))}
              </div>
            </section>
          )
        ))}

        <!-- General bucket — aos:true content without a registered area -->
        {(generalPosts.length > 0 || generalStories.length > 0) && (
          <section>
            <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400 mb-6">
              General — {generalPosts.length + generalStories.length}
            </h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {generalPosts.map((post) => (
                <EssayCard
                  title={post.data.title}
                  excerpt={post.data.excerpt}
                  date={post.data.date}
                  readTime={post.data.readTime}
                  category={post.data.category}
                  tags={post.data.tags}
                  slug={post.id}
                  contentType={post.data.contentType}
                  featured={false}
                />
              ))}
              {generalStories.map((story) => (
                <StoryCard
                  title={story.data.title}
                  excerpt={story.data.excerpt}
                  date={story.data.date}
                  readTime={story.data.readTime}
                  slug={story.id}
                  storyType={story.data.storyType}
                  projects={story.data.projects}
                  automated={story.data.automated}
                  workflow={story.data.workflow}
                  tags={story.data.tags}
                  featured={false}
                />
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</BaseLayout>
