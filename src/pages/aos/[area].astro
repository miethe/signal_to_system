---
import FacetPage from '../../components/family/FacetPage.astro';
import { getAllAosAreas } from '../../lib/content';
import { getPublications } from '../../lib/writing';
import { aosAreasBySlug } from '../../data/taxonomy';

export async function getStaticPaths() {
  const [facets, publications] = await Promise.all([getAllAosAreas(), getPublications()]);
  return facets.map((facet) => {
    const definition = aosAreasBySlug[facet.slug];
    const label = definition?.label ?? facet.slug.replace(/-/g, ' ');
    return {
      params: { area: facet.slug },
      props: {
        label,
        description: definition?.description ?? `Writing about ${label} in the Agentic OS on Signal to System.`,
        items: publications.filter((publication) => publication.aos && publication.aosAreas.includes(facet.slug)),
      },
    };
  });
}
const { label, description, items } = Astro.props;
---

<FacetPage icon="research-programs" title={label} description={description} eyebrow={['Agentic OS']} items={items} panelTitle="Related writing" back={{ href: '/aos/', label: 'The Agentic OS' }} />
