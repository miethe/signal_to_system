---
/**
 * Topic hub detail (v2 re-skin, node_01M35CKMYGY080GKHKBGR7F1J2). IndexRailLayout
 * body: essays matching this topic's category, rail = related tags (computed from
 * the matched essays) + a Browse card. Matching logic (post.category === hub.label)
 * is unchanged from v1 — only the skin changes.
 */
import Button from '../../components/ui/Button.astro';
import StateNotice from '../../components/primitives/StateNotice.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/primitives/PageHero.astro';
import Card from '../../components/primitives/Card.astro';
import SectionHeading from '../../components/primitives/SectionHeading.astro';
import Badge from '../../components/ui/Badge.astro';
import { TOPIC_HUBS, tagsBySlug, type TopicHub } from '../../data/taxonomy';
import { formatDate, formatDateISO, slugify } from '../../lib/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');

  return TOPIC_HUBS.map((hub) => {
    const posts = allPosts
      .filter((p) => p.data.status !== 'draft' && p.data.category.toLowerCase() === hub.label.toLowerCase())
      .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return b.data.date.getTime() - a.data.date.getTime();
      });

    return { params: { topic: hub.slug }, props: { hub, posts } };
  });
}

const { hub, posts } = Astro.props as { hub: TopicHub; posts: Awaited<ReturnType<typeof getCollection<'posts'>>> };

const totalCount = posts.length;
const featured = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);
const readLabel = (t: string) => `${t.replace(/\s*read$/i, '')} read`;

// Related tags: computed from the matched essays' own tags — never invented.
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags ?? []) {
    const s = slugify(t);
    tagCounts.set(s, (tagCounts.get(s) ?? 0) + 1);
  }
}
const relatedTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([slug]) => ({ slug, label: tagsBySlug[slug]?.label ?? slug.replace(/-/g, ' ') }));

const otherHubs = TOPIC_HUBS.filter((h) => h.slug !== hub.slug);
---

<BaseLayout title={hub.label} description={hub.description}>
  <PageHero
    compact
    eyebrow={['Writing', 'Topics', hub.label]}
    heading={hub.label}
    lede={`${hub.description} ${totalCount} ${totalCount === 1 ? 'essay' : 'essays'} so far.`}
  />

  <div class="topic-ir">
    <div class="topic-ir__main">
      {totalCount === 0 ? (
        <StateNotice kind="empty" compact title="No essays in this topic yet." body="Browse all essays while this topic fills in." ><Button slot="actions" href="/essays/" variant="outline" size="sm">Browse essays</Button></StateNotice>
      ) : (
        <>
          {featured.length > 0 && (
            <section class="topic-section" aria-labelledby="topic-featured">
              <SectionHeading id="topic-featured" icon="topics" title="Essential reading" level={2} />
              <ul class="topic-list">
                {featured.map((post) => (
                  <li>
                    <Card as="article" variant="panel" href={`/essays/${post.id}/`} class="topic-row">
                      <div class="topic-row__top">
                        <Badge variant="chip" text="Essay" />
                        <time class="s2s-meta" datetime={formatDateISO(post.data.date)}>{formatDate(post.data.date)}</time>
                        {post.data.readTime && <span class="s2s-meta">· {readLabel(post.data.readTime)}</span>}
                      </div>
                      <h3 class="topic-row__title">{post.data.title}</h3>
                      <p class="topic-row__excerpt">{post.data.excerpt}</p>
                    </Card>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {rest.length > 0 && (
            <section class="topic-section" aria-labelledby="topic-more">
              {featured.length > 0 && <SectionHeading id="topic-more" title={`More in ${hub.label}`} level={2} />}
              <ul class="topic-list">
                {rest.map((post) => (
                  <li>
                    <Card as="article" variant="panel" href={`/essays/${post.id}/`} class="topic-row">
                      <div class="topic-row__top">
                        <Badge variant="chip" text="Essay" />
                        <time class="s2s-meta" datetime={formatDateISO(post.data.date)}>{formatDate(post.data.date)}</time>
                        {post.data.readTime && <span class="s2s-meta">· {readLabel(post.data.readTime)}</span>}
                      </div>
                      <h3 class="topic-row__title">{post.data.title}</h3>
                      <p class="topic-row__excerpt">{post.data.excerpt}</p>
                    </Card>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )}
    </div>

    <aside class="topic-ir__rail" aria-label="Related">
      {relatedTags.length > 0 && (
        <Card variant="panel">
          <SectionHeading title="Related tags" level={3} />
          <div class="topic-related">
            {relatedTags.map((t) => (
              <Badge variant="chip" href={`/tags/${t.slug}/`} text={t.label} />
            ))}
          </div>
        </Card>
      )}
      <Card variant="panel">
        <SectionHeading title="Browse" level={3} />
        <ul class="topic-browse">
          <li><a class="s2s-focus" href="/tags/">All tags</a></li>
          <li><a class="s2s-focus" href="/series/">All series</a></li>
        </ul>
      </Card>
    </aside>

    <div class="topic-ir__after">
      <SectionHeading title="Other topics" level={3} />
      <div class="topic-others">
        {otherHubs.map((h) => (
          <a class="s2s-badge s2s-badge--chip s2s-focus" href={`/topics/${h.slug}/`}>{h.label}</a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .topic-ir {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding: 20px 16px 48px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .topic-ir__rail { display: flex; flex-direction: column; gap: 14px; }
  .topic-ir__after { margin-top: 8px; }
  .topic-section + .topic-section { margin-top: 32px; }

  .topic-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .topic-ir :global(.topic-row) { display: block; color: inherit; text-decoration: none; }
  .topic-row__top { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .topic-row__title {
    margin: 0 0 6px;
    font: var(--type-heading-weight) var(--type-card) / 1.25 var(--font-display);
    color: var(--s2s-ink);
  }
  .topic-row__excerpt {
    margin: 0;
    font: 400 var(--type-ui) / 1.5 var(--font-sans);
    color: var(--s2s-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .topic-related { display: flex; flex-wrap: wrap; gap: 6px; }
  .topic-browse { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .topic-browse a { font: 400 var(--type-ui) / 1.3 var(--font-sans); color: var(--s2s-accent); text-decoration: none; }
  .topic-browse a:hover { color: var(--s2s-accent-strong); }
  .topic-others { display: flex; flex-wrap: wrap; gap: 8px; }

  @media (min-width: 1024px) {
    .topic-ir {
      grid-template-columns: minmax(0, 1fr) var(--s2s-rail);
      gap: 24px 22px;
      padding: 16px 22px 56px 28px;
    }
    .topic-ir__rail { position: sticky; top: calc(var(--s2s-header-h) + 16px); align-self: start; }
    .topic-ir__after { grid-column: 1 / -1; }
  }
</style>
